Функция Элемент(ИмяСправочника, Наименование) Экспорт
    Менеджер = Справочники[ИмяСправочника]; Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если Не Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьЭлемент(); Объект.Наименование = Наименование; Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Процедура Заполнить() Экспорт
    Если Не Справочники.Номенклатура.НайтиПоНаименованию("Демо: данные заполнены", Истина).Пустая() Тогда Возврат; КонецЕсли;
    НачатьТранзакцию();
    Попытка
    Подразделение = Элемент("Подразделения", "Демо: основной цех");
    Склад = Элемент("Склады", "Демо: склад");
    Деталь = Элемент("Номенклатура", "Демо: плата");
    Блок = Элемент("Номенклатура", "Демо: компьютер");
    Аналог = Элемент("Номенклатура", "Демо: плата аналог");
    Свойство = Элемент("СвойстваНоменклатуры", "Демо: ASUS");
    Объект = Деталь.ПолучитьОбъект(); Объект.Артикул = "001"; Объект.Записать();
    Объект = Аналог.ПолучитьОбъект(); Объект.Артикул = "002"; Объект.Записать();
    Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
    Запись.Период = '20240101'; Запись.Подразделение = Подразделение; Запись.Метод = Перечисления.МетодыСписания.FIFO; Запись.Записать();
    Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
    Запись.Период = '20240101'; Запись.СистемныйБлок = Блок; Запись.Деталь = Деталь; Запись.Свойство = Свойство; Запись.Количество = 2; Запись.Записать();
    Запись = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Запись.Товар = Деталь; Запись.Аналог = Аналог; Запись.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент(); Приход.Дата = '20240102100000'; Приход.Подразделение = Подразделение; Приход.Склад = Склад;
    Стр = Приход.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Деталь; Стр.Свойство = Свойство; Стр.Количество = 20; Стр.Цена = 100; Стр.Сумма = 2000;
    Стр = Приход.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Аналог; Стр.Количество = 10; Стр.Цена = 120; Стр.Сумма = 1200;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Сборка = Документы.Сборка.СоздатьДокумент(); Сборка.Дата = '20240103100000';
    Сборка.ПодразделениеИсточник = Подразделение; Сборка.ПодразделениеПолучатель = Подразделение;
    Стр = Сборка.СистемныеБлоки.Добавить(); Стр.Номенклатура = Блок; Стр.Количество = 3;
    Сборка.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = '20240104100000';
    Стр = Продажа.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Блок; Стр.Подразделение = Подразделение; Стр.Количество = 1; Стр.Цена = 350; Стр.Сумма = 350;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = '20240105100000'; Продажа.Склад = Склад;
    Стр = Продажа.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Деталь; Стр.Количество = 23; Стр.Цена = 160; Стр.Сумма = 3680;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Операция = Документы.Операция.СоздатьДокумент(); Операция.Дата = '20240106100000';
    Стр = Операция.Проводки.Добавить(); Стр.СчетДт = ПланыСчетов.Управленческий.Товары; Стр.СчетКт = ПланыСчетов.Управленческий.Поставщики;
    Стр.НоменклатураДт = Деталь; Стр.СкладДт = Склад; Стр.КоличествоДт = 5; Стр.Сумма = 550;
    Операция.Записать(РежимЗаписиДокумента.Проведение);
    ЗаполнитьЗарплату();
    ЗаполнитьДополнительныеСведения();
    Элемент("Номенклатура", "Демо: данные заполнены");
    ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры


Процедура ЗаполнитьЗарплату() Экспорт
    РасчетЗарплаты.НастроитьВидыРасчета();
    Подразделение = Элемент("Подразделения", "Демо: основной цех");
    Работник = Элемент("ФизическиеЛица", "Демо: инженер");
    Руководитель = Элемент("ФизическиеЛица", "Демо: руководитель");
    Об = Работник.ПолучитьОбъект(); Об.НачалоСтажа = '20200101'; Об.Записать();
    Об = Руководитель.ПолучитьОбъект(); Об.НачалоСтажа = '20200101'; Об.Записать();
    График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); График.Отбор.Подразделение.Установить(Подразделение);
    Дата = '20231001';
    Пока Дата <= '20240430' Цикл
        Стр = График.Добавить(); Стр.Подразделение = Подразделение; Стр.Дата = Дата;
        Стр.Значение = ?(ДеньНедели(Дата) <= 5, 8, 0); Стр.Дни = ?(Стр.Значение > 0, 1, 0); Дата = Дата + 86400;
    КонецЦикла; График.Записать();
    Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Запись.Период = '20231001'; Запись.Сотрудник = Работник; Запись.Ставка = 100; Запись.Записать();
    Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Запись.Период = '20231001'; Запись.Сотрудник = Руководитель; Запись.Ставка = 200; Запись.Записать();
    Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 0; Запись.Процент = 5; Запись.Записать();
    Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 1; Запись.Процент = 10; Запись.Записать();
    Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Запись.Стаж = 3; Запись.Процент = 15; Запись.Записать();
    Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = '20231231';
    Для Н = 10 По 12 Цикл
        Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Работник; Стр.Подразделение = Подразделение;
        Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; Стр.ДатаНачала = Дата(2023, Н, 1); Стр.ДатаОкончания = КонецМесяца(Стр.ДатаНачала);
    КонецЦикла; Док.Записать(РежимЗаписиДокумента.Проведение);
    Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = '20240131';
    Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Руководитель; Стр.Подразделение = Подразделение;
    Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия; Стр.ДатаНачала = '20240101'; Стр.ДатаОкончания = '20240131';
    Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Работник; Стр.Подразделение = Подразделение;
    Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; Стр.ДатаНачала = '20240101'; Стр.ДатаОкончания = '20240131';
    Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Работник; Стр.Подразделение = Подразделение;
    Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; Стр.ДатаНачала = '20240115'; Стр.ДатаОкончания = '20240119';
    Док.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры


Функция ВидСведения(Имя, ИмяТипа)
    Ссылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Имя, Истина);
    Если Не Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Об = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); Об.Наименование = Имя;
    Об.ТипЗначения = Новый ОписаниеТипов(ИмяТипа); Об.Записать(); Возврат Об.Ссылка;
КонецФункции

Процедура ЗаполнитьДополнительныеСведения() Экспорт
    Менеджер = Элемент("ФизическиеЛица", "Демо: руководитель");
    ВалютаКредита = ВидСведения("Валюта кредита", "СправочникСсылка.Валюты");
    СрокКредита = ВидСведения("Срок кредита, дни", "Число");
    Регион = ВидСведения("Регион", "Строка");
    Производитель = ВидСведения("Производитель", "Строка");
    Об = Менеджер.ПолучитьОбъект(); Об.ДополнительныеСведенияКонтрагентов.Очистить();
    Об.ДополнительныеСведенияКонтрагентов.Добавить().ВидСведения = ВалютаКредита;
    Об.ДополнительныеСведенияКонтрагентов.Добавить().ВидСведения = СрокКредита;
    Об.ДополнительныеСведенияКонтрагентов.Добавить().ВидСведения = Регион; Об.Записать();
    Контрагент = Элемент("Контрагенты", "Демо: завод Сатурн"); Об = Контрагент.ПолучитьОбъект(); Об.Менеджер = Менеджер;
    Об.ДополнительныеСведения.Очистить();
    Стр = Об.ДополнительныеСведения.Добавить(); Стр.ВидСведения = СрокКредита; Стр.Значение = 10;
    Стр = Об.ДополнительныеСведения.Добавить(); Стр.ВидСведения = Регион; Стр.Значение = "Москва"; Об.Записать();
    Запись = РегистрыСведений.ЗначенияСвойствНоменклатуры.СоздатьМенеджерЗаписи();
    Запись.Свойство = Элемент("СвойстваНоменклатуры", "Демо: ASUS"); Запись.Характеристика = Производитель; Запись.Значение = "ASUS"; Запись.Записать();
КонецПроцедуры

