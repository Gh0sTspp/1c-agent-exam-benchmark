Функция ЗапросТаблица(Текст, Параметры) Экспорт
    Запрос = Новый Запрос(Текст);
    Для Каждого П Из Параметры Цикл
        Запрос.УстановитьПараметр(П.Ключ, П.Значение);
    КонецЦикла;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Ошибка(Текст) Экспорт
    ВызватьИсключение Текст;
КонецПроцедуры

Функция СуммаСтроки(Строка) Экспорт
    Если Строка.Сумма = 0 Тогда Возврат Окр(Строка.Цена * Строка.Количество, 2); КонецЕсли;
    Возврат Строка.Сумма;
КонецФункции

Процедура ПроверитьСтроки(Таблица) Экспорт
    Для Каждого Стр Из Таблица Цикл
        Если Не ЗначениеЗаполнено(Стр.Номенклатура) Или Стр.Количество <= 0 Тогда
            Ошибка("Укажите номенклатуру и положительное количество, строка " + Стр.НомерСтроки);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Приход(Док) Экспорт
    ПроверитьСтроки(Док.СписокНоменклатуры);
    СтарыеАналитики = ПредыдущиеАналитикиДокумента(Док, Истина);
    Док.Движения.ОстаткиНоменклатуры.Очистить();
    Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Док.Движения.Управленческий.Очистить();
    Док.Движения.Управленческий.Записывать = Истина;
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Сумма = СуммаСтроки(Стр);
        Если Сумма < 0 Тогда Ошибка("Сумма поступления не может быть отрицательной"); КонецЕсли;
        Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Док.Подразделение);
        Если ЗначениеЗаполнено(Подразделение) Тогда
            Дв = Док.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
            Дв.Период = Док.Дата; Дв.Номенклатура = Стр.Номенклатура;
            Дв.Подразделение = Подразделение; Дв.Свойство = Стр.Свойство;
            Дв.Партия = Док.Ссылка; Дв.ДатаПартии = Док.Дата;
            Дв.Количество = Стр.Количество; Дв.Стоимость = Сумма;
        КонецЕсли;
        Если ЗначениеЗаполнено(Док.Склад) Тогда
            Дв = Док.Движения.Управленческий.Добавить();
            Дв.Период = Док.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.Товары;
            Дв.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура; Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Док.Склад;
            Дв.КоличествоДт = Стр.Количество; Дв.Сумма = Сумма;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Док.Склад) Тогда
            Ошибка("Укажите склад бухгалтерского учета или подразделение оперативного учета");
        КонецЕсли;
    КонецЦикла;
    ПроверитьТекущиеОстатки(Док, Истина, СтарыеАналитики);
КонецПроцедуры

Процедура РучнаяОперация(Док) Экспорт
    Док.Движения.Управленческий.Очистить();
    Док.Движения.Управленческий.Записывать = Истина;
    Для Каждого Стр Из Док.Проводки Цикл
        Если Не ЗначениеЗаполнено(Стр.СчетДт) Или Не ЗначениеЗаполнено(Стр.СчетКт) Тогда
            Ошибка("В проводке должны быть указаны оба счета");
        КонецЕсли;
        Дв = Док.Движения.Управленческий.Добавить();
        Дв.Период = Док.Дата; Дв.СчетДт = Стр.СчетДт; Дв.СчетКт = Стр.СчетКт;
        Дв.Заказано = Стр.Заказано; Дв.Продано = Стр.Продано;
        Если Дв.СчетКт = ПланыСчетов.Управленческий.Товары И Дв.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки Тогда
            Если Не ЗначениеЗаполнено(Дв.Продано) Тогда Дв.Продано = Стр.НоменклатураКт; КонецЕсли;
            Если Не ЗначениеЗаполнено(Дв.Заказано) Тогда Дв.Заказано = Дв.Продано; КонецЕсли;
        КонецЕсли;
        Дв.Сумма = Стр.Сумма; Дв.КоличествоДт = Стр.КоличествоДт; Дв.КоличествоКт = Стр.КоличествоКт;
        Если ЗначениеЗаполнено(Стр.НоменклатураДт) Тогда Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.НоменклатураКт) Тогда Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураКт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СкладДт) Тогда Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СкладКт) Тогда Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладКт; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ЗаблокироватьЗапасы(Потребности, Момент)
    // Таблица нужна как изменяемый резерв при повторяющихся строках и партиях.
    Блокировка = Новый БлокировкаДанных;
    Э = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
    Э.Режим = РежимБлокировкиДанных.Исключительный;
    Э.ИсточникДанных = Потребности;
    Э.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    Э.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
    Э.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
    Блокировка.Заблокировать();
    П = Новый Структура("Момент,Товары,Подразделения", Момент,
        Потребности.ВыгрузитьКолонку("Номенклатура"), Потребности.ВыгрузитьКолонку("Подразделение"));
    Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    | Партия.Дата КАК ДатаПартии, КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    | ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
    | Номенклатура В (&Товары) И Подразделение В (&Подразделения))
    | УПОРЯДОЧИТЬ ПО ДатаПартии, Партия", П);
КонецФункции

Функция СписатьЗапас(Док, Остатки, Стр, Метод)
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Стр.Подразделение, Стр.Номенклатура, Стр.Свойство);
    Партии = Остатки.НайтиСтроки(Отбор);
    Всего = 0; Стоимость = 0;
    Для Каждого П Из Партии Цикл Всего = Всего + П.Количество; Стоимость = Стоимость + П.Стоимость; КонецЦикла;
    Если Всего < Стр.Количество Тогда
        Ошибка("Недостаточно " + Строка(Стр.Номенклатура) + ", подразделение " + Строка(Стр.Подразделение)
            + ", свойство " + Строка(Стр.Свойство) + ": требуется " + Стр.Количество + ", остаток " + Всего);
    КонецЕсли;
    Если Метод = Перечисления.МетодыСписания.ПоСредней Тогда Возврат СписатьПоСредней(Док, Партии, Стр.Количество, Всего, Стоимость); КонецЕсли;
    Осталось = Стр.Количество; Списано = 0;
    Если Метод = Перечисления.МетодыСписания.LIFO Тогда
        Обратный = Новый Массив;
        Н = Партии.Количество() - 1;
        Пока Н >= 0 Цикл Обратный.Добавить(Партии[Н]); Н = Н - 1; КонецЦикла;
        Партии = Обратный;
    КонецЕсли;
    Для Каждого П Из Партии Цикл
        Если Осталось <= 0 Тогда Прервать; КонецЕсли;
        Если П.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Кол = Мин(Осталось, П.Количество);
        Если Кол <= 0 Тогда Продолжить; КонецЕсли;
        Сум = ?(Кол = П.Количество, П.Стоимость, Окр(П.Стоимость * Кол / П.Количество, 2));
        Дв = Док.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
        ЗаполнитьЗначенияСвойств(Дв, П); Дв.Период = Док.Дата; Дв.Количество = Кол; Дв.Стоимость = Сум;
        П.Количество = П.Количество - Кол; П.Стоимость = П.Стоимость - Сум;
        Осталось = Осталось - Кол; Списано = Списано + Сум;
    КонецЦикла;
    Возврат Списано;
КонецФункции

Функция ТаблицаПотребностей()
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
    Т.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    Возврат Т;
КонецФункции

Процедура Сборка(Док) Экспорт
    Если Док.СистемныеБлоки.Количество() = 0 Тогда Ошибка("Укажите собираемые системные блоки"); КонецЕсли;
    ПроверитьСтроки(Док.СистемныеБлоки); ПроверитьСтроки(Док.ДополнительныеДетали);
    Если Не ЗначениеЗаполнено(Док.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Док.ПодразделениеПолучатель) Тогда
        Ошибка("Укажите подразделения списания и поступления");
    КонецЕсли;
    СтарыеАналитики = ПредыдущиеАналитикиДокумента(Док, Ложь);
    Док.Движения.ОстаткиНоменклатуры.Очистить();
    Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Док.Движения.ОстаткиНоменклатуры.Записать();
    Блоки = Док.СистемныеБлоки.Выгрузить(); Блоки.Свернуть("Номенклатура", "Количество");
    Блоки.Колонки.Добавить("Стоимость"); Блоки.ЗаполнитьЗначения(0, "Стоимость");
    П = Новый Структура("Момент,Блоки", Док.Дата, Блоки.ВыгрузитьКолонку("Номенклатура"));
    Спецификации = ЗапросТаблица("ВЫБРАТЬ С.СистемныйБлок, С.Деталь КАК Номенклатура, С.Свойство, С.Количество
    | ИЗ РегистрСведений.Спецификации КАК С
    | ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
    | ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Момент И СистемныйБлок В (&Блоки)
    | СГРУППИРОВАТЬ ПО СистемныйБлок) КАК Последние
    | ПО С.СистемныйБлок = Последние.СистемныйБлок И С.Период = Последние.Период", П);
    Потребности = ТаблицаПотребностей(); Потребности.Колонки.Добавить("СистемныйБлок");
    Для Каждого Блок Из Блоки Цикл
        Состав = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Блок.Номенклатура));
        Если Состав.Количество() = 0 Тогда Ошибка("Нет спецификации для " + Строка(Блок.Номенклатура)); КонецЕсли;
        Для Каждого Деталь Из Состав Цикл
            Если Деталь.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Стр = Потребности.Добавить(); ЗаполнитьЗначенияСвойств(Стр, Деталь);
            Стр.Количество = Деталь.Количество * Блок.Количество; Стр.Подразделение = Док.ПодразделениеИсточник;
        КонецЦикла;
    КонецЦикла;
    Для Каждого Деталь Из Док.ДополнительныеДетали Цикл
        Стр = Потребности.Добавить(); ЗаполнитьЗначенияСвойств(Стр, Деталь); Стр.Подразделение = Док.ПодразделениеИсточник;
    КонецЦикла;
    Остатки = ЗаблокироватьЗапасы(Потребности, Док.МоментВремени());
    ДопСтоимость = 0;
    Для Каждого Стр Из Потребности Цикл
        Стоимость = СписатьЗапас(Док, Остатки, Стр, Перечисления.МетодыСписания.ПоСредней);
        Если ЗначениеЗаполнено(Стр.СистемныйБлок) Тогда
            Блок = Блоки.Найти(Стр.СистемныйБлок, "Номенклатура"); Блок.Стоимость = Блок.Стоимость + Стоимость;
        Иначе ДопСтоимость = ДопСтоимость + Стоимость; КонецЕсли;
    КонецЦикла;
    ОстДоп = ДопСтоимость; ОстКол = Блоки.Итог("Количество");
    Для Каждого Блок Из Блоки Цикл
        Доля = ?(Блок.Количество = ОстКол, ОстДоп, Окр(ДопСтоимость * Блок.Количество / Блоки.Итог("Количество"), 2));
        Дв = Док.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
        Дв.Период = Док.Дата; Дв.Подразделение = Док.ПодразделениеПолучатель; Дв.Номенклатура = Блок.Номенклатура;
        Дв.Партия = Док.Ссылка; Дв.ДатаПартии = Док.Дата; Дв.Количество = Блок.Количество; Дв.Стоимость = Блок.Стоимость + Доля;
        ОстДоп = ОстДоп - Доля; ОстКол = ОстКол - Блок.Количество;
    КонецЦикла;
    ПроверитьТекущиеОстатки(Док, Ложь, СтарыеАналитики);
КонецПроцедуры

Процедура Продажа(Док) Экспорт
    ПроверитьСтроки(Док.СписокНоменклатуры);
    Док.Движения.Управленческий.Очистить();
    Док.Движения.Управленческий.Записывать = Истина;
    Док.Движения.ОстаткиНоменклатуры.Очистить();
    Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Док.Движения.Продажи.Очистить();
    Док.Движения.Продажи.Записывать = Истина;
    Док.Движения.Управленческий.Записать();
    Док.Движения.ОстаткиНоменклатуры.Записать();
    Если ЗначениеЗаполнено(Док.Склад) Тогда ПродажаБУ(Док); КонецЕсли;
    Потребности = ТаблицаПотребностей();
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Док.Подразделение);
        Если ЗначениеЗаполнено(Подразделение) Тогда
            П = Потребности.Добавить(); ЗаполнитьЗначенияСвойств(П, Стр); П.Подразделение = Подразделение;
        ИначеЕсли Не ЗначениеЗаполнено(Док.Склад) Тогда Ошибка("Укажите склад или подразделение"); КонецЕсли;
    КонецЦикла;
    Если Потребности.Количество() = 0 Тогда ПроверитьТекущиеОстатки(Док); Возврат; КонецЕсли;
    Остатки = ЗаблокироватьЗапасы(Потребности, Док.МоментВремени());
    Политики = ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))",
        Новый Структура("Дата,Подразделения", Док.Дата, Потребности.ВыгрузитьКолонку("Подразделение")));
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Док.Подразделение);
        Если Не ЗначениеЗаполнено(Подразделение) Тогда Продолжить; КонецЕсли;
        Политика = Политики.Найти(Подразделение, "Подразделение");
        Если Политика = Неопределено Тогда Ошибка("Не задана учетная политика подразделения " + Строка(Подразделение)); КонецЕсли;
        Если Не ЗначениеЗаполнено(Политика.Метод) Тогда Ошибка("Выберите метод списания в учетной политике подразделения"); КонецЕсли;
        П = Новый Структура("Подразделение,Номенклатура,Свойство,Количество", Подразделение, Стр.Номенклатура, Стр.Свойство, Стр.Количество);
        Стоимость = СписатьЗапас(Док, Остатки, П, Политика.Метод);
        Дв = Док.Движения.Продажи.Добавить(); Дв.Период = Док.Дата;
        Дв.Подразделение = Подразделение; Дв.Номенклатура = Стр.Номенклатура;
        Дв.Количество = Стр.Количество; Дв.Себестоимость = Стоимость; Дв.Выручка = СуммаСтроки(Стр);
    КонецЦикла;
    ПроверитьТекущиеОстатки(Док);
КонецПроцедуры

Процедура ПродажаБУ(Док)
    // Граф аналогов загружается один раз; транзитивное симметричное замыкание вычисляется без запросов в цикле.
    Связи = ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги", Новый Структура);
    Нужные = Новый Массив; Кандидаты = Новый Соответствие;
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Если Кандидаты.Получить(Стр.Номенклатура) <> Неопределено Тогда Продолжить; КонецЕсли;
        Группа = Новый Массив; Группа.Добавить(Стр.Номенклатура); Индекс = 0;
        Пока Индекс < Группа.Количество() Цикл
            Товар = Группа[Индекс]; Индекс = Индекс + 1;
            Для Каждого Связь Из Связи Цикл
                Аналог = Неопределено;
                Если Связь.Товар = Товар Тогда Аналог = Связь.Аналог; ИначеЕсли Связь.Аналог = Товар Тогда Аналог = Связь.Товар; КонецЕсли;
                Если Аналог <> Неопределено И Группа.Найти(Аналог) = Неопределено Тогда Группа.Добавить(Аналог); КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        Кандидаты.Вставить(Стр.Номенклатура, Группа);
        Для Каждого Товар Из Группа Цикл Если Нужные.Найти(Товар) = Неопределено Тогда Нужные.Добавить(Товар); КонецЕсли; КонецЦикла;
    КонецЦикла;
    Блокировка = Новый БлокировкаДанных; Э = Блокировка.Добавить("РегистрБухгалтерии.Управленческий");
    Э.Режим = РежимБлокировкиДанных.Исключительный;
    Э.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары);
    Т = Новый ТаблицаЗначений; Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Для Каждого Товар Из Нужные Цикл Т.Добавить().Номенклатура = Товар; КонецЦикла;
    Э.ИсточникДанных = Т;
    Э.ИспользоватьИзИсточникаДанных(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура, "Номенклатура"); Блокировка.Заблокировать();
    П = Новый Структура("Момент,Товары,Счет,Склад", Док.МоментВремени(), Нужные, ПланыСчетов.Управленческий.Товары, Док.Склад);
    Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    П.Вставить("Виды", Виды);
    Итоги = ЗапросТаблица("ВЫБРАТЬ Субконто1 КАК Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
    | ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 В (&Товары))", П);
    Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    Остатки = ЗапросТаблица("ВЫБРАТЬ Субконто1 КАК Номенклатура, Субконто2 КАК Склад, КоличествоОстаток КАК Количество
    | ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 В (&Товары) И Субконто2 = &Склад)", П);
    Порядок = ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Номенклатура, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Товары) УПОРЯДОЧИТЬ ПО Артикул, Номенклатура", П);
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Группа = Кандидаты.Получить(Стр.Номенклатура); ПорядокСтроки = Новый Массив; ПорядокСтроки.Добавить(Стр.Номенклатура);
        Для Каждого К Из Порядок Цикл
            Если К.Номенклатура <> Стр.Номенклатура И Группа.Найти(К.Номенклатура) <> Неопределено Тогда ПорядокСтроки.Добавить(К.Номенклатура); КонецЕсли;
        КонецЦикла;
        Осталось = Стр.Количество; ОстВыручка = СуммаСтроки(Стр);
        Для Каждого Товар Из ПорядокСтроки Цикл
            Если Осталось <= 0 Тогда Прервать; КонецЕсли;
            Складские = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Товар, Док.Склад));
            Если Складские.Количество() = 0 Тогда Продолжить; КонецЕсли;
            Ост = Складские[0]; Если Ост.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Итог = Итоги.Найти(Товар, "Номенклатура");
            Кол = Мин(Осталось, Ост.Количество);
            Стоимость = ?(Кол = Итог.Количество, Итог.Сумма, Окр(Итог.Сумма * Кол / Итог.Количество, 2));
            Выручка = ?(Кол = Осталось, ОстВыручка, Окр(СуммаСтроки(Стр) * Кол / Стр.Количество, 2));
            Дв = Док.Движения.Управленческий.Добавить(); Дв.Период = Док.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Дв.СчетКт = ПланыСчетов.Управленческий.Товары;
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Товар; Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Док.Склад; Дв.КоличествоКт = Кол; Дв.Сумма = Стоимость;
            Дв.Заказано = Стр.Номенклатура; Дв.Продано = Товар; 
            Дв = Док.Движения.Управленческий.Добавить(); Дв.Период = Док.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.Покупатели; Дв.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; Дв.Сумма = Выручка;
            Дв.Заказано = Стр.Номенклатура; Дв.Продано = Товар;
            Ост.Количество = Ост.Количество - Кол; Итог.Количество = Итог.Количество - Кол; Итог.Сумма = Итог.Сумма - Стоимость;
            Осталось = Осталось - Кол; ОстВыручка = ОстВыручка - Выручка;
        КонецЦикла;
        Если Осталось > 0 Тогда Ошибка("Недостаточно товара " + Строка(Стр.Номенклатура) + " и всех его аналогов. Не хватает " + Осталось); КонецЕсли;
    КонецЦикла;
КонецПроцедуры


Функция ПечатнаяФорма(Данные, Заголовок, Вид) Экспорт
    ТабДок = Новый ТабличныйДокумент; ТабДок.АвтоМасштаб = Истина;
    Количества = СтрРазделить("НачальноеКоличество,КоличествоПриход,КоличествоРасход,КонечноеКоличество", ",");
    Если Вид = "ВедомостьПоПодразделению" Тогда
        Поля = СтрРазделить("Характеристика,Номенклатура,НачальнаяСтоимость,СтоимостьПриход,СтоимостьРасход,КонечнаяСтоимость", ",");
        Заголовки = СтрРазделить("Характеристика,Товар,Нач. остаток,Приход,Расход,Кон. остаток", ",");
        Заголовки[0] = Данные.Колонки.Характеристика.Заголовок;
        Данные.Сортировать("Характеристика,Номенклатура");
    ИначеЕсли Вид = "ПродажиБухгалтерские" Тогда
        Поля = СтрРазделить("Номенклатура,Продано,Количество,Себестоимость,Продажа,Прибыль", ",");
        Заголовки = СтрРазделить("Номенклатура,Продано,Кол-во,Себестоимость,Продажа,Прибыль", ",");
        Данные.Сортировать("Номенклатура,Продано");
        Итоги = Данные.Скопировать(); Итоги.Свернуть("Номенклатура", "Количество,Себестоимость,Продажа,Прибыль");
    ИначеЕсли Вид = "Премии" Тогда
        Поля = СтрРазделить("Сотрудник,Стаж,Процент,СуммаПремии", ",");
        Заголовки = СтрРазделить("Сотрудник,Трудовой стаж (лет),% премии,Сумма премии", ",");
    Иначе
        Поля = СтрРазделить("Номенклатура,Количество,Себестоимость,Продажа,Прибыль", ",");
        Заголовки = СтрРазделить("Номенклатура,Кол-во,Себестоимость,Продажа,Прибыль", ",");
    КонецЕсли;
    ТабДок.Область(1,1,1,Поля.Количество()).Объединить(); ТабДок.Область(1,1).Текст = Заголовок;
    ТабДок.Область(1,1).Шрифт = Новый Шрифт(, 12, Истина);
    Для Н = 0 По Поля.Количество()-1 Цикл
        ТабДок.Область(3,Н+1).Текст = Заголовки[Н]; ТабДок.Область(3,Н+1).Шрифт = Новый Шрифт(, 10, Истина);
        ТабДок.Область(,Н+1).ШиринаКолонки = ?(Н=0 Или (Н=1 И Поля.Количество()=6),32,20);
    КонецЦикла;
    Номер = 4; ПредыдущаяГруппа = Неопределено;
    Для Каждого Стр Из Данные Цикл
        Если Вид = "ПродажиБухгалтерские" Или Вид = "ВедомостьПоПодразделению" Тогда
            Группа = Стр[Поля[0]];
            Если ПредыдущаяГруппа = Неопределено Или ПредыдущаяГруппа <> Группа Тогда
                ТабДок.Область(Номер,1).Текст = Строка(Группа);
                Если Вид = "ПродажиБухгалтерские" Тогда
                    ИтогГруппы = Итоги.Найти(Группа, "Номенклатура");
                    Для Н = 2 По Поля.Количество()-1 Цикл
                        Ячейка = ТабДок.Область(Номер,Н+1); Ячейка.СодержитЗначение = Истина;
                        Ячейка.Значение = ИтогГруппы[Поля[Н]]; Ячейка.Формат = ?(Н=2,"ЧГ=0; ЧН=","ЧДЦ=2; ЧН=");
                    КонецЦикла;
                КонецЕсли;
                ТабДок.Область(Номер,1,Номер,Поля.Количество()).Шрифт = Новый Шрифт(,10,Истина);
                Номер = Номер + 1; ПредыдущаяГруппа = Группа;
            КонецЕсли;
        КонецЕсли;
        Для Н = 0 По Поля.Количество()-1 Цикл
            Если Н=0 И (Вид="ПродажиБухгалтерские" Или Вид="ВедомостьПоПодразделению") Тогда Продолжить; КонецЕсли;
            Ячейка = ТабДок.Область(Номер, Н+1);
            Если ТипЗнч(Стр[Поля[Н]]) = Тип("Число") Тогда
                Ячейка.СодержитЗначение = Истина; Ячейка.Значение = Стр[Поля[Н]];
                Если Поля[Н]="Количество" Тогда Ячейка.Формат="ЧГ=0; ЧН=";
                ИначеЕсли Поля[Н]<>"Стаж" И Поля[Н]<>"Процент" Тогда Ячейка.Формат="ЧДЦ=2; ЧН="; КонецЕсли;
            Иначе Ячейка.Текст = Строка(Стр[Поля[Н]]); КонецЕсли;
        КонецЦикла;
        Если Вид = "ВедомостьПоПодразделению" Тогда
            Для Н = 0 По 3 Цикл
                ТабДок.Область(Номер,Н+3).СодержитЗначение = Ложь;
                ТабДок.Область(Номер,Н+3).Текст = Формат(Стр[Количества[Н]], "ЧГ=0; ЧН=") + Символы.ПС + Формат(Стр[Поля[Н+2]], "ЧДЦ=2; ЧН=");
            КонецЦикла;
        КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
    ТабДок.Область(Номер,1).Текст = "ИТОГО:";
    Для Н = 0 По Поля.Количество()-1 Цикл
        Если (Вид="Премии" И Н=3) Или (Вид="ПродажиБухгалтерские" И Н>=2) Или (Вид="ПродажиОперативные" И Н>=1) Тогда
            Ячейка = ТабДок.Область(Номер,Н+1); Ячейка.СодержитЗначение = Истина; Ячейка.Значение = Данные.Итог(Поля[Н]);
            Ячейка.Формат = ?(Поля[Н]="Количество","ЧГ=0; ЧН=","ЧДЦ=2; ЧН=");
        ИначеЕсли Вид="ВедомостьПоПодразделению" И Н>=2 Тогда
            ТабДок.Область(Номер,Н+1).Текст = Формат(Данные.Итог(Количества[Н-2]), "ЧГ=0; ЧН=") + Символы.ПС + Формат(Данные.Итог(Поля[Н]), "ЧДЦ=2; ЧН=");
        КонецЕсли;
    КонецЦикла;
    ТабДок.Область(Номер,1,Номер,Поля.Количество()).Шрифт = Новый Шрифт(,10,Истина);
    Возврат ТабДок;
КонецФункции


Функция СписатьПоСредней(Док, Партии, Количество, Всего, Стоимость)
    ЦелеваяСтоимость = ?(Количество = Всего, Стоимость, Окр(Стоимость * Количество / Всего, 2));
    Распределение = Новый ТаблицаЗначений;
    Распределение.Колонки.Добавить("Партия");
    Распределение.Колонки.Добавить("Количество"); Распределение.Колонки.Добавить("Стоимость");
    ОстКоличество = Количество; Списано = 0;
    Для Каждого П Из Партии Цикл
        Если П.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Р = Распределение.Добавить(); Р.Партия = П;
        Р.Количество = Мин(П.Количество, ОстКоличество, Окр(Количество * П.Количество / Всего, 3));
        ОстКоличество = ОстКоличество - Р.Количество;
        Р.Стоимость = ?(Р.Количество = П.Количество, П.Стоимость, Окр(П.Стоимость * Количество / Всего, 2));
        Списано = Списано + Р.Стоимость;
    КонецЦикла;
    Для Каждого Р Из Распределение Цикл
        Если ОстКоличество <= 0 Тогда Прервать; КонецЕсли;
        Доля = Мин(ОстКоличество, Р.Партия.Количество - Р.Количество);
        Р.Количество = Р.Количество + Доля; ОстКоличество = ОстКоличество - Доля;
        Если Р.Количество = Р.Партия.Количество Тогда
            Списано = Списано + Р.Партия.Стоимость - Р.Стоимость; Р.Стоимость = Р.Партия.Стоимость;
        КонецЕсли;
    КонецЦикла;
    Поправка = ЦелеваяСтоимость - Списано;
    Для Каждого Р Из Распределение Цикл
        Если Поправка = 0 Тогда Прервать; КонецЕсли;
        Если Р.Количество = Р.Партия.Количество Тогда Продолжить; КонецЕсли;
        Доля = ?(Поправка > 0, Мин(Поправка, Р.Партия.Стоимость - Р.Стоимость), -Мин(-Поправка, Р.Стоимость));
        Р.Стоимость = Р.Стоимость + Доля; Поправка = Поправка - Доля;
    КонецЦикла;
    Если Поправка <> 0 Тогда
        // При предельном округлении количества пропорция могла полностью закрыть
        // дорогую малую партию. Перераспределяем только внутренние партии;
        // общая средняя стоимость остается строго целевой, отрицательных остатков нет.
        Распределение.Колонки.Добавить("ЦенаПартии");
        Для Каждого Р Из Распределение Цикл Р.ЦенаПартии = Р.Партия.Стоимость / Р.Партия.Количество; КонецЦикла;
        Распределение.Сортировать("ЦенаПартии"); ОстКоличество = Количество; Списано = 0;
        Для Каждого Р Из Распределение Цикл
            Р.Количество = Мин(ОстКоличество, Р.Партия.Количество);
            Р.Стоимость = ?(Р.Количество = Р.Партия.Количество, Р.Партия.Стоимость, Окр(Р.Партия.Стоимость * Р.Количество / Р.Партия.Количество, 2));
            ОстКоличество = ОстКоличество - Р.Количество; Списано = Списано + Р.Стоимость;
        КонецЦикла;
        Поправка = ЦелеваяСтоимость - Списано;
        Для Каждого Р Из Распределение Цикл
            Если Поправка = 0 Тогда Прервать; КонецЕсли;
            Если Р.Количество = Р.Партия.Количество Тогда Продолжить; КонецЕсли;
            Доля = Мин(Поправка, Р.Партия.Стоимость - Р.Стоимость);
            Р.Стоимость = Р.Стоимость + Доля; Поправка = Поправка - Доля;
        КонецЦикла;
        Если Поправка <> 0 Тогда Ошибка("Нарушена согласованность количества и стоимости партий"); КонецЕсли;
    КонецЕсли;
    Для Каждого Р Из Распределение Цикл
        Если Р.Количество = 0 И Р.Стоимость = 0 Тогда Продолжить; КонецЕсли;
        П = Р.Партия; Дв = Док.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
        ЗаполнитьЗначенияСвойств(Дв, П); Дв.Период = Док.Дата; Дв.Количество = Р.Количество; Дв.Стоимость = Р.Стоимость;
        П.Количество = П.Количество - Р.Количество; П.Стоимость = П.Стоимость - Р.Стоимость;
    КонецЦикла;
    Возврат ЦелеваяСтоимость;
КонецФункции


Процедура ПроверитьТекущиеОстатки(Док, БухгалтерскийУчет = Истина, ПредыдущиеАналитики = Неопределено)
    // Блокировки по товарам уже удерживаются проведением. После записи проверяем
    // текущие итоги, включая более поздние документы: иначе расход задним числом
    // мог бы повторно использовать запас, уже израсходованный будущей продажей.
    Док.Движения.ОстаткиНоменклатуры.Записать();
    Если БухгалтерскийУчет Тогда Док.Движения.Управленческий.Записать(); КонецЕсли;
    Т = Док.Движения.ОстаткиНоменклатуры.Выгрузить();
    Если ПредыдущиеАналитики <> Неопределено Тогда
        Для Каждого Старый Из ПредыдущиеАналитики.Запасы Цикл ЗаполнитьЗначенияСвойств(Т.Добавить(), Старый); КонецЦикла;
    КонецЕсли;
    Если Т.Количество() > 0 Тогда
        П = Новый Структура("Товары,Подразделения", Т.ВыгрузитьКолонку("Номенклатура"), Т.ВыгрузитьКолонку("Подразделение"));
        ПроверитьЗапросОстатков("ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура
        | ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(,
        | Номенклатура В (&Товары) И Подразделение В (&Подразделения))
        | ГДЕ КоличествоОстаток < 0 ИЛИ СтоимостьОстаток < 0
        | ИЛИ (КоличествоОстаток = 0 И СтоимостьОстаток <> 0)", П, "Операция нарушает текущие остатки: ");
    КонецЕсли;
    Если Не БухгалтерскийУчет Тогда Возврат; КонецЕсли;
    Товары = ?(ПредыдущиеАналитики = Неопределено, Новый Массив, ПредыдущиеАналитики.ТоварыБУ);
    Для Каждого Дв Из Док.Движения.Управленческий Цикл
        Если Дв.СчетДт = ПланыСчетов.Управленческий.Товары Тогда Товары.Добавить(Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]); КонецЕсли;
        Если Дв.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
            Товары.Добавить(Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]);
        КонецЕсли;
    КонецЦикла;
    Если Товары.Количество() = 0 Тогда Возврат; КонецЕсли;
    Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    П = Новый Структура("Товары,Счет,Виды", Товары, ПланыСчетов.Управленческий.Товары, Виды);
    ПроверитьЗапросОстатков("ВЫБРАТЬ ПЕРВЫЕ 1 Субконто1 КАК Номенклатура
    | ИЗ РегистрБухгалтерии.Управленческий.Остатки(, Счет = &Счет, &Виды, Субконто1 В (&Товары))
    | ГДЕ КоличествоОстаток < 0 ИЛИ СуммаОстаток < 0 ИЛИ (КоличествоОстаток = 0 И СуммаОстаток <> 0)", П, "Операция нарушает текущие количество или стоимость товара: ");
    Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    ПроверитьЗапросОстатков("ВЫБРАТЬ ПЕРВЫЕ 1 Субконто1 КАК Номенклатура
    | ИЗ РегистрБухгалтерии.Управленческий.Остатки(, Счет = &Счет, &Виды, Субконто1 В (&Товары))
    | ГДЕ КоличествоОстаток < 0", П, "Недостаточно текущего остатка на складе: ");
КонецПроцедуры


Функция ПредыдущиеАналитикиДокумента(Док, БухгалтерскийУчет = Истина)
    // Сохраняем ключи старых движений: изменение товара, подразделения или удаление
    // строки поступления не должно оставлять незамеченным отрицательный остаток.
    Док.Движения.ОстаткиНоменклатуры.Прочитать();
    Запасы = Док.Движения.ОстаткиНоменклатуры.Выгрузить();
    ТоварыБУ = Новый Массив;
    Если БухгалтерскийУчет Тогда
        Док.Движения.Управленческий.Прочитать();
        Для Каждого Дв Из Док.Движения.Управленческий Цикл
            Если Дв.СчетДт = ПланыСчетов.Управленческий.Товары Тогда ТоварыБУ.Добавить(Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]); КонецЕсли;
            Если Дв.СчетКт = ПланыСчетов.Управленческий.Товары Тогда ТоварыБУ.Добавить(Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]); КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Возврат Новый Структура("Запасы,ТоварыБУ", Запасы, ТоварыБУ);
КонецФункции


Процедура ПроверитьЗапросОстатков(Текст, Параметры, Сообщение)
    Запрос = Новый Запрос(Текст);
    Для Каждого П Из Параметры Цикл Запрос.УстановитьПараметр(П.Ключ, П.Значение); КонецЦикла;
    Выборка = Запрос.Выполнить().Выбрать();
    Если Выборка.Следующий() Тогда Ошибка(Сообщение + Строка(Выборка.Номенклатура) + ". Проверьте последующие документы и порядок перепроведения."); КонецЕсли;
КонецПроцедуры

Процедура ОтменитьСкладскойДокумент(Док, БухгалтерскийУчет) Экспорт
    СтарыеАналитики = ПредыдущиеАналитикиДокумента(Док, БухгалтерскийУчет);
    Док.Движения.ОстаткиНоменклатуры.Очистить();
    Если БухгалтерскийУчет Тогда Док.Движения.Управленческий.Очистить(); КонецЕсли;
    ПроверитьТекущиеОстатки(Док, БухгалтерскийУчет, СтарыеАналитики);
КонецПроцедуры

