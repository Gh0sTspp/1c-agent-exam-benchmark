Процедура НастроитьВидыРасчета() Экспорт
    // Предопределенные виды сохраняют идентичность каркаса. Связи задаются однократно.
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф.ПолучитьОбъект();
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия.ПолучитьОбъект();
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка.Ссылка; Тариф.Записать();
    КонецЕсли;
    Если Премия.БазовыеВидыРасчета.Количество() = 0 Тогда
        Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф.Ссылка;
        Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка.Ссылка; Премия.Записать();
    КонецЕсли;
    Если Командировка.БазовыеВидыРасчета.Количество() = 0 Тогда
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф.Ссылка;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Премия.Ссылка;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Командировка.Ссылка; Командировка.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура Провести(Док) Экспорт
    // Расчет может затронуть цепочку премий и командировок в других подразделениях.
    // Единственная управляемая блокировка защищает всю такую цепочку до конца транзакции.
    Блокировка = Новый БлокировкаДанных;
    Э = Блокировка.Добавить("РегистрРасчета.Начисления"); Э.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    НастроитьВидыРасчета();
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    СтарыеРегистраторы = ЗависимыеРегистраторы(Док);
    Движения = Док.Движения.Начисления; Движения.Очистить(); Движения.Записывать = Истина;
    Движения.Записать();
    СтрокиНачислений = Док.ОсновныеНачисления.Выгрузить();
    // Точное повторение начисления не должно удваивать часы и расчетную базу.
    СтрокиНачислений.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    Для Каждого Стр Из СтрокиНачислений Цикл
        Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение)
            Или Не ЗначениеЗаполнено(Стр.ДатаНачала) Или Стр.ДатаОкончания < Стр.ДатаНачала Тогда
            УчетСервер.Ошибка("Проверьте сотрудника, подразделение и период начисления");
        КонецЕсли;
        Если Стр.ВидРасчета <> Тариф И Стр.ВидРасчета <> Премия И Стр.ВидРасчета <> Командировка Тогда
            УчетСервер.Ошибка("Используйте виды расчета Тариф, Премия или Командировка");
        КонецЕсли;
        Если Стр.ВидРасчета <> Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
            УчетСервер.Ошибка("Тариф и премия должны быть в пределах одного месяца");
        КонецЕсли;
        Начало = НачалоДня(Стр.ДатаНачала);
        Пока Начало <= Стр.ДатаОкончания Цикл
            Дв = Движения.Добавить(); Дв.Сотрудник = Стр.Сотрудник; Дв.Подразделение = Стр.Подразделение;
            Дв.ВидРасчета = Стр.ВидРасчета; Дв.ПериодДействияНачало = Начало;
            Дв.ПериодДействияКонец = Мин(КонецДня(Стр.ДатаОкончания), КонецМесяца(Начало));
            Дв.ПериодРегистрации = ?(Стр.ВидРасчета = Командировка,
                Макс(НачалоМесяца(Док.Дата), НачалоМесяца(Начало)), НачалоМесяца(Начало));
            Если Стр.ВидРасчета = Премия Тогда
                Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
                Дв.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            ИначеЕсли Стр.ВидРасчета = Командировка Тогда
                // Средний дневной заработок фиксируется на начало всей командировки.
                Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Стр.ДатаНачала), -3);
                Дв.БазовыйПериодКонец = НачалоМесяца(Стр.ДатаНачала) - 1;
            КонецЕсли;
            Начало = КонецМесяца(Начало) + 1;
        КонецЦикла;
    КонецЦикла;
    Дополнение = Движения.ПолучитьДополнение();
    Для Каждого Стр Из Дополнение Цикл
        Дв = Движения.Добавить(); ЗаполнитьЗначенияСвойств(Дв, Стр);
        Дв.Сторно = Истина; Дв.ПериодРегистрации = Стр.ПериодРегистрацииСторно;
        Дв.ПериодДействияНачало = Стр.ПериодДействияНачалоСторно;
        Дв.ПериодДействияКонец = Стр.ПериодДействияКонецСторно;
    КонецЦикла;
    Движения.Записать();
    Регистраторы = ЗависимыеРегистраторы(Док);
    Если Регистраторы.Найти(Док.Ссылка) = Неопределено Тогда Регистраторы.Добавить(Док.Ссылка); КонецЕсли;
    Для Каждого Старый Из СтарыеРегистраторы Цикл
        Если Регистраторы.Найти(Старый) = Неопределено Тогда Регистраторы.Добавить(Старый); КонецЕсли;
    КонецЦикла;
    Данные = РассчитатьРегистраторы(Регистраторы);
    Движения.Загрузить(Данные.Скопировать(Новый Структура("Регистратор", Док.Ссылка)));
КонецПроцедуры

Функция СтажПолныхЛет(ДатаСтажа, НаДату)
    Если Не ЗначениеЗаполнено(ДатаСтажа) Тогда Возврат 0; КонецЕсли;
    Лет = Год(НаДату) - Год(ДатаСтажа);
    Если Месяц(НаДату) < Месяц(ДатаСтажа) Или (Месяц(НаДату) = Месяц(ДатаСтажа) И День(НаДату) < День(ДатаСтажа)) Тогда Лет = Лет - 1; КонецЕсли;
    Возврат Макс(0, Лет);
КонецФункции

Функция ЗависимыеРегистраторы(Док) Экспорт
    Строки = Док.ОсновныеНачисления.Выгрузить();
    Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник, Подразделение, ДатаНачала ПОМЕСТИТЬ НовыеСтроки ИЗ &Строки КАК Т;
    | ВЫБРАТЬ Сотрудник, Подразделение, ДатаНачала ПОМЕСТИТЬ Строки ИЗ НовыеСтроки
    | ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Сотрудник, Подразделение, ПериодДействияНачало
    | ИЗ РегистрРасчета.Начисления ГДЕ Регистратор = &Регистратор;
    | ВЫБРАТЬ МИНИМУМ(ДатаНачала) КАК ДатаНачала ПОМЕСТИТЬ Граница ИЗ Строки;
    | ВЫБРАТЬ РАЗЛИЧНЫЕ Н.Регистратор
    | ИЗ РегистрРасчета.Начисления КАК Н ВНУТРЕННЕЕ СОЕДИНЕНИЕ Граница КАК С
    | ПО Н.ПериодДействияКонец >= НАЧАЛОПЕРИОДА(С.ДатаНачала, МЕСЯЦ)");
    Запрос.УстановитьПараметр("Строки", Строки);
    Запрос.УстановитьПараметр("Регистратор", Док.Ссылка);
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
КонецФункции

Процедура ЗаписатьТаблицуРасчетов(Данные, Регистраторы)
    // Объектные наборы формируются из уже полученной таблицы. Чтений БД в цикле нет.
    Для Каждого Регистратор Из Регистраторы Цикл
        Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(Регистратор);
        Набор.Загрузить(Данные.Скопировать(Новый Структура("Регистратор", Регистратор)));
        Набор.Записать();
    КонецЦикла;
КонецПроцедуры

Функция КлючСтроки(Регистратор, Номер)
    Возврат Строка(Регистратор.УникальныйИдентификатор()) + ":" + Формат(Номер, "ЧГ=0");
КонецФункции

Функция РассчитатьРегистраторы(Регистраторы) Экспорт
    П = Новый Структура("Регистраторы", Регистраторы);
    Данные = УчетСервер.ЗапросТаблица("ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления ГДЕ Регистратор В (&Регистраторы)", П);
    Если Данные.Количество() = 0 Тогда Возврат Данные; КонецЕсли;
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    Графики = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы,
    | ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК Дни, ЕСТЬNULL(ЗначениеПериодДействия, 0) КАК Норма
    | ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))", П);
    Ставки = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Н.Регистратор, Н.НомерСтроки, ЕСТЬNULL(Т.Ставка, 0) КАК Ставка,
    | Н.Сотрудник.НачалоСтажа КАК НачалоСтажа
    | ИЗ РегистрРасчета.Начисления КАК Н
    | ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ Н.Регистратор, Н.НомерСтроки, МАКСИМУМ(С.Период) КАК Период
    | ИЗ РегистрРасчета.Начисления КАК Н ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК С
    | ПО Н.Сотрудник = С.Сотрудник И С.Период <= НАЧАЛОПЕРИОДА(Н.ПериодДействияНачало, МЕСЯЦ)
    | ГДЕ Н.Регистратор В (&Регистраторы) СГРУППИРОВАТЬ ПО Н.Регистратор, Н.НомерСтроки) КАК ПС
    | ПО Н.Регистратор = ПС.Регистратор И Н.НомерСтроки = ПС.НомерСтроки
    | ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Т
    | ПО Т.Сотрудник = Н.Сотрудник И Т.Период = ПС.Период
    | ГДЕ Н.Регистратор В (&Регистраторы)", П);
    Шкала = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж", Новый Структура);
    КартаГрафиков = Новый Соответствие; КартаСтавок = Новый Соответствие; КартаДанных = Новый Соответствие;
    Для Каждого Г Из Графики Цикл КартаГрафиков.Вставить(КлючСтроки(Г.Регистратор, Г.НомерСтроки), Г); КонецЦикла;
    Для Каждого С Из Ставки Цикл КартаСтавок.Вставить(КлючСтроки(С.Регистратор, С.НомерСтроки), С); КонецЦикла;
    Для Каждого Дв Из Данные Цикл
        Дв.КлючЗаписи = КлючСтроки(Дв.Регистратор, Дв.НомерСтроки); Дв.ВесБазы = 1;
        КартаДанных.Вставить(Дв.КлючЗаписи, Дв);
        Г = КартаГрафиков.Получить(Дв.КлючЗаписи); С = КартаСтавок.Получить(Дв.КлючЗаписи);
        Дв.Результат = 0; Дв.Дни = 0;
        Если Г = Неопределено Тогда Продолжить; КонецЕсли;
        Если Дв.ВидРасчета = Тариф Тогда
            Если С = Неопределено Или С.Ставка <= 0 Тогда УчетСервер.Ошибка("Не задан тариф на начало месяца"); КонецЕсли;
            Дв.Ставка = С.Ставка; Дв.Результат = Окр(Г.Часы * Дв.Ставка, 2) * ?(Дв.Сторно, -1, 1);
            Дв.Дни = Г.Дни * ?(Дв.Сторно, -1, 1);
        Иначе
            Если С <> Неопределено Тогда Дв.Стаж = СтажПолныхЛет(С.НачалоСтажа, НачалоМесяца(Дв.ПериодДействияНачало)); КонецЕсли;
            Дв.Процент = 0;
            Для Каждого Ступень Из Шкала Цикл Если Дв.Стаж >= Ступень.Стаж Тогда Дв.Процент = Ступень.Процент; КонецЕсли; КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    ЗаписатьТаблицуРасчетов(Данные, Регистраторы);
    // ВесБазы=1 дает долю каждой базовой записи, рассчитанную механизмом базы платформы.
    // Это позволяет рассчитать цепочки за несколько месяцев в памяти, без запросов в цикле.
    Разрезы = Новый Массив; Разрезы.Добавить("КлючЗаписи"); Разрезы.Добавить("Сотрудник");
    Измерения = Новый Массив; Измерения.Добавить("Подразделение");
    П.Вставить("Измерения", Измерения); П.Вставить("Разрезы", Разрезы); П.Вставить("Вид", Премия);
    ТекстБазы = "ВЫБРАТЬ Регистратор, НомерСтроки, КлючЗаписиРазрез КАК КлючБазы,
    | СотрудникРазрез КАК Сотрудник, РезультатБаза КАК Результат, ДниБаза КАК Дни, ВесБазыБаза КАК Вес
    | ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы, Регистратор В (&Регистраторы) И ВидРасчета = &Вид)";
    БазаПремий = УчетСервер.ЗапросТаблица(ТекстБазы, П);
    Измерения = Новый Массив; Измерения.Добавить("Сотрудник"); П.Вставить("Измерения", Измерения); П.Вставить("Вид", Командировка);
    Разрезы = Новый Массив; Разрезы.Добавить("КлючЗаписи"); П.Вставить("Разрезы", Разрезы);
    БазаКомандировок = УчетСервер.ЗапросТаблица(СтрЗаменить(ТекстБазы, "СотрудникРазрез", "Сотрудник"), П);
    Данные.Сортировать("ПериодДействияНачало, НомерСтроки");
    Для Каждого Дв Из Данные Цикл
        Если Дв.ВидРасчета = Тариф Тогда Продолжить; КонецЕсли;
        Г = КартаГрафиков.Получить(Дв.КлючЗаписи);
        Если Г = Неопределено Тогда Продолжить; КонецЕсли;
        База = 0; Дней = 0;
        ТаблицаБазы = ?(Дв.ВидРасчета = Премия, БазаПремий, БазаКомандировок);
        СтрокиБазы = ТаблицаБазы.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Дв.Регистратор, Дв.НомерСтроки));
        Для Каждого Б Из СтрокиБазы Цикл
            Если Дв.ВидРасчета = Премия И Б.Сотрудник = Дв.Сотрудник Тогда Продолжить; КонецЕсли;
            Источник = КартаДанных.Получить(Б.КлючБазы);
            Если Источник = Неопределено Тогда
                База = База + Б.Результат; Дней = Дней + Б.Дни;
            Иначе
                База = База + Источник.Результат * Б.Вес; Дней = Дней + Источник.Дни * Б.Вес;
            КонецЕсли;
        КонецЦикла;
        Если Дв.ВидРасчета = Премия Тогда
            Если Г.Норма <> 0 Тогда Дв.Результат = Окр(База * Дв.Процент / 100 * Г.Часы / Г.Норма, 2) * ?(Дв.Сторно, -1, 1); КонецЕсли;
        ИначеЕсли Дней <> 0 Тогда
            Дв.Ставка = База / Дней; Дв.Результат = Окр(База / Дней * Г.Дни, 2) * ?(Дв.Сторно, -1, 1);
        КонецЕсли;
    КонецЦикла;
    ЗаписатьТаблицуРасчетов(Данные, Регистраторы);
    Возврат Данные;
КонецФункции

Процедура ОтменитьПроведение(Док) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Э = Блокировка.Добавить("РегистрРасчета.Начисления"); Э.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Регистраторы = ЗависимыеРегистраторы(Док);
    Набор = Док.Движения.Начисления; Набор.Очистить(); Набор.Записать();
    Индекс = Регистраторы.Найти(Док.Ссылка); Если Индекс <> Неопределено Тогда Регистраторы.Удалить(Индекс); КонецЕсли;
    РассчитатьРегистраторы(Регистраторы);
КонецПроцедуры


