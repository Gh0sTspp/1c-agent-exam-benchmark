#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    ОбновитьПоляМенеджера();
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоляМенеджера()
    СохранитьПоля(Объект);
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьПоля(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура СохранитьПоля(Приемник)
    Для Каждого Поле Из СоставПолей Цикл
        Найденные = Приемник.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения", Поле.ВидСведения));
        Если Найденные.Количество() = 0 Тогда
            Стр = Приемник.ДополнительныеСведения.Добавить(); Стр.ВидСведения = Поле.ВидСведения;
        Иначе Стр = Найденные[0]; КонецЕсли;
        Стр.Значение = ЭтотОбъект[Поле.Имя];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
    Удалить = Новый Массив;
    Для Каждого Поле Из СоставПолей Цикл
        Элементы.Удалить(Элементы[Поле.Имя]); Удалить.Добавить(Поле.Имя);
    КонецЦикла;
    Если Удалить.Количество() > 0 Тогда ИзменитьРеквизиты(, Удалить); КонецЕсли;
    СоставПолей.Очистить();
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ С.ВидСведения, С.ВидСведения.Наименование КАК Заголовок,
    | С.ВидСведения.ТипЗначения КАК ТипЗначения
    | ИЗ (ВЫБРАТЬ ВидСведения, МИНИМУМ(НомерСтроки) КАК Порядок
    | ИЗ Справочник.ФизическиеЛица.ДополнительныеСведенияКонтрагентов
    | ГДЕ Ссылка = &Менеджер И ВидСведения <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка)
    | СГРУППИРОВАТЬ ПО ВидСведения) КАК С УПОРЯДОЧИТЬ ПО С.Порядок");
    Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
    Виды = Запрос.Выполнить().Выгрузить();
    Добавить = Новый Массив;
    Для Каждого Вид Из Виды Цикл
        Имя = "Сведение" + СтрЗаменить(Строка(Вид.ВидСведения.УникальныйИдентификатор()), "-", "");
        Добавить.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения));
        Стр = СоставПолей.Добавить(); Стр.Имя = Имя; Стр.ВидСведения = Вид.ВидСведения;
    КонецЦикла;
    Если Добавить.Количество() = 0 Тогда Возврат; КонецЕсли;
    ИзменитьРеквизиты(Добавить);
    Для Каждого Поле Из СоставПолей Цикл
        Вид = Виды.Найти(Поле.ВидСведения, "ВидСведения");
        Элемент = Элементы.Добавить(Поле.Имя, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
        Элемент.Вид = ВидПоляФормы.ПолеВвода; Элемент.ПутьКДанным = Поле.Имя; Элемент.Заголовок = Вид.Заголовок;
        Найденные = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения", Поле.ВидСведения));
        Если Найденные.Количество() > 0 Тогда ЭтотОбъект[Поле.Имя] = Найденные[0].Значение; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

