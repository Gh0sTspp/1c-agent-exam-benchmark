Процедура ВыполнитьДемонстрацию() Экспорт
    Демонстрация.ЗаполнитьПример();
КонецПроцедуры

Функция ДанныеОтчета(ИмяОтчета, Начало, Конец, Подразделение = Неопределено) Экспорт
    Отчет = Отчеты[ИмяОтчета].Создать();
    Если ИмяОтчета = "Ведомость" Тогда Возврат Отчет.ПолучитьДанные(Начало, Конец, Подразделение); КонецЕсли;
    Возврат Отчет.ПолучитьДанные(Начало, Конец);
КонецФункции

Функция ПроверитьДемонстрацию() Экспорт
    Попытка
        Демонстрация.ЗаполнитьПример();
        Возврат "OK";
    Исключение
        Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
    КонецПопытки;
КонецФункции

Функция КонтрольРезультатов() Экспорт
    Текст = "";
    Для Каждого Имя Из СтрРазделить("ПродажиБухгалтерские,ПродажиОперативные,Премии,Ведомость", ",") Цикл
        Попытка
            Отчет = Отчеты[Имя].Создать();
            Если Имя = "Ведомость" Тогда
                Т = Отчет.ПолучитьДанные(Дата(2024,1,1),Дата(2024,3,31),Справочники.Подразделения.НайтиПоНаименованию("Демо: Основной цех",Истина));
            ИначеЕсли Имя = "Премии" Тогда
                Т = Отчет.ПолучитьДанные(Дата(2024,1,1),Дата(2024,1,31));
            Иначе
                Т = Отчет.ПолучитьДанные(Дата(2024,1,1),Дата(2024,3,31));
            КонецЕсли;
            ПечатнаяФорма = УчетСервер.ТабличныйОтчет(Т, Имя, Дата(2024,1,1), Дата(2024,3,31));
            Текст = Текст + Имя + ": " + Т.Количество() + Символы.ПС;
            Для Каждого С Из Т Цикл
                Для Каждого К Из Т.Колонки Цикл
                    Текст = Текст + К.Имя + "=" + Строка(С[К.Имя]) + "; ";
                КонецЦикла;
                Текст = Текст + Символы.ПС;
            КонецЦикла;
        Исключение
            Текст = Текст + Имя + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС;
        КонецПопытки;
    КонецЦикла;
    Возврат Текст;
КонецФункции

Функция ПроверитьМетодыСписания() Экспорт
    Текст = "";
    Для Н = 0 По 2 Цикл
        Метод = ?(Н=0,Перечисления.УчетнаяПолитика.ФИФО,?(Н=1,Перечисления.УчетнаяПолитика.ЛИФО,Перечисления.УчетнаяПолитика.ПоСредней));
        Подразделение = Демонстрация.Элемент(Справочники.Подразделения,"Тест " + Метод);
        Товар = Демонстрация.Элемент(Справочники.Номенклатура,"Тест списания " + Метод);
        Политика = РегистрыСведений.ПолитикиПодразделений.СоздатьМенеджерЗаписи();
        Политика.Период = Дата(2025,1,1); Политика.Подразделение = Подразделение; Политика.Метод = Метод; Политика.Записать();
        Для Партия = 1 По 2 Цикл
            Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2025,1,Партия);
            Стр = Док.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Товар; Стр.Подразделение = Подразделение; Стр.Количество=10; Стр.Цена=Партия*100; Стр.Сумма=Партия*1000;
            Док.Записать(РежимЗаписиДокумента.Проведение);
        КонецЦикла;
        Док = Документы.РасходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2025,1,3);
        Для Часть = 1 По 2 Цикл
            Стр = Док.СписокНоменклатуры.Добавить(); Стр.Номенклатура=Товар; Стр.Подразделение=Подразделение; Стр.Количество=Часть+1; Стр.Сумма=1000;
        КонецЦикла;
        Док.Записать(РежимЗаписиДокумента.Проведение);
        Док.Записать(РежимЗаписиДокумента.Проведение);
        П = Новый Структура("Док",Док.Ссылка);
        Т = УчетСервер.ЗапросТаблица("ВЫБРАТЬ СУММА(Количество) КАК Количество, СУММА(Стоимость) КАК Стоимость ИЗ РегистрНакопления.ОстаткиНоменклатуры ГДЕ Регистратор=&Док", П);
        Ожидание = ?(Н=0,500,?(Н=1,1000,750));
        Если Т[0].Количество<>5 Или Т[0].Стоимость<>Ожидание Тогда ВызватьИсключение "Ошибка метода " + Метод; КонецЕсли;
        Док.СписокНоменклатуры[0].Количество = 100;
        ОтрицательныйТест = Ложь;
        Попытка Док.Записать(РежимЗаписиДокумента.Проведение);
        Исключение ОтрицательныйТест = Истина;
        КонецПопытки;
        Если Не ОтрицательныйТест Тогда ВызватьИсключение "Нет отказа при нехватке"; КонецЕсли;
        Текст = Текст + Метод + ": стоимость " + Ожидание + ", дубли, перепроведение, нехватка — OK" + Символы.ПС;
    КонецЦикла;
    Возврат Текст;
КонецФункции
