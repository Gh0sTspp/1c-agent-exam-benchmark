
Функция Элемент(Менеджер, Имя) Экспорт
    Ссылка = Менеджер.НайтиПоНаименованию(Имя, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьЭлемент();
    Объект.Наименование = Имя;
    Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Процедура ЗаполнитьПример() Экспорт
    УчетСервер.НастроитьРасчеты();
    Цех = Элемент(Справочники.Подразделения, "Демо: Основной цех");
    Склад = Элемент(Справочники.Склады, "Демо: Склад");
    Деталь = Элемент(Справочники.Номенклатура, "Демо: Материнская плата");
    Аналог = Элемент(Справочники.Номенклатура, "Демо: Плата аналог");
    Блок = Элемент(Справочники.Номенклатура, "Демо: Системный блок");
    Свойство = Элемент(Справочники.Свойства, "Демо: ASUS 16 ГБ");
    Объект = Деталь.ПолучитьОбъект(); Объект.Артикул = "DEMO001"; Объект.Производитель = "ASUS"; Объект.Записать();
    Объект = Аналог.ПолучитьОбъект(); Объект.Артикул = "DEMO002"; Объект.Записать();
    Объект = Свойство.ПолучитьОбъект(); Объект.Номенклатура = Деталь; Объект.Записать();
    Политика = РегистрыСведений.ПолитикиПодразделений.СоздатьМенеджерЗаписи();
    Политика.Период = Дата(2024,1,1); Политика.Подразделение = Цех;
    Политика.Метод = Перечисления.УчетнаяПолитика.ФИФО; Политика.Записать();
    Спецификация = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
    Спецификация.Период = Дата(2024,1,1); Спецификация.Блок = Блок;
    Спецификация.Деталь = Деталь; Спецификация.Свойство = Свойство; Спецификация.Количество = 2; Спецификация.Записать();
    Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
    Связь.Товар = Деталь; Связь.Аналог = Аналог; Связь.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
    Приход.Дата = Дата(2024,1,2,10,0,0); Приход.Склад = Склад;
    Стр = Приход.СписокНоменклатуры.Добавить();
    Стр.Номенклатура = Деталь; Стр.Свойство = Свойство; Стр.Подразделение = Цех;
    Стр.Количество = 20; Стр.Цена = 5000; Стр.Сумма = 100000;
    Стр = Приход.СписокНоменклатуры.Добавить();
    Стр.Номенклатура = Аналог; Стр.Количество = 10; Стр.Цена = 5000; Стр.Сумма = 50000;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Сборка = Документы.Сборка.СоздатьДокумент();
    Сборка.Дата = Дата(2024,1,3,10,0,0); Сборка.Источник = Цех; Сборка.Получатель = Цех;
    Стр = Сборка.Блоки.Добавить(); Стр.Номенклатура = Блок; Стр.Количество = 2;
    Сборка.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
    Продажа.Дата = Дата(2024,1,4,10,0,0);
    Стр = Продажа.СписокНоменклатуры.Добавить();
    Стр.Номенклатура = Блок; Стр.Подразделение = Цех; Стр.Количество = 1; Стр.Цена = 15000; Стр.Сумма = 15000;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
    Продажа.Дата = Дата(2024,1,5,10,0,0); Продажа.Склад = Склад;
    Стр = Продажа.СписокНоменклатуры.Добавить();
    Стр.Номенклатура = Деталь; Стр.Количество = 23; Стр.Цена = 7000; Стр.Сумма = 161000;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Операция = Документы.Операция.СоздатьДокумент(); Операция.Дата = Дата(2024,1,6);
    Стр = Операция.Проводки.Добавить();
    Стр.СчетДт = ПланыСчетов.Управленческий.Товары; Стр.СчетКт = ПланыСчетов.Управленческий.Поставщики;
    Стр.НоменклатураДт = Деталь; Стр.СкладДт = Склад; Стр.КоличествоДт = 2; Стр.Сумма = 12000;
    Операция.Записать(РежимЗаписиДокумента.Проведение);
    Работник = Элемент(Справочники.ФизическиеЛица, "Демо: Работник");
    Руководитель = Элемент(Справочники.ФизическиеЛица, "Демо: Руководитель");
    Для Каждого Ссылка Из СтрРазделить("0,1,3", ",") Цикл
        Стаж = Число(Ссылка);
        Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
        Запись.Стаж = Стаж; Запись.Процент = ?(Стаж=0,5,?(Стаж=1,10,15)); Запись.Записать();
    КонецЦикла;
    Для Н = 1 По 2 Цикл
        Сотр = ?(Н=1,Работник,Руководитель);
        Объект = Сотр.ПолучитьОбъект(); Объект.НачалоСтажа = Дата(2018,1,1); Объект.Записать();
        Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи();
        Запись.Период = Дата(2023,10,1); Запись.Сотрудник = Сотр; Запись.Ставка = ?(Н=1,200,300); Запись.Записать();
    КонецЦикла;
    График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
    График.Отбор.Подразделение.Установить(Цех);
    День = Дата(2023,10,1);
    Пока День <= Дата(2024,3,31) Цикл
        Запись = График.Добавить(); Запись.Дата = День; Запись.Подразделение = Цех;
        Запись.Значение = ?(ДеньНедели(День)<=5,8,0); Запись.Дни = ?(Запись.Значение>0,1,0);
        День = День + 86400;
    КонецЦикла;
    График.Записать();
    Месяц = Дата(2023,10,1);
    Пока Месяц <= Дата(2024,2,1) Цикл
        Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = КонецМесяца(Месяц);
        Для Н = 1 По 2 Цикл
            Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = ?(Н=1,Работник,Руководитель);
            Стр.Подразделение = Цех; Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
            Стр.ДатаНачала = Месяц; Стр.ДатаОкончания = КонецМесяца(Месяц);
        КонецЦикла;
        Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Руководитель;
        Стр.Подразделение = Цех; Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия;
        Стр.ДатаНачала = Месяц; Стр.ДатаОкончания = КонецМесяца(Месяц);
        Док.Записать(РежимЗаписиДокумента.Проведение);
        Месяц = ДобавитьМесяц(Месяц,1);
    КонецЦикла;
    Док = Документы.НачислениеЗарплаты.СоздатьДокумент(); Док.Дата = Дата(2024,3,10);
    Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Руководитель; Стр.Подразделение = Цех;
    Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    Стр.ДатаНачала = Дата(2024,1,29); Стр.ДатаОкончания = Дата(2024,2,4);
    Док.Записать(РежимЗаписиДокумента.Проведение);
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Срок кредита, дни",Истина);
    Если Не ЗначениеЗаполнено(Вид) Тогда
        Х = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
        Х.Наименование = "Срок кредита, дни"; Х.ТипЗначения = Новый ОписаниеТипов("Число"); Х.Записать(); Вид = Х.Ссылка;
    КонецЕсли;
    Объект = Руководитель.ПолучитьОбъект();
    Если Объект.ДополнительныеСведения.Найти(Вид,"ВидСведения")=Неопределено Тогда Объект.ДополнительныеСведения.Добавить().ВидСведения=Вид; Объект.Записать(); КонецЕсли;
    Контрагент = Элемент(Справочники.Контрагенты,"Демо: Сатурн").ПолучитьОбъект();
    Контрагент.Менеджер = Руководитель; Контрагент.Записать();
КонецПроцедуры

Функция ТестКонтрагент() Экспорт
    Возврат Справочники.Контрагенты.НайтиПоНаименованию("Демо: Сатурн", Истина);
КонецФункции

Функция ТестЗначениеКонтрагента() Экспорт
    Ссылка = ТестКонтрагент();
    Для Каждого Стр Из Ссылка.ДополнительныеСведения Цикл
        Если Стр.ВидСведения.Наименование = "Срок кредита, дни" Тогда Возврат Стр.Значение; КонецЕсли;
    КонецЦикла;
    Возврат Неопределено;
КонецФункции
