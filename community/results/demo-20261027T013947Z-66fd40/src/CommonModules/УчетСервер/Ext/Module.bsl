
Функция ЗапросТаблица(Текст, Параметры) Экспорт
    Запрос = Новый Запрос(Текст);
    Для Каждого П Из Параметры Цикл
        Запрос.УстановитьПараметр(П.Ключ, П.Значение);
    КонецЦикла;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ОшибкаСтроки(Текст, Отказ) Экспорт
    Отказ = Истина;
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.Сообщить();
КонецПроцедуры

Функция СуммаСтроки(Строка) Экспорт
    Возврат ?(Строка.Сумма = 0, Окр(Строка.Количество * Строка.Цена, 2), Строка.Сумма);
КонецФункции

Процедура БлокироватьОстатки(Требования) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = Требования;
    Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
    Элемент.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура БлокироватьБухгалтерию() Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрБухгалтерии.Управленческий");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары);
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ТребованияПустые() Экспорт
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.Свойства"));
    Т.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    Т.Колонки.Добавить("Блок", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Возврат Т;
КонецФункции

Процедура Приход(Док, Отказ) Экспорт
    Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Док.Движения.Управленческий.Записывать = Истина;
    Для Каждого Стр Из Док.СписокНоменклатуры Цикл
        Если Стр.Количество <= 0 Или Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда
            ОшибкаСтроки("В приходе укажите товар и положительное количество, строка " + Стр.НомерСтроки, Отказ);
            Возврат;
        КонецЕсли;
        Если ЗначениеЗаполнено(Стр.Подразделение) Тогда
            Дв = Док.Движения.ОстаткиНоменклатуры.Добавить();
            Дв.Период = Док.Дата;
            Дв.ВидДвижения = ВидДвиженияНакопления.Приход;
            ЗаполнитьЗначенияСвойств(Дв, Стр, "Подразделение,Номенклатура,Свойство,Количество");
            Дв.Партия = Док.Дата;
            Дв.Стоимость = СуммаСтроки(Стр);
        КонецЕсли;
        Если ЗначениеЗаполнено(Док.Склад) Тогда
            Дв = Док.Движения.Управленческий.Добавить();
            Дв.Период = Док.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.Товары;
            Дв.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Дв.НоменклатураДт = Стр.Номенклатура;
            Дв.СкладДт = Док.Склад;
            Дв.КоличествоДт = Стр.Количество;
            Дв.Сумма = СуммаСтроки(Стр);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция СписатьОперативно(Док, Требования, Отказ) Экспорт
    Стоимости = Новый Соответствие;
    Если Требования.Количество() = 0 Тогда
        Возврат Стоимости;
    КонецЕсли;
    Требования.Свернуть("Подразделение,Номенклатура,Свойство,Блок", "Количество");
    БлокироватьОстатки(Требования);
    Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Док.Движения.ОстаткиНоменклатуры.Очистить();
    Док.Движения.ОстаткиНоменклатуры.Записать();
    П = Новый Структура("Момент,Товары,Подразделения", Док.МоментВремени(), Требования.ВыгрузитьКолонку("Номенклатура"), Требования.ВыгрузитьКолонку("Подразделение"));
    Остатки = ЗапросТаблица(
    "ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия, КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент, Номенклатура В (&Товары) И Подразделение В (&Подразделения))
    |УПОРЯДОЧИТЬ ПО Партия", П);
    Политики = ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.ПолитикиПодразделений.СрезПоследних(&Момент, Подразделение В (&Подразделения))", П);
    Для Каждого Стр Из Требования Цикл
        Если Стр.Количество <= 0 Тогда
            ОшибкаСтроки("Количество списания должно быть положительным: " + Стр.Номенклатура, Отказ);
            Возврат Стоимости;
        КонецЕсли;
        Метод = Перечисления.УчетнаяПолитика.ПоСредней;
        Пол = Политики.Найти(Стр.Подразделение, "Подразделение");
        Если Пол <> Неопределено Тогда Метод = Пол.Метод; КонецЕсли;
        Остатки.Сортировать("Партия " + ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, "Убыв", "Возр"));
        Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Стр.Подразделение, Стр.Номенклатура, Стр.Свойство);
        Партии = Остатки.НайтиСтроки(Отбор);
        Всего = 0;
        Сумма = 0;
        Для Каждого Пар Из Партии Цикл
            Всего = Всего + Пар.Количество;
            Сумма = Сумма + Пар.Стоимость;
        КонецЦикла;
        Если Всего < Стр.Количество Тогда
            ОшибкаСтроки("Недостаточно " + Стр.Номенклатура + " (" + Стр.Свойство + ") в " + Стр.Подразделение + "; требуется " + Стр.Количество + ", остаток " + Всего, Отказ);
            Возврат Стоимости;
        КонецЕсли;
        Осталось = Стр.Количество;
        СтоимостьСтроки = 0;
        Для Каждого Пар Из Партии Цикл
            Если Осталось <= 0 Тогда Прервать; КонецЕсли;
            Если Пар.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Кол = Мин(Осталось, Пар.Количество);
            Цена = Пар.Стоимость / Пар.Количество;
            Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
                // Равномерное списание каждой партии сохраняет среднюю и исключает зависимость от порядка.
                                Кол = Окр(Стр.Количество * Пар.Количество / Всего, 9);
            КонецЕсли;
            Стоим = ?(Кол = Пар.Количество, Пар.Стоимость, Окр(Кол * Цена, 2));
            Если Метод = Перечисления.УчетнаяПолитика.ПоСредней И Пар = Партии[Партии.Количество()-1] Тогда
                Кол = Осталось;
                Стоим = ?(Стр.Количество = Всего, Пар.Стоимость, Окр(Сумма * Стр.Количество / Всего,2) - СтоимостьСтроки);
            КонецЕсли;
            Дв = Док.Движения.ОстаткиНоменклатуры.Добавить();
            Дв.Период = Док.Дата;
            Дв.ВидДвижения = ВидДвиженияНакопления.Расход;
            ЗаполнитьЗначенияСвойств(Дв, Стр, "Подразделение,Номенклатура,Свойство");
            Дв.Партия = Пар.Партия;
            Дв.Количество = Кол;
            Дв.Стоимость = Стоим;
            Пар.Количество = Пар.Количество - Кол;
            Пар.Стоимость = Пар.Стоимость - Стоим;
            СтоимостьСтроки = СтоимостьСтроки + Стоим;
            Осталось = Осталось - Кол;
        КонецЦикла;
        Ключ = Стр.Блок;
        Старое = Стоимости.Получить(Ключ);
        Стоимости.Вставить(Ключ, ?(Старое = Неопределено, 0, Старое) + СтоимостьСтроки);
    КонецЦикла;
    Возврат Стоимости;
КонецФункции

Процедура Сборка(Док, Отказ) Экспорт
    Если Док.Блоки.Количество() = 0 Или Не ЗначениеЗаполнено(Док.Источник) Или Не ЗначениеЗаполнено(Док.Получатель) Тогда
        ОшибкаСтроки("Заполните подразделения и системные блоки.", Отказ);
        Возврат;
    КонецЕсли;
    П = Новый Структура("Дата,Блоки", Док.Дата, Док.Блоки.ВыгрузитьКолонку("Номенклатура"));
    Спецификации = ЗапросТаблица(
    "ВЫБРАТЬ Состав.Блок, Состав.Деталь, Состав.Свойство, Состав.Количество
    |ИЗ РегистрСведений.Спецификации КАК Состав
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ
    |(ВЫБРАТЬ Блок, МАКСИМУМ(Период) КАК Период ИЗ РегистрСведений.Спецификации
    |ГДЕ Блок В (&Блоки) И Период <= &Дата СГРУППИРОВАТЬ ПО Блок) КАК Актуальные
    |ПО Состав.Блок = Актуальные.Блок И Состав.Период = Актуальные.Период", П);
    Треб = ТребованияПустые();
    Для Каждого Б Из Док.Блоки Цикл
        Если Б.Количество <= 0 Тогда ОшибкаСтроки("Количество блоков должно быть положительным.", Отказ); Возврат; КонецЕсли;
        Состав = Спецификации.НайтиСтроки(Новый Структура("Блок", Б.Номенклатура));
        Если Состав.Количество() = 0 Тогда ОшибкаСтроки("Нет спецификации " + Б.Номенклатура, Отказ); Возврат; КонецЕсли;
        Для Каждого Д Из Состав Цикл
            С = Треб.Добавить();
            С.Подразделение = Док.Источник;
            С.Номенклатура = Д.Деталь;
            С.Свойство = Д.Свойство;
            С.Количество = Д.Количество * Б.Количество;
            С.Блок = Б.Номенклатура;
        КонецЦикла;
    КонецЦикла;
    Для Каждого Д Из Док.ДополнительныеДетали Цикл
        С = Треб.Добавить();
        ЗаполнитьЗначенияСвойств(С, Д);
        С.Подразделение = Док.Источник;
    КонецЦикла;
    Стоимости = СписатьОперативно(Док, Треб, Отказ);
    Если Отказ Тогда Возврат; КонецЕсли;
    ДопСтоимость = Стоимости.Получить(Справочники.Номенклатура.ПустаяСсылка());
    Если ДопСтоимость = Неопределено Тогда ДопСтоимость = 0; КонецЕсли;
    Блоки = Док.Блоки.Выгрузить();
    Блоки.Свернуть("Номенклатура", "Количество");
    Всего = Блоки.Итог("Количество");
    ОстатокДоп = ДопСтоимость;
    Для Каждого Б Из Блоки Цикл
        Стоимость = Стоимости.Получить(Б.Номенклатура);
        Доля = ?(Б = Блоки[Блоки.Количество()-1], ОстатокДоп, Окр(ДопСтоимость * Б.Количество / Всего,2));
        ОстатокДоп = ОстатокДоп - Доля;
        Дв = Док.Движения.ОстаткиНоменклатуры.Добавить();
        Дв.Период = Док.Дата;
        Дв.ВидДвижения = ВидДвиженияНакопления.Приход;
        Дв.Подразделение = Док.Получатель;
        Дв.Номенклатура = Б.Номенклатура;
        Дв.Количество = Б.Количество;
        Дв.Партия = Док.Дата;
        Дв.Стоимость = Стоимость + Доля;
    КонецЦикла;
КонецПроцедуры

Функция ГруппаАналогов(Товар, Связи) Экспорт
    Список = Новый Массив;
    Список.Добавить(Товар);
    Индекс = 0;
    Пока Индекс < Список.Количество() Цикл
        Текущий = Список[Индекс];
        Для Каждого Связь Из Связи Цикл
            Другой = Неопределено;
            Если Связь.Товар = Текущий Тогда Другой = Связь.Аналог; КонецЕсли;
            Если Связь.Аналог = Текущий Тогда Другой = Связь.Товар; КонецЕсли;
            Если Другой <> Неопределено И Список.Найти(Другой) = Неопределено Тогда Список.Добавить(Другой); КонецЕсли;
        КонецЦикла;
        Индекс = Индекс + 1;
    КонецЦикла;
    Возврат Список;
КонецФункции

Процедура ПродажаБух(Док, Отказ) Экспорт
    Если Не ЗначениеЗаполнено(Док.Склад) Тогда Возврат; КонецЕсли;
    БлокироватьБухгалтерию();
    Док.Движения.Управленческий.Записывать = Истина;
    Док.Движения.Управленческий.Очистить();
    Док.Движения.Управленческий.Записать();
    П = Новый Структура("Момент,Счет", Док.МоментВремени(), ПланыСчетов.Управленческий.Товары);
    Остатки = ЗапросТаблица(
    "ВЫБРАТЬ Номенклатура, Склад, КоличествоОстаток КАК Количество, СуммаОстаток КАК Сумма
        |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, )
    |УПОРЯДОЧИТЬ ПО Номенклатура.Артикул, Номенклатура", П);
    Итоги = Остатки.Скопировать();
    Итоги.Свернуть("Номенклатура", "Количество,Сумма");
    Связи = ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги", Новый Структура);
    Для Каждого С Из Док.СписокНоменклатуры Цикл
        Если С.Количество <= 0 Тогда ОшибкаСтроки("Количество продажи должно быть положительным.", Отказ); Возврат; КонецЕсли;
        Аналоги = ГруппаАналогов(С.Номенклатура, Связи);
        Кандидаты = Новый Массив;
        Для Каждого О Из Остатки Цикл
            Если О.Склад = Док.Склад И Аналоги.Найти(О.Номенклатура) <> Неопределено Тогда
                Если О.Номенклатура = С.Номенклатура Тогда Кандидаты.Вставить(0, О); Иначе Кандидаты.Добавить(О); КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Осталось = С.Количество;
        ОстВыручка = СуммаСтроки(С);
        Для Каждого О Из Кандидаты Цикл
            Если Осталось <= 0 Тогда Прервать; КонецЕсли;
            Если О.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Кол = Мин(Осталось, О.Количество);
            Итог = Итоги.Найти(О.Номенклатура, "Номенклатура");
            Стоимость = ?(Кол = Итог.Количество, Итог.Сумма, Окр(Итог.Сумма * Кол / Итог.Количество,2));
            Выручка = ?(Кол = Осталось, ОстВыручка, Окр(СуммаСтроки(С) * Кол / С.Количество,2));
            О.Количество = О.Количество - Кол;
            Итог.Количество = Итог.Количество - Кол;
            Итог.Сумма = Итог.Сумма - Стоимость;
            Дв = Док.Движения.Управленческий.Добавить();
            Дв.Период = Док.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
            Дв.СчетКт = ПланыСчетов.Управленческий.Товары;
            Дв.НоменклатураКт = О.Номенклатура;
            Дв.СкладКт = Док.Склад;
            Дв.КоличествоКт = Кол;
            Дв.Сумма = Стоимость;
            Дв = Док.Движения.Управленческий.Добавить();
            Дв.Период = Док.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.Покупатели;
            Дв.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
            Дв.Сумма = Выручка;
            Дв = Док.Движения.Продажи.Добавить();
            Дв.Период = Док.Дата;
            Дв.Раздел = "БУ";
            Дв.Номенклатура = С.Номенклатура;
            Дв.Продано = О.Номенклатура;
            Дв.Количество = Кол;
            Дв.Себестоимость = Стоимость;
            Дв.Выручка = Выручка;
            Осталось = Осталось - Кол;
            ОстВыручка = ОстВыручка - Выручка;
        КонецЦикла;
        Если Осталось > 0 Тогда
            ОшибкаСтроки("Недостаточно товара и аналогов: " + С.Номенклатура + ", не хватает " + Осталось, Отказ);
            Возврат;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Продажа(Док, Отказ) Экспорт
    Док.Движения.Продажи.Записывать = Истина;
    Треб = ТребованияПустые();
    Для Каждого С Из Док.СписокНоменклатуры Цикл
        Если ЗначениеЗаполнено(С.Подразделение) Тогда
            Т = Треб.Добавить();
            ЗаполнитьЗначенияСвойств(Т, С);
            Т.Блок = С.Номенклатура;
        КонецЕсли;
    КонецЦикла;
    Стоимости = СписатьОперативно(Док, Треб, Отказ);
    Если Отказ Тогда Возврат; КонецЕсли;
    Товары = Док.СписокНоменклатуры.Выгрузить();
    Товары.Свернуть("Номенклатура,Подразделение", "Количество,Сумма");
    Для Каждого С Из Товары Цикл
        Если Не ЗначениеЗаполнено(С.Подразделение) Тогда Продолжить; КонецЕсли;
        Дв = Док.Движения.Продажи.Добавить();
        Дв.Период = Док.Дата;
        Дв.Раздел = "ОУ";
        Дв.Номенклатура = С.Номенклатура;
        Дв.Продано = С.Номенклатура;
        Дв.Количество = С.Количество;
        Дв.Себестоимость = Стоимости.Получить(С.Номенклатура);
        Стоимости.Вставить(С.Номенклатура, 0);
        Дв.Выручка = С.Сумма;
    КонецЦикла;
    ПродажаБух(Док, Отказ);
КонецПроцедуры

Процедура Операция(Док, Отказ) Экспорт
    БлокироватьБухгалтерию();
    Док.Движения.Управленческий.Записывать = Истина;
    Для Каждого С Из Док.Проводки Цикл
        Дв = Док.Движения.Управленческий.Добавить();
        ЗаполнитьЗначенияСвойств(Дв, С);
        Дв.Период = Док.Дата;
    КонецЦикла;
КонецПроцедуры

Процедура НастроитьРасчеты() Экспорт
    ПВР = ПланыВидовРасчета.ОсновныеНачисления;
    Для Каждого Имя Из СтрРазделить("Тариф,Премия,Командировка", ",") Цикл
        Ссылка = ПВР[Имя];
        ОбъектВида = Ссылка.ПолучитьОбъект();
        Изменен = Ложь;
        Если Имя <> "Командировка" И ОбъектВида.ВытесняющиеВидыРасчета.Найти(ПВР.Командировка, "ВидРасчета") = Неопределено Тогда
            ОбъектВида.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПВР.Командировка;
            Изменен = Истина;
        КонецЕсли;
        Если Имя <> "Тариф" И ОбъектВида.БазовыеВидыРасчета.Найти(ПВР.Тариф, "ВидРасчета") = Неопределено Тогда
            ОбъектВида.БазовыеВидыРасчета.Добавить().ВидРасчета = ПВР.Тариф;
            Изменен = Истина;
        КонецЕсли;
        Если Имя = "Командировка" Тогда
            Для Каждого База Из СтрРазделить("Премия,Командировка", ",") Цикл
                Если ОбъектВида.БазовыеВидыРасчета.Найти(ПВР[База], "ВидРасчета") = Неопределено Тогда
                    ОбъектВида.БазовыеВидыРасчета.Добавить().ВидРасчета = ПВР[База];
                    Изменен = Истина;
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;
        Если Изменен Тогда ОбъектВида.Записать(); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Зарплата(Док, Отказ) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    НастроитьРасчеты();
    Набор = Док.Движения.Начисления;
    Набор.Записывать = Истина;
    Набор.Очистить();
    Для Каждого С Из Док.ОсновныеНачисления Цикл
        Если С.ДатаНачала > С.ДатаОкончания Или Не ЗначениеЗаполнено(С.Сотрудник) Или Не ЗначениеЗаполнено(С.Подразделение) Тогда
            ОшибкаСтроки("Неверный интервал или не заполнен сотрудник/подразделение в строке " + С.НомерСтроки, Отказ); Возврат;
        КонецЕсли;
        Если С.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(С.ДатаНачала) <> НачалоМесяца(С.ДатаОкончания) Тогда
            ОшибкаСтроки("Тариф и премия задаются внутри одного месяца.", Отказ); Возврат;
        КонецЕсли;
        Начало = С.ДатаНачала;
        Пока Начало <= С.ДатаОкончания Цикл
            Дв = Набор.Добавить();
            Дв.ПериодРегистрации = НачалоМесяца(Начало);
            Дв.ПериодДействияНачало = Начало;
            Дв.ПериодДействияКонец = КонецДня(Мин(КонецМесяца(Начало), С.ДатаОкончания));
            Дв.ВидРасчета = С.ВидРасчета;
            Дв.Сотрудник = С.Сотрудник;
            Дв.Подразделение = С.Подразделение;
            Дв.График = С.Подразделение;
            Если Дв.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
                Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
            Иначе
                Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -3);
            КонецЕсли;
            Дв.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            Начало = НачалоМесяца(ДобавитьМесяц(Начало, 1));
        КонецЦикла;
    КонецЦикла;
    Набор.Записать();
    ПересчитатьЗарплату();
    Набор.Прочитать();
КонецПроцедуры

Процедура ПересчитатьЗарплату() Экспорт
    Регистраторы = ЗапросТаблица(
    "ВЫБРАТЬ Регистратор, МИНИМУМ(ПериодРегистрации) КАК Период
    |ИЗ РегистрРасчета.Начисления
    |СГРУППИРОВАТЬ ПО Регистратор
    |УПОРЯДОЧИТЬ ПО Период, Регистратор", Новый Структура);
    Ставки = ЗапросТаблица("ВЫБРАТЬ Период, Сотрудник, Ставка ИЗ РегистрСведений.ТарифныеСтавки УПОРЯДОЧИТЬ ПО Период УБЫВ", Новый Структура);
    Сотрудники = ЗапросТаблица("ВЫБРАТЬ Ссылка, НачалоСтажа ИЗ Справочник.ФизическиеЛица", Новый Структура);
    Шкала = ЗапросТаблица("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж УБЫВ", Новый Структура);
    // Второй проход обновляет базу многоинтервального отклонения после начислений его первого месяца.
    Для Проход = 1 По 2 Цикл
        Для Каждого Рег Из Регистраторы Цикл
            РассчитатьНабор(Рег.Регистратор, Ставки, Сотрудники, Шкала);
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Процедура РассчитатьНабор(Регистратор, Ставки, Сотрудники, Шкала) Экспорт
    Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
    Набор.Отбор.Регистратор.Установить(Регистратор);
    Набор.Прочитать();
    П = Новый Структура("Регистратор", Регистратор);
    График = ЗапросТаблица(
    "ВЫБРАТЬ НомерСтроки, ЗначениеФактическийПериодДействия КАК Часы,
    |ДниФактическийПериодДействия КАК Дни, ЗначениеПериодРегистрации КАК Норма
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор = &Регистратор)", П);
    Для Каждого Дв Из Набор Цикл
        Г = График.Найти(Дв.НомерСтроки, "НомерСтроки");
        Дв.Часы = 0;
        Дв.Дни = 0;
        Дв.Результат = 0;
        Если Г = Неопределено Тогда Продолжить; КонецЕсли;
        Дв.Часы = Г.Часы;
                Дв.Дни = ?(Дв.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф, Г.Дни, 0);
        Если Дв.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Ставка = 0;
            Для Каждого Ст Из Ставки Цикл
                Если Ст.Сотрудник = Дв.Сотрудник И Ст.Период <= НачалоМесяца(Дв.ПериодДействияНачало) Тогда Ставка = Ст.Ставка; Прервать; КонецЕсли;
            КонецЦикла;
            Дв.Результат = Окр(Ставка * Г.Часы, 2);
        КонецЕсли;
        Сотр = Сотрудники.Найти(Дв.Сотрудник, "Ссылка");
        Дв.Стаж = 0;
        Если Сотр <> Неопределено И ЗначениеЗаполнено(Сотр.НачалоСтажа) Тогда
            Месяцев = (Год(Дв.ПериодРегистрации)-Год(Сотр.НачалоСтажа))*12 + Месяц(Дв.ПериодРегистрации)-Месяц(Сотр.НачалоСтажа);
            Если День(Дв.ПериодРегистрации) < День(Сотр.НачалоСтажа) Тогда Месяцев = Месяцев - 1; КонецЕсли;
            Дв.Стаж = Макс(0, Цел(Месяцев/12));
        КонецЕсли;
        Дв.Процент = 0;
        Для Каждого Ст Из Шкала Цикл
            Если Дв.Стаж >= Ст.Стаж Тогда Дв.Процент = Ст.Процент; Прервать; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Набор.Записать();
    // База премии подбирается по подразделению, с разрезом сотрудника для исключения руководителя.
    Измерения = Новый Массив;
    Измерения.Добавить("Подразделение");
    Разрезы = Новый Массив;
    Разрезы.Добавить("Сотрудник");
    П.Вставить("Измерения", Измерения);
    П.Вставить("Разрезы", Разрезы);
    БазаПремии = ЗапросТаблица(
    "ВЫБРАТЬ НомерСтроки, СотрудникРазрез КАК Сотрудник, РезультатБаза КАК Сумма
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы, Регистратор = &Регистратор)", П);
    Для Каждого Дв Из Набор Цикл
        Если Дв.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        Сумма = 0;
        Для Каждого Б Из БазаПремии.НайтиСтроки(Новый Структура("НомерСтроки", Дв.НомерСтроки)) Цикл
            Если Б.Сотрудник <> Дв.Сотрудник Тогда Сумма = Сумма + Б.Сумма; КонецЕсли;
        КонецЦикла;
        Г = График.Найти(Дв.НомерСтроки, "НомерСтроки");
        Если Г <> Неопределено И Г.Норма > 0 Тогда Дв.Результат = Окр(Сумма * Дв.Процент / 100 * Г.Часы / Г.Норма, 2); КонецЕсли;
    КонецЦикла;
    Набор.Записать();
    Измерения.Очистить();
    Измерения.Добавить("Сотрудник");
    П.Вставить("Измерения", Измерения);
    БазаКомандировки = ЗапросТаблица(
    "ВЫБРАТЬ НомерСтроки, РезультатБаза КАК Сумма, ДниБаза КАК Дни
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, , Регистратор = &Регистратор)", П);
    Для Каждого Дв Из Набор Цикл
        Если Дв.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        Б = БазаКомандировки.Найти(Дв.НомерСтроки, "НомерСтроки");
                Г = График.Найти(Дв.НомерСтроки, "НомерСтроки");
        Если Б <> Неопределено И Б.Дни > 0 И Г <> Неопределено Тогда Дв.Результат = Окр(Б.Сумма / Б.Дни * Г.Дни, 2); КонецЕсли;
    КонецЦикла;
    // Дни для среднего заработка учитываются один раз — в тарифе, а не повторно в премии.
    Для Каждого Дв Из Набор Цикл
        Если Дв.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда Дв.Дни = 0; КонецЕсли;
    КонецЦикла;
    Набор.Записать();
КонецПроцедуры

Функция ТабличныйОтчет(Таблица, Заголовок, Начало, Конец) Экспорт
    Док = Новый ТабличныйДокумент;
    Док.Область(1,1).Текст = Заголовок;
    Док.Область(2,1).Текст = Формат(Начало,"ДФ=dd.MM.yyyy") + " - " + Формат(Конец,"ДФ=dd.MM.yyyy");
    Если Заголовок = "Ведомость" Тогда
        Шапка = СтрРазделить("Производитель,Товар,Нач. ост.,Приход,Расход,Кон. ост.", ",");
        Поля = СтрРазделить("НачальныйОстаток,Приход,Расход,КонечныйОстаток", ",");
        Номер = 4;
        Для Каждого С Из Таблица Цикл
            Номер = Номер + 1;
            Док.Область(Номер,1).Текст = С.Производитель;
            Док.Область(Номер,2).Текст = Строка(С.Номенклатура) + ?(ЗначениеЗаполнено(С.Характеристика), " (" + С.Характеристика + ")", "");
            Для Н = 0 По 3 Цикл
                Док.Область(Номер,Н+3).Текст = Строка(С[Поля[Н]+"Количество"]);
                Док.Область(Номер+1,Н+3).Текст = Формат(С[Поля[Н]],"ЧДЦ=2");
            КонецЦикла;
            Номер = Номер + 1;
        КонецЦикла;
    ИначеЕсли Заголовок = "ПродажиБухгалтерские" Тогда
        Шапка = СтрРазделить("Номенклатура,Продано,Кол-во,Себест-сть,Продажа,Прибыль", ",");
        Итоги = Таблица.Скопировать();
        Итоги.Свернуть("Номенклатура", "Количество,Себестоимость,Выручка,Прибыль");
        Поля = СтрРазделить("Количество,Себестоимость,Выручка,Прибыль", ",");
        Номер = 4;
        Для Каждого ИтоговаяСтрока Из Итоги Цикл
            Номер = Номер + 1;
            Док.Область(Номер,1).Текст = Строка(ИтоговаяСтрока.Номенклатура);
            Для Н = 0 По 3 Цикл
                Док.Область(Номер,Н+3).Текст = Строка(ИтоговаяСтрока[Поля[Н]]);
            КонецЦикла;
            Для Каждого С Из Таблица.НайтиСтроки(Новый Структура("Номенклатура",ИтоговаяСтрока.Номенклатура)) Цикл
                Номер = Номер + 1;
                Док.Область(Номер,2).Текст = Строка(С.Продано);
                Для Н = 0 По 3 Цикл
                    Док.Область(Номер,Н+3).Текст = Строка(С[Поля[Н]]);
                КонецЦикла;
            КонецЦикла;
        КонецЦикла;
    Иначе
        Если Заголовок = "Премии" Тогда
            Шапка = СтрРазделить("Сотрудник,Трудовой стаж,% премии,Сумма премии", ",");
            Поля = СтрРазделить("Сотрудник,Стаж,Процент,Сумма", ",");
        Иначе
            Шапка = СтрРазделить("Номенклатура,Кол-во,Себест-сть,Продажа,Прибыль", ",");
            Поля = СтрРазделить("Номенклатура,Количество,Себестоимость,Выручка,Прибыль", ",");
        КонецЕсли;
        Номер = 4;
        Для Каждого С Из Таблица Цикл
            Номер = Номер + 1;
            Для Н = 0 По Поля.Количество()-1 Цикл
                Док.Область(Номер,Н+1).Текст = Строка(С[Поля[Н]]);
            КонецЦикла;
        КонецЦикла;
        Док.Область(Номер+1,1).Текст = "ИТОГО:";
        Для Н = 1 По Поля.Количество()-1 Цикл
            Если Заголовок <> "Премии" Или Поля[Н] = "Сумма" Тогда
                Док.Область(Номер+1,Н+1).Текст = Строка(Таблица.Итог(Поля[Н]));
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Для Н = 0 По Шапка.Количество()-1 Цикл
        Док.Область(4,Н+1).Текст = Шапка[Н];
        Док.Область(4,Н+1).Шрифт = Новый Шрифт(,,Истина);
        Док.Область(,Н+1,,Н+1).ШиринаКолонки = ?(Н<2,25,15);
    КонецЦикла;
    Возврат Док;
КонецФункции
