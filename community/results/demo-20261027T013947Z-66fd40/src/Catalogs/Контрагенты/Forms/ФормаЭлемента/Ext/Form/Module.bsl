#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ОбновитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    МенеджерИзмененНаСервере();
КонецПроцедуры

&НаСервере
Процедура МенеджерИзмененНаСервере()
    СохранитьПоляВРеквизиты();
    ОбновитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьПоляВРеквизиты()
    Для Каждого Поле Из КартаПолей Цикл
        Найдено = Ложь;
        Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
            Если Стр.ВидСведения = Поле.Вид Тогда
                Стр.Значение = ЭтотОбъект[Поле.Имя];
                Найдено = Истина;
                Прервать;
            КонецЕсли;
        КонецЦикла;
        Если Не Найдено Тогда
            Стр = Объект.ДополнительныеСведения.Добавить();
            Стр.ВидСведения = Поле.Вид;
            Стр.Значение = ЭтотОбъект[Поле.Имя];
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДополнительныеПоля()
    Удалить = Новый Массив;
    Для Каждого Поле Из КартаПолей Цикл
        Элемент = Элементы.Найти(Поле.Имя);
        Если Элемент <> Неопределено Тогда Элементы.Удалить(Элемент); КонецЕсли;
        Удалить.Добавить(Поле.Имя);
    КонецЦикла;
    КартаПолей.Очистить();
    Добавить = Новый Массив;
    Запрос = Новый Запрос(
        "ВЫБРАТЬ Ссылка КАК ВидСведения, Наименование, ТипЗначения
    |ИЗ ПланВидовХарактеристик.СвойстваОбъектов
    |ГДЕ Ссылка В (ВЫБРАТЬ ВидСведения ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка = &Менеджер)");
    Запрос.УстановитьПараметр("Менеджер",Объект.Менеджер);
    Виды = Запрос.Выполнить().Выгрузить();
    Для Каждого Вид Из Виды Цикл
        Имя = "ДС_" + СтрЗаменить(Строка(Вид.ВидСведения.УникальныйИдентификатор()), "-", "");
        Добавить.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения));
        Поле = КартаПолей.Добавить(); Поле.Имя = Имя; Поле.Вид = Вид.ВидСведения;
    КонецЦикла;
    ИзменитьРеквизиты(Добавить, Удалить);
    Для Каждого Вид Из Виды Цикл
        Имя = "ДС_" + СтрЗаменить(Строка(Вид.ВидСведения.УникальныйИдентификатор()), "-", "");
        Элемент = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
        Элемент.Вид = ВидПоляФормы.ПолеВвода;
        Элемент.ПутьКДанным = Имя;
        Элемент.Заголовок = Вид.Наименование;
        Для Каждого Стр Из Объект.ДополнительныеСведения Цикл
            Если Стр.ВидСведения = Вид.ВидСведения Тогда ЭтотОбъект[Имя] = Стр.Значение; Прервать; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьПоляВРеквизиты();
    ТекущийОбъект.ДополнительныеСведения.Загрузить(РеквизитФормыВЗначение("Объект").ДополнительныеСведения.Выгрузить());
КонецПроцедуры
