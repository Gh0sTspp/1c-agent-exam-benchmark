Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    БлокировкаПриПроведении = Новый БлокировкаДанных; ЭлементБлокировки = БлокировкаПриПроведении.Добавить("РегистрНакопления.ПартииНоменклатуры"); ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    ЭлементБлокировки = БлокировкаПриПроведении.Добавить("РегистрБухгалтерии.Проводки"); ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаПриПроведении.Заблокировать();
    Движения.ОстаткиНоменклатуры.Записывать = Истина; Движения.ОстаткиНоменклатуры.Очистить(); Движения.ОстаткиНоменклатуры.Записать();
    Движения.ПартииНоменклатуры.Записывать = Истина; Движения.ПартииНоменклатуры.Очистить(); Движения.ПартииНоменклатуры.Записать();
    Движения.ПродажиОперативные.Записывать = Истина; Движения.ПродажиОперативные.Очистить(); Движения.ПродажиОперативные.Записать();
    Движения.Проводки.Записывать = Истина; Движения.Проводки.Очистить(); Движения.Проводки.Записать();
    Если ЗначениеЗаполнено(Склад) Тогда ПровестиБухРасход(Отказ); Возврат; КонецЕсли;
    ЗаблокироватьОстатки(); Движения.ОстаткиНоменклатуры.Записывать = Истина; Движения.ПартииНоменклатуры.Записывать = Истина;
    Движения.ОстаткиНоменклатуры.Записать(); Движения.ПартииНоменклатуры.Записать(); Движения.ПродажиОперативные.Записывать = Истина;
    Товары = Новый Массив; Подразделения = Новый Массив;
    Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
        Если НЕ ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Или НЕ ЗначениеЗаполнено(СтрокаТовара.Подразделение) Тогда Отказ = Истина; Сообщить("Не заполнены товар или подразделение"); Возврат; КонецЕсли;
        Если Товары.Найти(СтрокаТовара.Номенклатура) = Неопределено Тогда Товары.Добавить(СтрокаТовара.Номенклатура); КонецЕсли;
        Если Подразделения.Найти(СтрокаТовара.Подразделение) = Неопределено Тогда Подразделения.Добавить(СтрокаТовара.Подразделение); КонецЕсли;
    КонецЦикла;
    Если Товары.Количество() = 0 Тогда Возврат; КонецЕсли;
    ВсеПартии = ЗагрузитьПартии(Товары, Подразделения);
    Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.ПолитикиПодразделений.СрезПоследних(&Дата, Подразделение В (&Подразделения))"); Запрос.УстановитьПараметр("Дата", Дата); Запрос.УстановитьПараметр("Подразделения", Подразделения); Политики = Запрос.Выполнить().Выгрузить();
    Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
        Политика = Политики.Найти(СтрокаТовара.Подразделение, "Подразделение"); Метод = Перечисления.УчетнаяПолитика.ПоСредней;
        Если Политика <> Неопределено И ЗначениеЗаполнено(Политика.Метод) Тогда Метод = Политика.Метод; КонецЕсли;
        Стоимость = Списать(ВсеПартии, СтрокаТовара.Подразделение, СтрокаТовара.Номенклатура, СтрокаТовара.Свойство, СтрокаТовара.Количество, Метод, Отказ);
        Если Отказ Тогда Возврат; КонецЕсли;
        Движение = Движения.ПродажиОперативные.Добавить(); Движение.Период = Дата; Движение.Подразделение = СтрокаТовара.Подразделение; Движение.Номенклатура = СтрокаТовара.Номенклатура; Движение.Количество = СтрокаТовара.Количество; Движение.Стоимость = Стоимость; Движение.Выручка = СтрокаТовара.Сумма;
    КонецЦикла;
КонецПроцедуры

Функция ЗагрузитьПартии(Товары, Подразделения)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Остатки.Подразделение, Остатки.Номенклатура, Остатки.Свойство, Остатки.ДатаПартии, Остатки.Партия, Остатки.КоличествоОстаток КАК Количество, Остатки.СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(&Момент, Номенклатура В (&Товары) И Подразделение В (&Подразделения)) КАК Остатки
    |ГДЕ Остатки.КоличествоОстаток > 0 УПОРЯДОЧИТЬ ПО Остатки.ДатаПартии, Остатки.Партия.МоментВремени";
    Запрос.УстановитьПараметр("Момент", МоментВремени()); Запрос.УстановитьПараметр("Товары", Товары); Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Списать(ВсеПартии, Подразделение, Товар, Свойство, Количество, Метод, Отказ)
    Партии = ВсеПартии.НайтиСтроки(Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство));
    Остаток = 0; СтоимостьВсего = 0;
    Для Каждого Партия Из Партии Цикл Остаток = Остаток + Партия.Количество; СтоимостьВсего = СтоимостьВсего + Партия.Стоимость; КонецЦикла;
    Если Количество <= 0 Или Остаток < Количество Тогда Отказ = Истина; Сообщить("Недостаточно остатка или некорректное количество: " + Товар); Возврат 0; КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.ПоСредней И Партии.Количество() > 1 Тогда
        ОстатокСтоимость = СтоимостьВсего; ОстатокКоличество = Остаток;
        Для Каждого Партия Из Партии Цикл
            Если Партия.Количество = 0 Тогда Продолжить; КонецЕсли;
            Если Партия.Количество = ОстатокКоличество Тогда НоваяСтоимость = ОстатокСтоимость;
            Иначе НоваяСтоимость = Окр(ОстатокСтоимость * Партия.Количество / ОстатокКоличество, 2); КонецЕсли;
            Разница = НоваяСтоимость - Партия.Стоимость;
            Если Разница <> 0 Тогда
                Если Разница > 0 Тогда Корректировка = Движения.ПартииНоменклатуры.ДобавитьПриход(); Иначе Корректировка = Движения.ПартииНоменклатуры.ДобавитьРасход(); КонецЕсли;
                Корректировка.Период = Дата; Корректировка.ДатаПартии = Партия.ДатаПартии; Корректировка.Партия = Партия.Партия; Корректировка.Подразделение = Подразделение; Корректировка.Номенклатура = Товар; Корректировка.Свойство = Свойство; Корректировка.Стоимость = ?(Разница > 0, Разница, -Разница);
            КонецЕсли;
            Партия.Стоимость = НоваяСтоимость; ОстатокСтоимость = ОстатокСтоимость - НоваяСтоимость; ОстатокКоличество = ОстатокКоличество - Партия.Количество;
        КонецЦикла;
    КонецЕсли;
    Надо = Количество; Стоимость = 0; Индекс = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, Партии.Количество()-1, 0); Шаг = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, -1, 1);
    Пока Надо > 0 И Индекс >= 0 И Индекс < Партии.Количество() Цикл
        Партия = Партии[Индекс]; Индекс = Индекс + Шаг;
        Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Взять = Мин(Надо, Партия.Количество);
        Если Взять = Партия.Количество Тогда Сумма = Партия.Стоимость; Иначе Сумма = Окр(Партия.Стоимость * Взять / Партия.Количество, 2); КонецЕсли;
        Движение = Движения.ПартииНоменклатуры.ДобавитьРасход(); Движение.Период = Дата; Движение.ДатаПартии = Партия.ДатаПартии; Движение.Партия = Партия.Партия; Движение.Подразделение = Подразделение; Движение.Номенклатура = Товар; Движение.Свойство = Свойство; Движение.Количество = Взять; Движение.Стоимость = Сумма;
        Партия.Количество = Партия.Количество - Взять; Партия.Стоимость = Партия.Стоимость - Сумма; Стоимость = Стоимость + Сумма; Надо = Надо - Взять;
    КонецЦикла;
    ДвижениеИтог = Движения.ОстаткиНоменклатуры.ДобавитьРасход(); ДвижениеИтог.Период = Дата; ДвижениеИтог.Подразделение = Подразделение; ДвижениеИтог.Номенклатура = Товар; ДвижениеИтог.Свойство = Свойство; ДвижениеИтог.Количество = Количество; ДвижениеИтог.Стоимость = Стоимость;
    Возврат Стоимость;
КонецФункции

Процедура ЗаблокироватьОстатки()
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрНакопления.ПартииНоменклатуры"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПровестиБухРасход(Отказ)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрБухгалтерии.Проводки"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Движения.Проводки.Записывать = Истина; Движения.Проводки.Записать();
    ЗапросСвязей = Новый Запрос("ВЫБРАТЬ Номенклатура, Аналог ИЗ РегистрСведений.АналогиНоменклатуры"); Связи = ЗапросСвязей.Выполнить().Выгрузить();
    ВсеТовары = Новый Массив;
    Для Каждого Строка Из СписокНоменклатуры Цикл Если ВсеТовары.Найти(Строка.Номенклатура) = Неопределено Тогда ВсеТовары.Добавить(Строка.Номенклатура); КонецЕсли; КонецЦикла;
    Индекс = 0;
    Пока Индекс < ВсеТовары.Количество() Цикл
        Текущий = ВсеТовары[Индекс]; Индекс = Индекс + 1;
        Для Каждого Связь Из Связи Цикл
            Другой = Неопределено; Если Связь.Номенклатура = Текущий Тогда Другой = Связь.Аналог; ИначеЕсли Связь.Аналог = Текущий Тогда Другой = Связь.Номенклатура; КонецЕсли;
            Если Другой <> Неопределено И ВсеТовары.Найти(Другой) = Неопределено Тогда ВсеТовары.Добавить(Другой); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Если ВсеТовары.Количество() = 0 Тогда Возврат; КонецЕсли;
    ЗапросАртикулов = Новый Запрос("ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Товары)"); ЗапросАртикулов.УстановитьПараметр("Товары", ВсеТовары); Артикулы = ЗапросАртикулов.Выполнить().Выгрузить();
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура) КАК Товар, ВЫРАЗИТЬ(Остатки.Субконто2 КАК Справочник.Склады) КАК Склад, (Остатки.КоличествоОстатокДт - Остатки.КоличествоОстатокКт) КАК Количество
    |ИЗ РегистрБухгалтерии.Проводки.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 В (&Товары)) КАК Остатки";
    Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склад);
    Запрос.УстановитьПараметр("Момент", МоментВремени()); Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); Запрос.УстановитьПараметр("Виды", Виды); Запрос.УстановитьПараметр("Товары", ВсеТовары);
    Остатки = Запрос.Выполнить().Выгрузить();
    ЗапросСтоимости = Новый Запрос("ВЫБРАТЬ ВЫРАЗИТЬ(Остатки.Субконто1 КАК Справочник.Номенклатура) КАК Товар, (Остатки.СуммаОстатокДт - Остатки.СуммаОстатокКт) КАК Стоимость ИЗ РегистрБухгалтерии.Проводки.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 В (&Товары)) КАК Остатки");
    ВидыСтоимость = Новый Массив; ВидыСтоимость.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    ЗапросСтоимости.УстановитьПараметр("Момент", МоментВремени()); ЗапросСтоимости.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); ЗапросСтоимости.УстановитьПараметр("Виды", ВидыСтоимость); ЗапросСтоимости.УстановитьПараметр("Товары", ВсеТовары); ОстаткиСтоимости = ЗапросСтоимости.Выполнить().Выгрузить();
    Для Каждого Строка Из СписокНоменклатуры Цикл
        Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество <= 0 Тогда Отказ = Истина; Возврат; КонецЕсли;
        Кандидаты = Новый Массив; Кандидаты.Добавить(Строка.Номенклатура); Индекс = 0;
        Пока Индекс < Кандидаты.Количество() Цикл
            Текущий = Кандидаты[Индекс]; Индекс = Индекс + 1;
            Для Каждого Связь Из Связи Цикл
                Другой = Неопределено; Если Связь.Номенклатура = Текущий Тогда Другой = Связь.Аналог; ИначеЕсли Связь.Аналог = Текущий Тогда Другой = Связь.Номенклатура; КонецЕсли;
                Если Другой <> Неопределено И Кандидаты.Найти(Другой) = Неопределено Тогда Кандидаты.Добавить(Другой); КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        Аналоги = Новый ТаблицаЗначений; Аналоги.Колонки.Добавить("Товар"); Аналоги.Колонки.Добавить("Артикул");
        Для Каждого Товар Из Кандидаты Цикл Если Товар <> Строка.Номенклатура Тогда А = Аналоги.Добавить(); А.Товар = Товар; А.Артикул = Артикулы.Найти(Товар, "Ссылка").Артикул; КонецЕсли; КонецЦикла;
        Аналоги.Сортировать("Артикул"); Кандидаты.Очистить(); Кандидаты.Добавить(Строка.Номенклатура); Для Каждого А Из Аналоги Цикл Кандидаты.Добавить(А.Товар); КонецЦикла;
        Осталось = Строка.Количество; ОсталосьВыручки = Строка.Сумма;
        Для Каждого Товар Из Кандидаты Цикл
            Если Осталось <= 0 Тогда Прервать; КонецЕсли;
            СтрокиОстатков = Остатки.НайтиСтроки(Новый Структура("Товар", Товар)); Всего = 0; НаСкладе = Неопределено;
            Для Каждого О Из СтрокиОстатков Цикл Всего = Всего + О.Количество; Если О.Склад = Склад Тогда НаСкладе = О; КонецЕсли; КонецЦикла;
            ОстатокСтоимости = ОстаткиСтоимости.Найти(Товар, "Товар"); СтоимостьВсего = 0; Если ОстатокСтоимости <> Неопределено Тогда СтоимостьВсего = ОстатокСтоимости.Стоимость; КонецЕсли;
            Если НаСкладе = Неопределено Или Всего <= 0 Тогда Продолжить; КонецЕсли;
            Взять = Мин(Осталось, Макс(0, НаСкладе.Количество)); Если Взять = 0 Тогда Продолжить; КонецЕсли;
            Стоимость = ?(Взять = Всего, СтоимостьВсего, Окр(СтоимостьВсего * Взять / Всего, 2)); Выручка = ?(Взять = Осталось, ОсталосьВыручки, Окр(ОсталосьВыручки * Взять / Осталось, 2));
            Д = Движения.Проводки.Добавить(); Д.Период = Дата; Д.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Д.СчетКт = ПланыСчетов.Управленческий.Товары;
            Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Товар; Д.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Склад; Д.КоличествоКт = Взять; Д.Сумма = Стоимость;
            Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураПродажи] = Строка.Номенклатура; Д.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.ФактическиПродано] = Товар;
            ДВыручка = Движения.Проводки.Добавить(); ДВыручка.Период = Дата; ДВыручка.СчетДт = ПланыСчетов.Управленческий.Покупатели; ДВыручка.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; ДВыручка.Сумма = Выручка;
            ДВыручка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураПродажи] = Строка.Номенклатура; ДВыручка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.ФактическиПродано] = Товар;
            НаСкладе.Количество = НаСкладе.Количество - Взять; Если ОстатокСтоимости <> Неопределено Тогда ОстатокСтоимости.Стоимость = ОстатокСтоимости.Стоимость - Стоимость; КонецЕсли; Осталось = Осталось - Взять; ОсталосьВыручки = ОсталосьВыручки - Выручка;
        КонецЦикла;
        Если Осталось > 0 Тогда Отказ = Истина; Сообщить("Недостаточно товара и аналогов: " + Строка.Номенклатура); Возврат; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

