Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    БлокировкаПриПроведении = Новый БлокировкаДанных; ЭлементБлокировки = БлокировкаПриПроведении.Добавить("РегистрНакопления.ПартииНоменклатуры"); ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
    БлокировкаПриПроведении.Заблокировать();
    Движения.ОстаткиНоменклатуры.Записывать = Истина; Движения.ОстаткиНоменклатуры.Очистить(); Движения.ОстаткиНоменклатуры.Записать();
    Движения.ПартииНоменклатуры.Записывать = Истина; Движения.ПартииНоменклатуры.Очистить(); Движения.ПартииНоменклатуры.Записать();
    Если НЕ ЗначениеЗаполнено(ПодразделениеИсточник) Или НЕ ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда Отказ = Истина; Сообщить("Не заполнены подразделения сборки"); Возврат; КонецЕсли;
    ЗаблокироватьОстатки(); Движения.ОстаткиНоменклатуры.Записывать = Истина; Движения.ПартииНоменклатуры.Записывать = Истина;
    Движения.ОстаткиНоменклатуры.Записать(); Движения.ПартииНоменклатуры.Записать();
    Блоки = Новый Массив;
    Для Каждого СтрокаПродукции Из Продукция Цикл
        Если НЕ ЗначениеЗаполнено(СтрокаПродукции.Номенклатура) Или СтрокаПродукции.Количество <= 0 Тогда Отказ = Истина; Возврат; КонецЕсли;
        Если Блоки.Найти(СтрокаПродукции.Номенклатура) = Неопределено Тогда Блоки.Добавить(СтрокаПродукции.Номенклатура); КонецЕсли;
    КонецЦикла;
    Если Блоки.Количество() = 0 Тогда Отказ = Истина; Сообщить("Не указана продукция"); Возврат; КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ История.СистемныйБлок, МАКСИМУМ(История.Период) КАК Период ПОМЕСТИТЬ Даты
    |ИЗ РегистрСведений.Спецификации КАК История ГДЕ История.СистемныйБлок В (&Блоки) И История.Период <= &Дата СГРУППИРОВАТЬ ПО История.СистемныйБлок;
    |ВЫБРАТЬ Состав.СистемныйБлок, Состав.Деталь, Состав.Свойство, Состав.Количество
    |ИЗ РегистрСведений.Спецификации КАК Состав ВНУТРЕННЕЕ СОЕДИНЕНИЕ Даты КАК Даты ПО Состав.СистемныйБлок = Даты.СистемныйБлок И Состав.Период = Даты.Период";
    Запрос.УстановитьПараметр("Дата", Дата); Запрос.УстановитьПараметр("Блоки", Блоки); Состав = Запрос.Выполнить().Выгрузить();
    Товары = Новый Массив;
    Для Каждого СтрокаСостава Из Состав Цикл Если Товары.Найти(СтрокаСостава.Деталь) = Неопределено Тогда Товары.Добавить(СтрокаСостава.Деталь); КонецЕсли; КонецЦикла;
    Для Каждого Деталь Из ДополнительныеДетали Цикл Если Товары.Найти(Деталь.Номенклатура) = Неопределено Тогда Товары.Добавить(Деталь.Номенклатура); КонецЕсли; КонецЦикла;
    Подразделения = Новый Массив; Подразделения.Добавить(ПодразделениеИсточник); ВсеПартии = ЗагрузитьПартии(Товары, Подразделения);
    Себестоимость = Новый Массив; КоличествоПродукции = 0;
    Для Каждого СтрокаПродукции Из Продукция Цикл
        КоличествоПродукции = КоличествоПродукции + СтрокаПродукции.Количество; ЗатратыСтроки = 0;
        СтрокиСостава = Состав.НайтиСтроки(Новый Структура("СистемныйБлок", СтрокаПродукции.Номенклатура));
        Если СтрокиСостава.Количество() = 0 Тогда Отказ = Истина; Сообщить("Не найдена спецификация: " + СтрокаПродукции.Номенклатура); Возврат; КонецЕсли;
        Для Каждого СтрокаСостава Из СтрокиСостава Цикл
            ЗатратыСтроки = ЗатратыСтроки + Списать(ВсеПартии, ПодразделениеИсточник, СтрокаСостава.Деталь, СтрокаСостава.Свойство, СтрокаСостава.Количество * СтрокаПродукции.Количество, Перечисления.УчетнаяПолитика.ПоСредней, Отказ);
            Если Отказ Тогда Возврат; КонецЕсли;
        КонецЦикла;
        Себестоимость.Добавить(ЗатратыСтроки);
    КонецЦикла;
    ДопЗатраты = 0;
    Для Каждого Деталь Из ДополнительныеДетали Цикл
        ДопЗатраты = ДопЗатраты + Списать(ВсеПартии, ПодразделениеИсточник, Деталь.Номенклатура, Деталь.Свойство, Деталь.Количество, Перечисления.УчетнаяПолитика.ПоСредней, Отказ);
        Если Отказ Тогда Возврат; КонецЕсли;
    КонецЦикла;
    Осталось = ДопЗатраты; ОсталосьКоличество = КоличествоПродукции; Индекс = 0;
    Для Каждого СтрокаПродукции Из Продукция Цикл
        Если ОсталосьКоличество = СтрокаПродукции.Количество Тогда Доля = Осталось; Иначе Доля = Окр(Осталось * СтрокаПродукции.Количество / ОсталосьКоличество, 2); КонецЕсли;
        Движение = Движения.ОстаткиНоменклатуры.ДобавитьПриход(); Движение.Период = Дата; Движение.Подразделение = ПодразделениеПолучатель; Движение.Номенклатура = СтрокаПродукции.Номенклатура; Движение.Количество = СтрокаПродукции.Количество; Движение.Стоимость = Себестоимость[Индекс] + Доля;
        Партия = Движения.ПартииНоменклатуры.ДобавитьПриход(); ЗаполнитьЗначенияСвойств(Партия, Движение); Партия.ДатаПартии = Дата; Партия.Партия = Ссылка;
        Осталось = Осталось - Доля; ОсталосьКоличество = ОсталосьКоличество - СтрокаПродукции.Количество; Индекс = Индекс + 1;
    КонецЦикла;
КонецПроцедуры

Функция ЗагрузитьПартии(Товары, Подразделения)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Остатки.Подразделение, Остатки.Номенклатура, Остатки.Свойство, Остатки.ДатаПартии, Остатки.Партия, Остатки.КоличествоОстаток КАК Количество, Остатки.СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(&Момент, Номенклатура В (&Товары) И Подразделение В (&Подразделения)) КАК Остатки
    |ГДЕ Остатки.КоличествоОстаток > 0 УПОРЯДОЧИТЬ ПО Остатки.ДатаПартии, Остатки.Партия.МоментВремени";
    Запрос.УстановитьПараметр("Момент", МоментВремени()); Запрос.УстановитьПараметр("Товары", Товары); Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Списать(ВсеПартии, Подразделение, Товар, Свойство, Количество, Метод, Отказ)
    Партии = ВсеПартии.НайтиСтроки(Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство));
    Остаток = 0; СтоимостьВсего = 0;
    Для Каждого Партия Из Партии Цикл Остаток = Остаток + Партия.Количество; СтоимостьВсего = СтоимостьВсего + Партия.Стоимость; КонецЦикла;
    Если Количество <= 0 Или Остаток < Количество Тогда Отказ = Истина; Сообщить("Недостаточно остатка или некорректное количество: " + Товар); Возврат 0; КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.ПоСредней И Партии.Количество() > 1 Тогда
        ОстатокСтоимость = СтоимостьВсего; ОстатокКоличество = Остаток;
        Для Каждого Партия Из Партии Цикл
            Если Партия.Количество = 0 Тогда Продолжить; КонецЕсли;
            Если Партия.Количество = ОстатокКоличество Тогда НоваяСтоимость = ОстатокСтоимость;
            Иначе НоваяСтоимость = Окр(ОстатокСтоимость * Партия.Количество / ОстатокКоличество, 2); КонецЕсли;
            Разница = НоваяСтоимость - Партия.Стоимость;
            Если Разница <> 0 Тогда
                Если Разница > 0 Тогда Корректировка = Движения.ПартииНоменклатуры.ДобавитьПриход(); Иначе Корректировка = Движения.ПартииНоменклатуры.ДобавитьРасход(); КонецЕсли;
                Корректировка.Период = Дата; Корректировка.ДатаПартии = Партия.ДатаПартии; Корректировка.Партия = Партия.Партия; Корректировка.Подразделение = Подразделение; Корректировка.Номенклатура = Товар; Корректировка.Свойство = Свойство; Корректировка.Стоимость = ?(Разница > 0, Разница, -Разница);
            КонецЕсли;
            Партия.Стоимость = НоваяСтоимость; ОстатокСтоимость = ОстатокСтоимость - НоваяСтоимость; ОстатокКоличество = ОстатокКоличество - Партия.Количество;
        КонецЦикла;
    КонецЕсли;
    Надо = Количество; Стоимость = 0; Индекс = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, Партии.Количество()-1, 0); Шаг = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, -1, 1);
    Пока Надо > 0 И Индекс >= 0 И Индекс < Партии.Количество() Цикл
        Партия = Партии[Индекс]; Индекс = Индекс + Шаг;
        Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Взять = Мин(Надо, Партия.Количество);
        Если Взять = Партия.Количество Тогда Сумма = Партия.Стоимость; Иначе Сумма = Окр(Партия.Стоимость * Взять / Партия.Количество, 2); КонецЕсли;
        Движение = Движения.ПартииНоменклатуры.ДобавитьРасход(); Движение.Период = Дата; Движение.ДатаПартии = Партия.ДатаПартии; Движение.Партия = Партия.Партия; Движение.Подразделение = Подразделение; Движение.Номенклатура = Товар; Движение.Свойство = Свойство; Движение.Количество = Взять; Движение.Стоимость = Сумма;
        Партия.Количество = Партия.Количество - Взять; Партия.Стоимость = Партия.Стоимость - Сумма; Стоимость = Стоимость + Сумма; Надо = Надо - Взять;
    КонецЦикла;
    ДвижениеИтог = Движения.ОстаткиНоменклатуры.ДобавитьРасход(); ДвижениеИтог.Период = Дата; ДвижениеИтог.Подразделение = Подразделение; ДвижениеИтог.Номенклатура = Товар; ДвижениеИтог.Свойство = Свойство; ДвижениеИтог.Количество = Количество; ДвижениеИтог.Стоимость = Стоимость;
    Возврат Стоимость;
КонецФункции

Процедура ЗаблокироватьОстатки()
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрНакопления.ПартииНоменклатуры"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
КонецПроцедуры
