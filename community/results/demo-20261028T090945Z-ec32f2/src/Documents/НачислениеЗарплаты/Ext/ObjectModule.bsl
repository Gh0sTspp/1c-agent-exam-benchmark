    |ИЗ РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(Регистратор = &Регистратор) КАК График";
    Запрос.УстановитьПараметр("Регистратор", Ссылка);
    ДанныеГрафика = Запрос.Выполнить().Выбрать();
    ЗапросКоррекций = Новый Запрос("ВЫБРАТЬ СтрокаИсточника, ПериодРегистрации, СУММА(ЧасыСторно) КАК Часы ИЗ РегистрРасчета.ОсновныеНачисления ГДЕ Сторно И Активность И РегистраторИсточника = &Регистратор СГРУППИРОВАТЬ ПО СтрокаИсточника, ПериодРегистрации"); ЗапросКоррекций.УстановитьПараметр("Регистратор", Ссылка); Коррекции = ЗапросКоррекций.Выполнить().Выгрузить();
    ЗапросСтавок = Новый Запрос("ВЫБРАТЬ Сотрудник, Подразделение, Период, Оклад ИЗ РегистрСведений.СведенияОСотрудниках ГДЕ Сотрудник В (&Сотрудники) И Подразделение В (&Подразделения) И Период <= &Дата УПОРЯДОЧИТЬ ПО Период УБЫВ");
    ЗапросСтавок.УстановитьПараметр("Сотрудники", Сотрудники); ЗапросСтавок.УстановитьПараметр("Подразделения", Подразделения); ЗапросСтавок.УстановитьПараметр("Дата", МаксимальныйМесяц); Ставки = ЗапросСтавок.Выполнить().Выгрузить();
    ЗапросСтажа = Новый Запрос("ВЫБРАТЬ Ссылка, НачалоСтажа ИЗ Справочник.ФизическиеЛица ГДЕ Ссылка В (&Сотрудники)"); ЗапросСтажа.УстановитьПараметр("Сотрудники", Сотрудники); СтажСотрудников = ЗапросСтажа.Выполнить().Выгрузить();
    Шкала = Новый Запрос("ВЫБРАТЬ СтажЛет, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО СтажЛет УБЫВ"); Шкала = Шкала.Выполнить().Выгрузить();
    Пока ДанныеГрафика.Следующий() Цикл
        Запись = Движения.ОсновныеНачисления[ДанныеГрафика.НомерСтроки - 1];
        Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
