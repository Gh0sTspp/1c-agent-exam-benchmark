        КонецЕсли;
    КонецЦикла;
    Движения.ОсновныеНачисления.Записать();
    Измерения = Новый Массив; Измерения.Добавить("Подразделение");
    БазаПодразделения = ПолучитьБазу(Измерения, Ложь);
    Измерения.Добавить("Сотрудник"); БазаСотрудникаПодразделения = ПолучитьБазу(Измерения, Ложь);
    Измерения = Новый Массив; Измерения.Добавить("Сотрудник"); БазаСотрудника = ПолучитьБазу(Измерения, Ложь);
    ЗапросДней = Новый Запрос("ВЫБРАТЬ Данные.Сотрудник, Данные.ПериодДействияНачало, ЕСТЬNULL(Данные.ДниФактическийПериодДействия, 0) КАК Дни ИЗ РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(Сотрудник В (&Сотрудники) И ВидРасчета = &Вид И ПериодДействия МЕЖДУ &Начало И &Конец И НЕ Сторно) КАК Данные");
    ЗапросДней.УстановитьПараметр("Начало", ДобавитьМесяц(МинимальныйМесяц,-3)); ЗапросДней.УстановитьПараметр("Конец", КонецМесяца(МаксимальныйМесяц)); ЗапросДней.УстановитьПараметр("Сотрудники", Сотрудники); ЗапросДней.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Оклад); ДниИстории = ЗапросДней.Выполнить().Выгрузить();
    ЗапросСторноДней = Новый Запрос("ВЫБРАТЬ Сотрудник, ПериодДействияНачало, ДниСторно ИЗ РегистрРасчета.ОсновныеНачисления ГДЕ Сотрудник В (&Сотрудники) И ВидРасчета = &Вид И Сторно И Активность И ПериодРегистрации > ПериодИсточника И ПериодДействияНачало >= &Начало И ПериодДействияНачало <= &Конец");
    ЗапросСторноДней.УстановитьПараметр("Сотрудники", Сотрудники); ЗапросСторноДней.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Оклад); ЗапросСторноДней.УстановитьПараметр("Начало", ДобавитьМесяц(МинимальныйМесяц,-3)); ЗапросСторноДней.УстановитьПараметр("Конец", КонецМесяца(МаксимальныйМесяц)); СторноДней = ЗапросСторноДней.Выполнить().Выгрузить();
    ДанныеГрафика.Сбросить();
    Пока ДанныеГрафика.Следующий() Цикл
        Запись = Движения.ОсновныеНачисления[ДанныеГрафика.НомерСтроки - 1];
        Месяц = НачалоМесяца(Запись.ПериодДействияНачало);
        Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
