Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Блокировка = Новый БлокировкаДанных; ЭлементБлокировки = Блокировка.Добавить("РегистрРасчета.ОсновныеНачисления"); ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    СтарыеПоездки = ПолучитьПоездкиДокумента(); ЗависимыеПриИзменении = Неопределено;
    Если СтарыеПоездки.Количество() > 0 И ПоездкиИзменились(СтарыеПоездки) Тогда ЗависимыеПриИзменении = ПолучитьЗависимыеНачисления(); КонецЕсли;
    Движения.ОсновныеНачисления.Записывать = Истина; Движения.ОсновныеНачисления.Очистить(); Движения.ОсновныеНачисления.Записать();
    Сотрудники = Новый Массив; Подразделения = Новый Массив; МинимальныйМесяц = Неопределено; МаксимальныйМесяц = Неопределено;
    Для Каждого Строка Из ОсновныеНачисления Цикл
        Если НЕ ЗначениеЗаполнено(Строка.Сотрудник) Или НЕ ЗначениеЗаполнено(Строка.Подразделение) Или НЕ ЗначениеЗаполнено(Строка.ВидРасчета) Или НЕ ЗначениеЗаполнено(Строка.ДатаНачала) Или НЕ ЗначениеЗаполнено(Строка.ДатаОкончания) Или Строка.ДатаНачала > Строка.ДатаОкончания Тогда Отказ = Истина; Сообщить("Некорректная строка начисления"); Возврат; КонецЕсли;
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Оклад И Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия И Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Отказ = Истина; Сообщить("Неизвестный вид начисления"); Возврат; КонецЕсли;
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда Отказ = Истина; Сообщить("Тариф и премия вводятся в пределах месяца"); Возврат; КонецЕсли;
        Если Сотрудники.Найти(Строка.Сотрудник) = Неопределено Тогда Сотрудники.Добавить(Строка.Сотрудник); КонецЕсли;
        Если Подразделения.Найти(Строка.Подразделение) = Неопределено Тогда Подразделения.Добавить(Строка.Подразделение); КонецЕсли;
        МесяцСтроки = НачалоМесяца(Строка.ДатаНачала);
        Если МинимальныйМесяц = Неопределено Или МесяцСтроки < МинимальныйМесяц Тогда МинимальныйМесяц = МесяцСтроки; КонецЕсли;
        Если МаксимальныйМесяц = Неопределено Или МесяцСтроки > МаксимальныйМесяц Тогда МаксимальныйМесяц = МесяцСтроки; КонецЕсли;
        Начало = НачалоДня(Строка.ДатаНачала);
        Пока Начало <= Строка.ДатаОкончания Цикл
            Конец = Мин(КонецМесяца(Начало), КонецДня(Строка.ДатаОкончания));
            Д = Движения.ОсновныеНачисления.Добавить();
            Д.ПериодРегистрации = Макс(НачалоМесяца(Начало), НачалоМесяца(Дата));
            Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка И Д.ПериодРегистрации = НачалоМесяца(Начало) Тогда Д.ПериодРегистрации = ДобавитьМесяц(Д.ПериодРегистрации, 1); КонецЕсли; Д.ПериодДействияНачало = Начало; Д.ПериодДействияКонец = Конец;
            Д.Сотрудник = Строка.Сотрудник; Д.Подразделение = Строка.Подразделение; Д.ВидРасчета = Строка.ВидРасчета; Д.НачалоКомандировки = Строка.ДатаНачала;
            Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1); Д.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            ИначеЕсли Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
                Д.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Строка.ДатаНачала), -3); Д.БазовыйПериодКонец = НачалоМесяца(Строка.ДатаНачала) - 1;
            КонецЕсли;
            Начало = НачалоДня(Конец + 1);
        КонецЦикла;
    КонецЦикла;
