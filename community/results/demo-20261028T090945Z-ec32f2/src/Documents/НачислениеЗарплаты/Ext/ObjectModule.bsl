                Стаж = Год(Месяц) - Год(ДатаСтажа); Если ДобавитьМесяц(ДатаСтажа, Стаж * 12) > Месяц Тогда Стаж = Стаж - 1; КонецЕсли;
                Запись.СтажЛет = Стаж; Запись.ПроцентПремии = 0;
                Для Каждого СтрокаШкалы Из Шкала Цикл Если СтрокаШкалы.СтажЛет <= Стаж Тогда Запись.ПроцентПремии = СтрокаШкалы.Процент; Прервать; КонецЕсли; КонецЦикла;
                Запись.БазаПремии = ЗначениеБазы(БазаПодразделения, ДанныеГрафика.НомерСтроки) - ЗначениеБазы(БазаСотрудникаПодразделения, ДанныеГрафика.НомерСтроки);
            КонецЕсли;
            Если Запись.НормаЧасов > 0 Тогда Запись.Результат = Окр(Запись.БазаПремии * Запись.ПроцентПремии / 100 * ?(Запись.Сторно, Запись.ЧасыСторно, ЧасыФакт) / Запись.НормаЧасов * ?(Запись.Сторно, -1, 1), 2); КонецЕсли;
        ИначеЕсли Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
            Месяц = НачалоМесяца(Запись.НачалоКомандировки);
            СуммаБазы = ЗначениеБазы(БазаСотрудника, ДанныеГрафика.НомерСтроки);
            Дней = 0;
            Для Каждого ДеньИстории Из ДниИстории.НайтиСтроки(Новый Структура("Сотрудник", Запись.Сотрудник)) Цикл
                Если ДеньИстории.ПериодДействияНачало >= ДобавитьМесяц(Месяц,-3) И ДеньИстории.ПериодДействияНачало < Месяц Тогда Дней = Дней + ДеньИстории.Дни; КонецЕсли;
            КонецЦикла;
            Для Каждого СторноИстории Из СторноДней.НайтиСтроки(Новый Структура("Сотрудник", Запись.Сотрудник)) Цикл
                Если СторноИстории.ПериодДействияНачало >= ДобавитьМесяц(Месяц,-3) И СторноИстории.ПериодДействияНачало < Месяц Тогда Дней = Дней - СторноИстории.ДниСторно; КонецЕсли;
            КонецЦикла;
            Если Дней > 0 Тогда Запись.Результат = Окр(СуммаБазы / Дней * ДанныеГрафика.ДниФакт, 2); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Движения.ОсновныеНачисления.Записать();
    ПерепровестиЗависимые(ЗависимыеПриИзменении);
КонецПроцедуры

Функция ПолучитьБазу(Измерения, НеИспользуется)
    Запрос = Новый Запрос("ВЫБРАТЬ База.НомерСтроки КАК НомерСтроки, СУММА(База.РезультатБаза) КАК Сумма ИЗ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(&Измерения, &Измерения, , Регистратор = &Регистратор) КАК База СГРУППИРОВАТЬ ПО База.НомерСтроки");
    Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Регистратор", Ссылка); Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
Функция ЗначениеБазы(Таблица, НомерСтроки)
    Строка = Таблица.Найти(НомерСтроки, "НомерСтроки"); Если Строка = Неопределено Или Строка.Сумма = NULL Тогда Возврат 0; КонецЕсли; Возврат Строка.Сумма;
КонецФункции
Функция ПолучитьПоездкиДокумента()
    Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник, Подразделение, ПериодДействияНачало КАК Начало, ПериодДействияКонец КАК Конец ИЗ РегистрРасчета.ОсновныеНачисления ГДЕ Регистратор = &Регистратор И ВидРасчета = &Вид И НЕ Сторно И Активность");
    Запрос.УстановитьПараметр("Регистратор", Ссылка); Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка); Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция ПоездкиИзменились(Старые)
    Новые = Старые.Скопировать(); Новые.Очистить();
    Для Каждого Строка Из ОсновныеНачисления Цикл
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Или НЕ ЗначениеЗаполнено(Строка.ДатаНачала) Или НЕ ЗначениеЗаполнено(Строка.ДатаОкончания) Или Строка.ДатаНачала > Строка.ДатаОкончания Тогда Продолжить; КонецЕсли;
        Начало = НачалоДня(Строка.ДатаНачала);
        Пока Начало <= Строка.ДатаОкончания Цикл
            Конец = Мин(КонецМесяца(Начало), КонецДня(Строка.ДатаОкончания)); Запись = Новые.Добавить(); Запись.Сотрудник = Строка.Сотрудник; Запись.Подразделение = Строка.Подразделение; Запись.Начало = Начало; Запись.Конец = Конец; Начало = НачалоДня(Конец + 1);
        КонецЦикла;
    КонецЦикла;
    Если Старые.Количество() <> Новые.Количество() Тогда Возврат Истина; КонецЕсли;
    Для Каждого Старая Из Старые Цикл
        Найденные = Новые.НайтиСтроки(Новый Структура("Сотрудник,Подразделение,Начало,Конец", Старая.Сотрудник, Старая.Подразделение, Старая.Начало, Старая.Конец));
        Если Найденные.Количество() = 0 Тогда Возврат Истина; КонецЕсли; Новые.Удалить(Найденные[0]);
    КонецЦикла;
    Возврат Ложь;
КонецФункции

Функция ПолучитьЗависимыеНачисления()
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Начисления.Регистратор КАК Документ
    |ИЗ РегистрРасчета.ОсновныеНачисления КАК Поездки ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления КАК Начисления
    | ПО Начисления.Сотрудник = Поездки.Сотрудник И Начисления.Подразделение = Поездки.Подразделение И Начисления.ПериодДействияНачало <= Поездки.ПериодДействияКонец И Начисления.ПериодДействияКонец >= Поездки.ПериодДействияНачало
    |ГДЕ Поездки.Регистратор = &Регистратор И Поездки.ВидРасчета = &Командировка И НЕ Поездки.Сторно И Начисления.Регистратор <> &Регистратор И НЕ Начисления.Сторно И Начисления.ВидРасчета В (&Виды)");
    Виды = Новый Массив; Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Оклад); Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Премия);
    Запрос.УстановитьПараметр("Регистратор", Ссылка); Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка); Запрос.УстановитьПараметр("Виды", Виды); Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ПерепровестиЗависимые(Зависимые)
    Если Зависимые = Неопределено Тогда Возврат; КонецЕсли;
    Для Каждого Строка Из Зависимые Цикл
        ДокументОбъект = Строка.Документ.ПолучитьОбъект();
        Если ДокументОбъект <> Неопределено И ДокументОбъект.Проведен Тогда ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрРасчета.ОсновныеНачисления"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
    Зависимые = ПолучитьЗависимыеНачисления(); Если Зависимые.Количество() = 0 Тогда Возврат; КонецЕсли;
    Движения.ОсновныеНачисления.Записывать = Истина; Движения.ОсновныеНачисления.Очистить(); Движения.ОсновныеНачисления.Записать();
    ПерепровестиЗависимые(Зависимые);
КонецПроцедуры
