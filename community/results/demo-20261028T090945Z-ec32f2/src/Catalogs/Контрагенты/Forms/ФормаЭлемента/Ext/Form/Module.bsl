&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ОбновитьПоля();
КонецПроцедуры
&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
    ОбновитьПоля();
КонецПроцедуры
&НаСервере
Функция ИмяПоля(Вид)
    Возврат "ДопПоле" + СтрЗаменить(Строка(Вид.УникальныйИдентификатор()), "-", "");
КонецФункции
&НаСервере
Процедура СохранитьПоляВФорму()
    Для Каждого Строка Из Объект.ДополнительныеСведения Цикл
        Если ЗначениеЗаполнено(Строка.ВидСведения) Тогда
            Имя = ИмяПоля(Строка.ВидСведения);
            Если Элементы.Найти(Имя) <> Неопределено Тогда Строка.Значение = ЭтотОбъект[Имя]; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
&НаСервере
Процедура ОбновитьПоля()
    СохранитьПоляВФорму();
    УдалитьРеквизиты = Новый Массив;
    Для Каждого Строка Из Объект.ДополнительныеСведения Цикл
        Если ЗначениеЗаполнено(Строка.ВидСведения) Тогда
            Имя = ИмяПоля(Строка.ВидСведения); Поле = Элементы.Найти(Имя);
            Если Поле <> Неопределено Тогда Элементы.Удалить(Поле); УдалитьРеквизиты.Добавить(Имя); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если УдалитьРеквизиты.Количество() > 0 Тогда ИзменитьРеквизиты(, УдалитьРеквизиты); КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    МенеджерОбъект = Объект.Менеджер.ПолучитьОбъект();
    Если МенеджерОбъект = Неопределено Тогда Возврат; КонецЕсли;
    ДобавитьРеквизиты = Новый Массив; Виды = Новый Массив;
    Для Каждого Сведения Из МенеджерОбъект.ДополнительныеРеквизиты Цикл
        Вид = Сведения.ВидСведения;
        Если НЕ ЗначениеЗаполнено(Вид) Или Виды.Найти(Вид) <> Неопределено Тогда Продолжить; КонецЕсли;
        Виды.Добавить(Вид); Имя = ИмяПоля(Вид);
        ДобавитьРеквизиты.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения));
    КонецЦикла;
    Если ДобавитьРеквизиты.Количество() > 0 Тогда ИзменитьРеквизиты(ДобавитьРеквизиты); КонецЕсли;
    Для Каждого Вид Из Виды Цикл
        Имя = ИмяПоля(Вид); Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.Менеджер.Родитель);
        Поле.Вид = ВидПоляФормы.ПолеВвода; Поле.ПутьКДанным = Имя; Поле.Заголовок = Строка(Вид);
        Найденная = Неопределено;
        Для Каждого Строка Из Объект.ДополнительныеСведения Цикл Если Строка.ВидСведения = Вид Тогда Найденная = Строка; Прервать; КонецЕсли; КонецЦикла;
        Если Найденная = Неопределено Тогда Найденная = Объект.ДополнительныеСведения.Добавить(); Найденная.ВидСведения = Вид; КонецЕсли;
        Если Найденная.Значение <> Неопределено Тогда ЭтотОбъект[Имя] = Найденная.Значение; КонецЕсли;
    КонецЦикла;
КонецПроцедуры
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьПоляВФорму();
    ТекущийОбъект.ДополнительныеСведения.Очистить();
    Для Каждого Строка Из Объект.ДополнительныеСведения Цикл
        Новая = ТекущийОбъект.ДополнительныеСведения.Добавить(); Новая.ВидСведения = Строка.ВидСведения; Новая.Значение = Строка.Значение;
    КонецЦикла;
КонецПроцедуры

