    Спецификация = РегистрыСведений.Спецификации.СоздатьНаборЗаписей(); Спецификация.Отбор.СистемныйБлок.Установить(Блок); Запись = Спецификация.Добавить(); Запись.Период = Дата(2024,1,1); Запись.СистемныйБлок = Блок; Запись.Деталь = Товар; Запись.Свойство = Свойство; Запись.Количество = 1; Спецификация.Записать();
    Сборка = Документы.Сборка.СоздатьДокумент(); Сборка.Дата = Дата(2024,1,14,12,0,0); Сборка.ПодразделениеИсточник = Подразделение; Сборка.ПодразделениеПолучатель = Подразделение; Строка = Сборка.Продукция.Добавить(); Строка.Номенклатура = Блок; Строка.Количество = 1; Сборка.Записать(РежимЗаписиДокумента.Проведение);
    НаборПремий = РегистрыСведений.ШкалаПремий.СоздатьНаборЗаписей(); НаборПремий.Отбор.СтажЛет.Установить(0); Запись = НаборПремий.Добавить(); Запись.СтажЛет = 0; Запись.Процент = 5; НаборПремий.Записать();
