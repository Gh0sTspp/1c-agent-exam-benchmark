КонецПроцедуры


Функция ПодготовитьФорму() Экспорт
    Вид = ПланыВидовХарактеристик.ДополнительныеСведения.НайтиПоНаименованию("Срок кредита");
    Если Вид.Пустая() Тогда
        В = ПланыВидовХарактеристик.ДополнительныеСведения.СоздатьЭлемент(); В.Наименование = "Срок кредита"; В.ТипЗначения = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)); В.Записать(); Вид = В.Ссылка;
    КонецЕсли;
    Сотрудник = Справочники.ФизическиеЛица.НайтиПоНаименованию("Демо сотрудник"); С = Сотрудник.ПолучитьОбъект(); С.ДополнительныеРеквизиты.Очистить(); С.ДополнительныеРеквизиты.Добавить().ВидСведения = Вид; С.Записать();
    Контрагент = Справочники.Контрагенты.НайтиПоНаименованию("Демо контрагент");
    Если Контрагент.Пустая() Тогда К = Справочники.Контрагенты.СоздатьЭлемент(); К.Наименование = "Демо контрагент"; К.Менеджер = Сотрудник; К.Записать(); Контрагент = К.Ссылка; КонецЕсли;
    Возврат Контрагент;
КонецФункции


