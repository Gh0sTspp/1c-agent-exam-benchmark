&НаКлиенте
Процедура Сформировать(Команда) Экспорт
    СформироватьНаСервере();
КонецПроцедуры
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Начало = НачалоМесяца(ТекущаяДата()); Конец = КонецМесяца(Начало);
КонецПроцедуры
&НаСервере
Процедура Ячейка(СтрокаНомер, Колонка, Значение)
    Результат.Область(СтрокаНомер, Колонка).Текст = Строка(Значение);
КонецПроцедуры
&НаСервере
Процедура СформироватьНаСервере()
    Данные = Отчеты.ПродажиБухгалтерские.СформироватьДанные(НачалоДня(Начало), КонецДня(Конец));
    Данные.Сортировать("Номенклатура, Продано"); Результат.Очистить();
    Заголовки = СтрРазделить("Номенклатура|Продано|Количество|Себестоимость|Продажа|Прибыль", "|");
    Для Н = 0 По Заголовки.Количество()-1 Цикл Ячейка(1, Н+1, Заголовки[Н]); КонецЦикла;
    Номер = 1; Текущий = Неопределено; СтрокаГруппы = 0; Кол = 0; Себ = 0; Продажа = 0; Прибыль = 0;
    Для Каждого Запись Из Данные Цикл
        Если Текущий <> Запись.Номенклатура Тогда
            Если СтрокаГруппы > 0 Тогда ЗаполнитьИтог(СтрокаГруппы, Кол, Себ, Продажа, Прибыль); КонецЕсли;
            Номер = Номер + 1; СтрокаГруппы = Номер; Текущий = Запись.Номенклатура; Ячейка(Номер, 1, Текущий);
            Кол = 0; Себ = 0; Продажа = 0; Прибыль = 0;
        КонецЕсли;
        Номер = Номер + 1; Ячейка(Номер, 2, Запись.Продано); ЗаполнитьИтог(Номер, Запись.Количество, Запись.Себестоимость, Запись.Продажа, Запись.Прибыль);
        Кол = Кол + Запись.Количество; Себ = Себ + Запись.Себестоимость; Продажа = Продажа + Запись.Продажа; Прибыль = Прибыль + Запись.Прибыль;
    КонецЦикла;
    Если СтрокаГруппы > 0 Тогда ЗаполнитьИтог(СтрокаГруппы, Кол, Себ, Продажа, Прибыль); КонецЕсли;
КонецПроцедуры
&НаСервере
Процедура ЗаполнитьИтог(Номер, Кол, Себ, Продажа, Прибыль)
    Ячейка(Номер, 3, Кол); Ячейка(Номер, 4, Себ); Ячейка(Номер, 5, Продажа); Ячейка(Номер, 6, Прибыль);
КонецПроцедуры
