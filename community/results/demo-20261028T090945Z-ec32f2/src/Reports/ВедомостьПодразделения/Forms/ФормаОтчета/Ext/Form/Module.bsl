&НаКлиенте
Процедура Сформировать(Команда) Экспорт
    СформироватьНаСервере();
КонецПроцедуры
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    Начало = НачалоМесяца(ТекущаяДата()); Конец = КонецМесяца(Начало);
КонецПроцедуры
&НаСервере
Процедура Ячейка(СтрокаНомер, Колонка, Значение)
    Если Значение = NULL Тогда Возврат; КонецЕсли;
    Результат.Область(СтрокаНомер, Колонка).Текст = Строка(Значение);
КонецПроцедуры
&НаСервере
Процедура СформироватьНаСервере()
    Данные = Отчеты.ВедомостьПодразделения.СформироватьДанные(НачалоДня(Начало), КонецДня(Конец), Подразделение);
    Данные.Сортировать("Характеристика, Номенклатура"); Результат.Очистить();
    Заголовки = СтрРазделить("Характеристика|Товар|Начальный остаток|Приход|Расход|Конечный остаток", "|");
    Для Н = 0 По Заголовки.Количество()-1 Цикл Ячейка(1, Н+1, Заголовки[Н]); КонецЦикла;
    Номер = 1; Текущий = Неопределено;
    Для Каждого Запись Из Данные Цикл
        Если ЗначениеЗаполнено(ВидХарактеристики) И Запись.ВидХарактеристики <> ВидХарактеристики Тогда Продолжить; КонецЕсли;
        Если Текущий <> Запись.Характеристика Тогда Номер = Номер + 1; Ячейка(Номер, 1, Запись.Характеристика); Текущий = Запись.Характеристика; КонецЕсли;
        Номер = Номер + 1; Ячейка(Номер, 2, Запись.Номенклатура);
        Ячейка(Номер, 3, Запись.НачалоКоличество); Ячейка(Номер, 4, Запись.ПриходКоличество); Ячейка(Номер, 5, Запись.РасходКоличество); Ячейка(Номер, 6, Запись.КонецКоличество);
        Номер = Номер + 1; Ячейка(Номер, 3, Запись.НачалоСтоимость); Ячейка(Номер, 4, Запись.ПриходСтоимость); Ячейка(Номер, 5, Запись.РасходСтоимость); Ячейка(Номер, 6, Запись.КонецСтоимость);
    КонецЦикла;
КонецПроцедуры
