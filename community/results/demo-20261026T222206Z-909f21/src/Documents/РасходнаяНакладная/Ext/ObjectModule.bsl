Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если СписокНоменклатуры.Количество() = 0 Тогда Отказ = Истина; Сообщить("Табличная часть пуста"); Возврат; КонецЕсли;
    КлючиОУ = Учет.КлючиОперативногоУчета(); КлючиБУ = Учет.КлючиБухгалтерии();
    Группы = Новый Соответствие; ТоварыБУ = Новый Массив;
    Если ЗначениеЗаполнено(Склад) Тогда
        БлокировкаАналогов = Новый БлокировкаДанных; Элемент = БлокировкаАналогов.Добавить("РегистрСведений.Аналоги"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый; БлокировкаАналогов.Заблокировать();
        Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, Номенклатура.Артикул КАК АртикулНоменклатуры, Аналог, Аналог.Артикул КАК АртикулАналога ИЗ РегистрСведений.Аналоги"); Связи = Запрос.Выполнить().Выгрузить();
        Артикулы = Новый Соответствие;
        Для Каждого Связь Из Связи Цикл Артикулы.Вставить(Связь.Номенклатура, Связь.АртикулНоменклатуры); Артикулы.Вставить(Связь.Аналог, Связь.АртикулАналога); КонецЦикла;
    КонецЕсли;
    Для Каждого Стр Из СписокНоменклатуры Цикл
        ПодрСтроки = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Подразделение);
        Если ЗначениеЗаполнено(ПодрСтроки) Тогда Ключ = КлючиОУ.Добавить(); Ключ.Подразделение = ПодрСтроки; Ключ.Номенклатура = Стр.Номенклатура; Ключ.Свойство = Стр.Свойство; КонецЕсли;
        Если ЗначениеЗаполнено(Склад) И Группы.Получить(Стр.Номенклатура) = Неопределено Тогда
            Группа = Учет.ГруппаАналогов(Стр.Номенклатура, Связи, Артикулы); Группы.Вставить(Стр.Номенклатура, Группа);
            Для Каждого Товар Из Группа Цикл Если ТоварыБУ.Найти(Товар) = Неопределено Тогда ТоварыБУ.Добавить(Товар); Ключ = КлючиБУ.Добавить(); Ключ.Номенклатура = Товар; КонецЕсли; КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Учет.ДобавитьСтарыеКлючи(Движения, КлючиОУ, КлючиБУ);
    Учет.ЗаблокироватьОстатки(КлючиОУ, КлючиБУ);
    Движения.ОстаткиТоваров.Записывать = Истина; Движения.ОстаткиПодразделений.Записывать = Истина; Движения.Проводки.Записывать = Истина; Движения.Продажи.Записывать = Истина;
    Движения.ОстаткиТоваров.Записать(); Движения.ОстаткиПодразделений.Записать(); Движения.Проводки.Записать(); Движения.Продажи.Записать();
    Если ЗначениеЗаполнено(Склад) Тогда Остатки = Учет.ОстаткиБухгалтерии(Новый Граница(Дата, ВидГраницы.Включая), ТоварыБУ); КонецЕсли;
    ПартииОУ = Учет.ЗагрузитьПартии(Новый Граница(Дата, ВидГраницы.Включая), КлючиОУ);
    Политики = Учет.Политики(Дата, КлючиОУ);
    Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
        Если Не ЗначениеЗаполнено(СтрокаТовара.Номенклатура) Тогда Отказ = Истина; Сообщить("Не заполнена номенклатура"); Продолжить; КонецЕсли;
        Если СтрокаТовара.Количество <= 0 Тогда Отказ = Истина; Сообщить("Количество должно быть положительным"); Продолжить; КонецЕсли;
        Подр = ?(ЗначениеЗаполнено(СтрокаТовара.Подразделение), СтрокаТовара.Подразделение, Подразделение);
        Если Не ЗначениеЗаполнено(Подр) И Не ЗначениеЗаполнено(Склад) Тогда Отказ = Истина; Сообщить("Укажите склад или подразделение"); Продолжить; КонецЕсли;
        Если ЗначениеЗаполнено(Подр) Тогда
            Метод = Политики.Получить(Подр); Если Метод = Неопределено Или Не ЗначениеЗаполнено(Метод) Тогда Метод = Перечисления.УчетнаяПолитика.ПоСредней; КонецЕсли;
            Партии = Учет.СписатьПартииИзПамяти(ПартииОУ, Подр, СтрокаТовара.Номенклатура, СтрокаТовара.Свойство, СтрокаТовара.Количество, Метод, Отказ);
            Если Не Отказ Тогда
                Учет.ЗаписатьСписаниеОУ(Движения, Дата, Подр, СтрокаТовара.Номенклатура, СтрокаТовара.Свойство, Партии);
                Продажа = Движения.Продажи.Добавить(); Продажа.Период = Дата; Продажа.Подразделение = Подр;
                Продажа.Номенклатура = СтрокаТовара.Номенклатура; Продажа.Продано = СтрокаТовара.Номенклатура;
                Продажа.Количество = СтрокаТовара.Количество; Продажа.Стоимость = Партии.Итог("Стоимость"); Продажа.Выручка = СтрокаТовара.Сумма;
            КонецЕсли;
        КонецЕсли;
        Если ЗначениеЗаполнено(Склад) Тогда
            Осталось = СтрокаТовара.Количество; ОсталосьВыручки = СтрокаТовара.Сумма;
            Для Каждого Кандидат Из Группы.Получить(СтрокаТовара.Номенклатура) Цикл
                Если Осталось <= 0 Тогда Прервать; КонецЕсли;
                КолВо = 0; Стоимость = 0; СкладскаяСтрока = Неопределено;
                Для Каждого ЗаписьОстатка Из Остатки Цикл
                    Если ЗаписьОстатка.Номенклатура = Кандидат Тогда
                        КолВо = КолВо + ЗаписьОстатка.Количество; Стоимость = Стоимость + ЗаписьОстатка.Стоимость;
                        Если ЗаписьОстатка.Склад = Склад Тогда СкладскаяСтрока = ЗаписьОстатка; КонецЕсли;
                    КонецЕсли;
                КонецЦикла;
                Если СкладскаяСтрока = Неопределено Или КолВо <= 0 Тогда Продолжить; КонецЕсли;
                Взять = Мин(Осталось, Макс(0, СкладскаяСтрока.Количество));
                Если Взять <= 0 Тогда Продолжить; КонецЕсли;
                Себестоимость = ?(Взять = КолВо, Стоимость, Окр(Стоимость * Взять / КолВо, 2));
                Выручка = ?(Взять = Осталось, ОсталосьВыручки, Окр(ОсталосьВыручки * Взять / Осталось, 2));
                Движ = Движения.Проводки.Добавить(); Движ.Период = Дата; Движ.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Движ.СчетКт = ПланыСчетов.Управленческий.Товары;
                Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Кандидат;
                Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Склад;
                Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураЗаказа] = СтрокаТовара.Номенклатура;
                Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураПродажи] = Кандидат;
                Движ.КоличествоКт = Взять; Движ.Сумма = Себестоимость;
                Движ = Движения.Проводки.Добавить(); Движ.Период = Дата; Движ.СчетДт = ПланыСчетов.Управленческий.Покупатели;
                Движ.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; Движ.Сумма = Выручка;
                Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураЗаказа] = СтрокаТовара.Номенклатура;
                Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураПродажи] = Кандидат;
                СкладскаяСтрока.Количество = СкладскаяСтрока.Количество - Взять; СкладскаяСтрока.Стоимость = СкладскаяСтрока.Стоимость - Себестоимость;
                Осталось = Осталось - Взять; ОсталосьВыручки = ОсталосьВыручки - Выручка;
            КонецЦикла;
            Если Осталось > 0 Тогда Отказ = Истина; Сообщить("Недостаточно товара и аналогов: " + Строка(СтрокаТовара.Номенклатура)); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если Не Отказ Тогда
        Движения.ОстаткиТоваров.Записать(); Движения.ОстаткиПодразделений.Записать();
        Учет.ПроверитьХронологиюОУ(КлючиОУ, Дата, Отказ);
        Если Не Отказ Тогда Движения.Проводки.Записать(); Учет.ПроверитьХронологиюБУ(КлючиБУ, Дата, Отказ); КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    КлючиОУ = Учет.КлючиОперативногоУчета(); КлючиБУ = Учет.КлючиБухгалтерии();
    Учет.ДобавитьСтарыеКлючи(Движения, КлючиОУ, КлючиБУ); Учет.ЗаблокироватьОстатки(КлючиОУ, КлючиБУ);
    Движения.ОстаткиТоваров.Записать(); Движения.ОстаткиПодразделений.Записать(); Движения.Проводки.Записать();
    Учет.ПроверитьХронологиюОУ(КлючиОУ, Дата, Отказ);
    Если Не Отказ Тогда Учет.ПроверитьХронологиюБУ(КлючиБУ, Дата, Отказ); КонецЕсли;
КонецПроцедуры
