Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    КлючиБУ = Учет.КлючиБухгалтерии(); Учет.ДобавитьСтарыеКлючиБУ(Движения, КлючиБУ);
    Для Каждого Стр Из Проводки Цикл
        Если Стр.СчетДт = ПланыСчетов.Управленческий.Товары Тогда Ключ = КлючиБУ.Добавить(); Ключ.Номенклатура = Стр.НоменклатураДт; КонецЕсли;
        Если Стр.СчетКт = ПланыСчетов.Управленческий.Товары Тогда Ключ = КлючиБУ.Добавить(); Ключ.Номенклатура = Стр.НоменклатураКт; КонецЕсли;
    КонецЦикла;
    Учет.ЗаблокироватьОстатки(Неопределено, Неопределено, Истина);
    Для Каждого Стр Из Проводки Цикл
        Если Не ЗначениеЗаполнено(Стр.СчетДт) Или Не ЗначениеЗаполнено(Стр.СчетКт) Тогда Отказ = Истина; Сообщить("Укажите счета проводки"); Продолжить; КонецЕсли;
        Если Стр.СчетДт = ПланыСчетов.Управленческий.Товары И (Не ЗначениеЗаполнено(Стр.НоменклатураДт) Или Не ЗначениеЗаполнено(Стр.СкладДт)) Тогда Отказ = Истина; Сообщить("Укажите товар и склад по дебету счета товаров"); Продолжить; КонецЕсли;
        Если Стр.СчетКт = ПланыСчетов.Управленческий.Товары И (Не ЗначениеЗаполнено(Стр.НоменклатураКт) Или Не ЗначениеЗаполнено(Стр.СкладКт)) Тогда Отказ = Истина; Сообщить("Укажите товар и склад по кредиту счета товаров"); Продолжить; КонецЕсли;
        Движ = Движения.Проводки.Добавить(); Движ.Период = Дата; Движ.СчетДт = Стр.СчетДт; Движ.СчетКт = Стр.СчетКт;
        Если ЗначениеЗаполнено(Стр.НоменклатураДт) Тогда Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.НоменклатураКт) Тогда Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураКт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СкладДт) Тогда Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СкладКт) Тогда Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладКт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.ЗаказДт) Тогда Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураЗаказа] = Стр.ЗаказДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.ЗаказКт) Тогда Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураЗаказа] = Стр.ЗаказКт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.ПроданоДт) Тогда Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураПродажи] = Стр.ПроданоДт; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.ПроданоКт) Тогда Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.НоменклатураПродажи] = Стр.ПроданоКт; КонецЕсли;
        Движ.КоличествоДт = Стр.КоличествоДт; Движ.КоличествоКт = Стр.КоличествоКт; Движ.Сумма = Стр.Сумма;
    КонецЦикла;
    Движения.Проводки.Записывать = Истина;
    Если Не Отказ Тогда Движения.Проводки.Записать(); Учет.ПроверитьХронологиюБУ(КлючиБУ, Дата, Отказ); КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    КлючиБУ = Учет.КлючиБухгалтерии(); Учет.ДобавитьСтарыеКлючиБУ(Движения, КлючиБУ); Учет.ЗаблокироватьОстатки(Неопределено, Неопределено, Истина);
    Движения.Проводки.Записать(); Учет.ПроверитьХронологиюБУ(КлючиБУ, Дата, Отказ);
КонецПроцедуры
