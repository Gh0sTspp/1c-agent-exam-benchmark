Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    БлокировкаСпецификаций = Новый БлокировкаДанных; Элемент = БлокировкаСпецификаций.Добавить("РегистрСведений.Спецификации"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый; БлокировкаСпецификаций.Заблокировать();
    Если Не ЗначениеЗаполнено(ПодразделениеИсточник) Или Не ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда Отказ = Истина; Сообщить("Укажите оба подразделения"); Возврат; КонецЕсли;
    Для Каждого Стр Из СистемныеБлоки Цикл
        Если Не ЗначениеЗаполнено(Стр.Номенклатура) Или Стр.Количество <= 0 Тогда Отказ = Истина; Сообщить("Укажите системный блок и положительное количество"); КонецЕсли;
    КонецЦикла;
    Для Каждого Стр Из ДополнительныеДетали Цикл
        Если Не ЗначениеЗаполнено(Стр.Номенклатура) Или Стр.Количество <= 0 Тогда Отказ = Истина; Сообщить("Укажите дополнительную деталь и положительное количество"); КонецЕсли;
    КонецЦикла;
    Если Отказ Тогда Возврат; КонецЕсли;
    Блоки = СистемныеБлоки.Выгрузить(); Блоки.Свернуть("Номенклатура", "Количество");
    Блоки.Колонки.Добавить("Стоимость");
    Требования = Новый ТаблицаЗначений;
    Требования.Колонки.Добавить("Блок"); Требования.Колонки.Добавить("Номенклатура"); Требования.Колонки.Добавить("Свойство"); Требования.Колонки.Добавить("Количество"); Требования.Колонки.Добавить("Стоимость");
    КоличествоБлоков = 0;
    Для Каждого Блок Из Блоки Цикл
        Блок.Стоимость = 0;
        Если Блок.Количество <= 0 Тогда Отказ = Истина; Сообщить("Количество блоков должно быть положительным"); Продолжить; КонецЕсли;
        КоличествоБлоков = КоличествоБлоков + Блок.Количество;
    КонецЦикла;
    Если КоличествоБлоков <= 0 Или Отказ Тогда Отказ = Истина; Сообщить("Не указаны собираемые блоки"); Возврат; КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Блоки.Номенклатура КАК Номенклатура, Блоки.Количество КАК Количество ПОМЕСТИТЬ ВТБлоки ИЗ &Блоки КАК Блоки ИНДЕКСИРОВАТЬ ПО Номенклатура;
    |ВЫБРАТЬ Состав.СистемныйБлок КАК СистемныйБлок, МАКСИМУМ(Состав.Период) КАК Период ПОМЕСТИТЬ ВТВерсии
    |ИЗ РегистрСведений.Спецификации КАК Состав ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТБлоки КАК Блоки ПО Состав.СистемныйБлок = Блоки.Номенклатура
    |ГДЕ Состав.Период <= &Дата СГРУППИРОВАТЬ ПО Состав.СистемныйБлок ИНДЕКСИРОВАТЬ ПО СистемныйБлок, Период;
    |ВЫБРАТЬ Состав.СистемныйБлок КАК Блок, Состав.Деталь КАК Номенклатура, Состав.Свойство КАК Свойство, Состав.Количество * Блоки.Количество КАК Количество
    |ИЗ ВТВерсии КАК Версии ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Спецификации КАК Состав ПО Состав.СистемныйБлок = Версии.СистемныйБлок И Состав.Период = Версии.Период
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТБлоки КАК Блоки ПО Блоки.Номенклатура = Состав.СистемныйБлок ГДЕ Состав.Количество > 0;
    |ВЫБРАТЬ ПЕРВЫЕ 1 Блоки.Номенклатура КАК Номенклатура ИЗ ВТБлоки КАК Блоки ЛЕВОЕ СОЕДИНЕНИЕ ВТВерсии КАК Версии ПО Версии.СистемныйБлок = Блоки.Номенклатура ГДЕ Версии.СистемныйБлок ЕСТЬ NULL";
    Запрос.УстановитьПараметр("Блоки", Блоки.Скопировать(, "Номенклатура,Количество")); Запрос.УстановитьПараметр("Дата", Дата);
    РезультатыСостава = Запрос.ВыполнитьПакет();
    Если Не РезультатыСостава[3].Пустой() Тогда Отказ = Истина; Сообщить("Для собираемого блока не задана спецификация на дату документа"); Возврат; КонецЕсли;
    Состав = РезультатыСостава[2].Выбрать(); Пока Состав.Следующий() Цикл
        Стр = Требования.Добавить(); Стр.Блок = Состав.Блок; Стр.Номенклатура = Состав.Номенклатура; Стр.Свойство = Состав.Свойство; Стр.Количество = Состав.Количество;
    КонецЦикла;
    Для Каждого Деталь Из ДополнительныеДетали Цикл
        Стр = Требования.Добавить(); Стр.Номенклатура = Деталь.Номенклатура; Стр.Свойство = Деталь.Свойство; Стр.Количество = Деталь.Количество;
    КонецЦикла;
    Свод = Требования.Скопировать(); Свод.Свернуть("Номенклатура, Свойство", "Количество");
    КлючиОУ = Учет.КлючиОперативногоУчета();
    Для Каждого Стр Из Свод Цикл Ключ = КлючиОУ.Добавить(); Ключ.Подразделение = ПодразделениеИсточник; Ключ.Номенклатура = Стр.Номенклатура; Ключ.Свойство = Стр.Свойство; КонецЦикла;
    Для Каждого Блок Из Блоки Цикл Ключ = КлючиОУ.Добавить(); Ключ.Подразделение = ПодразделениеПолучатель; Ключ.Номенклатура = Блок.Номенклатура; КонецЦикла;
    Учет.ДобавитьСтарыеКлючиОУ(Движения, КлючиОУ); Учет.ЗаблокироватьОстатки(КлючиОУ, Учет.КлючиБухгалтерии());
    Движения.ОстаткиТоваров.Записывать = Истина; Движения.ОстаткиПодразделений.Записывать = Истина; Движения.ОстаткиТоваров.Записать(); Движения.ОстаткиПодразделений.Записать();
    ПартииОУ = Учет.ЗагрузитьПартии(Новый Граница(Дата, ВидГраницы.Включая), КлючиОУ);
    ДопСтоимость = 0;
    Для Каждого Стр Из Свод Цикл
        Если Стр.Количество <= 0 Тогда Отказ = Истина; Сообщить("Количество деталей должно быть положительным"); Продолжить; КонецЕсли;
        Партии = Учет.СписатьПартииИзПамяти(ПартииОУ, ПодразделениеИсточник, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Перечисления.УчетнаяПолитика.ПоСредней, Отказ);
        Если Отказ Тогда Продолжить; КонецЕсли;
        Учет.ЗаписатьСписаниеОУ(Движения, Дата, ПодразделениеИсточник, Стр.Номенклатура, Стр.Свойство, Партии);
        ОсталосьСтоимости = Партии.Итог("Стоимость"); ОсталосьДеталей = Стр.Количество;
        Для Каждого Потребность Из Требования.НайтиСтроки(Новый Структура("Номенклатура,Свойство", Стр.Номенклатура, Стр.Свойство)) Цикл
            Сумма = ?(Потребность.Количество = ОсталосьДеталей, ОсталосьСтоимости, Окр(ОсталосьСтоимости * Потребность.Количество / ОсталосьДеталей, 2));
            ОсталосьСтоимости = ОсталосьСтоимости - Сумма; ОсталосьДеталей = ОсталосьДеталей - Потребность.Количество;
            Если ЗначениеЗаполнено(Потребность.Блок) Тогда
                Для Каждого Блок Из Блоки Цикл Если Блок.Номенклатура = Потребность.Блок Тогда Блок.Стоимость = Блок.Стоимость + Сумма; Прервать; КонецЕсли; КонецЦикла;
            Иначе ДопСтоимость = ДопСтоимость + Сумма; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    ОсталосьБлоков = КоличествоБлоков;
    Для Каждого Блок Из Блоки Цикл
        ДоляДоп = ?(Блок.Количество = ОсталосьБлоков, ДопСтоимость, Окр(ДопСтоимость * Блок.Количество / ОсталосьБлоков, 2));
        Движ = Движения.ОстаткиТоваров.ДобавитьПриход(); Движ.Период = Дата; Движ.Подразделение = ПодразделениеПолучатель;
        Движ.Номенклатура = Блок.Номенклатура; Движ.Партия = Ссылка; Движ.Количество = Блок.Количество; Движ.Стоимость = Блок.Стоимость + ДоляДоп;
        Движ = Движения.ОстаткиПодразделений.ДобавитьПриход(); Движ.Период = Дата; Движ.Подразделение = ПодразделениеПолучатель; Движ.Номенклатура = Блок.Номенклатура; Движ.Количество = Блок.Количество; Движ.Стоимость = Блок.Стоимость + ДоляДоп;
        ДопСтоимость = ДопСтоимость - ДоляДоп; ОсталосьБлоков = ОсталосьБлоков - Блок.Количество;
    КонецЦикла;
    Если Не Отказ Тогда
        Движения.ОстаткиТоваров.Записать(); Движения.ОстаткиПодразделений.Записать();
        Учет.ПроверитьХронологиюОУ(КлючиОУ, Дата, Отказ);
    КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    КлючиОУ = Учет.КлючиОперативногоУчета(); Учет.ДобавитьСтарыеКлючиОУ(Движения, КлючиОУ);
    Учет.ЗаблокироватьОстатки(КлючиОУ, Учет.КлючиБухгалтерии());
    Движения.ОстаткиТоваров.Записать(); Движения.ОстаткиПодразделений.Записать(); Учет.ПроверитьХронологиюОУ(КлючиОУ, Дата, Отказ);
КонецПроцедуры
