Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    ЗаблокироватьРасчеты();
    Движения.ОсновныеНачисления.Записывать = Истина; Движения.ОсновныеНачисления.Записать();
    Для Каждого Стр Из ОсновныеНачисления Цикл
        Если Не ЗначениеЗаполнено(Стр.ДатаНачала) Или Не ЗначениеЗаполнено(Стр.ДатаОкончания) Или Стр.ДатаНачала > Стр.ДатаОкончания Или Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Или Не ЗначениеЗаполнено(Стр.ВидРасчета) Тогда
            Отказ = Истина; Сообщить("Не заполнены сотрудник, подразделение, вид расчета или период"); Продолжить;
        КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
            Отказ = Истина; Сообщить("Используйте тариф, премию или командировку"); Продолжить;
        КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
            Отказ = Истина; Сообщить("Тариф и премия вводятся в пределах одного месяца"); Продолжить;
        КонецЕсли;
    КонецЦикла;
    Если Отказ Тогда Возврат; КонецЕсли;
    НормализованныеСтроки = ОбъединитьПересекающиесяСтроки();
    ПроверитьПересечениеНачислений(НормализованныеСтроки, Отказ);
    Если Отказ Тогда Возврат; КонецЕсли;
    Для Каждого Стр Из НормализованныеСтроки Цикл
        НачалоЧасти = НачалоДня(Стр.ДатаНачала);
        Пока НачалоЧасти <= Стр.ДатаОкончания Цикл
            КонецЧасти = Мин(КонецДня(Стр.ДатаОкончания), КонецМесяца(НачалоЧасти));
            Движ = Движения.ОсновныеНачисления.Добавить(); Движ.ПериодРегистрации = НачалоМесяца(Дата);
            Движ.ПериодДействияНачало = НачалоЧасти; Движ.ПериодДействияКонец = КонецЧасти;
            Движ.Сотрудник = Стр.Сотрудник; Движ.Подразделение = Стр.Подразделение; Движ.ВидРасчета = Стр.ВидРасчета;
            Месяц = НачалоМесяца(?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, Стр.ДатаНачала, НачалоЧасти));
            Движ.БазовыйПериодНачало = ДобавитьМесяц(Месяц, ?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, -3, -1));
            Движ.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(Месяц, -1));
            НачалоЧасти = НачалоДня(КонецЧасти + 1);
        КонецЦикла;
    КонецЦикла;
    Если Отказ Тогда Возврат; КонецЕсли;
    // Дополнение также должно включить ранее рассчитанные записи этого месяца.
    // Временный следующий период виден только внутри транзакции проведения.
    Для Каждого Движ Из Движения.ОсновныеНачисления Цикл Движ.ПериодРегистрации = ДобавитьМесяц(НачалоМесяца(Дата), 1); КонецЦикла;
    Движения.ОсновныеНачисления.Записать();
    Дополнение = Движения.ОсновныеНачисления.ПолучитьДополнение();
    ИсходныеСторно = Новый Соответствие; Источники = Новый Соответствие;
    КлючиСторно = Новый ТаблицаЗначений;
    КлючиСторно.Колонки.Добавить("Документ", Новый ОписаниеТипов("ДокументСсылка.НачислениеЗарплаты"));
    КлючиСторно.Колонки.Добавить("Строка", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    Для Каждого СтрокаСторно Из Дополнение Цикл
        Для Каждого Поездка Из НормализованныеСтроки Цикл
            Если Поездка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Или Поездка.Сотрудник <> СтрокаСторно.Сотрудник Или Поездка.Подразделение <> СтрокаСторно.Подразделение Тогда Продолжить; КонецЕсли;
            НачалоПересечения = Макс(СтрокаСторно.ПериодДействияНачалоСторно, НачалоДня(Поездка.ДатаНачала));
            КонецПересечения = Мин(СтрокаСторно.ПериодДействияКонецСторно, КонецДня(Поездка.ДатаОкончания));
            Если НачалоПересечения > КонецПересечения Тогда Продолжить; КонецЕсли;
            Движ = Движения.ОсновныеНачисления.Добавить(); ЗаполнитьЗначенияСвойств(Движ, СтрокаСторно);
            ПоДокументу = Источники.Получить(СтрокаСторно.Регистратор);
            Если ПоДокументу = Неопределено Тогда ПоДокументу = Новый Соответствие; Источники.Вставить(СтрокаСторно.Регистратор, ПоДокументу); КонецЕсли;
            Исходное = ПоДокументу.Получить(СтрокаСторно.НомерСтроки);
            Если Исходное = Неопределено Тогда
                Исходное = Новый Структура("Результат,Часы,СторнированоЧасов,СторнированоСумма", СтрокаСторно.Результат, СтрокаСторно.Часы, 0, 0);
                ПоДокументу.Вставить(СтрокаСторно.НомерСтроки, Исходное);
                Ключ = КлючиСторно.Добавить(); Ключ.Документ = СтрокаСторно.Регистратор; Ключ.Строка = СтрокаСторно.НомерСтроки;
            КонецЕсли;
            Движ.ИсходныйДокумент = СтрокаСторно.Регистратор; Движ.ИсходнаяСтрока = СтрокаСторно.НомерСтроки;
            ИсходныеСторно.Вставить(Движения.ОсновныеНачисления.Количество(), Исходное);
            Движ.Сторно = Истина; Движ.ПериодРегистрации = ДобавитьМесяц(НачалоМесяца(Дата), 1);
            Движ.ПериодДействияНачало = НачалоПересечения; Движ.ПериодДействияКонец = КонецПересечения;
        КонецЦикла;
    КонецЦикла;
    Если КлючиСторно.Количество() > 0 Тогда
        ЗапросСторно = Новый Запрос("ВЫБРАТЬ Документ, Строка ПОМЕСТИТЬ ВТКлючи ИЗ &Ключи КАК Ключи ИНДЕКСИРОВАТЬ ПО Документ, Строка;
        |ВЫБРАТЬ Ключи.Документ КАК Документ, Ключи.Строка КАК Строка, -СУММА(Начисления.Часы) КАК Часы, -СУММА(Начисления.Результат) КАК Сумма
        |ИЗ ВТКлючи КАК Ключи ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления КАК Начисления
        |ПО Начисления.ИсходныйДокумент = Ключи.Документ И Начисления.ИсходнаяСтрока = Ключи.Строка
        |ГДЕ Начисления.Сторно И Начисления.Регистратор <> &Ссылка
        |СГРУППИРОВАТЬ ПО Ключи.Документ, Ключи.Строка");
        ЗапросСторно.УстановитьПараметр("Ключи", КлючиСторно); ЗапросСторно.УстановитьПараметр("Ссылка", Ссылка);
        ВыборкаСторно = ЗапросСторно.Выполнить().Выбрать();
        Пока ВыборкаСторно.Следующий() Цикл
            Исходное = Источники.Получить(ВыборкаСторно.Документ).Получить(ВыборкаСторно.Строка);
            Исходное.СторнированоЧасов = ВыборкаСторно.Часы; Исходное.СторнированоСумма = ВыборкаСторно.Сумма;
        КонецЦикла;
    КонецЕсли;
    Движения.ОсновныеНачисления.Записать();
    РассчитатьВид(ПланыВидовРасчета.ОсновныеНачисления.Тариф, ИсходныеСторно);
    РассчитатьВид(ПланыВидовРасчета.ОсновныеНачисления.Премия, ИсходныеСторно);
    РассчитатьВид(ПланыВидовРасчета.ОсновныеНачисления.Командировка, ИсходныеСторно);
    Для Каждого Движ Из Движения.ОсновныеНачисления Цикл Движ.ПериодРегистрации = НачалоМесяца(Дата); КонецЦикла;
    Движения.ОсновныеНачисления.Записать();
КонецПроцедуры

Процедура РассчитатьВид(Вид, ИсходныеСторно)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ График.НомерСтроки КАК НомерСтроки,
    | ЕСТЬNULL(График.ЗначениеФактическийПериодДействия, 0) КАК Часы,
    | ЕСТЬNULL(График.ДниФактическийПериодДействия, 0) КАК Дни,
    | ЕСТЬNULL(График.ЗначениеПериодДействия, 0) КАК ПланЧасы,
    | График.Сотрудник.ДатаНачалаСтажа КАК ДатаСтажа
    |ИЗ РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(Регистратор = &Ссылка И ВидРасчета = &Вид) КАК График";
    Запрос.УстановитьПараметр("Ссылка", Ссылка); Запрос.УстановитьПараметр("Вид", Вид);
    Графики = Запрос.Выполнить().Выгрузить(); Если Графики.Количество() = 0 Тогда Возврат; КонецЕсли;
    Строки = Новый ТаблицаЗначений;
    Строки.Колонки.Добавить("Номер", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
    Строки.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
    Строки.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Строки.Колонки.Добавить("Месяц", Новый ОписаниеТипов("Дата"));
    Строки.Колонки.Добавить("НачалоБазы", Новый ОписаниеТипов("Дата"));
    Строки.Колонки.Добавить("КонецБазы", Новый ОписаниеТипов("Дата"));
    Для Каждого График Из Графики Цикл
        Движ = Движения.ОсновныеНачисления[График.НомерСтроки - 1]; Стр = Строки.Добавить();
        Стр.Номер = График.НомерСтроки; Стр.Сотрудник = Движ.Сотрудник; Стр.Подразделение = Движ.Подразделение;
        Стр.Месяц = НачалоМесяца(Движ.ПериодДействияНачало); Стр.НачалоБазы = Движ.БазовыйПериодНачало; Стр.КонецБазы = Движ.БазовыйПериодКонец;
    КонецЦикла;
    Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда РассчитатьКомандировки(Графики, Строки, Вид); Возврат; КонецЕсли;
    Ставки = Новый Соответствие; БазаВсех = Новый Соответствие; БазаСотрудника = Новый Соответствие; Шкала = Новый ТаблицаЗначений;
    Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
        Ставки = СтавкиДляСтрок(Строки);
    ИначеЕсли Вид = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
        Шкала = Новый Запрос("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж УБЫВ"); Шкала = Шкала.Выполнить().Выгрузить();
        Измерения = Новый Массив; Измерения.Добавить("Подразделение"); БазаВсех = БазыДляСтрок(Вид, Измерения);
        Измерения.Добавить("Сотрудник"); БазаСотрудника = БазыДляСтрок(Вид, Измерения);
    КонецЕсли;
    Для Каждого График Из Графики Цикл
        Движ = Движения.ОсновныеНачисления[График.НомерСтроки - 1]; Знак = ?(Движ.Сторно, -1, 1);
        Если Не Движ.Сторно Тогда Движ.ПланЧасы = График.ПланЧасы; КонецЕсли;
        Движ.Часы = График.Часы * Знак; Движ.Дни = ?(Вид = ПланыВидовРасчета.ОсновныеНачисления.Тариф, График.Дни * Знак, 0);
        Если Движ.Сторно Тогда
            Исходное = ИсходныеСторно.Получить(График.НомерСтроки);
            Если Исходное <> Неопределено И Исходное.Часы <> 0 Тогда
                ОсталосьЧасов = Макс(0, Исходное.Часы - Исходное.СторнированоЧасов - График.Часы);
                НоваяСумма = Исходное.Результат - Окр(Исходное.Результат * ОсталосьЧасов / Исходное.Часы, 2);
                Движ.Результат = -(НоваяСумма - Исходное.СторнированоСумма);
                Исходное.СторнированоЧасов = Исходное.СторнированоЧасов + График.Часы;
                Исходное.СторнированоСумма = НоваяСумма;
            Иначе Движ.Результат = 0; КонецЕсли;
            Продолжить;
        КонецЕсли;
        Месяц = НачалоМесяца(Движ.ПериодДействияНачало);
        Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Ставка = ЧислоПоКлючу(Ставки, График.НомерСтроки); Движ.Результат = Окр(Ставка * График.Часы * Знак, 2);
        ИначеЕсли Вид = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
            Если ЗначениеЗаполнено(График.ДатаСтажа) Тогда
                Стаж = Год(Месяц) - Год(График.ДатаСтажа); Если ДобавитьМесяц(График.ДатаСтажа, Стаж * 12) > Месяц Тогда Стаж = Стаж - 1; КонецЕсли;
                Движ.Стаж = Макс(0, Стаж);
            КонецЕсли;
            Для Каждого Порог Из Шкала Цикл Если Движ.Стаж >= Порог.Стаж Тогда Движ.Процент = Порог.Процент; Прервать; КонецЕсли; КонецЦикла;
            Доля = ?(Движ.ПланЧасы = 0, 0, График.Часы / Движ.ПланЧасы);
            Движ.Результат = Окр((ЧислоПоКлючу(БазаВсех, График.НомерСтроки) - ЧислоПоКлючу(БазаСотрудника, График.НомерСтроки)) * Движ.Процент / 100 * Доля * Знак, 2);
        КонецЕсли;
    КонецЦикла;
    Движения.ОсновныеНачисления.Записать(, Истина);
КонецПроцедуры

Процедура РассчитатьКомандировки(Графики, Строки, Вид)
    ДниБазы = ДниДляСтрок(Строки); Измерения = Новый Массив; Измерения.Добавить("Сотрудник");
    БазаСотрудника = БазыДляСтрок(Вид, Измерения);
    Графики.Колонки.Добавить("НачалоБазы", Новый ОписаниеТипов("Дата"));
    Для Каждого График Из Графики Цикл График.НачалоБазы = Движения.ОсновныеНачисления[График.НомерСтроки - 1].БазовыйПериодНачало; КонецЦикла;
    Графики.Сортировать("НачалоБазы,НомерСтроки"); Индекс = 0; ЗаписанныеПоездки = Новый Соответствие;
    Пока Индекс < Графики.Количество() Цикл
        ПериодБазы = Графики[Индекс].НачалоБазы; НачальныйИндекс = Индекс;
        Пока Индекс < Графики.Количество() И Графики[Индекс].НачалоБазы = ПериодБазы Цикл
            График = Графики[Индекс]; Движ = Движения.ОсновныеНачисления[График.НомерСтроки - 1]; Знак = ?(Движ.Сторно, -1, 1);
            Если Не Движ.Сторно Тогда Движ.ПланЧасы = График.ПланЧасы; КонецЕсли;
            Движ.Часы = График.Часы * Знак; Движ.Дни = 0; Дней = ЧислоПоКлючу(ДниБазы, График.НомерСтроки);
            База = ЧислоПоКлючу(БазаСотрудника, График.НомерСтроки);
            // База получена единожды. Ранее рассчитанные части этого документа записаны в регистр;
            // их суммы добавляем, если их месяц входит в базовый период текущей поездки.
            ПоездкиСотрудника = ЗаписанныеПоездки.Получить(Движ.Сотрудник);
            Если ПоездкиСотрудника <> Неопределено Тогда
                Для Каждого Предыдущая Из ПоездкиСотрудника Цикл
                    Если Предыдущая.Начало >= Движ.БазовыйПериодНачало И Предыдущая.Конец <= Движ.БазовыйПериодКонец Тогда База = База + Предыдущая.Результат; КонецЕсли;
                КонецЦикла;
            КонецЕсли;
            Если Дней > 0 Тогда Движ.Результат = Окр(База / Дней * График.Дни * Знак, 2); КонецЕсли;
            Индекс = Индекс + 1;
        КонецЦикла;
        Движения.ОсновныеНачисления.Записать(, Истина);
        Для НомерГрафика = НачальныйИндекс По Индекс - 1 Цикл
            График = Графики[НомерГрафика]; Движ = Движения.ОсновныеНачисления[График.НомерСтроки - 1];
            ПоездкиСотрудника = ЗаписанныеПоездки.Получить(Движ.Сотрудник);
            Если ПоездкиСотрудника = Неопределено Тогда ПоездкиСотрудника = Новый Массив; ЗаписанныеПоездки.Вставить(Движ.Сотрудник, ПоездкиСотрудника); КонецЕсли;
            ПоездкиСотрудника.Добавить(Новый Структура("Начало,Конец,Результат", Движ.ПериодДействияНачало, Движ.ПериодДействияКонец, Движ.Результат));
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Функция ЧислоПоКлючу(СоответствиеЗначений, Ключ)
    Значение = СоответствиеЗначений.Получить(Ключ); Возврат ?(Значение = Неопределено, 0, Значение);
КонецФункции

Функция БазыДляСтрок(Вид, Измерения)
    Запрос = Новый Запрос("ВЫБРАТЬ База.НомерСтроки КАК Номер, СУММА(База.РезультатБаза) КАК Значение ИЗ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(&Измерения, &Измерения, , Регистратор = &Ссылка И ВидРасчета = &Вид) КАК База СГРУППИРОВАТЬ ПО База.НомерСтроки");
    Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Ссылка", Ссылка); Запрос.УстановитьПараметр("Вид", Вид);
    Выборка = Запрос.Выполнить().Выбрать(); Результат = Новый Соответствие; Пока Выборка.Следующий() Цикл Результат.Вставить(Выборка.Номер, Выборка.Значение); КонецЦикла; Возврат Результат;
КонецФункции

Функция СтавкиДляСтрок(Строки)
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ Док.Номер КАК Номер, Док.Сотрудник КАК Сотрудник, Док.Подразделение КАК Подразделение, Док.Месяц КАК Месяц ПОМЕСТИТЬ ВТСтроки ИЗ &Строки КАК Док ИНДЕКСИРОВАТЬ ПО Сотрудник, Подразделение;
    |ВЫБРАТЬ Док.Номер КАК Номер, Док.Сотрудник КАК Сотрудник, Док.Подразделение КАК Подразделение, МАКСИМУМ(Тарифы.Период) КАК Период
    |ПОМЕСТИТЬ ВТПериоды ИЗ ВТСтроки КАК Док ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Тарифы
    |ПО Тарифы.Сотрудник = Док.Сотрудник И Тарифы.Подразделение = Док.Подразделение И Тарифы.Период <= Док.Месяц
    |СГРУППИРОВАТЬ ПО Док.Номер, Док.Сотрудник, Док.Подразделение ИНДЕКСИРОВАТЬ ПО Сотрудник, Подразделение, Период;
    |ВЫБРАТЬ ВТПериоды.Номер КАК Номер, ЕСТЬNULL(Тарифы.Ставка, 0) КАК Значение ИЗ ВТПериоды
    |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Тарифы ПО Тарифы.Сотрудник = ВТПериоды.Сотрудник И Тарифы.Подразделение = ВТПериоды.Подразделение И Тарифы.Период = ВТПериоды.Период";
    Запрос.УстановитьПараметр("Строки", Строки); Выборка = Запрос.Выполнить().Выбрать(); Результат = Новый Соответствие; Пока Выборка.Следующий() Цикл Результат.Вставить(Выборка.Номер, Выборка.Значение); КонецЦикла; Возврат Результат;
КонецФункции

Функция ДниДляСтрок(Строки)
    Запрос = Новый Запрос("ВЫБРАТЬ Док.Номер КАК Номер, Док.Сотрудник КАК Сотрудник, Док.НачалоБазы КАК НачалоБазы, Док.КонецБазы КАК КонецБазы ПОМЕСТИТЬ ВТСтроки ИЗ &Строки КАК Док ИНДЕКСИРОВАТЬ ПО Сотрудник;
    |ВЫБРАТЬ Док.Номер КАК Номер, ЕСТЬNULL(СУММА(Начисления.Дни), 0) КАК Значение ИЗ ВТСтроки КАК Док ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления КАК Начисления ПО Начисления.Сотрудник = Док.Сотрудник И Начисления.ВидРасчета = &Тариф И Начисления.ПериодДействияНачало >= Док.НачалоБазы И Начисления.ПериодДействияКонец <= Док.КонецБазы СГРУППИРОВАТЬ ПО Док.Номер");
    Запрос.УстановитьПараметр("Строки", Строки); Запрос.УстановитьПараметр("Тариф", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
    Выборка = Запрос.Выполнить().Выбрать(); Результат = Новый Соответствие; Пока Выборка.Следующий() Цикл Результат.Вставить(Выборка.Номер, Выборка.Значение); КонецЦикла; Возврат Результат;
КонецФункции

Процедура ЗаблокироватьРасчеты()
    Ключи = Новый ТаблицаЗначений;
    Ключи.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
    Ключи.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Отделы = Новый ТаблицаЗначений; Отделы.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Люди = Новый ТаблицаЗначений; Люди.Колонки.Добавить("Сотрудник", Новый ОписаниеТипов("СправочникСсылка.ФизическиеЛица"));
    Для Каждого Стр Из ОсновныеНачисления Цикл ДобавитьКлючРасчета(Ключи, Отделы, Люди, Стр.Сотрудник, Стр.Подразделение, Стр.ВидРасчета); КонецЦикла;
    Движения.ОсновныеНачисления.Прочитать();
    Для Каждого Стр Из Движения.ОсновныеНачисления Цикл ДобавитьКлючРасчета(Ключи, Отделы, Люди, Стр.Сотрудник, Стр.Подразделение, Стр.ВидРасчета); КонецЦикла;
    Движения.ОсновныеНачисления.Очистить();
    Блокировка = Новый БлокировкаДанных;
    Если Ключи.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрСведений.ГрафикиРаботы"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый; Элемент.ИсточникДанных = Ключи; Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
        Элемент = Блокировка.Добавить("РегистрСведений.ТарифныеСтавки"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый; Элемент.ИсточникДанных = Ключи;
        Элемент.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник"); Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    КонецЕсли;
    Если Отделы.Количество() > 0 Тогда Элемент = Блокировка.Добавить("РегистрСведений.ШкалаПремий"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый; КонецЕсли;
    Если Ключи.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрРасчета.ОсновныеНачисления"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = Ключи;
        Элемент.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник"); Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    КонецЕсли;
    Если Отделы.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрРасчета.ОсновныеНачисления"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = Отделы;
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    КонецЕсли;
    Если Люди.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрРасчета.ОсновныеНачисления"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = Люди;
        Элемент.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник");
    КонецЕсли;
    Если Ключи.Количество() + Отделы.Количество() + Люди.Количество() > 0 Тогда Блокировка.Заблокировать(); КонецЕсли;
КонецПроцедуры

Процедура ДобавитьКлючРасчета(Ключи, Отделы, Люди, Сотрудник, Подразделение, Вид)
    Стр = Ключи.Добавить(); Стр.Сотрудник = Сотрудник; Стр.Подразделение = Подразделение;
    Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Стр = Отделы.Добавить(); Стр.Подразделение = Подразделение; КонецЕсли;
    Если Вид = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Стр = Люди.Добавить(); Стр.Сотрудник = Сотрудник; КонецЕсли;
КонецПроцедуры

Функция ОбъединитьПересекающиесяСтроки()
    Исходные = ОсновныеНачисления.Выгрузить(); Исходные.Сортировать("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    Результат = Исходные.СкопироватьКолонки(); Последняя = Неопределено;
    Для Каждого Стр Из Исходные Цикл
        Если Последняя <> Неопределено И Последняя.Сотрудник = Стр.Сотрудник И Последняя.Подразделение = Стр.Подразделение И Последняя.ВидРасчета = Стр.ВидРасчета И НачалоДня(Стр.ДатаНачала) <= КонецДня(Последняя.ДатаОкончания) Тогда
            Последняя.ДатаОкончания = Макс(Последняя.ДатаОкончания, Стр.ДатаОкончания);
        Иначе
            Последняя = Результат.Добавить(); ЗаполнитьЗначенияСвойств(Последняя, Стр);
        КонецЕсли;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ПроверитьПересечениеНачислений(Строки, Отказ)
    Сотрудники = Новый Массив; Начало = Неопределено; Конец = Неопределено;
    Для Каждого Стр Из Строки Цикл
        Если Сотрудники.Найти(Стр.Сотрудник) = Неопределено Тогда Сотрудники.Добавить(Стр.Сотрудник); КонецЕсли;
        Начало = ?(Начало = Неопределено, НачалоДня(Стр.ДатаНачала), Мин(Начало, НачалоДня(Стр.ДатаНачала)));
        Конец = ?(Конец = Неопределено, КонецДня(Стр.ДатаОкончания), Макс(Конец, КонецДня(Стр.ДатаОкончания)));
    КонецЦикла;
    Если Сотрудники.Количество() = 0 Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Сотрудник, Подразделение, ВидРасчета, ПериодДействияНачало КАК Начало, ПериодДействияКонец КАК Конец ИЗ РегистрРасчета.ОсновныеНачисления ГДЕ Сотрудник В (&Сотрудники) И НЕ Сторно И Регистратор <> &Ссылка И ПериодДействияНачало <= &Конец И ПериодДействияКонец >= &Начало");
    Запрос.УстановитьПараметр("Сотрудники", Сотрудники); Запрос.УстановитьПараметр("Ссылка", Ссылка); Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец);
    Существующие = Запрос.Выполнить().Выгрузить();
    Для Каждого Стр Из Строки Цикл
        Для Каждого Другая Из Существующие.НайтиСтроки(Новый Структура("Сотрудник,Подразделение,ВидРасчета", Стр.Сотрудник, Стр.Подразделение, Стр.ВидРасчета)) Цикл
            Если Другая.Начало <= КонецДня(Стр.ДатаОкончания) И Другая.Конец >= НачалоДня(Стр.ДатаНачала) Тогда Отказ = Истина; Сообщить("Для сотрудника уже введено начисление этого вида за пересекающийся период"); Возврат; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    ЗаблокироватьРасчеты();
КонецПроцедуры
