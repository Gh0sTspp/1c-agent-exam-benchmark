&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    СоздатьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    СоздатьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура СоздатьДополнительныеПоля()
    // Сохраняем введенное до смены менеджера в данные формы.
    Для Каждого СохраненнаяСтрока Из Объект.ДополнительныеСведения Цикл
        Если ЗначениеЗаполнено(СохраненнаяСтрока.ВидСведения) Тогда
            Имя = ИмяПоля(СохраненнаяСтрока.ВидСведения);
            Если Элементы.Найти(Имя) <> Неопределено Тогда СохраненнаяСтрока.Значение = ЭтотОбъект[Имя]; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Удаляемые = Новый Массив;
    Для Каждого Элемент Из Элементы Цикл
        Если Лев(Элемент.Имя, 4) = "Доп_" И СтрДлина(Элемент.Имя) = 36 Тогда Удаляемые.Добавить(Элемент.Имя); КонецЕсли;
    КонецЦикла;
    Для Каждого Имя Из Удаляемые Цикл Элементы.Удалить(Элементы[Имя]); КонецЦикла;
    Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(, Удаляемые); КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    СведенияМенеджера = ПолучитьСведенияМенеджера(Объект.Менеджер);
    Добавляемые = Новый Массив; УжеДобавлены = Новый Соответствие;
    Для Каждого Стр Из СведенияМенеджера Цикл
        Если Не ЗначениеЗаполнено(Стр.ВидСведения) Тогда Продолжить; КонецЕсли;
        Имя = ИмяПоля(Стр.ВидСведения);
        Если УжеДобавлены.Получить(Имя) <> Неопределено Тогда Продолжить; КонецЕсли;
        УжеДобавлены.Вставить(Имя, Истина);
        Добавляемые.Добавить(Новый РеквизитФормы(Имя, Стр.ТипЗначения, , Стр.Наименование));
    КонецЦикла;
    Если Добавляемые.Количество() = 0 Тогда Возврат; КонецЕсли;
    ИзменитьРеквизиты(Добавляемые);
    Для Каждого Стр Из СведенияМенеджера Цикл
        Если Не ЗначениеЗаполнено(Стр.ВидСведения) Тогда Продолжить; КонецЕсли;
        Имя = ИмяПоля(Стр.ВидСведения);
        Если Элементы.Найти(Имя) <> Неопределено Тогда Продолжить; КонецЕсли;
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы")); Поле.Вид = ВидПоляФормы.ПолеВвода; Поле.ПутьКДанным = Имя; Поле.Заголовок = Стр.Наименование;
        ТипыЗначения = Стр.ТипЗначения.Типы();
        Если ТипыЗначения.Количество() = 1 И ТипыЗначения[0] = Тип("СправочникСсылка.ЗначенияХарактеристик") Тогда
            ОтборЗначений = Новый Массив; ОтборЗначений.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Стр.ВидСведения));
            Поле.ПараметрыВыбора = Новый ФиксированныйМассив(ОтборЗначений);
        КонецЕсли;
        Найдена = Ложь;
        Для Каждого ЗначениеСтрока Из Объект.ДополнительныеСведения Цикл
            Если ЗначениеСтрока.ВидСведения = Стр.ВидСведения Тогда ЭтотОбъект[Имя] = ЗначениеСтрока.Значение; Найдена = Истина; Прервать; КонецЕсли;
        КонецЦикла;
        Если Не Найдена Тогда ЗначениеСтрока = Объект.ДополнительныеСведения.Добавить(); ЗначениеСтрока.ВидСведения = Стр.ВидСведения; КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьСведенияМенеджера(Менеджер)
    Запрос = Новый Запрос("ВЫБРАТЬ Сведения.ВидСведения КАК ВидСведения, Сведения.ВидСведения.Наименование КАК Наименование, Сведения.ВидСведения.ТипЗначения КАК ТипЗначения
    |ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения КАК Сведения ГДЕ Сведения.Ссылка = &Менеджер УПОРЯДОЧИТЬ ПО Сведения.НомерСтроки");
    Запрос.УстановитьПараметр("Менеджер", Менеджер); Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаСервере
Функция ИмяПоля(Вид)
    Возврат "Доп_" + СтрЗаменить(Строка(Вид.УникальныйИдентификатор()), "-", "");
КонецФункции

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    МенеджерОбъект = Объект.Менеджер.ПолучитьОбъект();
    Для Каждого Стр Из МенеджерОбъект.ДополнительныеСведения Цикл
        Если Не ЗначениеЗаполнено(Стр.ВидСведения) Тогда Продолжить; КонецЕсли;
        Имя = ИмяПоля(Стр.ВидСведения);
        Если Элементы.Найти(Имя) = Неопределено Тогда Продолжить; КонецЕсли;
        Найдена = Неопределено;
        Для Каждого ЗначениеСтрока Из ТекущийОбъект.ДополнительныеСведения Цикл
            Если ЗначениеСтрока.ВидСведения = Стр.ВидСведения Тогда Найдена = ЗначениеСтрока; Прервать; КонецЕсли;
        КонецЦикла;
        Если Найдена = Неопределено Тогда Найдена = ТекущийОбъект.ДополнительныеСведения.Добавить(); Найдена.ВидСведения = Стр.ВидСведения; КонецЕсли;
        Найдена.Значение = ЭтотОбъект[Имя];
    КонецЦикла;
КонецПроцедуры
