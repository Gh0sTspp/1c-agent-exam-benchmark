    Стр = ЗарплатаФевраль.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Сотрудник; Стр.Подразделение = Подр; Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф; Стр.ДатаНачала = Дата(2024,2,1); Стр.ДатаОкончания = Дата(2024,2,29); ЗарплатаФевраль.Записать(РежимЗаписиДокумента.Проведение);
