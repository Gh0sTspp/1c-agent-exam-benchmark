    Стр = Приход.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Товар; Стр.Свойство = Свойство; Стр.Количество = 10; Стр.Цена = 100; Стр.Сумма = 1000; Приход.Записать(РежимЗаписиДокумента.Проведение);
