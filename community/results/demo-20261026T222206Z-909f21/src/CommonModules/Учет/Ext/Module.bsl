// Движения и контроль остатков выполняются под управляемой блокировкой.
Функция КлючиОперативногоУчета() Экспорт
    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Таблица.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
    Возврат Таблица;
КонецФункции

Функция КлючиБухгалтерии() Экспорт
    Таблица = Новый ТаблицаЗначений;
    Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Возврат Таблица;
КонецФункции

Процедура ЗаблокироватьОстатки(КлючиОУ = Неопределено, КлючиБУ = Неопределено, ТолькоБухгалтерия = Ложь) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Если КлючиОУ <> Неопределено И КлючиОУ.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрСведений.УчетнаяПолитикаПодразделений"); Элемент.Режим = РежимБлокировкиДанных.Разделяемый; Элемент.ИсточникДанных = КлючиОУ;
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    КонецЕсли;
    Если КлючиОУ = Неопределено И Не ТолькоБухгалтерия Тогда
        Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров"); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    ИначеЕсли КлючиОУ <> Неопределено И КлючиОУ.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров"); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.ИсточникДанных = КлючиОУ;
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
        Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
        Элемент.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
    КонецЕсли;
    Если КлючиОУ = Неопределено И Не ТолькоБухгалтерия Тогда
        Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиПодразделений"); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    ИначеЕсли КлючиОУ <> Неопределено И КлючиОУ.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиПодразделений"); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = КлючиОУ;
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение"); Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура"); Элемент.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
    КонецЕсли;
    Если КлючиБУ = Неопределено Тогда
        Элемент = Блокировка.Добавить("РегистрБухгалтерии.Проводки"); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    ИначеЕсли КлючиБУ.Количество() > 0 Тогда
        Элемент = Блокировка.Добавить("РегистрБухгалтерии.Проводки"); Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары); Элемент.ИсточникДанных = КлючиБУ;
        Элемент.ИспользоватьИзИсточникаДанных(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура, "Номенклатура");
    КонецЕсли;
    Блокировка.Заблокировать();
КонецПроцедуры



// Возвращает таблицу партий с количеством и стоимостью списания.


Процедура ЗаписатьСписаниеОУ(Движения, ДатаДокумента, Подразделение, Номенклатура, Свойство, Партии) Экспорт
    Для Каждого Стр Из Партии Цикл
        Если Стр.Количество <> 0 Или Стр.Стоимость > 0 Тогда
            Движ = Движения.ОстаткиТоваров.ДобавитьРасход(); Движ.Период = ДатаДокумента; Движ.Подразделение = Подразделение;
            Движ.Номенклатура = Номенклатура; Движ.Свойство = Свойство; Движ.Партия = Стр.Партия; Движ.Количество = Стр.Количество; Движ.Стоимость = Макс(0, Стр.Стоимость);
        КонецЕсли;
        Если Стр.Стоимость < 0 Тогда
            Движ = Движения.ОстаткиТоваров.ДобавитьПриход(); Движ.Период = ДатаДокумента; Движ.Подразделение = Подразделение;
            Движ.Номенклатура = Номенклатура; Движ.Свойство = Свойство; Движ.Партия = Стр.Партия; Движ.Стоимость = -Стр.Стоимость;
        КонецЕсли;
    КонецЦикла;
    Движ = Движения.ОстаткиПодразделений.ДобавитьРасход(); Движ.Период = ДатаДокумента; Движ.Подразделение = Подразделение;
    Движ.Номенклатура = Номенклатура; Движ.Свойство = Свойство; Движ.Количество = Партии.Итог("Количество"); Движ.Стоимость = Партии.Итог("Стоимость");
КонецПроцедуры

// Все складские остатки и стоимость по номенклатуре берутся непосредственно из регистра бухгалтерии.
Функция ОстаткиБухгалтерии(Момент, НоменклатураДляОтбора) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ВЫРАЗИТЬ(Складские.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
    | ВЫРАЗИТЬ(Складские.Субконто2 КАК Справочник.Склады) КАК Склад,
    | Складские.КоличествоОстатокДт КАК Количество, ЕСТЬNULL(ОстаткиПоТовару.СуммаОстатокДт, 0) КАК Стоимость
    |ИЗ РегистрБухгалтерии.Проводки.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 В (&Товары)) КАК Складские
    | ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Проводки.Остатки(&Момент, Счет = &Счет, &Номенклатура, Субконто1 В (&Товары)) КАК ОстаткиПоТовару
    | ПО Складские.Субконто1 = ОстаткиПоТовару.Субконто1";
    Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    ВидНоменклатуры = Новый Массив; ВидНоменклатуры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Запрос.УстановитьПараметр("Виды", Виды); Запрос.УстановитьПараметр("Товары", НоменклатураДляОтбора); Запрос.УстановитьПараметр("Номенклатура", ВидНоменклатуры); Запрос.УстановитьПараметр("Момент", Момент);
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
    Данные = Запрос.Выполнить().Выгрузить();
    УжеУчтены = Новый Соответствие;
    Для Каждого Стр Из Данные Цикл
        Если УжеУчтены.Получить(Стр.Номенклатура) = Неопределено Тогда УжеУчтены.Вставить(Стр.Номенклатура, Истина);
        Иначе Стр.Стоимость = 0; КонецЕсли;
    КонецЦикла;
    Возврат Данные;
КонецФункции

Функция ГруппаАналогов(Номенклатура, Связи, Артикулы) Экспорт
    Группа = Новый Массив; Группа.Добавить(Номенклатура); Индекс = 0;
    Пока Индекс < Группа.Количество() Цикл
        Текущий = Группа[Индекс];
        Для Каждого Связь Из Связи Цикл
            Другой = Неопределено;
            Если Связь.Номенклатура = Текущий Тогда Другой = Связь.Аналог;
            ИначеЕсли Связь.Аналог = Текущий Тогда Другой = Связь.Номенклатура; КонецЕсли;
            Если Другой <> Неопределено И Группа.Найти(Другой) = Неопределено Тогда Группа.Добавить(Другой); КонецЕсли;
        КонецЦикла;
        Индекс = Индекс + 1;
    КонецЦикла;
    Кандидаты = Новый ТаблицаЗначений; Кандидаты.Колонки.Добавить("Номенклатура"); Кандидаты.Колонки.Добавить("Артикул");
    Для Каждого Элемент Из Группа Цикл
        Если Элемент <> Номенклатура Тогда Стр = Кандидаты.Добавить(); Стр.Номенклатура = Элемент; Стр.Артикул = Артикулы.Получить(Элемент); КонецЕсли;
    КонецЦикла;
    Кандидаты.Сортировать("Артикул, Номенклатура");
    Результат = Новый Массив; Результат.Добавить(Номенклатура);
    Для Каждого Стр Из Кандидаты Цикл Результат.Добавить(Стр.Номенклатура); КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ЗагрузитьПартии(Момент, Ключи) Экспорт
    Результат = Новый ТаблицаЗначений;
    Если Ключи.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Ключи.Подразделение КАК Подразделение, Ключи.Номенклатура КАК Номенклатура, Ключи.Свойство КАК Свойство
    |ПОМЕСТИТЬ ВТКлючи ИЗ &Ключи КАК Ключи ИНДЕКСИРОВАТЬ ПО Подразделение, Номенклатура, Свойство;
    |ВЫБРАТЬ Остатки.Подразделение КАК Подразделение, Остатки.Номенклатура КАК Номенклатура, Остатки.Свойство КАК Свойство,
    | Остатки.Партия КАК Партия, Остатки.КоличествоОстаток КАК Количество, Остатки.СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиТоваров.Остатки(&Момент, Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТКлючи) И Подразделение В (ВЫБРАТЬ Подразделение ИЗ ВТКлючи) И Свойство В (ВЫБРАТЬ Свойство ИЗ ВТКлючи)) КАК Остатки
    | ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКлючи КАК Ключи ПО Остатки.Подразделение = Ключи.Подразделение И Остатки.Номенклатура = Ключи.Номенклатура И Остатки.Свойство = Ключи.Свойство
    |ГДЕ Остатки.КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО Остатки.Партия.Дата, Остатки.Партия";
    Запрос.УстановитьПараметр("Момент", Момент); Запрос.УстановитьПараметр("Ключи", Ключи);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СписатьПартииИзПамяти(Остатки, Подразделение, Номенклатура, Свойство, Количество, Метод, Отказ) Экспорт
    Партии = Остатки.НайтиСтроки(Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Номенклатура, Свойство));
    Итого = 0; ВсегоСтоимость = 0;
    Для Каждого Партия Из Партии Цикл Итого = Итого + Партия.Количество; ВсегоСтоимость = ВсегоСтоимость + Партия.Стоимость; КонецЦикла;
    Результат = Новый ТаблицаЗначений; Результат.Колонки.Добавить("Партия"); Результат.Колонки.Добавить("Количество"); Результат.Колонки.Добавить("Стоимость");
    Если Количество <= 0 Или Итого < Количество Тогда
        Отказ = Истина; Сообщить("Недостаточно товара " + Строка(Номенклатура) + " в подразделении " + Строка(Подразделение)); Возврат Результат;
    КонецЕсли;
    Осталось = Количество; ОстатокБазы = Итого; Списания = Новый Соответствие;
    Для Индекс = 0 По Партии.Количество() - 1 Цикл
        Если Осталось <= 0 Тогда Прервать; КонецЕсли;
        НомерПартии = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, Партии.Количество() - 1 - Индекс, Индекс); Партия = Партии[НомерПартии];
        Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
            Взять = ?(ОстатокБазы = Партия.Количество, Осталось, Окр(Осталось * Партия.Количество / ОстатокБазы, 3));
        Иначе Взять = Мин(Осталось, Партия.Количество); КонецЕсли;
        Взять = Мин(Взять, Партия.Количество); ОстатокБазы = ОстатокБазы - Партия.Количество;
        Если Взять <= 0 Тогда Продолжить; КонецЕсли;
        Списания.Вставить(Партия.Партия, Взять); Осталось = Осталось - Взять;
    КонецЦикла;
    Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
        СтоимостьРасхода = ?(Количество = Итого, ВсегоСтоимость, Окр(ВсегоСтоимость * Количество / Итого, 2));
        ОстатокСтоимость = ВсегоСтоимость - СтоимостьРасхода; ОстатокКоличество = Итого - Количество;
        Для Каждого Партия Из Партии Цикл
            Взять = Списания.Получить(Партия.Партия); Если Взять = Неопределено Тогда Взять = 0; КонецЕсли;
            ОстатокПартии = Партия.Количество - Взять; НоваяСтоимость = 0;
            Если ОстатокПартии > 0 Тогда
                НоваяСтоимость = ?(ОстатокПартии = ОстатокКоличество, ОстатокСтоимость, Окр(ОстатокСтоимость * ОстатокПартии / ОстатокКоличество, 2));
                ОстатокСтоимость = ОстатокСтоимость - НоваяСтоимость; ОстатокКоличество = ОстатокКоличество - ОстатокПартии;
            КонецЕсли;
            РазницаСтоимости = Партия.Стоимость - НоваяСтоимость;
            Если Взять <> 0 Или РазницаСтоимости <> 0 Тогда Стр = Результат.Добавить(); Стр.Партия = Партия.Партия; Стр.Количество = Взять; Стр.Стоимость = РазницаСтоимости; КонецЕсли;
            Партия.Количество = ОстатокПартии; Партия.Стоимость = НоваяСтоимость;
        КонецЦикла;
    Иначе
        Для Каждого Партия Из Партии Цикл
            Взять = Списания.Получить(Партия.Партия); Если Взять = Неопределено Тогда Продолжить; КонецЕсли;
            Стоимость = ?(Взять = Партия.Количество, Партия.Стоимость, Окр(Партия.Стоимость * Взять / Партия.Количество, 2));
            Стр = Результат.Добавить(); Стр.Партия = Партия.Партия; Стр.Количество = Взять; Стр.Стоимость = Стоимость;
            Партия.Количество = Партия.Количество - Взять; Партия.Стоимость = Партия.Стоимость - Стоимость;
        КонецЦикла;
    КонецЕсли;
    Возврат Результат;
КонецФункции

// При перепроведении блокируем также старые ключи, которые исчезнут из регистра.
Процедура ДобавитьСтарыеКлючи(Движения, КлючиОУ, КлючиБУ) Экспорт
    Движения.ОстаткиТоваров.Прочитать();
    Для Каждого Движ Из Движения.ОстаткиТоваров Цикл
        Ключ = КлючиОУ.Добавить(); Ключ.Подразделение = Движ.Подразделение; Ключ.Номенклатура = Движ.Номенклатура; Ключ.Свойство = Движ.Свойство;
    КонецЦикла;
    Движения.ОстаткиТоваров.Очистить();
    Движения.ОстаткиПодразделений.Прочитать();
    Для Каждого Движ Из Движения.ОстаткиПодразделений Цикл Ключ = КлючиОУ.Добавить(); Ключ.Подразделение = Движ.Подразделение; Ключ.Номенклатура = Движ.Номенклатура; Ключ.Свойство = Движ.Свойство; КонецЦикла;
    Движения.ОстаткиПодразделений.Очистить();
    Движения.Проводки.Прочитать();
    Для Каждого Движ Из Движения.Проводки Цикл
        Если Движ.СчетДт = ПланыСчетов.Управленческий.Товары Тогда
            Ключ = КлючиБУ.Добавить(); Ключ.Номенклатура = Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура];
        КонецЕсли;
        Если Движ.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
            Ключ = КлючиБУ.Добавить(); Ключ.Номенклатура = Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура];
        КонецЕсли;
    КонецЦикла;
    Движения.Проводки.Очистить();
КонецПроцедуры

Процедура ДобавитьСтарыеКлючиОУ(Движения, КлючиОУ) Экспорт
    Движения.ОстаткиТоваров.Прочитать();
    Для Каждого Движ Из Движения.ОстаткиТоваров Цикл
        Ключ = КлючиОУ.Добавить(); Ключ.Подразделение = Движ.Подразделение; Ключ.Номенклатура = Движ.Номенклатура; Ключ.Свойство = Движ.Свойство;
    КонецЦикла;
    Движения.ОстаткиТоваров.Очистить();
    Движения.ОстаткиПодразделений.Прочитать();
    Для Каждого Движ Из Движения.ОстаткиПодразделений Цикл Ключ = КлючиОУ.Добавить(); Ключ.Подразделение = Движ.Подразделение; Ключ.Номенклатура = Движ.Номенклатура; Ключ.Свойство = Движ.Свойство; КонецЦикла;
    Движения.ОстаткиПодразделений.Очистить();
КонецПроцедуры

Функция Политики(ДатаДокумента, Ключи) Экспорт
    Подразделения = Новый Массив;
    Для Каждого Ключ Из Ключи Цикл Если Подразделения.Найти(Ключ.Подразделение) = Неопределено Тогда Подразделения.Добавить(Ключ.Подразделение); КонецЕсли; КонецЦикла;
    Результат = Новый Соответствие; Если Подразделения.Количество() = 0 Тогда Возврат Результат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Способ ИЗ РегистрСведений.УчетнаяПолитикаПодразделений.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
    Запрос.УстановитьПараметр("Дата", ДатаДокумента); Запрос.УстановитьПараметр("Подразделения", Подразделения); Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл Результат.Вставить(Выборка.Подразделение, Выборка.Способ); КонецЦикла;
    Возврат Результат;
КонецФункции

// Проверяем и последующие движения: ввод задним числом не должен создавать отрицательный остаток позже.
Процедура ПроверитьХронологиюОУ(Ключи, Начало, Отказ) Экспорт
    Если Ключи.Количество() = 0 Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Ключи.Подразделение КАК Подразделение, Ключи.Номенклатура КАК Номенклатура, Ключи.Свойство КАК Свойство ПОМЕСТИТЬ ВТКлючи ИЗ &Ключи КАК Ключи ИНДЕКСИРОВАТЬ ПО Подразделение, Номенклатура, Свойство;
    |ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Подразделение КАК Подразделение, Остатки.Номенклатура КАК Номенклатура
    |ИЗ РегистрНакопления.ОстаткиПодразделений.ОстаткиИОбороты(&Начало, &Конец, Секунда, , Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТКлючи) И Подразделение В (ВЫБРАТЬ Подразделение ИЗ ВТКлючи) И Свойство В (ВЫБРАТЬ Свойство ИЗ ВТКлючи)) КАК Остатки
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКлючи КАК Ключи ПО Остатки.Подразделение = Ключи.Подразделение И Остатки.Номенклатура = Ключи.Номенклатура И Остатки.Свойство = Ключи.Свойство
    |ГДЕ Остатки.КоличествоКонечныйОстаток < 0 ИЛИ Остатки.СтоимостьКонечныйОстаток < 0 ИЛИ (Остатки.КоличествоКонечныйОстаток = 0 И Остатки.СтоимостьКонечныйОстаток <> 0);
    |ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Подразделение КАК Подразделение, Остатки.Номенклатура КАК Номенклатура
    |ИЗ РегистрНакопления.ОстаткиТоваров.ОстаткиИОбороты(&Начало, &Конец, Секунда, , Номенклатура В (ВЫБРАТЬ Номенклатура ИЗ ВТКлючи) И Подразделение В (ВЫБРАТЬ Подразделение ИЗ ВТКлючи) И Свойство В (ВЫБРАТЬ Свойство ИЗ ВТКлючи)) КАК Остатки
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКлючи КАК Ключи ПО Остатки.Подразделение = Ключи.Подразделение И Остатки.Номенклатура = Ключи.Номенклатура И Остатки.Свойство = Ключи.Свойство
    |ГДЕ Остатки.КоличествоКонечныйОстаток < 0 ИЛИ Остатки.СтоимостьКонечныйОстаток < 0 ИЛИ (Остатки.КоличествоКонечныйОстаток = 0 И Остатки.СтоимостьКонечныйОстаток <> 0)";
    Запрос.УстановитьПараметр("Ключи", Ключи); Запрос.УстановитьПараметр("Начало", НачалоДня(Начало)); Запрос.УстановитьПараметр("Конец", Дата(3999,12,31,23,59,59));
    Результаты = Запрос.ВыполнитьПакет();
    Если Не Результаты[1].Пустой() Или Не Результаты[2].Пустой() Тогда Отказ = Истина; Сообщить("Изменение приводит к некорректному последующему остатку; скорректируйте и перепроведите последующие документы."); КонецЕсли;
КонецПроцедуры

Процедура ПроверитьХронологиюБУ(Ключи, Начало, Отказ) Экспорт
    Если Ключи.Количество() = 0 Тогда Возврат; КонецЕсли;
    Товары = Ключи.ВыгрузитьКолонку("Номенклатура"); Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    ТолькоТовар = Новый Массив; ТолькоТовар.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Субконто1 КАК Номенклатура ИЗ РегистрБухгалтерии.Проводки.ОстаткиИОбороты(&Начало, &Конец, Секунда, , Счет = &Счет, &Виды, Субконто1 В (&Товары)) КАК Остатки
    |ГДЕ Остатки.КоличествоКонечныйОстаток < 0;
    |ВЫБРАТЬ ПЕРВЫЕ 1 Остатки.Субконто1 КАК Номенклатура ИЗ РегистрБухгалтерии.Проводки.ОстаткиИОбороты(&Начало, &Конец, Секунда, , Счет = &Счет, &ТолькоТовар, Субконто1 В (&Товары)) КАК Остатки
    |ГДЕ Остатки.СуммаКонечныйОстаток < 0 ИЛИ (Остатки.КоличествоКонечныйОстаток = 0 И Остатки.СуммаКонечныйОстаток <> 0)";
    Запрос.УстановитьПараметр("Начало", НачалоДня(Начало)); Запрос.УстановитьПараметр("Конец", Дата(3999,12,31,23,59,59)); Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
    Запрос.УстановитьПараметр("Виды", Виды); Запрос.УстановитьПараметр("ТолькоТовар", ТолькоТовар); Запрос.УстановитьПараметр("Товары", Товары);
    Результаты = Запрос.ВыполнитьПакет();
    Если Не Результаты[0].Пустой() Или Не Результаты[1].Пустой() Тогда Отказ = Истина; Сообщить("Изменение приводит к некорректному последующему бухгалтерскому остатку; скорректируйте и перепроведите последующие документы."); КонецЕсли;
КонецПроцедуры

Процедура ДобавитьСтарыеКлючиБУ(Движения, КлючиБУ) Экспорт
    Движения.Проводки.Прочитать();
    Для Каждого Движ Из Движения.Проводки Цикл
        Если Движ.СчетДт = ПланыСчетов.Управленческий.Товары Тогда Ключ = КлючиБУ.Добавить(); Ключ.Номенклатура = Движ.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]; КонецЕсли;
        Если Движ.СчетКт = ПланыСчетов.Управленческий.Товары Тогда Ключ = КлючиБУ.Добавить(); Ключ.Номенклатура = Движ.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура]; КонецЕсли;
    КонецЦикла;
    Движения.Проводки.Очистить();
КонецПроцедуры
