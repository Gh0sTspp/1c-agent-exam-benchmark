Процедура ПередЗаписью(Отказ, Замещение)
    Ключи = Новый ТаблицаЗначений;
    Ключи.Колонки.Добавить("Блок", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Ключи.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
    Ключи.Колонки.Добавить("Начало", Новый ОписаниеТипов("Дата"));
    Ключи.Колонки.Добавить("Конец", Новый ОписаниеТипов("Дата"));
    Для Каждого Стр Из ЭтотОбъект Цикл
        Если Стр.Количество < 0 Тогда Отказ = Истина; Сообщить("Количество в спецификации не может быть отрицательным"); КонецЕсли;
        Если Не ЗначениеЗаполнено(Стр.СистемныйБлок) Тогда Отказ = Истина; Сообщить("Укажите системный блок"); КонецЕсли;
        Ключ = Ключи.Добавить(); Ключ.Блок = Стр.СистемныйБлок; Ключ.Дата = НачалоДня(Стр.Период);
        Ключ.Начало = НачалоНедели(Стр.Период); Ключ.Конец = КонецНедели(Стр.Период);
    КонецЦикла;
    Если Отказ Или Ключи.Количество() = 0 Тогда Возврат; КонецЕсли;
    Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрСведений.Спецификации");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = Ключи; Элемент.ИспользоватьИзИсточникаДанных("СистемныйБлок", "Блок"); Блокировка.Заблокировать();
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Блок, Дата, Начало, Конец ПОМЕСТИТЬ ВТКлючи ИЗ &Ключи КАК Ключи ИНДЕКСИРОВАТЬ ПО Блок, Начало;
    |ВЫБРАТЬ ПЕРВЫЕ 1 Один.Блок КАК Блок ИЗ ВТКлючи КАК Один ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТКлючи КАК Другой
    |ПО Один.Блок = Другой.Блок И Один.Начало = Другой.Начало И Один.Дата <> Другой.Дата;
    |ВЫБРАТЬ ПЕРВЫЕ 1 Ключи.Блок КАК Блок ИЗ ВТКлючи КАК Ключи ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Спецификации КАК Состав
    |ПО Ключи.Блок = Состав.СистемныйБлок И Состав.Период МЕЖДУ Ключи.Начало И Ключи.Конец И Состав.Период <> Ключи.Дата");
    Запрос.УстановитьПараметр("Ключи", Ключи); Результаты = Запрос.ВыполнитьПакет();
    Если Не Результаты[1].Пустой() Или Не Результаты[2].Пустой() Тогда Отказ = Истина; Сообщить("Спецификация блока может изменяться только один раз в неделю"); КонецЕсли;
КонецПроцедуры
