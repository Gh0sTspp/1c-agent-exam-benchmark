&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
    КонецПериода = КонецМесяца(НачалоПериода);
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
    СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
    Начало = НачалоПериода; Конец = КонецПериода;
    Если Конец < Начало Тогда ВызватьИсключение "Конец периода меньше начала."; КонецЕсли;
    Если Не ЗначениеЗаполнено(Подразделение) Тогда ВызватьИсключение "Укажите подразделение."; КонецЕсли;
    Данные = Отчеты.ВедомостьПоПодразделению.ПолучитьДанные(Начало, Конец, Подразделение);
    Результат = УчетСервер.ПечатьОтчета("ВедомостьПоПодразделению", Данные, Начало, Конец, Подразделение);
КонецПроцедуры
