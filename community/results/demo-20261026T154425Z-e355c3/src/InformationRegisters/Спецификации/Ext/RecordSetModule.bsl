
Процедура ПередЗаписью(Отказ, Замещение)
    Если Количество() = 0 Тогда Возврат; КонецЕсли;
    Ключи = Новый ТаблицаЗначений;
    Ключи.Колонки.Добавить("СистемныйБлок", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Ключи.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
    Ключи.Колонки.Добавить("НачалоНедели", Новый ОписаниеТипов("Дата"));
    Для Каждого Стр Из ЭтотОбъект Цикл
        Если Не ЗначениеЗаполнено(Стр.СистемныйБлок) Или Не ЗначениеЗаполнено(Стр.Номенклатура) Или Стр.Количество <= 0 Тогда
            УчетСервер.Ошибка("Укажите системный блок, деталь и положительное количество в спецификации.", Отказ); Возврат;
        КонецЕсли;
        Ключ = Ключи.Добавить();
        Ключ.СистемныйБлок = Стр.СистемныйБлок; Ключ.Период = НачалоДня(Стр.Период);
        Ключ.НачалоНедели = НачалоНедели(Стр.Период);
    КонецЦикла;
    Ключи.Свернуть("СистемныйБлок,Период,НачалоНедели");
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.Спецификации");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = Ключи;
    Элемент.ИспользоватьИзИсточникаДанных("СистемныйБлок", "СистемныйБлок");
    Блокировка.Заблокировать();
    Запрос = Новый Запрос(
    "ВЫБРАТЬ * ПОМЕСТИТЬ Ключи ИЗ &Ключи КАК К;
    |ВЫБРАТЬ ПЕРВЫЕ 1 К.СистемныйБлок
    |ИЗ Ключи КАК К ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Спецификации КАК С
    |ПО К.СистемныйБлок = С.СистемныйБлок И С.Период >= К.НачалоНедели
    | И С.Период < ДОБАВИТЬКДАТЕ(К.НачалоНедели, ДЕНЬ, 7) И С.Период <> К.Период
    |ОБЪЕДИНИТЬ
    |ВЫБРАТЬ К.СистемныйБлок ИЗ Ключи КАК К ВНУТРЕННЕЕ СОЕДИНЕНИЕ Ключи КАК Д
    |ПО К.СистемныйБлок = Д.СистемныйБлок И К.НачалоНедели = Д.НачалоНедели И К.Период <> Д.Период");
    Запрос.УстановитьПараметр("Ключи", Ключи);
    Если Не Запрос.Выполнить().Пустой() Тогда
        УчетСервер.Ошибка("В одной календарной неделе для блока допустима только одна дата версии спецификации.", Отказ);
    КонецЕсли;
КонецПроцедуры
