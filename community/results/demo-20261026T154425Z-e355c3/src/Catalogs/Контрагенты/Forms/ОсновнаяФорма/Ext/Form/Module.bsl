#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    ОбновитьМенеджераНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьМенеджераНаСервере()
    СохранитьЗначенияПолей(Объект);
    ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьЗначенияПолей(ТекущийОбъект);
КонецПроцедуры

&НаСервере
Процедура СохранитьЗначенияПолей(ДанныеОбъекта)
    Для Каждого Описание Из ОписаниеДопПолей Цикл
        НайденныеСтроки = ДанныеОбъекта.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения", Описание.ВидСведения));
        СтрокаЗначения = ?(НайденныеСтроки.Количество() = 0, Неопределено, НайденныеСтроки[0]);
        Если СтрокаЗначения = Неопределено Тогда
            СтрокаЗначения = ДанныеОбъекта.ДополнительныеСведения.Добавить();
            СтрокаЗначения.ВидСведения = Описание.ВидСведения;
        КонецЕсли;
        СтрокаЗначения.Значение = ЭтотОбъект[Описание.ИмяПоля];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
    УдаляемыеРеквизиты = Новый Массив;
    Для Каждого Описание Из ОписаниеДопПолей Цикл
        Поле = Элементы.Найти(Описание.ИмяПоля);
        Если Поле <> Неопределено Тогда Элементы.Удалить(Поле); КонецЕсли;
        УдаляемыеРеквизиты.Добавить(Описание.ИмяПоля);
    КонецЦикла;
    Если УдаляемыеРеквизиты.Количество() > 0 Тогда ИзменитьРеквизиты(Новый Массив, УдаляемыеРеквизиты); КонецЕсли;
    ОписаниеДопПолей.Очистить();
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ РАЗЛИЧНЫЕ Т.ВидСведения ПОМЕСТИТЬ Виды
    |ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения КАК Т
    |ГДЕ Т.Ссылка = &Менеджер;
    |ВЫБРАТЬ Т.ВидСведения КАК ВидСведения,
    | Т.ВидСведения.Наименование КАК Наименование, Т.ВидСведения.ТипЗначения КАК ТипЗначения
    |ИЗ Виды КАК Т
    |УПОРЯДОЧИТЬ ПО Наименование");
    Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
    Сведения = Запрос.Выполнить().Выгрузить();
    НовыеРеквизиты = Новый Массив;
    Для Каждого Сведение Из Сведения Цикл
        ИмяПоля = "ДопПоле" + Строка(Сведения.Индекс(Сведение));
        НовыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяПоля, Сведение.ТипЗначения));
        Описание = ОписаниеДопПолей.Добавить(); Описание.ИмяПоля = ИмяПоля; Описание.ВидСведения = Сведение.ВидСведения;
    КонецЦикла;
    ИзменитьРеквизиты(НовыеРеквизиты);
    Для Каждого Сведение Из Сведения Цикл
        ИмяПоля = "ДопПоле" + Строка(Сведения.Индекс(Сведение));
        Поле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Если Сведение.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияХарактеристик")) И Сведение.ТипЗначения.Типы().Количество() = 1 Тогда
            МассивПараметровПоля = Новый Массив;
            МассивПараметровПоля.Добавить(Новый ПараметрВыбора("Отбор.Владелец", Сведение.ВидСведения));
            Поле.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметровПоля);
        КонецЕсли;
        Поле.ПутьКДанным = ИмяПоля; Поле.Заголовок = Сведение.Наименование;
        Поле.УстановитьДействие("ПриИзменении", "Подключаемый_ДопПолеПриИзменении");
        НайденныеСтроки = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения", Сведение.ВидСведения));
        ЗначениеСведения = ?(НайденныеСтроки.Количество() = 0, Неопределено, НайденныеСтроки[0]);
        Если ЗначениеСведения <> Неопределено Тогда ЭтотОбъект[ИмяПоля] = Сведение.ТипЗначения.ПривестиЗначение(ЗначениеСведения.Значение); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДопПолеПриИзменении(Элемент)
    Модифицированность = Истина;
КонецПроцедуры
