
Процедура Ошибка(Текст, Отказ) Экспорт
    Отказ = Истина;
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.Сообщить();
КонецПроцедуры

Функция СуммаСтроки(Строка) Экспорт
    Если Строка.Сумма = 0 И Строка.Цена <> 0 Тогда
        Возврат Окр(Строка.Количество * Строка.Цена, 2);
    КонецЕсли;
    Возврат Строка.Сумма;
КонецФункции

Функция ПроверитьСтроки(Таблица, Отказ) Экспорт
    Для Каждого Строка Из Таблица Цикл
        Если Не ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество <= 0 Тогда
            Ошибка("Укажите номенклатуру и положительное количество. Строка " + Строка.НомерСтроки, Отказ);
        КонецЕсли;
    КонецЦикла;
    Возврат Не Отказ;
КонецФункции

Функция ТаблицаПотребностей() Экспорт
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
    Т.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    Т.Колонки.Добавить("СистемныйБлок", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Возврат Т;
КонецФункции

Процедура ЗаблокироватьОстатки(Т) Экспорт
    Если Т.Количество() = 0 Тогда Возврат; КонецЕсли;
    Т.Сортировать("Подразделение, Номенклатура, Свойство");
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = Т;
    Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
    Элемент.ИспользоватьИзИсточникаДанных("Свойство", "Свойство");
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ОстаткиДляСписания(Документ, Потребности) Экспорт
    Документ.Движения.ОстаткиНоменклатуры.Прочитать();
    КлючиКонтроля = Потребности.Скопировать();
    НачалоКонтроля = Документ.Дата;
    Для Каждого СтароеДвижение Из Документ.Движения.ОстаткиНоменклатуры Цикл
        ЗаполнитьЗначенияСвойств(КлючиКонтроля.Добавить(), СтароеДвижение);
        НачалоКонтроля = Мин(НачалоКонтроля, СтароеДвижение.Период);
    КонецЦикла;
    ЗаблокироватьОстатки(КлючиКонтроля);
    Документ.ДополнительныеСвойства.Вставить("ОперативныеКлючиКонтроля", КлючиКонтроля);
    Документ.ДополнительныеСвойства.Вставить("НачалоОперативногоКонтроля", НачалоКонтроля);
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    | КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
    | Подразделение В (&Подразделения) И Номенклатура В (&Номенклатура))
    |ГДЕ КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО Партия.Дата, Партия");
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Подразделения", Потребности.ВыгрузитьКолонку("Подразделение"));
    Запрос.УстановитьПараметр("Номенклатура", Потребности.ВыгрузитьКолонку("Номенклатура"));
    // Изменяемая таблица распределяет общий остаток между повторяющимися строками.
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Политики(ДатаДокумента, Подразделения) Экспорт
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Подразделение, Метод
    |ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
    Запрос.УстановитьПараметр("Дата", ДатаДокумента);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ДвижениеЗапаса(Набор, ДатаДокумента, Вид, Подразделение, Товар, Свойство, Партия, Количество, Стоимость) Экспорт
    Движение = Набор.Добавить();
    Движение.Период = ДатаДокумента;
    Движение.ВидДвижения = Вид;
    Движение.Подразделение = Подразделение;
    Движение.Номенклатура = Товар;
    Движение.Свойство = Свойство;
    Движение.Партия = Партия;
    Движение.Количество = Количество;
    Движение.Стоимость = Стоимость;
КонецПроцедуры

Функция СписатьЗапас(Документ, Остатки, Подразделение, Товар, Свойство, Количество, Метод, Отказ) Экспорт
    Строки = Остатки.НайтиСтроки(Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство));
    ВсегоКоличество = 0;
    ВсегоСтоимость = 0;
    Для Каждого Стр Из Строки Цикл
        ВсегоКоличество = ВсегоКоличество + Стр.Количество;
        ВсегоСтоимость = ВсегоСтоимость + Стр.Стоимость;
    КонецЦикла;
    Если ВсегоКоличество < Количество Тогда
        Ошибка("Недостаточно " + Товар + " (" + Свойство + ") в подразделении " + Подразделение
            + ". Требуется " + Количество + ", доступно " + ВсегоКоличество, Отказ);
        Возврат 0;
    КонецЕсли;
    ПоСредней = Метод = Перечисления.УчетнаяПолитика.ПоСредней;
    КСписанию = ?(ПоСредней, ?(Количество = ВсегоКоличество, ВсегоСтоимость,
        Окр(ВсегоСтоимость * Количество / ВсегоКоличество, 2)), 0);
    Осталось = Количество;
    Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
        ОбратныеСтроки = Новый Массив;
        Индекс = Строки.Количество() - 1;
        Пока Индекс >= 0 Цикл
            ОбратныеСтроки.Добавить(Строки[Индекс]);
            Индекс = Индекс - 1;
        КонецЦикла;
        Строки = ОбратныеСтроки;
    КонецЕсли;
    ИтогСтоимость = 0;
    ОстатокСтоимость = ВсегоСтоимость - КСписанию;
    ОстатокКоличество = ВсегоКоличество - Количество;
    Для Каждого Стр Из Строки Цикл
        Взять = Мин(Стр.Количество, Осталось);
        НовоеКоличество = Стр.Количество - Взять;
        Если ПоСредней Тогда
            // После усреднения партии получают одинаковую учетную цену.
            // Последняя ненулевая партия забирает копеечный остаток стоимости.
            НоваяСтоимость = ?(НовоеКоличество = 0, 0,
                ?(НовоеКоличество = ОстатокКоличество, ОстатокСтоимость,
                Окр(ОстатокСтоимость * НовоеКоличество / ОстатокКоличество, 2)));
            Стоимость = Стр.Стоимость - НоваяСтоимость;
            ОстатокСтоимость = ОстатокСтоимость - НоваяСтоимость;
            ОстатокКоличество = ОстатокКоличество - НовоеКоличество;
        Иначе
            Стоимость = ?(Взять = Стр.Количество, Стр.Стоимость,
                Окр(Стр.Стоимость * Взять / Стр.Количество, 2));
            НоваяСтоимость = Стр.Стоимость - Стоимость;
        КонецЕсли;
        Если Взять <> 0 Или Стоимость <> 0 Тогда
            ДвижениеЗапаса(Документ.Движения.ОстаткиНоменклатуры, Документ.Дата,
                ВидДвиженияНакопления.Расход, Подразделение, Товар, Свойство, Стр.Партия, Взять, Стоимость);
        КонецЕсли;
        Стр.Количество = НовоеКоличество;
        Стр.Стоимость = НоваяСтоимость;
        Осталось = Осталось - Взять;
        ИтогСтоимость = ИтогСтоимость + Стоимость;
        Если Не ПоСредней И Осталось = 0 Тогда Прервать; КонецЕсли;
    КонецЦикла;
    Возврат ИтогСтоимость;
КонецФункции

Процедура КонтрольОстатков(Документ, Потребности, Отказ, НачалоКонтроля = Неопределено) Экспорт
    Если НачалоКонтроля = Неопределено Тогда
        КлючиКонтроля = Неопределено;
        Если Документ.ДополнительныеСвойства.Свойство("ОперативныеКлючиКонтроля", КлючиКонтроля) Тогда
            Потребности = КлючиКонтроля;
        КонецЕсли;
        НачалоКонтроля = Документ.Дата;
        Документ.ДополнительныеСвойства.Свойство("НачалоОперативногоКонтроля", НачалоКонтроля);
    КонецЕсли;
    Если Потребности.Количество() = 0 Тогда Возврат; КонецЕсли;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Номенклатура, Подразделение, Свойство, Партия, Регистратор,
    | КоличествоКонечныйОстаток, СтоимостьКонечныйОстаток
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.ОстаткиИОбороты(
    | &Начало, &Граница, Регистратор, Движения,
    | Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |ГДЕ КоличествоКонечныйОстаток < 0 ИЛИ СтоимостьКонечныйОстаток < 0");
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоКонтроля));
    Запрос.УстановитьПараметр("Граница", Дата(3999,12,31));
    Запрос.УстановитьПараметр("Подразделения", Потребности.ВыгрузитьКолонку("Подразделение"));
    Запрос.УстановитьПараметр("Товары", Потребности.ВыгрузитьКолонку("Номенклатура"));
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ошибка("Изменение приводит к отрицательному остатку: " + Выборка.Номенклатура + ", " + Выборка.Подразделение
            + ". Нарушение возникает при документе " + Выборка.Регистратор, Отказ);
    КонецЦикла;
КонецПроцедуры

Процедура ПриходОперативный(Документ, Отказ) Экспорт
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Если Не ЗначениеЗаполнено(Документ.Подразделение) Тогда Возврат; КонецЕсли;
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Сумма = СуммаСтроки(Стр);
        Если Сумма < 0 Тогда Ошибка("Сумма прихода не может быть отрицательной.", Отказ); Возврат; КонецЕсли;
        ДвижениеЗапаса(Документ.Движения.ОстаткиНоменклатуры, Документ.Дата, ВидДвиженияНакопления.Приход,
            Документ.Подразделение, Стр.Номенклатура, Стр.Свойство, Документ.Ссылка, Стр.Количество, Сумма);
    КонецЦикла;
КонецПроцедуры

Процедура ПродажаОперативная(Документ, Отказ) Экспорт
    Т = ТаблицаПотребностей();
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Если ЗначениеЗаполнено(Стр.Подразделение) Тогда
            Н = Т.Добавить(); ЗаполнитьЗначенияСвойств(Н, Стр);
        КонецЕсли;
    КонецЦикла;
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.Продажи.Записывать = Истина;
    Документ.Движения.Продажи.Очистить();
    Если Т.Количество() = 0 Тогда Возврат; КонецЕсли;
    Остатки = ОстаткиДляСписания(Документ, Т);
    ПолитикиПодразделений = Политики(Документ.Дата, Т.ВыгрузитьКолонку("Подразделение"));
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Если Не ЗначениеЗаполнено(Стр.Подразделение) Тогда Продолжить; КонецЕсли;
        Политика = ПолитикиПодразделений.Найти(Стр.Подразделение, "Подразделение");
        Если Политика = Неопределено Тогда
            Ошибка("Не задана учетная политика подразделения " + Стр.Подразделение, Отказ); Продолжить;
        КонецЕсли;
        Стоимость = СписатьЗапас(Документ, Остатки, Стр.Подразделение, Стр.Номенклатура,
            Стр.Свойство, Стр.Количество, Политика.Метод, Отказ);
        Если Отказ Тогда Возврат; КонецЕсли;
        Дв = Документ.Движения.Продажи.Добавить();
        Дв.Период = Документ.Дата; Дв.Номенклатура = Стр.Номенклатура;
        Дв.Количество = Стр.Количество; Дв.Себестоимость = Стоимость; Дв.Выручка = СуммаСтроки(Стр);
    КонецЦикла;
    КонтрольОстатков(Документ, Т, Отказ);
КонецПроцедуры

Процедура Сборка(Документ, Отказ) Экспорт
    Если Не ЗначениеЗаполнено(Документ.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Документ.ПодразделениеПриемник) Тогда
        Ошибка("Укажите подразделения списания и выпуска.", Отказ); Возврат;
    КонецЕсли;
    Если Документ.СистемныеБлоки.Количество() = 0 Тогда Ошибка("Не указан выпуск.", Отказ); Возврат; КонецЕсли;
    Если Не ПроверитьСтроки(Документ.СистемныеБлоки, Отказ) Или Не ПроверитьСтроки(Документ.ДополнительныеДетали, Отказ) Тогда Возврат; КонецЕсли;
    Выпуск = Документ.СистемныеБлоки.Выгрузить();
    Выпуск.Свернуть("Номенклатура", "Количество");
    Выпуск.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Номенклатура, Количество ПОМЕСТИТЬ Выпуск ИЗ &Выпуск КАК Т;
    |ВЫБРАТЬ С.СистемныйБлок, МАКСИМУМ(С.Период) КАК Период
    |ПОМЕСТИТЬ Версии ИЗ РегистрСведений.Спецификации КАК С
    |ГДЕ С.СистемныйБлок В (ВЫБРАТЬ Номенклатура ИЗ Выпуск) И С.Период <= &Дата
    |СГРУППИРОВАТЬ ПО С.СистемныйБлок;
    |ВЫБРАТЬ С.СистемныйБлок, С.Номенклатура, С.Свойство, СУММА(С.Количество * Вып.Количество) КАК Количество
    |ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Версии КАК Р ПО С.СистемныйБлок = Р.СистемныйБлок И С.Период = Р.Период
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ Выпуск КАК Вып ПО С.СистемныйБлок = Вып.Номенклатура
    |СГРУППИРОВАТЬ ПО С.СистемныйБлок, С.Номенклатура, С.Свойство");
    Запрос.УстановитьПараметр("Выпуск", Выпуск);
    Запрос.УстановитьПараметр("Дата", Документ.Дата);
    Состав = Запрос.Выполнить().Выгрузить();
    Т = ТаблицаПотребностей();
    Для Каждого Стр Из Состав Цикл
        Если Стр.Количество <= 0 Тогда Ошибка("В спецификации должно быть положительное количество.", Отказ); Возврат; КонецЕсли;
        Н = Т.Добавить(); ЗаполнитьЗначенияСвойств(Н, Стр); Н.Подразделение = Документ.ПодразделениеИсточник;
    КонецЦикла;
    Для Каждого Стр Из Выпуск Цикл
        Если Состав.Найти(Стр.Номенклатура, "СистемныйБлок") = Неопределено Тогда
            Ошибка("Нет действующей спецификации: " + Стр.Номенклатура, Отказ);
        КонецЕсли;
    КонецЦикла;
    Если Отказ Тогда Возврат; КонецЕсли;
    Для Каждого Стр Из Документ.ДополнительныеДетали Цикл
        Н = Т.Добавить(); ЗаполнитьЗначенияСвойств(Н, Стр); Н.Подразделение = Документ.ПодразделениеИсточник;
    КонецЦикла;
    Остатки = ОстаткиДляСписания(Документ, Т);
    СтоимостьДополнений = 0;
    Для Каждого Стр Из Т Цикл
        Стоимость = СписатьЗапас(Документ, Остатки, Стр.Подразделение, Стр.Номенклатура,
            Стр.Свойство, Стр.Количество, Перечисления.УчетнаяПолитика.ПоСредней, Отказ);
        Если Отказ Тогда Возврат; КонецЕсли;
        Если ЗначениеЗаполнено(Стр.СистемныйБлок) Тогда
            В = Выпуск.Найти(Стр.СистемныйБлок, "Номенклатура");
            В.Стоимость = В.Стоимость + Стоимость;
        Иначе
            СтоимостьДополнений = СтоимостьДополнений + Стоимость;
        КонецЕсли;
    КонецЦикла;
    ВсегоВыпуск = Выпуск.Итог("Количество");
    Для Каждого В Из Выпуск Цикл
        Добавка = ?(В.Количество = ВсегоВыпуск, СтоимостьДополнений,
            Окр(СтоимостьДополнений * В.Количество / ВсегоВыпуск, 2));
        СтоимостьДополнений = СтоимостьДополнений - Добавка; ВсегоВыпуск = ВсегоВыпуск - В.Количество;
        ДвижениеЗапаса(Документ.Движения.ОстаткиНоменклатуры, Документ.Дата, ВидДвиженияНакопления.Приход,
            Документ.ПодразделениеПриемник, В.Номенклатура, Справочники.СвойстваНоменклатуры.ПустаяСсылка(),
            Документ.Ссылка, В.Количество, В.Стоимость + Добавка);
    КонецЦикла;
    КонтрольОстатков(Документ, Т, Отказ);
КонецПроцедуры

Процедура НастроитьПланСчетов() Экспорт
    Счет = ПланыСчетов.Управленческий.Товары.ПолучитьОбъект();
    Если Не Счет.Количественный Или Счет.ВидыСубконто.Количество() <> 2 Тогда
        Счет.Количественный = Истина;
        Счет.ВидыСубконто.Очистить();
        Строка = Счет.ВидыСубконто.Добавить();
        Строка.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
        Строка.ТолькоОбороты = Ложь;
        Строка.Суммовой = Истина; Строка.Количественный = Истина;
        Строка = Счет.ВидыСубконто.Добавить();
        Строка.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склады;
        Строка.ТолькоОбороты = Ложь;
        Строка.Суммовой = Ложь; Строка.Количественный = Истина;
        Счет.Записать();
    КонецЕсли;
    Счет = ПланыСчетов.Управленческий.ПрибылиУбытки.ПолучитьОбъект();
    Если Не Счет.Количественный Или Счет.ВидыСубконто.Количество() <> 2 Тогда
        Счет.Количественный = Истина;
        Счет.ВидыСубконто.Очистить();
        Строка = Счет.ВидыСубконто.Добавить();
        Строка.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
        Строка.ТолькоОбороты = Истина; Строка.Суммовой = Истина; Строка.Количественный = Истина;
        Строка = Счет.ВидыСубконто.Добавить();
        Строка.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Продано;
        Строка.ТолькоОбороты = Истина; Строка.Суммовой = Истина; Строка.Количественный = Истина;
        Счет.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура ПриходБухгалтерский(Документ, Отказ) Экспорт
    Документ.Движения.Управленческий.Записывать = Истина;
    Документ.Движения.Управленческий.Очистить();
    Если Не ЗначениеЗаполнено(Документ.Склад) Тогда Возврат; КонецЕсли;
    НастроитьПланСчетов();
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Сумма = СуммаСтроки(Стр);
        Если Сумма < 0 Тогда Ошибка("Сумма прихода не может быть отрицательной.", Отказ); Возврат; КонецЕсли;
        Дв = Документ.Движения.Управленческий.Добавить();
        Дв.Период = Документ.Дата;
        Дв.СчетДт = ПланыСчетов.Управленческий.Товары;
        Дв.СчетКт = ПланыСчетов.Управленческий.Поставщики;
        Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура;
        Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
        Дв.КоличествоДт = Стр.Количество;
        Дв.Сумма = Сумма;
    КонецЦикла;
КонецПроцедуры

Функция КандидатыНаСписание(Товары) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Номенклатура, Аналог ИЗ РегистрСведений.АналогиНоменклатуры");
    Ребра = Запрос.Выполнить().Выбрать();
    Граф = Новый Соответствие;
    Пока Ребра.Следующий() Цикл
        Для Направление = 0 По 1 Цикл
            Л = ?(Направление = 0, Ребра.Номенклатура, Ребра.Аналог);
            П = ?(Направление = 0, Ребра.Аналог, Ребра.Номенклатура);
            Соседи = Граф.Получить(Л);
            Если Соседи = Неопределено Тогда Соседи = Новый Массив; Граф.Вставить(Л, Соседи); КонецЕсли;
            Соседи.Добавить(П);
        КонецЦикла;
    КонецЦикла;
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Заявлено", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Товар", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Обработано = Новый Соответствие;
    Для Каждого Товар Из Товары Цикл
        Если Обработано.Получить(Товар) <> Неопределено Тогда Продолжить; КонецЕсли;
        Обработано.Вставить(Товар, Истина);
        Очередь = Новый Массив; Очередь.Добавить(Товар);
        Посещены = Новый Соответствие; Посещены.Вставить(Товар, Истина);
        Индекс = 0;
        Пока Индекс < Очередь.Количество() Цикл
            Узел = Очередь[Индекс]; Индекс = Индекс + 1;
            Стр = Т.Добавить(); Стр.Заявлено = Товар; Стр.Товар = Узел;
            Соседи = Граф.Получить(Узел);
            Если Соседи = Неопределено Тогда Продолжить; КонецЕсли;
            Для Каждого Сосед Из Соседи Цикл
                Если Посещены.Получить(Сосед) = Неопределено Тогда
                    Посещены.Вставить(Сосед, Истина); Очередь.Добавить(Сосед);
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
    Возврат Т;
КонецФункции

Процедура ЗаблокироватьТоварыБухгалтерии(Кандидаты) Экспорт
    Кандидаты.Сортировать("Товар");
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрБухгалтерии.Управленческий");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары);
    Элемент.ИсточникДанных = Кандидаты;
    Элемент.ИспользоватьИзИсточникаДанных("Субконто1", "Товар");
    Блокировка.Заблокировать();
КонецПроцедуры

Процедура ПродажаБухгалтерская(Документ, Отказ) Экспорт
    Документ.Движения.Управленческий.Записывать = Истина;
    Если Не ЗначениеЗаполнено(Документ.Склад) Тогда Возврат; КонецЕсли;
    НастроитьПланСчетов();
    Кандидаты = КандидатыНаСписание(Документ.СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
    Ключи = КлючиУчета(Документ, Истина, Ложь);
    Для Каждого Кандидат Из Кандидаты Цикл
        ДобавитьБухгалтерскийКлюч(Ключи.Бухгалтерские, Кандидат.Товар, Документ.Склад);
    КонецЦикла;
    ЗаблокироватьТоварыБухгалтерии(Ключи.Бухгалтерские);
    Документ.Движения.Управленческий.Очистить();
    Документ.Движения.Управленческий.Записать();
    ВидыСубконто = Новый Массив;
    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Заявлено, Товар ПОМЕСТИТЬ Кандидаты ИЗ &Кандидаты КАК К;
    |ВЫБРАТЬ К.Заявлено, К.Товар,
    | ВЫБОР КОГДА К.Заявлено = К.Товар ТОГДА 0 ИНАЧЕ 1 КОНЕЦ КАК Приоритет,
    | К.Товар.Артикул КАК Артикул
    |ИЗ Кандидаты КАК К УПОРЯДОЧИТЬ ПО Заявлено, Приоритет, Артикул, Товар;
    |ВЫБРАТЬ Субконто1 КАК Товар, КоличествоОстаток КАК Количество
    |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, ,
    | Субконто1 В (&Товары) И Субконто2 = &Склад);
    |ВЫБРАТЬ Субконто1 КАК Товар, СуммаОстаток КАК Сумма, КоличествоОстаток КАК Количество
    |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, &ВидыСубконто,
    | Субконто1 В (&Товары))");
    Запрос.УстановитьПараметр("Кандидаты", Кандидаты);
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
    Запрос.УстановитьПараметр("Товары", Кандидаты.ВыгрузитьКолонку("Товар"));
    Запрос.УстановитьПараметр("Склад", Документ.Склад);
    Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
    Пакет = Запрос.ВыполнитьПакет();
    Порядок = Пакет[1].Выгрузить();
    СкладскиеОстатки = Пакет[2].Выгрузить();
    СуммовыеОстатки = Пакет[3].Выгрузить();
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Осталось = Стр.Количество;
        ОсталосьСумма = СуммаСтроки(Стр);
        Если ОсталосьСумма < 0 Тогда Ошибка("Сумма продажи не может быть отрицательной.", Отказ); Возврат; КонецЕсли;
        Для Каждого Кандидат Из Порядок.НайтиСтроки(Новый Структура("Заявлено", Стр.Номенклатура)) Цикл
            Остаток = СкладскиеОстатки.Найти(Кандидат.Товар, "Товар");
            Если Остаток = Неопределено Или Остаток.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Взять = Мин(Осталось, Остаток.Количество);
            Среднее = СуммовыеОстатки.Найти(Кандидат.Товар, "Товар");
            Если Среднее = Неопределено Или Среднее.Количество < Взять Тогда
                Ошибка("Некорректный количественный остаток по номенклатуре " + Кандидат.Товар, Отказ); Возврат;
            КонецЕсли;
            Себестоимость = ?(Взять = Среднее.Количество, Среднее.Сумма, Окр(Среднее.Сумма * Взять / Среднее.Количество, 2));
            Выручка = ?(Взять = Осталось, ОсталосьСумма, Окр(ОсталосьСумма * Взять / Осталось, 2));
            Дв = Документ.Движения.Управленческий.Добавить();
            Дв.Период = Документ.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
            Дв.СчетКт = ПланыСчетов.Управленческий.Товары;
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Кандидат.Товар;
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
            Дв.КоличествоКт = Взять; Дв.Сумма = Себестоимость;
            Дв.КоличествоДт = Взять;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Кандидат.Товар;
            Дв = Документ.Движения.Управленческий.Добавить();
            Дв.Период = Документ.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.Покупатели;
            Дв.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
            Дв.Сумма = Выручка;
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура;
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Кандидат.Товар;
            Остаток.Количество = Остаток.Количество - Взять;
            Среднее.Количество = Среднее.Количество - Взять; Среднее.Сумма = Среднее.Сумма - Себестоимость;
            Осталось = Осталось - Взять; ОсталосьСумма = ОсталосьСумма - Выручка;
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
        КонецЦикла;
        Если Осталось > 0 Тогда
            Ошибка("Недостаточно товара и его аналогов: " + Стр.Номенклатура + ". Не хватает " + Осталось, Отказ); Возврат;
        КонецЕсли;
    КонецЦикла;
    ЗаписатьИКонтролировать(Документ, Ключи, Истина, Ложь, Отказ);
КонецПроцедуры

Процедура КонтрольБухгалтерскихОстатков(Склад, Товары, Отказ) Экспорт
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Субконто1 КАК Товар
    |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Момент, Счет = &Счет, ,
    | Субконто1 В (&Товары) И Субконто2 = &Склад)
    |ГДЕ КоличествоОстаток < 0");
    Запрос.УстановитьПараметр("Момент", Дата(3999,12,31));
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
    Запрос.УстановитьПараметр("Товары", Товары);
    Запрос.УстановитьПараметр("Склад", Склад);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ошибка("Отрицательный остаток по бухгалтерскому учету: " + Выборка.Товар, Отказ);
    КонецЦикла;
    КонтрольСуммТоваров(Товары, Отказ);
КонецПроцедуры

Процедура РучнаяОперация(Документ, Отказ) Экспорт
    НастроитьПланСчетов();
    Документ.Движения.Управленческий.Записывать = Истина;
    Документ.Движения.Управленческий.Очистить();
    Для Каждого Стр Из Документ.Проводки Цикл
        Если Не ЗначениеЗаполнено(Стр.СчетДт) Или Не ЗначениеЗаполнено(Стр.СчетКт) Тогда
            Ошибка("Укажите оба счета в строке " + Стр.НомерСтроки, Отказ); Продолжить;
        КонецЕсли;
        Дв = Документ.Движения.Управленческий.Добавить();
        Дв.Период = Документ.Дата; Дв.СчетДт = Стр.СчетДт; Дв.СчетКт = Стр.СчетКт; Дв.Сумма = Стр.Сумма;
        Дв.КоличествоДт = Стр.КоличествоДт; Дв.КоличествоКт = Стр.КоличествоКт;
        Если Стр.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки Тогда
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураДт;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = ?(ЗначениеЗаполнено(Стр.ПроданоДт), Стр.ПроданоДт, Стр.НоменклатураДт);
        КонецЕсли;
        Если Стр.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки Тогда
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураКт;
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = ?(ЗначениеЗаполнено(Стр.ПроданоКт), Стр.ПроданоКт, Стр.НоменклатураКт);
        КонецЕсли;
        Если Стр.СчетДт = ПланыСчетов.Управленческий.Товары Тогда
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураДт;
            Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладДт;
        КонецЕсли;
        Если Стр.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.НоменклатураКт;
            Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Стр.СкладКт;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура ЯчейкаОтчета(ТабДок, Строка, Колонка, Значение, Денежная = Ложь)
    Область = ТабДок.Область(Строка, Колонка);
    Если ТипЗнч(Значение) = Тип("Число") Тогда
        Область.СодержитЗначение = Истина;
        Область.Значение = Значение;
        Область.Формат = ?(Денежная, "ЧДЦ=2", "ЧДЦ=3; ЧДР=.; ЧН=0");
    Иначе
        Область.Текст = Строка(Значение);
    КонецЕсли;
    ЛинияГраницы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
    Область.ГраницаСлева = ЛинияГраницы; Область.ГраницаСправа = ЛинияГраницы;
    Область.ГраницаСверху = ЛинияГраницы; Область.ГраницаСнизу = ЛинияГраницы;
КонецПроцедуры

Функция ПечатьОтчета(ИмяОтчета, Данные, Начало, Конец, Подразделение = Неопределено) Экспорт
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.АвтоМасштаб = Истина;
    Если ИмяОтчета = "ВедомостьПоПодразделению" Тогда
        Заголовки = СтрРазделить("Производитель;Товар;Нач. ост.;Приход;Расход;Кон. ост.", ";");
        Заголовок = "Ведомость по подразделению «" + Подразделение + "»";
    ИначеЕсли ИмяОтчета = "ПремииСотрудников" Тогда
        Заголовки = СтрРазделить("Сотрудник;Трудовой стаж;% премии;Сумма премии", ";");
        Заголовок = "Премии. Месяц: " + Формат(Начало, "ДФ=MMMM yyyy");
    ИначеЕсли ИмяОтчета = "ПродажиТоваровИАналогов" Тогда
        Заголовки = СтрРазделить("Номенклатура;Продано;Кол-во;Себест-сть;Продажа;Прибыль", ";");
        Заголовок = "Продажи товаров и аналогов";
    Иначе
        Заголовки = СтрРазделить("Номенклатура;Кол-во;Себест-сть;Продажа;Прибыль", ";");
        Заголовок = "Продажи";
    КонецЕсли;
    Если ИмяОтчета <> "ПремииСотрудников" Тогда
        Заголовок = Заголовок + " с " + Формат(Начало, "ДФ=dd.MM.yyyy") + " по " + Формат(Конец, "ДФ=dd.MM.yyyy");
    КонецЕсли;
    Область = ТабДок.Область(1,1,1,Заголовки.Количество()); Область.Объединить();
    Область.Текст = Заголовок; Область.Шрифт = Новый Шрифт(,12,Истина);
    Для Индекс = 0 По Заголовки.Количество()-1 Цикл
        ЯчейкаОтчета(ТабДок, 3, Индекс+1, Заголовки[Индекс]);
    КонецЦикла;
    ТабДок.Область(3,1,3,Заголовки.Количество()).Шрифт = Новый Шрифт(,,Истина);
    Номер = 4;
    Если ИмяОтчета = "ВедомостьПоПодразделению" Тогда
        Производитель = Неопределено;
        Для Каждого Стр Из Данные Цикл
            Если Производитель <> Стр.Производитель Тогда
                Производитель = Стр.Производитель;
                ЯчейкаОтчета(ТабДок, Номер, 1, Производитель);
                ТабДок.Область(Номер,1,Номер,6).Шрифт = Новый Шрифт(,,Истина); Номер = Номер + 1;
            КонецЕсли;
            ЯчейкаОтчета(ТабДок, Номер, 2, Стр.Номенклатура);
            ЯчейкаОтчета(ТабДок, Номер, 3, Стр.НачальноеКоличество);
            ЯчейкаОтчета(ТабДок, Номер, 4, Стр.КоличествоПриход);
            ЯчейкаОтчета(ТабДок, Номер, 5, Стр.КоличествоРасход);
            ЯчейкаОтчета(ТабДок, Номер, 6, Стр.КонечноеКоличество);
            Номер = Номер + 1;
            ЯчейкаОтчета(ТабДок, Номер, 3, Стр.НачальныйОстаток, Истина);
            ЯчейкаОтчета(ТабДок, Номер, 4, Стр.Приход, Истина);
            ЯчейкаОтчета(ТабДок, Номер, 5, Стр.Расход, Истина);
            ЯчейкаОтчета(ТабДок, Номер, 6, Стр.КонечныйОстаток, Истина);
            Номер = Номер + 1;
        КонецЦикла;
    ИначеЕсли ИмяОтчета = "ПродажиТоваровИАналогов" Тогда
        Итоги = Данные.Скопировать(); Итоги.Свернуть("Номенклатура","Количество,Себестоимость,Выручка,Прибыль");
        Для Каждого Итог Из Итоги Цикл
            ЯчейкаОтчета(ТабДок, Номер, 1, Итог.Номенклатура);
            ЯчейкаОтчета(ТабДок, Номер, 3, Итог.Количество);
            ЯчейкаОтчета(ТабДок, Номер, 4, Итог.Себестоимость, Истина);
            ЯчейкаОтчета(ТабДок, Номер, 5, Итог.Выручка, Истина);
            ЯчейкаОтчета(ТабДок, Номер, 6, Итог.Прибыль, Истина);
            ТабДок.Область(Номер,1,Номер,6).Шрифт = Новый Шрифт(,,Истина); Номер = Номер + 1;
            Для Каждого Стр Из Данные.НайтиСтроки(Новый Структура("Номенклатура",Итог.Номенклатура)) Цикл
                ЯчейкаОтчета(ТабДок, Номер, 2, Стр.Продано);
                ЯчейкаОтчета(ТабДок, Номер, 3, Стр.Количество);
                ЯчейкаОтчета(ТабДок, Номер, 4, Стр.Себестоимость, Истина);
                ЯчейкаОтчета(ТабДок, Номер, 5, Стр.Выручка, Истина);
                ЯчейкаОтчета(ТабДок, Номер, 6, Стр.Прибыль, Истина); Номер = Номер + 1;
            КонецЦикла;
        КонецЦикла;
    ИначеЕсли ИмяОтчета = "ПремииСотрудников" Тогда
        Для Каждого Стр Из Данные Цикл
            ЯчейкаОтчета(ТабДок, Номер, 1, Стр.Сотрудник);
            ЯчейкаОтчета(ТабДок, Номер, 2, Строка(Стр.Стаж) + " лет");
            ЯчейкаОтчета(ТабДок, Номер, 3, Стр.Процент);
            ЯчейкаОтчета(ТабДок, Номер, 4, Стр.СуммаПремии, Истина); Номер = Номер + 1;
        КонецЦикла;
        ЯчейкаОтчета(ТабДок, Номер, 1, "ИТОГО:");
        ЯчейкаОтчета(ТабДок, Номер, 4, Данные.Итог("СуммаПремии"), Истина);
    Иначе
        Для Каждого Стр Из Данные Цикл
            ЯчейкаОтчета(ТабДок, Номер, 1, Стр.Номенклатура);
            ЯчейкаОтчета(ТабДок, Номер, 2, Стр.Количество);
            ЯчейкаОтчета(ТабДок, Номер, 3, Стр.Себестоимость, Истина);
            ЯчейкаОтчета(ТабДок, Номер, 4, Стр.Выручка, Истина);
            ЯчейкаОтчета(ТабДок, Номер, 5, Стр.Прибыль, Истина); Номер = Номер + 1;
        КонецЦикла;
    КонецЕсли;
    Для Колонка = 1 По Заголовки.Количество() Цикл
        ТабДок.Область(1,Колонка,Номер,Колонка).ШиринаКолонки = ?(Колонка <= 2,25,16);
    КонецЦикла;
    Возврат ТабДок;
КонецФункции

Функция КлючиУчета(Документ, ЕстьБухгалтерский, ЕстьОперативный)
    Оперативные = ТаблицаПотребностей();
    НачалоКонтроля = Документ.Дата;
    Бухгалтерские = Новый ТаблицаЗначений;
    Бухгалтерские.Колонки.Добавить("Товар", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Бухгалтерские.Колонки.Добавить("Склад", Новый ОписаниеТипов("СправочникСсылка.Склады"));
    Если ЕстьБухгалтерский Тогда
        Документ.Движения.Управленческий.Прочитать();
        Для Каждого Дв Из Документ.Движения.Управленческий Цикл
            НачалоКонтроля = Мин(НачалоКонтроля, Дв.Период);
            Если Дв.СчетДт = ПланыСчетов.Управленческий.Товары Тогда
                ДобавитьБухгалтерскийКлюч(Бухгалтерские,
                    Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура],
                    Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады]);
            КонецЕсли;
            Если Дв.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
                ДобавитьБухгалтерскийКлюч(Бухгалтерские,
                    Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура],
                    Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады]);
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если ЕстьОперативный Тогда
        Документ.Движения.ОстаткиНоменклатуры.Прочитать();
        Для Каждого Дв Из Документ.Движения.ОстаткиНоменклатуры Цикл
            НачалоКонтроля = Мин(НачалоКонтроля, Дв.Период);
            ЗаполнитьЗначенияСвойств(Оперативные.Добавить(), Дв);
        КонецЦикла;
    КонецЕсли;
    Возврат Новый Структура("Бухгалтерские,Оперативные,НачалоКонтроля", Бухгалтерские, Оперативные, НачалоКонтроля);
КонецФункции

Процедура ДобавитьБухгалтерскийКлюч(Ключи, Товар, Склад)
    Если Не ЗначениеЗаполнено(Товар) Или Не ЗначениеЗаполнено(Склад) Тогда Возврат; КонецЕсли;
    Ключ = Ключи.Добавить(); Ключ.Товар = Товар; Ключ.Склад = Склад;
КонецПроцедуры

Процедура ЗаблокироватьКлючиУчета(Ключи)
    // Во всех документах порядок один: бухгалтерский учет, затем оперативный.
    Если Ключи.Бухгалтерские.Количество() > 0 Тогда ЗаблокироватьТоварыБухгалтерии(Ключи.Бухгалтерские); КонецЕсли;
    ЗаблокироватьОстатки(Ключи.Оперативные);
КонецПроцедуры

Процедура ЗаписатьИКонтролировать(Документ, Ключи, ЕстьБухгалтерский, ЕстьОперативный, Отказ)
    Если ЕстьБухгалтерский Тогда
        Документ.Движения.Управленческий.Записать();
    КонецЕсли;
    Если ЕстьОперативный Тогда
        Если Ключи.Оперативные.Количество() > 0 Тогда
            КонтрольОстатков(Документ, Ключи.Оперативные, Отказ, Ключи.НачалоКонтроля);
        Иначе
            Документ.Движения.ОстаткиНоменклатуры.Записать();
        КонецЕсли;
    КонецЕсли;
    Если ЕстьБухгалтерский И Ключи.Бухгалтерские.Количество() > 0 Тогда
        Запрос = Новый Запрос(
        "ВЫБРАТЬ Субконто1 КАК Товар, Субконто2 КАК Склад, Регистратор
        |ИЗ РегистрБухгалтерии.Управленческий.ОстаткиИОбороты(&Начало, &Момент, Регистратор, Движения, Счет = &Счет, ,
        | Субконто1 В (&Товары) И Субконто2 В (&Склады))
        |ГДЕ КоличествоКонечныйОстаток < 0");
        Запрос.УстановитьПараметр("Начало", НачалоДня(Ключи.НачалоКонтроля));
        Запрос.УстановитьПараметр("Момент", Дата(3999,12,31));
        Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
        Запрос.УстановитьПараметр("Товары", Ключи.Бухгалтерские.ВыгрузитьКолонку("Товар"));
        Запрос.УстановитьПараметр("Склады", Ключи.Бухгалтерские.ВыгрузитьКолонку("Склад"));
        Выборка = Запрос.Выполнить().Выбрать();
        Пока Выборка.Следующий() Цикл
            Ошибка("Изменение приводит к недостатку товара " + Выборка.Товар + " на складе " + Выборка.Склад, Отказ);
        КонецЦикла;
    КонецЕсли;
    Если ЕстьБухгалтерский И Ключи.Бухгалтерские.Количество() > 0 Тогда
        КонтрольСуммТоваров(Ключи.Бухгалтерские.ВыгрузитьКолонку("Товар"), Отказ, Ключи.НачалоКонтроля);
    КонецЕсли;
КонецПроцедуры

Процедура ПриходНакладной(Документ, Отказ) Экспорт
    НастроитьПланСчетов();
    Ключи = КлючиУчета(Документ, Истина, Истина);
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Если ЗначениеЗаполнено(Документ.Подразделение) Тогда
            Ключ = Ключи.Оперативные.Добавить(); ЗаполнитьЗначенияСвойств(Ключ, Стр); Ключ.Подразделение = Документ.Подразделение;
        КонецЕсли;
        ДобавитьБухгалтерскийКлюч(Ключи.Бухгалтерские, Стр.Номенклатура, Документ.Склад);
    КонецЦикла;
    ЗаблокироватьКлючиУчета(Ключи);
    ПриходБухгалтерский(Документ, Отказ);
    ПриходОперативный(Документ, Отказ);
    Если Отказ Тогда Возврат; КонецЕсли;
    ЗаписатьИКонтролировать(Документ, Ключи, Истина, Истина, Отказ);
КонецПроцедуры

Процедура РучнаяОперацияСКонтролем(Документ, Отказ) Экспорт
    НастроитьПланСчетов();
    Ключи = КлючиУчета(Документ, Истина, Ложь);
    Для Каждого Стр Из Документ.Проводки Цикл
        Если Стр.СчетДт = ПланыСчетов.Управленческий.Товары Тогда
            Если Не ЗначениеЗаполнено(Стр.НоменклатураДт) Или Не ЗначениеЗаполнено(Стр.СкладДт) Тогда
                Ошибка("Для счета товаров укажите номенклатуру и склад по дебету.", Отказ); Возврат;
            КонецЕсли;
            ДобавитьБухгалтерскийКлюч(Ключи.Бухгалтерские, Стр.НоменклатураДт, Стр.СкладДт);
        КонецЕсли;
        Если Стр.СчетКт = ПланыСчетов.Управленческий.Товары Тогда
            Если Не ЗначениеЗаполнено(Стр.НоменклатураКт) Или Не ЗначениеЗаполнено(Стр.СкладКт) Тогда
                Ошибка("Для счета товаров укажите номенклатуру и склад по кредиту.", Отказ); Возврат;
            КонецЕсли;
            ДобавитьБухгалтерскийКлюч(Ключи.Бухгалтерские, Стр.НоменклатураКт, Стр.СкладКт);
        КонецЕсли;
    КонецЦикла;
    ЗаблокироватьКлючиУчета(Ключи);
    РучнаяОперация(Документ, Отказ);
    Если Отказ Тогда Возврат; КонецЕсли;
    ЗаписатьИКонтролировать(Документ, Ключи, Истина, Ложь, Отказ);
КонецПроцедуры

Процедура ОтменаУчета(Документ, ЕстьБухгалтерский, ЕстьОперативный, Отказ) Экспорт
    Ключи = КлючиУчета(Документ, ЕстьБухгалтерский, ЕстьОперативный);
    ЗаблокироватьКлючиУчета(Ключи);
    Если ЕстьБухгалтерский Тогда Документ.Движения.Управленческий.Очистить(); КонецЕсли;
    Если ЕстьОперативный Тогда Документ.Движения.ОстаткиНоменклатуры.Очистить(); КонецЕсли;
    ЗаписатьИКонтролировать(Документ, Ключи, ЕстьБухгалтерский, ЕстьОперативный, Отказ);
КонецПроцедуры

Процедура КонтрольСуммТоваров(Товары, Отказ, НачалоКонтроля = Неопределено)
    Если НачалоКонтроля = Неопределено Тогда НачалоКонтроля = Дата(1,1,1); КонецЕсли;
    ВидыСубконто = Новый Массив;
    ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Субконто1 КАК Товар, Регистратор
    |ИЗ РегистрБухгалтерии.Управленческий.ОстаткиИОбороты(&Начало, &Момент, Регистратор, Движения, Счет = &Счет, &ВидыСубконто, Субконто1 В (&Товары))
    |ГДЕ СуммаКонечныйОстаток < 0 ИЛИ (КоличествоКонечныйОстаток = 0 И СуммаКонечныйОстаток <> 0)");
    Запрос.УстановитьПараметр("Начало", НачалоДня(НачалоКонтроля));
    Запрос.УстановитьПараметр("Момент", Дата(3999,12,31));
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
    Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
    Запрос.УстановитьПараметр("Товары", Товары);
    Выборка = Запрос.Выполнить().Выбрать();
    Пока Выборка.Следующий() Цикл
        Ошибка("Некорректная стоимость остатка товара " + Выборка.Товар + ": проверьте суммы и количество проводок.", Отказ);
    КонецЦикла;
КонецПроцедуры

Процедура ОбеспечитьНастройкуУчета() Экспорт
    // Настройки предопределенных счетов и видов расчета — данные базы.
    // Инициализация выполняется до любых пользовательских движений и идемпотентна.
    НачатьТранзакцию();
    Попытка
        Блокировка = Новый БлокировкаДанных;
        Элемент = Блокировка.Добавить("ПланСчетов.Управленческий");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("Ссылка", ПланыСчетов.Управленческий.Товары);
        Элемент = Блокировка.Добавить("ПланСчетов.Управленческий");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.УстановитьЗначение("Ссылка", ПланыСчетов.Управленческий.ПрибылиУбытки);
        Виды = Новый Массив;
        Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Оклад);
        Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Премия);
        Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Командировка);
        Для Каждого Вид Из Виды Цикл
            Элемент = Блокировка.Добавить("ПланВидовРасчета.ОсновныеНачисления");
            Элемент.Режим = РежимБлокировкиДанных.Исключительный;
            Элемент.УстановитьЗначение("Ссылка", Вид);
        КонецЦикла;
        Блокировка.Заблокировать();
        НастроитьПланСчетов();
        РасчетЗарплаты.НастроитьВидыРасчета();
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры
