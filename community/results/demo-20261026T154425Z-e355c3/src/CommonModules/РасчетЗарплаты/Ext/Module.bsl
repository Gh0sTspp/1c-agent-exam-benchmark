
Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Оклад;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    Виды = Новый Массив; Виды.Добавить(Тариф); Виды.Добавить(Премия); Виды.Добавить(Командировка);
    Объекты = Новый Массив;
    Объекты.Добавить(Тариф.ПолучитьОбъект());
    Объекты.Добавить(Премия.ПолучитьОбъект());
    Объекты.Добавить(Командировка.ПолучитьОбъект());
    Для Каждого Объект Из Объекты Цикл
        Вид = Объект.Ссылка;
        Если Вид = Тариф Тогда
            Если Объект.ВытесняющиеВидыРасчета.Количество() = 1 Тогда Продолжить; КонецЕсли;
            Объект.ВытесняющиеВидыРасчета.Очистить();
            Стр = Объект.ВытесняющиеВидыРасчета.Добавить(); Стр.ВидРасчета = Командировка;
        ИначеЕсли Вид = Премия Тогда
            Если Объект.ВытесняющиеВидыРасчета.Количество() = 1 И Объект.БазовыеВидыРасчета.Количество() = 1 Тогда Продолжить; КонецЕсли;
            Объект.ВытесняющиеВидыРасчета.Очистить();
            Стр = Объект.ВытесняющиеВидыРасчета.Добавить(); Стр.ВидРасчета = Командировка;
            Объект.БазовыеВидыРасчета.Очистить();
            Стр = Объект.БазовыеВидыРасчета.Добавить(); Стр.ВидРасчета = Тариф;
        Иначе
            Если Объект.БазовыеВидыРасчета.Количество() = 3 Тогда Продолжить; КонецЕсли;
            Объект.БазовыеВидыРасчета.Очистить();
            Для Каждого БазовыйВид Из Виды Цикл
                Стр = Объект.БазовыеВидыРасчета.Добавить(); Стр.ВидРасчета = БазовыйВид;
            КонецЦикла;
        КонецЕсли;
        Объект.Записать();
    КонецЦикла;
КонецПроцедуры

Процедура Начислить(Документ, Отказ) Экспорт
    ЗаблокироватьОбластьРасчета(Документ);
    НастроитьВидыРасчета();
    Набор = Документ.Движения.Начисления;
    Набор.Записывать = Истина;
    Набор.Очистить();
    Набор.Записать();
    Строки = Документ.ОсновныеНачисления.Выгрузить();
    Строки.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    Для Каждого Стр Из Строки Цикл
        Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение)
            Или Не ЗначениеЗаполнено(Стр.ДатаНачала) Или Стр.ДатаОкончания < Стр.ДатаНачала Тогда
            УчетСервер.Ошибка("Укажите сотрудника, подразделение и корректный период начисления.", Отказ); Возврат;
        КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Оклад
            И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия
            И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
            УчетСервер.Ошибка("Выберите тариф, премию или командировку.", Отказ); Возврат;
        КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
            И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
            УчетСервер.Ошибка("Тариф и премия вводятся в пределах календарного месяца.", Отказ); Возврат;
        КонецЕсли;
        ТекущаяДатаНачала = НачалоДня(Стр.ДатаНачала);
        Пока ТекущаяДатаНачала <= Стр.ДатаОкончания Цикл
            Дв = Набор.Добавить();
            Дв.Сотрудник = Стр.Сотрудник; Дв.Подразделение = Стр.Подразделение;
            Дв.ПодразделениеГрафика = Стр.Подразделение;
            Дв.ВидРасчета = Стр.ВидРасчета;
            Дв.ПериодРегистрации = ?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка,
                Макс(НачалоМесяца(Документ.Дата), НачалоМесяца(ТекущаяДатаНачала)), НачалоМесяца(ТекущаяДатаНачала));
            Дв.ПериодДействияНачало = ТекущаяДатаНачала;
            Дв.ПериодДействияКонец = Мин(КонецМесяца(ТекущаяДатаНачала), КонецДня(Стр.ДатаОкончания));
            Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Стр.ДатаНачала),
                ?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, -3, -1));
            Дв.БазовыйПериодКонец = НачалоМесяца(Стр.ДатаНачала) - 1;
            ТекущаяДатаНачала = НачалоДня(Дв.ПериодДействияКонец) + 86400;
        КонецЦикла;
    КонецЦикла;
    // Платформа определяет сторнируемые записи и точные интервалы прошлого периода.
    Дополнение = Набор.ПолучитьДополнение();
    ДобавитьСторноЗаписи(Набор, Дополнение);
    Набор.Записать();
    ПересчитатьСвязанныеНачисления(Документ, Отказ);
    Набор.Записывать = Ложь;
КонецПроцедуры

Процедура Отменить(Документ, Отказ) Экспорт
    ЗаблокироватьОбластьРасчета(Документ);
    Документ.Движения.Начисления.Очистить();
    Документ.Движения.Начисления.Записать();
    ПересчитатьСвязанныеНачисления(Документ, Отказ);
    Документ.Движения.Начисления.Записывать = Ложь;
КонецПроцедуры

Функция КлючЗаписи(Регистратор, НомерСтроки)
    Возврат ЗначениеВСтрокуВнутр(Регистратор) + ":" + Строка(НомерСтроки);
КонецФункции

Функция ПолныхЛет(НачалоСтажа, Момент)
    Если Не ЗначениеЗаполнено(НачалоСтажа) Тогда Возврат 0; КонецЕсли;
    Лет = Год(Момент) - Год(НачалоСтажа);
    Если ДобавитьМесяц(НачалоСтажа, Лет * 12) > Момент Тогда Лет = Лет - 1; КонецЕсли;
    Возврат Макс(0, Лет);
КонецФункции

Процедура СохранитьИзмененныеНаборы(Таблица, Исходные)
    Наборы = Новый Соответствие;
    Измененные = Новый Соответствие;
    Для Каждого Стр Из Таблица Цикл
        Ключ = КлючЗаписи(Стр.Регистратор, Стр.НомерСтроки);
        Старое = Исходные.Получить(Ключ);
        Состояние = Строка(Стр.Результат) + "/" + Строка(Стр.ОтработаноДней) + "/"
            + Строка(Стр.Ставка) + "/" + Строка(Стр.Стаж) + "/" + Строка(Стр.Процент) + "/" + Строка(Стр.НормаДней);
        Если Старое <> Состояние Тогда Измененные.Вставить(Стр.Регистратор, Истина); КонецЕсли;
        Исходные.Вставить(Ключ, Состояние);
        Набор = Наборы.Получить(Стр.Регистратор);
        Если Набор = Неопределено Тогда
            Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
            Набор.Отбор.Регистратор.Установить(Стр.Регистратор);
            Наборы.Вставить(Стр.Регистратор, Набор);
        КонецЕсли;
        Дв = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Дв, Стр);
    КонецЦикла;
    // В цикле только запись уже рассчитанных наборов, чтений базы здесь нет.
    // Состав и периоды записей не меняются: таблица фактического периода
    // сохраняется без повторного расчета, объекты перерасчета не используются.
    Для Каждого Элемент Из Измененные Цикл
        Наборы.Получить(Элемент.Ключ).Записать(Истина, Ложь, Ложь, Ложь);
    КонецЦикла;
КонецПроцедуры

Процедура ПересчитатьСвязанныеНачисления(Документ, Отказ)
    // Основная таблица используется для редактирования наборов. Данные времени
    // и расчетная база далее получаются исключительно из виртуальных таблиц.
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Р.Регистратор, Р.НомерСтроки, Р.Активность, Р.Сторно, Р.ВидРасчета,
    | Р.ПериодРегистрации, Р.ПериодДействия, Р.ПериодДействияНачало, Р.ПериодДействияКонец,
    | Р.БазовыйПериодНачало, Р.БазовыйПериодКонец,
    | Р.Сотрудник, Р.Подразделение, Р.ПодразделениеГрафика, Р.Результат, Р.ОтработаноДней,
    | Р.Ставка, Р.Стаж, Р.Процент, Р.ИсходнаяСтрока, Р.НормаДней
    |ИЗ РегистрРасчета.Начисления КАК Р");
    ВсеЗаписи = Запрос.Выполнить().Выгрузить();
    Если ВсеЗаписи.Количество() = 0 Тогда Возврат; КонецЕсли;
    // Замыкание связей сотрудник-подразделение учитывает совместительство и базу руководителей.
    Сотрудники = Новый Соответствие; Подразделения = Новый Соответствие;
    Для Каждого Стр Из Документ.ОсновныеНачисления Цикл
        Сотрудники.Вставить(Стр.Сотрудник, Истина); Подразделения.Вставить(Стр.Подразделение, Истина);
    КонецЦикла;
    ОбластьРасчета = Неопределено;
    Если Документ.ДополнительныеСвойства.Свойство("ОбластьРасчета", ОбластьРасчета) Тогда
        Для Каждого Стр Из ОбластьРасчета Цикл
            Сотрудники.Вставить(Стр.Сотрудник, Истина); Подразделения.Вставить(Стр.Подразделение, Истина);
        КонецЦикла;
    КонецЕсли;
    Изменено = Истина;
    Пока Изменено Цикл
        Изменено = Ложь;
        Для Каждого Стр Из ВсеЗаписи Цикл
            Если Сотрудники.Получить(Стр.Сотрудник) <> Неопределено Или Подразделения.Получить(Стр.Подразделение) <> Неопределено Тогда
                Если Сотрудники.Получить(Стр.Сотрудник) = Неопределено Тогда Сотрудники.Вставить(Стр.Сотрудник, Истина); Изменено = Истина; КонецЕсли;
                Если Подразделения.Получить(Стр.Подразделение) = Неопределено Тогда Подразделения.Вставить(Стр.Подразделение, Истина); Изменено = Истина; КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Таблица = ВсеЗаписи.СкопироватьКолонки();
    Для Каждого Стр Из ВсеЗаписи Цикл
        Если Сотрудники.Получить(Стр.Сотрудник) <> Неопределено Тогда ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Стр); КонецЕсли;
    КонецЦикла;
    Если Таблица.Количество() = 0 Тогда Возврат; КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = Таблица;
    Элемент.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник");
    Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    Блокировка.Заблокировать();
    Таблица.Индексы.Добавить("Регистратор,НомерСтроки");
    Регистраторы = Таблица.ВыгрузитьКолонку("Регистратор");
    Запрос = Новый Запрос(
    "ВЫБРАТЬ * ПОМЕСТИТЬ Записи ИЗ &Записи КАК Р;
    |ВЫБРАТЬ Регистратор, НомерСтроки,
    | ЕСТЬNULL(ЗначениеФактическийПериодДействия,0) КАК Часы,
    | ЕСТЬNULL(ДнейФактическийПериодДействия,0) КАК Дни,
    | ЕСТЬNULL(ДнейПериодРегистрации,0) КАК НормаДней
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы));
    |ВЫБРАТЬ Р.Регистратор, Р.НомерСтроки, МАКСИМУМ(Т.Период) КАК Период
    |ПОМЕСТИТЬ ДатыСтавок ИЗ Записи КАК Р
    |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Т
    | ПО Т.Сотрудник = Р.Сотрудник И Т.Подразделение = Р.Подразделение И Т.Период <= НАЧАЛОПЕРИОДА(Р.ПериодДействияНачало, МЕСЯЦ)
    |СГРУППИРОВАТЬ ПО Р.Регистратор, Р.НомерСтроки;
    |ВЫБРАТЬ Р.Регистратор, Р.НомерСтроки, Т.Ставка, Р.Сотрудник.НачалоСтажа КАК НачалоСтажа
    |ИЗ Записи КАК Р
    |ЛЕВОЕ СОЕДИНЕНИЕ ДатыСтавок КАК Д ПО Р.Регистратор = Д.Регистратор И Р.НомерСтроки = Д.НомерСтроки
    |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Т
    | ПО Т.Сотрудник = Р.Сотрудник И Т.Подразделение = Р.Подразделение И Т.Период = Д.Период;
    |ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж");
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы); Запрос.УстановитьПараметр("Записи", Таблица);
    Пакет = Запрос.ВыполнитьПакет();
    График = Пакет[1].Выгрузить(); Ставки = Пакет[3].Выгрузить(); Шкала = Пакет[4].Выгрузить();
    График.Индексы.Добавить("Регистратор,НомерСтроки"); Ставки.Индексы.Добавить("Регистратор,НомерСтроки");
    Исходные = Новый Соответствие;
    Для Каждого Стр Из Таблица Цикл
        Ключ = КлючЗаписи(Стр.Регистратор, Стр.НомерСтроки);
        Исходные.Вставить(Ключ, Строка(Стр.Результат) + "/" + Строка(Стр.ОтработаноДней) + "/"
            + Строка(Стр.Ставка) + "/" + Строка(Стр.Стаж) + "/" + Строка(Стр.Процент) + "/" + Строка(Стр.НормаДней));
        Отбор = Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки);
        ДанныеСтавки = Ставки.НайтиСтроки(Отбор)[0];
        Время = График.НайтиСтроки(Отбор)[0];
        Если Не Стр.Сторно Тогда Стр.НормаДней = Время.НормаДней; КонецЕсли;
        Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
            Если ДанныеСтавки.Ставка = NULL Тогда
                УчетСервер.Ошибка("Нет тарифной ставки на начало месяца: " + Стр.Сотрудник + ", " + Стр.Подразделение, Отказ); Возврат;
            КонецЕсли;
            Стр.Ставка = ДанныеСтавки.Ставка;
            Стр.Результат = Окр(Стр.Ставка * Время.Часы * ?(Стр.Сторно, -1, 1), 2);
            Стр.ОтработаноДней = Время.Дни * ?(Стр.Сторно, -1, 1);
        ИначеЕсли Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
            Стр.Стаж = ПолныхЛет(ДанныеСтавки.НачалоСтажа, НачалоМесяца(Стр.ПериодДействияНачало));
            Стр.Процент = 0; НайденПроцент = Ложь;
            Для Каждого Порог Из Шкала Цикл
                Если Порог.Стаж <= Стр.Стаж Тогда Стр.Процент = Порог.Процент; НайденПроцент = Истина; КонецЕсли;
            КонецЦикла;
            Если Не НайденПроцент Тогда УчетСервер.Ошибка("Не заполнена шкала премий для стажа " + Стр.Стаж, Отказ); Возврат; КонецЕсли;
            Стр.ОтработаноДней = 0;
        Иначе
            Стр.ОтработаноДней = 0;
        КонецЕсли;
    КонецЦикла;
    СохранитьИзмененныеНаборы(Таблица, Исходные);
    Измерения = Новый Массив; Измерения.Добавить("Подразделение");
    Разрезы = Новый Массив; Разрезы.Добавить("Сотрудник");
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Регистратор, НомерСтроки, Сотрудник, СотрудникРазрез,
    | ЕСТЬNULL(РезультатБаза,0) КАК База
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы,
    | Регистратор В (&Регистраторы) И ВидРасчета = &Вид)");
    Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Разрезы", Разрезы);
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы); Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Премия);
    БазыПремий = Запрос.Выполнить().Выгрузить(); БазыПремий.Индексы.Добавить("Регистратор,НомерСтроки");
    Для Каждого Стр Из Таблица Цикл
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        Отбор = Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки);
        База = 0;
        Для Каждого БазаСтрока Из БазыПремий.НайтиСтроки(Отбор) Цикл
            Если БазаСтрока.СотрудникРазрез <> Стр.Сотрудник Тогда База = База + БазаСтрока.База; КонецЕсли;
        КонецЦикла;
        Время = График.НайтиСтроки(Отбор)[0];
        Стр.Результат = ?(Стр.НормаДней = 0, 0, Окр(База * Стр.Процент / 100 * Время.Дни / Стр.НормаДней * ?(Стр.Сторно, -1, 1), 2));
    КонецЦикла;
    СохранитьИзмененныеНаборы(Таблица, Исходные);
    Измерения = Новый Массив; Измерения.Добавить("Сотрудник");
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(РезультатБаза,0) КАК База,
    | ЕСТЬNULL(ОтработаноДнейБаза,0) КАК ДниБазы
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, ,
    | Регистратор В (&Регистраторы) И ВидРасчета = &Вид)");
    Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
    Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
    БазыКомандировок = Запрос.Выполнить().Выгрузить(); БазыКомандировок.Индексы.Добавить("Регистратор,НомерСтроки");
    ИзмененияКомандировок = Таблица.СкопироватьКолонки();
    ИзмененияКомандировок.Колонки.Добавить("Изменение", Новый ОписаниеТипов("Число"));
    Таблица.Сортировать("БазовыйПериодКонец,ПериодДействияНачало");
    Для Каждого Стр Из Таблица Цикл
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        Отбор = Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки);
        Базы = БазыКомандировок.НайтиСтроки(Отбор);
        База = 0; ДниБазы = 0;
        Для Каждого БазаСтрока Из Базы Цикл База = База + БазаСтрока.База; ДниБазы = ДниБазы + БазаСтрока.ДниБазы; КонецЦикла;
        // Полные месяцы базы и помесячные записи позволяют применить уже
        // рассчитанные изменения предшествующих командировок без новых чтений БД.
        Для Каждого Изменение Из ИзмененияКомандировок Цикл
            Если Изменение.Сотрудник = Стр.Сотрудник
                И Изменение.ПериодДействияНачало >= Стр.БазовыйПериодНачало
                И Изменение.ПериодДействияНачало <= Стр.БазовыйПериодКонец Тогда
                База = База + Изменение.Изменение;
            КонецЕсли;
        КонецЦикла;
        Время = График.НайтиСтроки(Отбор)[0];
        НовыйРезультат = ?(ДниБазы = 0, 0, Окр(База / ДниБазы * Время.Дни * ?(Стр.Сторно, -1, 1), 2));
        Изменение = ИзмененияКомандировок.Добавить(); ЗаполнитьЗначенияСвойств(Изменение, Стр);
        Изменение.Изменение = НовыйРезультат - Стр.Результат;
        Стр.Результат = НовыйРезультат;
    КонецЦикла;
    СохранитьИзмененныеНаборы(Таблица, Исходные);
КонецПроцедуры

Процедура ЗаблокироватьОбластьРасчета(Документ)
    // Сначала читается только топология связей, без сумм, ставок и графиков.
    // Все расчетные данные затем читаются уже под блокировкой компоненты.
    Запрос = Новый Запрос(
    "ВЫБРАТЬ РАЗЛИЧНЫЕ Сотрудник, Подразделение, Регистратор ИЗ РегистрРасчета.Начисления");
    Связи = Запрос.Выполнить().Выгрузить();
    Сотрудники = Новый Соответствие; Подразделения = Новый Соответствие;
    Для Каждого Стр Из Документ.ОсновныеНачисления Цикл
        Если ЗначениеЗаполнено(Стр.Сотрудник) Тогда Сотрудники.Вставить(Стр.Сотрудник, Истина); КонецЕсли;
        Если ЗначениеЗаполнено(Стр.Подразделение) Тогда Подразделения.Вставить(Стр.Подразделение, Истина); КонецЕсли;
        НоваяСвязь = Связи.Добавить(); НоваяСвязь.Сотрудник = Стр.Сотрудник;
        НоваяСвязь.Подразделение = Стр.Подразделение; НоваяСвязь.Регистратор = Документ.Ссылка;
    КонецЦикла;
    Для Каждого Стр Из Связи Цикл
        Если Стр.Регистратор = Документ.Ссылка Тогда
            Сотрудники.Вставить(Стр.Сотрудник, Истина); Подразделения.Вставить(Стр.Подразделение, Истина);
        КонецЕсли;
    КонецЦикла;
    Изменено = Истина;
    Пока Изменено Цикл
        Изменено = Ложь;
        Для Каждого Стр Из Связи Цикл
            Если Сотрудники.Получить(Стр.Сотрудник) <> Неопределено Или Подразделения.Получить(Стр.Подразделение) <> Неопределено Тогда
                Если Сотрудники.Получить(Стр.Сотрудник) = Неопределено Тогда Сотрудники.Вставить(Стр.Сотрудник, Истина); Изменено = Истина; КонецЕсли;
                Если Подразделения.Получить(Стр.Подразделение) = Неопределено Тогда Подразделения.Вставить(Стр.Подразделение, Истина); Изменено = Истина; КонецЕсли;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Область = Связи.СкопироватьКолонки("Сотрудник,Подразделение");
    Для Каждого Стр Из Связи Цикл
        Если Сотрудники.Получить(Стр.Сотрудник) <> Неопределено Тогда
            ЗаполнитьЗначенияСвойств(Область.Добавить(), Стр);
        КонецЕсли;
    КонецЦикла;
    Если Область.Количество() = 0 Тогда Возврат; КонецЕсли;
    Область.Свернуть("Сотрудник,Подразделение"); Область.Сортировать("Сотрудник,Подразделение");
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = Область;
    Элемент.ИспользоватьИзИсточникаДанных("Сотрудник", "Сотрудник");
    Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный; Элемент.ИсточникДанных = Область;
    Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    Блокировка.Заблокировать();
    Документ.ДополнительныеСвойства.Вставить("ОбластьРасчета", Область);
КонецПроцедуры

Процедура ДобавитьСторноЗаписи(Набор, Дополнение)
    Если Дополнение.Количество() = 0 Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(ДнейПериодРегистрации,0) КАК НормаДней
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))");
    Запрос.УстановитьПараметр("Регистраторы", Дополнение.ВыгрузитьКолонку("Регистратор"));
    ГрафикИсточников = Запрос.Выполнить().Выгрузить();
    ГрафикИсточников.Индексы.Добавить("Регистратор,НомерСтроки");
    Для Каждого Стр Из Дополнение Цикл
        Дв = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Дв, Стр,, "Регистратор,НомерСтроки,ПериодДействия");
        Дв.Сторно = Истина;
        Дв.ПериодРегистрации = Стр.ПериодРегистрацииСторно;
        Дв.ПериодДействияНачало = Стр.ПериодДействияНачалоСторно;
        Дв.ПериодДействияКонец = Стр.ПериодДействияКонецСторно;
        Если Дв.НормаДней = 0 Тогда
            Источники = ГрафикИсточников.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки));
            Если Источники.Количество() > 0 Тогда Дв.НормаДней = Источники[0].НормаДней; КонецЕсли;
        КонецЕсли;
        Дв.Результат = 0; Дв.ОтработаноДней = 0;
    КонецЦикла;
КонецПроцедуры
