        Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
        Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент(); Начисление.Номер = "ДМ0000001"; Начисление.Дата = Дата(2024,1,31,12,0,0);
        Месяц = Дата(2023,11,1);
        Пока Месяц <= Дата(2024,1,1) Цикл
            СтрокаЗарплаты(Начисление, Работник, Цех, Тариф, Месяц, НачалоДня(КонецМесяца(Месяц)));
