Процедура ЗаписатьСведения(ИмяРегистра, Данные)
    Запись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
    ЗаполнитьЗначенияСвойств(Запись, Данные);
    Запись.Записать();
КонецПроцедуры
