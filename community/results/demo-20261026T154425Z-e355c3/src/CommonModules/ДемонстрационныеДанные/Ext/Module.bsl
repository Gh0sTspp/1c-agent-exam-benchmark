        Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
        Приход.Номер = "ДМ0000002"; Приход.Дата = Дата(2024,1,4,12,0,0); Приход.Подразделение = Продажи; Приход.Склад = Склад;
