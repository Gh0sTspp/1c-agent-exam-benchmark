        СтрокаЗарплаты(Начисление, Руководитель, Цех, Премия, Дата(2024,2,1), Дата(2024,2,29));
        СтрокаЗарплаты(Начисление, Руководитель, Цех, Тариф, Дата(2024,3,1), Дата(2024,3,31));
