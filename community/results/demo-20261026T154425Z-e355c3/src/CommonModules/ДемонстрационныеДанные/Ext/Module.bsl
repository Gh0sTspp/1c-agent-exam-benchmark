        КонецЦикла;
        Начисление.Записать(РежимЗаписиДокумента.Проведение);
        Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент(); Начисление.Номер = "ДМ0000002"; Начисление.Дата = Дата(2024,3,31,12,0,0);
        СтрокаЗарплаты(Начисление, Работник, Цех, Тариф, Дата(2024,2,1), Дата(2024,2,29));
