        День = Дата(2023,11,1);
        Пока День <= Дата(2024,3,31) Цикл
            Запись = РегистрыСведений.ГрафикиРаботы.СоздатьМенеджерЗаписи();
            Запись.Дата = День; Запись.Подразделение = Цех;
            Запись.Значение = ?(ДеньНедели(День) <= 5,8,0); Запись.Дней = ?(Запись.Значение > 0,1,0); Запись.Записать();
            День = День + 86400;
        КонецЦикла;
        ЗаписатьСведения("ТарифныеСтавки", Новый Структура("Период,Подразделение,Сотрудник,Ставка", Дата(2023,11,1), Цех, Работник, 100));
        ЗаписатьСведения("ТарифныеСтавки", Новый Структура("Период,Подразделение,Сотрудник,Ставка", Дата(2023,11,1), Цех, Руководитель, 200));
