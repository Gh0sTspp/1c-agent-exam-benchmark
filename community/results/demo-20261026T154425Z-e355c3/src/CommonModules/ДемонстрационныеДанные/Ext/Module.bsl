        Стр = Сборка.СистемныеБлоки.Добавить(); Стр.Номенклатура = Блок; Стр.Количество = 2;
        Стр = Сборка.ДополнительныеДетали.Добавить(); Стр.Номенклатура = Видео; Стр.Свойство = PALIT; Стр.Количество = 1;
