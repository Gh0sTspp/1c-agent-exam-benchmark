
Функция НайтиИлиСоздать(ИмяСправочника, Наименование)
    Менеджер = Справочники[ИмяСправочника];
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьЭлемент(); Объект.Наименование = Наименование; Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Функция СоздатьВидСведения(Наименование, ТипЗначения)
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Вид) Тогда Возврат Вид; КонецЕсли;
    Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
    Объект.Наименование = Наименование; Объект.ТипЗначения = ТипЗначения; Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Процедура СтрокаНакладной(Документ, Товар, Количество, Цена, Свойство = Неопределено, Подразделение = Неопределено)
    Стр = Документ.СписокНоменклатуры.Добавить();
    Стр.Номенклатура = Товар; Стр.Количество = Количество; Стр.Цена = Цена; Стр.Сумма = Окр(Количество * Цена, 2);
    Если Свойство <> Неопределено Тогда Стр.Свойство = Свойство; КонецЕсли;
    Если Подразделение <> Неопределено Тогда Стр.Подразделение = Подразделение; КонецЕсли;
КонецПроцедуры

Процедура СтрокаЗарплаты(Документ, Сотрудник, Подразделение, Вид, Начало, Конец)
    Стр = Документ.ОсновныеНачисления.Добавить();
    Стр.Сотрудник = Сотрудник; Стр.Подразделение = Подразделение; Стр.ВидРасчета = Вид;
    Стр.ДатаНачала = Начало; Стр.ДатаОкончания = Конец;
КонецПроцедуры

Процедура Заполнить() Экспорт
    Если ЗначениеЗаполнено(Документы.Сборка.НайтиПоНомеру("ДМ0000001", Дата(2024,1,1))) Тогда Возврат; КонецЕсли;
    НачатьТранзакцию();
    Попытка
