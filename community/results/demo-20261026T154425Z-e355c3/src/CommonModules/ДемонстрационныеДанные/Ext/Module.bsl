        СтрокаНакладной(Приход, Аналог1, 3, 10); СтрокаНакладной(Приход, Аналог2, 1, 7);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Операция = Документы.Операция.СоздатьДокумент();
        Операция.Номер = "ДМ0000001"; Операция.Дата = Дата(2024,1,8,12,0,0);
        Стр = Операция.Проводки.Добавить(); Стр.СчетДт = ПланыСчетов.Управленческий.Товары; Стр.СчетКт = ПланыСчетов.Управленческий.Поставщики;
        Стр.НоменклатураДт = Товар; Стр.СкладДт = Склад; Стр.КоличествоДт = 1; Стр.Сумма = 5;
        Операция.Записать(РежимЗаписиДокумента.Проведение);
        Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
        Продажа.Номер = "ДМ0000003"; Продажа.Дата = Дата(2024,1,9,12,0,0); Продажа.Склад = Склад;
        СтрокаНакладной(Продажа, Товар, 5, 92);
        Продажа.Записать(РежимЗаписиДокумента.Проведение);
        Работник = НайтиИлиСоздать("ФизическиеЛица", "Демо — работник");
