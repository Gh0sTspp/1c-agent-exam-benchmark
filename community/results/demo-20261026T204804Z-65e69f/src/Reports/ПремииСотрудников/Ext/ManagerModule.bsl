#Область ПрограммныйИнтерфейс

// Возвращает премии сотрудников за календарный месяц, в который входит начало периода.
//
// Параметры:
//  НачалоПериода, КонецПериода - Дата - период отчета (отчет строится только за один месяц).
//
// Возвращаемое значение:
//  ТаблицаЗначений - строки отчета.
//
Функция ПолучитьДанные(НачалоПериода, КонецПериода) Экспорт

	Параметры = Новый Структура("Месяц", НачалоМесяца(НачалоПериода));
	Возврат ОтчетыСервер.ДанныеСхемы(ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных"), Параметры);

