#Область ПрограммныйИнтерфейс

// Заполняет информационную базу примером данных всех разделов задачи и проводит документы.
// Вызывается без параметров в чистой базе, развернутой из каркаса.
//
Процедура Заполнить() Экспорт

	УчетСервер.НастроитьВидыРасчета();
	ЗаполнитьОперативныйУчет();
	ЗаполнитьБухгалтерскийУчет();
	ЗаполнитьПериодическиеРасчеты();
	ЗаполнитьУправляемыеФормы();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОперативныйУчет

Процедура ЗаполнитьОперативныйУчет()

	ОсновнойЦех = Элемент("Подразделения", "Основной цех");
	Магазин = Элемент("Подразделения", "Магазин");
	СборочныйЦех = Элемент("Подразделения", "Сборочный цех");

	УстановитьПолитику(ОсновнойЦех, Перечисления.УчетнаяПолитика.ФИФО);
	УстановитьПолитику(Магазин, Перечисления.УчетнаяПолитика.ЛИФО);
	УстановитьПолитику(СборочныйЦех, Перечисления.УчетнаяПолитика.ПоСредней);

	Производитель = ВидХарактеристики("Производитель", Новый ОписаниеТипов("СправочникСсылка.ЗначенияХарактеристикНоменклатуры"));
	ОбъемПамяти = ВидХарактеристики("Объем памяти, Гб", Новый ОписаниеТипов("Число"));
	ASUS = ЗначениеХарактеристики(Производитель, "ASUS");
	PALIT = ЗначениеХарактеристики(Производитель, "PALIT");
	Intel = ЗначениеХарактеристики(Производитель, "Intel");

	Видеокарта = Элемент("Номенклатура", "Видеокарта", "ОУ-001");
	МатеринскаяПлата = Элемент("Номенклатура", "Материнская плата", "ОУ-002");
	Процессор = Элемент("Номенклатура", "Процессор", "ОУ-003");
	СистемныйБлок = Элемент("Номенклатура", "Системный блок", "ОУ-004");
	Принтер = Элемент("Номенклатура", "Принтер", "ОУ-005");

	ВидеокартаASUS = Свойство(Видеокарта, "ASUS 4 Гб");
	ВидеокартаPALIT = Свойство(Видеокарта, "PALIT 2 Гб");
	ПлатаASUS = Свойство(МатеринскаяПлата, "ASUS");
	ПроцессорIntel = Свойство(Процессор, "Intel");

	ЗаписатьЗначениеСвойства(ВидеокартаASUS, Производитель, ASUS);
	ЗаписатьЗначениеСвойства(ВидеокартаASUS, ОбъемПамяти, 4);
	ЗаписатьЗначениеСвойства(ВидеокартаPALIT, Производитель, PALIT);
	ЗаписатьЗначениеСвойства(ВидеокартаPALIT, ОбъемПамяти, 2);
	ЗаписатьЗначениеСвойства(ПлатаASUS, Производитель, ASUS);
	ЗаписатьЗначениеСвойства(ПроцессорIntel, Производитель, Intel);

	НаборСпецификации = РегистрыСведений.СпецификацииСистемныхБлоков.СоздатьНаборЗаписей();
	НаборСпецификации.Отбор.Период.Установить(Дата(2014, 1, 1));
	НаборСпецификации.Отбор.СистемныйБлок.Установить(СистемныйБлок);
	ДобавитьСтрокуСпецификации(НаборСпецификации, СистемныйБлок, Видеокарта, ВидеокартаASUS, 1);
	ДобавитьСтрокуСпецификации(НаборСпецификации, СистемныйБлок, МатеринскаяПлата, ПлатаASUS, 1);
	ДобавитьСтрокуСпецификации(НаборСпецификации, СистемныйБлок, Процессор, ПроцессорIntel, 1);
	НаборСпецификации.Записать();

	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2014, 1, 10, 10, 0, 0);
	Приход.Подразделение = ОсновнойЦех;
	ДобавитьСтроку(Приход.СписокНоменклатуры, Видеокарта, 4, 15000, ВидеокартаASUS);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Видеокарта, 2, 11500, ВидеокартаPALIT);
	ДобавитьСтроку(Приход.СписокНоменклатуры, МатеринскаяПлата, 2, 5500, ПлатаASUS);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Процессор, 3, 9000, ПроцессорIntel);
	Приход.Записать(РежимЗаписиДокумента.Проведение);

	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2014, 1, 11, 10, 0, 0);
	Приход.Подразделение = ОсновнойЦех;
	ДобавитьСтроку(Приход.СписокНоменклатуры, Видеокарта, 2, 16000, ВидеокартаASUS);
	Приход.Записать(РежимЗаписиДокумента.Проведение);

	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2014, 1, 12, 10, 0, 0);
	Приход.Подразделение = Магазин;
	ДобавитьСтроку(Приход.СписокНоменклатуры, Принтер, 2, 9000);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Принтер, 3, 11000);
	Приход.Записать(РежимЗаписиДокумента.Проведение);

	Сборка = Документы.Сборка.СоздатьДокумент();
	Сборка.Дата = Дата(2014, 1, 15, 10, 0, 0);
	Сборка.ПодразделениеСписания = ОсновнойЦех;
	Сборка.ПодразделениеПоступления = Магазин;
	СтрокаБлока = Сборка.СистемныеБлоки.Добавить();
	СтрокаБлока.СистемныйБлок = СистемныйБлок;
	СтрокаБлока.Количество = 1;
	СтрокаДетали = Сборка.ДополнительныеДетали.Добавить();
	СтрокаДетали.Деталь = Видеокарта;
	СтрокаДетали.Свойство = ВидеокартаASUS;
	СтрокаДетали.Количество = 1;
	Сборка.Записать(РежимЗаписиДокумента.Проведение);

	Расход = Документы.РасходнаяНакладная.СоздатьДокумент();
	Расход.Дата = Дата(2014, 2, 20, 10, 0, 0);
	ДобавитьСтроку(Расход.СписокНоменклатуры, СистемныйБлок, 1, 75000, , Магазин);
	ДобавитьСтроку(Расход.СписокНоменклатуры, Принтер, 3, 14000, , Магазин);
	Расход.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

Процедура УстановитьПолитику(Подразделение, Метод)

	Запись = РегистрыСведений.УчетнаяПолитикаПодразделений.СоздатьМенеджерЗаписи();
	Запись.Период = Дата(2014, 1, 1);
	Запись.Подразделение = Подразделение;
	Запись.МетодСписания = Метод;
	Запись.Записать();

КонецПроцедуры

Функция ВидХарактеристики(Наименование, ТипЗначения)

	Ссылка = ПланыВидовХарактеристик.ХарактеристикиНоменклатуры.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = ПланыВидовХарактеристик.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ТипЗначения = ТипЗначения;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ЗначениеХарактеристики(Владелец, Наименование)

	Ссылка = Справочники.ЗначенияХарактеристикНоменклатуры.НайтиПоНаименованию(Наименование, Истина, , Владелец);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Справочники.ЗначенияХарактеристикНоменклатуры.СоздатьЭлемент();
	Объект.Владелец = Владелец;
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция Свойство(Номенклатура, Наименование)

	Ссылка = Справочники.СвойстваНоменклатуры.НайтиПоНаименованию(Наименование, Истина, , Номенклатура);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Справочники.СвойстваНоменклатуры.СоздатьЭлемент();
	Объект.Владелец = Номенклатура;
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура ЗаписатьЗначениеСвойства(Свойство, Характеристика, Значение)

	Запись = РегистрыСведений.ЗначенияСвойствНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Свойство = Свойство;
	Запись.Характеристика = Характеристика;
	Запись.Значение = Значение;
	Запись.Записать();

КонецПроцедуры

Процедура ДобавитьСтрокуСпецификации(Набор, СистемныйБлок, Деталь, Свойство, Количество)

	Запись = Набор.Добавить();
	Запись.Период = Дата(2014, 1, 1);
	Запись.СистемныйБлок = СистемныйБлок;
	Запись.Деталь = Деталь;
	Запись.Свойство = Свойство;
	Запись.Количество = Количество;

КонецПроцедуры

#КонецОбласти

#Область БухгалтерскийУчет

Процедура ЗаполнитьБухгалтерскийУчет()

	Склад = Элемент("Склады", "Основной склад");
	Куртка = Элемент("Номенклатура", "Куртка замшевая", "БУ-100");
	Портсигар = Элемент("Номенклатура", "Портсигар", "БУ-200");
	ПортсигарИмп = Элемент("Номенклатура", "Портсигар (имп.)", "БУ-201");
	ПортсигарОтеч = Элемент("Номенклатура", "Портсигар (отеч.)", "БУ-202");

	// Портсигар -> Портсигар (имп.) -> Портсигар (отеч.): аналоги транзитивны.
	ЗаписатьАналог(Портсигар, ПортсигарИмп);
	ЗаписатьАналог(ПортсигарИмп, ПортсигарОтеч);

	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2014, 1, 5, 10, 0, 0);
	Приход.Склад = Склад;
	ДобавитьСтроку(Приход.СписокНоменклатуры, Куртка, 5, 100);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Портсигар, 1, 5);
	ДобавитьСтроку(Приход.СписокНоменклатуры, ПортсигарИмп, 3, 10);
	ДобавитьСтроку(Приход.СписокНоменклатуры, ПортсигарОтеч, 2, 7);
	Приход.Записать(РежимЗаписиДокумента.Проведение);

	Расход = Документы.РасходнаяНакладная.СоздатьДокумент();
	Расход.Дата = Дата(2014, 2, 10, 10, 0, 0);
	Расход.Склад = Склад;
	ДобавитьСтроку(Расход.СписокНоменклатуры, Куртка, 3, 200);
	ДобавитьСтроку(Расход.СписокНоменклатуры, Портсигар, 5, 92);
	Расход.Записать(РежимЗаписиДокумента.Проведение);

	// Ручная операция с произвольной корреспонденцией счетов.
	Операция = Документы.Операция.СоздатьДокумент();
	Операция.Дата = Дата(2014, 2, 28, 10, 0, 0);
	Операция.Содержание = "Оплата покупателя";
	Проводка = Операция.Движения.Управленческий.Добавить();
	Проводка.Период = Операция.Дата;
	Проводка.СчетДт = ПланыСчетов.Управленческий.Касса;
	Проводка.СчетКт = ПланыСчетов.Управленческий.Покупатели;
	Проводка.Сумма = 500;
	Операция.Движения.Управленческий.Записывать = Истина;
	Операция.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

Процедура ЗаписатьАналог(Номенклатура, Аналог)

	Запись = РегистрыСведений.АналогиНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Номенклатура = Номенклатура;
	Запись.Аналог = Аналог;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти

#Область ПериодическиеРасчеты

Процедура ЗаполнитьПериодическиеРасчеты()

	ОтделПродаж = Справочники.Подразделения.ОтделПродаж;
	ОтделРазработки = Справочники.Подразделения.ОтделРазработки;

	Обработка = Обработки.ЗаполнениеГрафика.Создать();
	Обработка.ЗаполнитьГрафик(Дата(2013, 10, 1), Дата(2014, 6, 30), "67", ОтделПродаж);
	Обработка.ЗаполнитьГрафик(Дата(2013, 10, 1), Дата(2014, 6, 30), "67", ОтделРазработки);

	Иванов = Справочники.ФизическиеЛица.Иванов;
	Петров = Справочники.ФизическиеЛица.Петров;
	Сидоров = Справочники.ФизическиеЛица.Сидоров;
	УстановитьСтаж(Иванов, Дата(2009, 3, 1));
	УстановитьСтаж(Петров, Дата(2013, 5, 15));
	УстановитьСтаж(Сидоров, Дата(2012, 1, 10));

	УстановитьСтавку(Иванов, ОтделПродаж, 500);
	УстановитьСтавку(Петров, ОтделПродаж, 300);
	УстановитьСтавку(Сидоров, ОтделПродаж, 200);
	УстановитьСтавку(Сидоров, ОтделРазработки, 400);

	УстановитьПроцент(0, 5);
	УстановитьПроцент(1, 10);
	УстановитьПроцент(3, 15);

	Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Премия = ПланыВидовРасчета.ОсновныеНачисления.ПремияРуководителю;
	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;

	Для Месяц = 1 По 3 Цикл
		НачалоМес = Дата(2014, Месяц, 1);
		КонецМес = КонецМесяца(НачалоМес);
		Документ = Документы.НачислениеЗарплаты.СоздатьДокумент();
		Документ.Дата = КонецМес;
		ДобавитьНачисление(Документ, Иванов, ОтделПродаж, Тариф, НачалоМес, КонецМес);
		ДобавитьНачисление(Документ, Петров, ОтделПродаж, Тариф, НачалоМес, КонецМес);
		ДобавитьНачисление(Документ, Сидоров, ОтделПродаж, Тариф, НачалоМес, КонецМес);
		ДобавитьНачисление(Документ, Сидоров, ОтделРазработки, Тариф, НачалоМес, КонецМес);
		Если Месяц > 1 Тогда
			ДобавитьНачисление(Документ, Иванов, ОтделПродаж, Премия, НачалоМес, КонецМес);
		КонецЕсли;
		Если Месяц = 3 Тогда
			ДобавитьНачисление(Документ, Петров, ОтделПродаж, Командировка, Дата(2014, 3, 24), Дата(2014, 4, 4));
		КонецЕсли;
		Документ.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

	// Командировка, введенная задним числом: тариф февраля пересчитывается с учетом вытеснения.
	Документ = Документы.НачислениеЗарплаты.СоздатьДокумент();
	Документ.Дата = Дата(2014, 4, 10);
	ДобавитьНачисление(Документ, Сидоров, ОтделРазработки, Командировка, Дата(2014, 2, 10), Дата(2014, 2, 12));
	Документ.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

Процедура УстановитьСтаж(Сотрудник, ДатаНачалаСтажа)

	Объект = Сотрудник.ПолучитьОбъект();
	Объект.ДатаНачалаСтажа = ДатаНачалаСтажа;
	Объект.Записать();

КонецПроцедуры

Процедура УстановитьСтавку(Сотрудник, Подразделение, Ставка)

	Запись = РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи();
	Запись.Период = Дата(2014, 1, 1);
	Запись.Сотрудник = Сотрудник;
	Запись.Подразделение = Подразделение;
	Запись.Оклад = Ставка;
	Запись.Записать();

КонецПроцедуры

Процедура УстановитьПроцент(СтажОтЛет, Процент)

	Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
	Запись.СтажОтЛет = СтажОтЛет;
	Запись.ПроцентПремии = Процент;
	Запись.Записать();

КонецПроцедуры

Процедура ДобавитьНачисление(Документ, Сотрудник, Подразделение, ВидРасчета, ДатаНачала, ДатаОкончания)

	Строка = Документ.ОсновныеНачисления.Добавить();
	Строка.Сотрудник = Сотрудник;
	Строка.Подразделение = Подразделение;
	Строка.ВидРасчета = ВидРасчета;
	Строка.ДатаНачала = ДатаНачала;
	Строка.ДатаОкончания = ДатаОкончания;

КонецПроцедуры

#КонецОбласти

#Область УправляемыеФормы

Процедура ЗаполнитьУправляемыеФормы()

	ВалютаКредита = ВидСведений("Валюта кредита", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	СрокКредита = ВидСведений("Срок кредита, дни", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));
	Регион = ВидСведений("Регион", Новый ОписаниеТипов("СправочникСсылка.ЗначенияДополнительныхСведений"));

	Москва = Справочники.ЗначенияДополнительныхСведений.НайтиПоНаименованию("Москва", Истина, , Регион);
	Если Не ЗначениеЗаполнено(Москва) Тогда
		Объект = Справочники.ЗначенияДополнительныхСведений.СоздатьЭлемент();
		Объект.Владелец = Регион;
		Объект.Наименование = "Москва";
		Объект.Записать();
		Москва = Объект.Ссылка;
	КонецЕсли;

	Менеджер = Справочники.ФизическиеЛица.Иванов.ПолучитьОбъект();
	Менеджер.ДополнительныеСведенияКонтрагентов.Очистить();
	Менеджер.ДополнительныеСведенияКонтрагентов.Добавить().ВидСведений = ВалютаКредита;
	Менеджер.ДополнительныеСведенияКонтрагентов.Добавить().ВидСведений = СрокКредита;
	Менеджер.ДополнительныеСведенияКонтрагентов.Добавить().ВидСведений = Регион;
	Менеджер.Записать();

	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Наименование = "Завод ""Сатурн""";
	Контрагент.Менеджер = Менеджер.Ссылка;
	ДобавитьСведение(Контрагент, ВалютаКредита, Справочники.Валюты.РоссийскийРубль);
	ДобавитьСведение(Контрагент, СрокКредита, 10);
	ДобавитьСведение(Контрагент, Регион, Москва);
	Контрагент.Записать();

КонецПроцедуры

Функция ВидСведений(Наименование, ТипЗначения)

	Ссылка = ПланыВидовХарактеристик.ВидыДополнительныхСведений.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = ПланыВидовХарактеристик.ВидыДополнительныхСведений.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ТипЗначения = ТипЗначения;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура ДобавитьСведение(Контрагент, ВидСведений, Значение)

	Строка = Контрагент.ДополнительныеСведения.Добавить();
	Строка.ВидСведений = ВидСведений;
	Строка.Значение = Значение;

КонецПроцедуры

#КонецОбласти

Функция Элемент(ИмяСправочника, Наименование, Артикул = "")

	Менеджер = Справочники[ИмяСправочника];
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Менеджер.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Если ЗначениеЗаполнено(Артикул) Тогда
		Объект.Артикул = Артикул;
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура ДобавитьСтроку(Таблица, Номенклатура, Количество, Цена, Свойство = Неопределено, Подразделение = Неопределено)

	Строка = Таблица.Добавить();
	Строка.Номенклатура = Номенклатура;
	Строка.Количество = Количество;
	Строка.Цена = Цена;
	Строка.Сумма = Количество * Цена;
	Если Свойство <> Неопределено Тогда
		Строка.Свойство = Свойство;
	КонецЕсли;
	Если Подразделение <> Неопределено Тогда
		Строка.Подразделение = Подразделение;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
