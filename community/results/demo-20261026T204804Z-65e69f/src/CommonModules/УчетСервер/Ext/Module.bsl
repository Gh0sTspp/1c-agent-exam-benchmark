#Область ПрограммныйИнтерфейс

#Область ОперативныйУчет

// Списывает товары из регистров ОстаткиТоваров и ПартииТоваров.
// Себестоимость определяется по учетной политике подразделения на дату документа:
// ФИФО/ЛИФО - по партиям, По средней - по средней стоимости в разрезе подразделения, номенклатуры и свойства.
//
// Параметры:
//  Движения - КоллекцияДвижений - движения проводимого документа.
//  МенеджерВТ - МенеджерВременныхТаблиц - содержит ВТСписание (Подразделение, Номенклатура, Свойство, Количество).
//  МоментВремени - МоментВремени - момент проведения документа.
//  Отказ - Булево - устанавливается при нехватке товара.
//
// Возвращаемое значение:
//  ТаблицаЗначений - Подразделение, Номенклатура, Свойство, Количество, Стоимость.
//
Функция СписатьТовары(Движения, МенеджерВТ, МоментВремени, Отказ) Экспорт

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сп.Подразделение КАК Подразделение,
	|	Сп.Номенклатура КАК Номенклатура,
	|	Сп.Свойство КАК Свойство,
	|	СУММА(Сп.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТКСписанию
	|ИЗ
	|	ВТСписание КАК Сп
	|
	|СГРУППИРОВАТЬ ПО
	|	Сп.Подразделение,
	|	Сп.Номенклатура,
	|	Сп.Свойство
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Подразделение,
	|	Номенклатура,
	|	Свойство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	К.Подразделение КАК Подразделение,
	|	К.Номенклатура КАК Номенклатура
	|ИЗ
	|	ВТКСписанию КАК К";
	РезультатБлокировки = Запрос.Выполнить();

	Блокировка = Новый БлокировкаДанных;
	Для Каждого ИмяРегистра Из СтрРазделить("ОстаткиТоваров,ПартииТоваров", ",") Цикл
		ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления." + ИмяРегистра);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = РезультатБлокировки;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	КонецЦикла;
	Блокировка.Заблокировать();

	Запрос.УстановитьПараметр("МоментВремени", МоментВремени);
	Запрос.УстановитьПараметр("Дата", МоментВремени.Дата);
	Запрос.УстановитьПараметр("ЛИФО", Перечисления.УчетнаяПолитика.ЛИФО);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	К.Подразделение КАК Подразделение,
	|	К.Номенклатура КАК Номенклатура,
	|	К.Свойство КАК Свойство,
	|	К.Количество КАК КоличествоСписать,
	|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК КоличествоОстаток,
	|	ЕСТЬNULL(Остатки.СтоимостьОстаток, 0) КАК СтоимостьОстаток,
	|	ЕСТЬNULL(Политика.МетодСписания, ЗНАЧЕНИЕ(Перечисление.УчетнаяПолитика.ФИФО)) КАК МетодСписания,
	|	Партии.Партия КАК Партия,
	|	ЕСТЬNULL(Партии.КоличествоОстаток, 0) КАК КоличествоПартии,
	|	ЕСТЬNULL(Партии.СтоимостьОстаток, 0) КАК СтоимостьПартии,
	|	ВЫБОР
	|		КОГДА Политика.МетодСписания = &ЛИФО
	|			ТОГДА -1
	|		ИНАЧЕ 1
	|	КОНЕЦ * РАЗНОСТЬДАТ(ДАТАВРЕМЯ(2000, 1, 1), ЕСТЬNULL(Партии.Партия.Дата, ДАТАВРЕМЯ(2000, 1, 1)), СЕКУНДА) КАК ПорядокПартии
	|ИЗ
	|	ВТКСписанию КАК К
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
	|				&МоментВремени,
	|				(Подразделение, Номенклатура, Свойство) В
	|					(ВЫБРАТЬ
	|						Т.Подразделение,
	|						Т.Номенклатура,
	|						Т.Свойство
	|					ИЗ
	|						ВТКСписанию КАК Т)) КАК Остатки
	|		ПО К.Подразделение = Остатки.Подразделение
	|			И К.Номенклатура = Остатки.Номенклатура
	|			И К.Свойство = Остатки.Свойство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаПодразделений.СрезПоследних(
	|				&Дата,
	|				Подразделение В
	|					(ВЫБРАТЬ
	|						Т.Подразделение
	|					ИЗ
	|						ВТКСписанию КАК Т)) КАК Политика
	|		ПО К.Подразделение = Политика.Подразделение
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ПартииТоваров.Остатки(
	|				&МоментВремени,
	|				(Подразделение, Номенклатура, Свойство) В
	|					(ВЫБРАТЬ
	|						Т.Подразделение,
	|						Т.Номенклатура,
	|						Т.Свойство
	|					ИЗ
	|						ВТКСписанию КАК Т)) КАК Партии
	|		ПО К.Подразделение = Партии.Подразделение
	|			И К.Номенклатура = Партии.Номенклатура
	|			И К.Свойство = Партии.Свойство
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение,
	|	Номенклатура,
	|	Свойство,
	|	ПорядокПартии";

	Себестоимость = Новый ТаблицаЗначений;
	Себестоимость.Колонки.Добавить("Подразделение");
	Себестоимость.Колонки.Добавить("Номенклатура");
	Себестоимость.Колонки.Добавить("Свойство");
	Себестоимость.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Себестоимость.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));

	ПоСредней = Перечисления.УчетнаяПолитика.ПоСредней;
	Выборка = Запрос.Выполнить().Выбрать();
	ЕстьЗапись = Выборка.Следующий();
	Пока ЕстьЗапись Цикл

		Подразделение = Выборка.Подразделение;
		Номенклатура = Выборка.Номенклатура;
		Свойство = Выборка.Свойство;
		КоличествоСписать = Выборка.КоличествоСписать;
		КоличествоОстаток = Выборка.КоличествоОстаток;
		СтоимостьОстаток = Выборка.СтоимостьОстаток;
		МетодСписания = Выборка.МетодСписания;

		Если КоличествоСписать > КоличествоОстаток Тогда
			Отказ = Истина;
			ОбщегоНазначенияСообщить(СтрШаблон("Недостаточно ""%1""%2 в подразделении ""%3"": требуется %4, в наличии %5",
				Номенклатура, ?(ЗначениеЗаполнено(Свойство), " (" + Свойство + ")", ""), Подразделение,
				КоличествоСписать, КоличествоОстаток));
		КонецЕсли;

		// Списание партий в порядке учетной политики (для средней - в порядке ФИФО, только количественно-суммовой учет партий).
		ОсталосьСписать = КоличествоСписать;
		СтоимостьПоПартиям = 0;
		Пока ЕстьЗапись
			И Выборка.Подразделение = Подразделение
			И Выборка.Номенклатура = Номенклатура
			И Выборка.Свойство = Свойство Цикл

			Если ОсталосьСписать > 0 И Выборка.КоличествоПартии > 0 Тогда
				Списано = Мин(ОсталосьСписать, Выборка.КоличествоПартии);
				Если Списано = Выборка.КоличествоПартии Тогда
					СтоимостьСписания = Выборка.СтоимостьПартии;
				Иначе
					СтоимостьСписания = Окр(Выборка.СтоимостьПартии * Списано / Выборка.КоличествоПартии, 2);
				КонецЕсли;
				Движение = Движения.ПартииТоваров.ДобавитьРасход();
				Движение.Период = МоментВремени.Дата;
				Движение.Подразделение = Подразделение;
				Движение.Номенклатура = Номенклатура;
				Движение.Свойство = Свойство;
				Движение.Партия = Выборка.Партия;
				Движение.Количество = Списано;
				Движение.Стоимость = СтоимостьСписания;
				ОсталосьСписать = ОсталосьСписать - Списано;
				СтоимостьПоПартиям = СтоимостьПоПартиям + СтоимостьСписания;
			КонецЕсли;
			ЕстьЗапись = Выборка.Следующий();

		КонецЦикла;

		Если КоличествоСписать >= КоличествоОстаток Тогда
			Стоимость = СтоимостьОстаток;
		ИначеЕсли МетодСписания = ПоСредней Тогда
			Стоимость = Окр(СтоимостьОстаток * КоличествоСписать / КоличествоОстаток, 2);
		Иначе
			Стоимость = СтоимостьПоПартиям;
		КонецЕсли;

		Движение = Движения.ОстаткиТоваров.ДобавитьРасход();
		Движение.Период = МоментВремени.Дата;
		Движение.Подразделение = Подразделение;
		Движение.Номенклатура = Номенклатура;
		Движение.Свойство = Свойство;
		Движение.Количество = КоличествоСписать;
		Движение.Стоимость = Стоимость;

		СтрокаСебестоимости = Себестоимость.Добавить();
		СтрокаСебестоимости.Подразделение = Подразделение;
		СтрокаСебестоимости.Номенклатура = Номенклатура;
		СтрокаСебестоимости.Свойство = Свойство;
		СтрокаСебестоимости.Количество = КоличествоСписать;
		СтрокаСебестоимости.Стоимость = Стоимость;

	КонецЦикла;

	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.ПартииТоваров.Записывать = Истина;

	Возврат Себестоимость;

КонецФункции

#КонецОбласти

#Область БухгалтерскийУчет

// Пересчитывает группы аналогов (транзитивное замыкание связей регистра АналогиНоменклатуры).
// Товары, связанные цепочкой аналогов, получают общий номер группы.
//
Процедура ПересчитатьГруппыАналогов() Экспорт

	Блокировка = Новый БлокировкаДанных;
	Блокировка.Добавить("РегистрСведений.ГруппыАналогов").Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	А.Номенклатура КАК Номенклатура,
	|	А.Аналог КАК Аналог
	|ИЗ
	|	РегистрСведений.АналогиНоменклатуры КАК А";
	Выборка = Запрос.Выполнить().Выбрать();

	// Граф связей: товар -> массив соседей (связь аналогов симметрична и транзитивна).
	Соседи = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Если Выборка.Номенклатура = Выборка.Аналог Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСоседа(Соседи, Выборка.Номенклатура, Выборка.Аналог);
		ДобавитьСоседа(Соседи, Выборка.Аналог, Выборка.Номенклатура);
	КонецЦикла;

	НаборЗаписей = РегистрыСведений.ГруппыАналогов.СоздатьНаборЗаписей();
	Группы = Новый Соответствие;
	НомерГруппы = 0;
	Для Каждого Элемент Из Соседи Цикл
		Если Группы[Элемент.Ключ] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НомерГруппы = НомерГруппы + 1;
		Очередь = Новый Массив;
		Очередь.Добавить(Элемент.Ключ);
		Группы.Вставить(Элемент.Ключ, НомерГруппы);
		Индекс = 0;
		Пока Индекс < Очередь.Количество() Цикл
			Товар = Очередь[Индекс];
			Индекс = Индекс + 1;
			Запись = НаборЗаписей.Добавить();
			Запись.Номенклатура = Товар;
			Запись.Группа = НомерГруппы;
			Для Каждого Сосед Из Соседи[Товар] Цикл
				Если Группы[Сосед] = Неопределено Тогда
					Группы.Вставить(Сосед, НомерГруппы);
					Очередь.Добавить(Сосед);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	НаборЗаписей.Записать();

КонецПроцедуры

#КонецОбласти

#Область ПериодическиеРасчеты

// Заполняет вытесняющие и базовые виды расчета предопределенных видов расчета,
// если они еще не заполнены (настройка хранится в данных плана видов расчета).
//
Процедура НастроитьВидыРасчета() Экспорт

	Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Премия = ПланыВидовРасчета.ОсновныеНачисления.ПремияРуководителю;
	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;

	Настройки = Новый Соответствие;
	Настройки.Вставить(Тариф, Новый Структура("Вытесняющие, Базовые", ОбщийМассив(Командировка), Новый Массив));
	Настройки.Вставить(Премия, Новый Структура("Вытесняющие, Базовые", ОбщийМассив(Командировка), ОбщийМассив(Тариф)));
	Настройки.Вставить(Командировка, Новый Структура("Вытесняющие, Базовые", Новый Массив, ОбщийМассив(Тариф, Премия, Командировка)));

	Для Каждого Настройка Из Настройки Цикл
		ВидРасчета = Настройка.Ключ;
		Если ВидРасчета.ВытесняющиеВидыРасчета.Количество() = Настройка.Значение.Вытесняющие.Количество()
			И ВидРасчета.БазовыеВидыРасчета.Количество() = Настройка.Значение.Базовые.Количество() Тогда
			Продолжить;
		КонецЕсли;
		Объект = ВидРасчета.ПолучитьОбъект();
		Объект.ВытесняющиеВидыРасчета.Очистить();
		Для Каждого Вид Из Настройка.Значение.Вытесняющие Цикл
			Объект.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Вид;
		КонецЦикла;
		Объект.БазовыеВидыРасчета.Очистить();
		Для Каждого Вид Из Настройка.Значение.Базовые Цикл
			Объект.БазовыеВидыРасчета.Добавить().ВидРасчета = Вид;
		КонецЦикла;
		Объект.Записать();
	КонецЦикла;

КонецПроцедуры

// Количество полных лет между датами.
//
Функция ПолныхЛет(ДатаНачала, ДатаОкончания) Экспорт

	Если Не ЗначениеЗаполнено(ДатаНачала) Или ДатаОкончания < ДатаНачала Тогда
		Возврат 0;
	КонецЕсли;
	Лет = Год(ДатаОкончания) - Год(ДатаНачала);
	Если ДобавитьМесяц(НачалоДня(ДатаНачала), Лет * 12) > НачалоДня(ДатаОкончания) Тогда
		Лет = Лет - 1;
	КонецЕсли;
	Возврат Лет;

КонецФункции

#КонецОбласти

// Выводит сообщение пользователю.
//
Процедура ОбщегоНазначенияСообщить(Текст) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСоседа(Соседи, Товар, Сосед)

	Список = Соседи[Товар];
	Если Список = Неопределено Тогда
		Список = Новый Массив;
		Соседи.Вставить(Товар, Список);
	КонецЕсли;
	Если Список.Найти(Сосед) = Неопределено Тогда
		Список.Добавить(Сосед);
	КонецЕсли;

КонецПроцедуры

Функция ОбщийМассив(Значение1, Значение2 = Неопределено, Значение3 = Неопределено)

	Результат = Новый Массив;
	Для Каждого Значение Из ОбщийМассивЗначений(Значение1, Значение2, Значение3) Цикл
		Результат.Добавить(Значение);
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОбщийМассивЗначений(Значение1, Значение2, Значение3)

	Результат = Новый Массив;
	Результат.Добавить(Значение1);
	Если Значение2 <> Неопределено Тогда
		Результат.Добавить(Значение2);
	КонецЕсли;
	Если Значение3 <> Неопределено Тогда
		Результат.Добавить(Значение3);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти
