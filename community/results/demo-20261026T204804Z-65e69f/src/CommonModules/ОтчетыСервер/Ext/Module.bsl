#Область ПрограммныйИнтерфейс

// Выполняет схему компоновки данных отчета и возвращает плоскую таблицу значений
// (детальные записи со всеми полями набора данных).
//
// Параметры:
//  Схема - СхемаКомпоновкиДанных - основная схема отчета.
//  Параметры - Структура - значения параметров данных схемы.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки соответствуют полям схемы.
//
Функция ДанныеСхемы(Схема, Параметры) Экспорт

	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема));
	Компоновщик.ЗагрузитьНастройки(Схема.НастройкиПоУмолчанию);
	Настройки = Компоновщик.Настройки;

	Настройки.Структура.Очистить();
	Настройки.Выбор.Элементы.Очистить();
	Для Каждого ПолеНабора Из Схема.НаборыДанных[0].Поля Цикл
		ВыбранноеПоле = Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ПолеНабора.ПутьКДанным);
	КонецЦикла;
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));

	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ВертикальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);
	Настройки.ПараметрыВывода.УстановитьЗначениеПараметра("ГоризонтальноеРасположениеОбщихИтогов", РасположениеИтоговКомпоновкиДанных.Нет);

	Для Каждого Параметр Из Параметры Цикл
		Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Параметр.Ключ, Параметр.Значение);
	КонецЦикла;

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = КомпоновщикМакета.Выполнить(Схема, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	Процессор = Новый ПроцессорКомпоновкиДанных;
	Процессор.Инициализировать(Макет);

	Результат = Новый ТаблицаЗначений;
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Результат);
	ПроцессорВывода.Вывести(Процессор);

	Возврат Результат;

КонецФункции

#КонецОбласти
