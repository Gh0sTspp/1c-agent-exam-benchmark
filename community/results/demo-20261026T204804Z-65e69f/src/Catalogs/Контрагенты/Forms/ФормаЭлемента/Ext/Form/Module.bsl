#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ПостроитьДополнительныеПоля();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	ПеренестиЗначенияДополнительныхПолей(ТекущийОбъект.ДополнительныеСведения);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)

	МенеджерПриИзмененииНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура МенеджерПриИзмененииНаСервере()

	ПеренестиЗначенияДополнительныхПолей(Объект.ДополнительныеСведения);
	ПостроитьДополнительныеПоля();

КонецПроцедуры

// Создает поля ввода для видов дополнительных сведений, указанных у выбранного менеджера.
// В списке ДополнительныеПоля: значение - вид сведений, представление - имя реквизита и элемента формы.
//
&НаСервере
Процедура ПостроитьДополнительныеПоля()

	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого Поле Из ДополнительныеПоля Цикл
		Элементы.Удалить(Элементы[Поле.Представление]);
		УдаляемыеРеквизиты.Добавить(Поле.Представление);
	КонецЦикла;
	ДополнительныеПоля.Очистить();
	Если УдаляемыеРеквизиты.Количество() > 0 Тогда
		ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сведения.ВидСведений КАК ВидСведений,
	|	Сведения.ВидСведений.Наименование КАК Наименование,
	|	Сведения.ВидСведений.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.ФизическиеЛица.ДополнительныеСведенияКонтрагентов КАК Сведения
	|ГДЕ
	|	Сведения.Ссылка = &Менеджер
	|	И Сведения.ВидСведений <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыДополнительныхСведений.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сведения.НомерСтроки";
	Выборка = Запрос.Выполнить().Выбрать();

	ДобавляемыеРеквизиты = Новый Массив;
	Заголовки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если ДополнительныеПоля.НайтиПоЗначению(Выборка.ВидСведений) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяРеквизита = "ДополнительноеСведение" + Формат(ДополнительныеПоля.Количество() + 1, "ЧГ=0");
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизита, Выборка.ТипЗначения, , Выборка.Наименование));
		ДополнительныеПоля.Добавить(Выборка.ВидСведений, ИмяРеквизита);
		Заголовки.Добавить(Выборка.Наименование);
	КонецЦикла;
	Если ДобавляемыеРеквизиты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	Для Индекс = 0 По ДополнительныеПоля.Количество() - 1 Цикл
		Поле = ДополнительныеПоля[Индекс];
		Элемент = Элементы.Добавить(Поле.Представление, Тип("ПолеФормы"), Элементы.ГруппаДополнительныеСведения);
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = Поле.Представление;
		Элемент.Заголовок = Заголовки[Индекс];

		НайденныеСтроки = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Поле.Значение));
		Если НайденныеСтроки.Количество() > 0 Тогда
			ЭтотОбъект[Поле.Представление] = НайденныеСтроки[0].Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Переносит значения дополнительных полей формы в табличную часть ДополнительныеСведения.
//
&НаСервере
Процедура ПеренестиЗначенияДополнительныхПолей(ДополнительныеСведения)

	Для Каждого Поле Из ДополнительныеПоля Цикл
		Значение = ЭтотОбъект[Поле.Представление];
		НайденныеСтроки = ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Поле.Значение));
		Для Каждого Строка Из НайденныеСтроки Цикл
			ДополнительныеСведения.Удалить(Строка);
		КонецЦикла;
		Если ЗначениеЗаполнено(Значение) Тогда
			НоваяСтрока = ДополнительныеСведения.Добавить();
			НоваяСтрока.ВидСведений = Поле.Значение;
			НоваяСтрока.Значение = Значение;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
