#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Склад) Тогда
		УчетСервер.ОбщегоНазначенияСообщить("Укажите подразделение (оперативный учет) и/или склад (бухгалтерский учет)");
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СуммаПоДокументу = СписокНоменклатуры.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Строки.Номенклатура КАК Номенклатура,
	|	Строки.Свойство КАК Свойство,
	|	СУММА(Строки.Количество) КАК Количество,
	|	СУММА(Строки.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ПриходнаяНакладная.СписокНоменклатуры КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Номенклатура,
	|	Строки.Свойство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Строки.Номенклатура КАК Номенклатура,
	|	СУММА(Строки.Количество) КАК Количество,
	|	СУММА(Строки.Сумма) КАК Сумма
	|ИЗ
	|	Документ.ПриходнаяНакладная.СписокНоменклатуры КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Номенклатура";
	Результаты = Запрос.ВыполнитьПакет();

	// Оперативный учет: остатки и партии в разрезе подразделения, номенклатуры и свойства.
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Выборка = Результаты[0].Выбрать();
		Пока Выборка.Следующий() Цикл
			Движение = Движения.ОстаткиТоваров.ДобавитьПриход();
			Движение.Период = Дата;
			Движение.Подразделение = Подразделение;
			Движение.Номенклатура = Выборка.Номенклатура;
			Движение.Свойство = Выборка.Свойство;
			Движение.Количество = Выборка.Количество;
			Движение.Стоимость = Выборка.Сумма;

			Движение = Движения.ПартииТоваров.ДобавитьПриход();
			Движение.Период = Дата;
			Движение.Подразделение = Подразделение;
			Движение.Номенклатура = Выборка.Номенклатура;
			Движение.Свойство = Выборка.Свойство;
			Движение.Партия = Ссылка;
			Движение.Количество = Выборка.Количество;
			Движение.Стоимость = Выборка.Сумма;
		КонецЦикла;
		Движения.ОстаткиТоваров.Записывать = Истина;
		Движения.ПартииТоваров.Записывать = Истина;
	КонецЕсли;

	// Бухгалтерский учет: Дт Товары - Кт Поставщики.
	Если ЗначениеЗаполнено(Склад) Тогда
		Выборка = Результаты[1].Выбрать();
		Пока Выборка.Следующий() Цикл
			Проводка = Движения.Управленческий.Добавить();
			Проводка.Период = Дата;
			Проводка.СчетДт = ПланыСчетов.Управленческий.Товары;
			Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Выборка.Номенклатура;
			Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Склад;
			Проводка.КоличествоДт = Выборка.Количество;
			Проводка.СчетКт = ПланыСчетов.Управленческий.Поставщики;
			Проводка.Сумма = Выборка.Сумма;
		КонецЦикла;
		Движения.Управленческий.Записывать = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
