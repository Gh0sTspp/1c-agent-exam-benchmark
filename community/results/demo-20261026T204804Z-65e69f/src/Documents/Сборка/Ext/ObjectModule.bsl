#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ПодразделениеСписания", ПодразделениеСписания);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Блоки.СистемныйБлок КАК СистемныйБлок,
	|	СУММА(Блоки.Количество) КАК Количество
	|ПОМЕСТИТЬ ВТБлоки
	|ИЗ
	|	Документ.Сборка.СистемныеБлоки КАК Блоки
	|ГДЕ
	|	Блоки.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Блоки.СистемныйБлок
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	СистемныйБлок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Срез.Период КАК Период,
	|	Срез.СистемныйБлок КАК СистемныйБлок,
	|	Срез.Деталь КАК Деталь,
	|	Срез.Свойство КАК Свойство,
	|	Срез.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСрез
	|ИЗ
	|	РегистрСведений.СпецификацииСистемныхБлоков.СрезПоследних(
	|			&Дата,
	|			СистемныйБлок В
	|				(ВЫБРАТЬ
	|					Б.СистемныйБлок
	|				ИЗ
	|					ВТБлоки КАК Б)) КАК Срез
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// Актуальная спецификация блока - записи с последней датой изменения состава
	|ВЫБРАТЬ
	|	Срез.СистемныйБлок КАК СистемныйБлок,
	|	МАКСИМУМ(Срез.Период) КАК Период
	|ПОМЕСТИТЬ ВТАктуальныеСпецификации
	|ИЗ
	|	ВТСрез КАК Срез
	|
	|СГРУППИРОВАТЬ ПО
	|	Срез.СистемныйБлок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Срез.СистемныйБлок КАК СистемныйБлок,
	|	Срез.Деталь КАК Номенклатура,
	|	Срез.Свойство КАК Свойство,
	|	Блоки.Количество * Срез.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСоставБлоков
	|ИЗ
	|	ВТСрез КАК Срез
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТАктуальныеСпецификации КАК Актуальные
	|		ПО Срез.СистемныйБлок = Актуальные.СистемныйБлок
	|			И Срез.Период = Актуальные.Период
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТБлоки КАК Блоки
	|		ПО Срез.СистемныйБлок = Блоки.СистемныйБлок
	|ГДЕ
	|	Срез.Количество > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ПодразделениеСписания КАК Подразделение,
	|	Состав.Номенклатура КАК Номенклатура,
	|	Состав.Свойство КАК Свойство,
	|	Состав.Количество КАК Количество
	|ПОМЕСТИТЬ ВТСписание
	|ИЗ
	|	ВТСоставБлоков КАК Состав
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	&ПодразделениеСписания,
	|	Детали.Деталь,
	|	Детали.Свойство,
	|	Детали.Количество
	|ИЗ
	|	Документ.Сборка.ДополнительныеДетали КАК Детали
	|ГДЕ
	|	Детали.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Блоки.СистемныйБлок КАК СистемныйБлок,
	|	Блоки.Количество КАК Количество,
	|	НЕ Актуальные.Период ЕСТЬ NULL КАК ЕстьСпецификация
	|ИЗ
	|	ВТБлоки КАК Блоки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТАктуальныеСпецификации КАК Актуальные
	|		ПО Блоки.СистемныйБлок = Актуальные.СистемныйБлок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Состав.СистемныйБлок КАК СистемныйБлок,
	|	Состав.Номенклатура КАК Номенклатура,
	|	Состав.Свойство КАК Свойство,
	|	Состав.Количество КАК Количество
	|ИЗ
	|	ВТСоставБлоков КАК Состав";
	Результаты = Запрос.ВыполнитьПакет();
	Блоки = Результаты[5].Выгрузить();
	СоставБлоков = Результаты[6].Выгрузить();

	Для Каждого СтрокаБлока Из Блоки Цикл
		Если Не СтрокаБлока.ЕстьСпецификация Тогда
			УчетСервер.ОбщегоНазначенияСообщить(СтрШаблон("Для системного блока ""%1"" не задана спецификация на %2",
				СтрокаБлока.СистемныйБлок, Формат(Дата, "ДЛФ=D")));
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Себестоимость = УчетСервер.СписатьТовары(Движения, МенеджерВТ, МоментВремени(), Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// Распределение себестоимости деталей по собранным блокам:
	// детали спецификации - по составу блока, дополнительные детали - пропорционально количеству блоков.
	Себестоимость.Индексы.Добавить("Номенклатура, Свойство");
	Блоки.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	СтоимостьВсего = Себестоимость.Итог("Стоимость");
	СтоимостьПоСпецификациям = 0;
	Для Каждого СтрокаБлока Из Блоки Цикл
		Для Каждого СтрокаСостава Из СоставБлоков.НайтиСтроки(Новый Структура("СистемныйБлок", СтрокаБлока.СистемныйБлок)) Цикл
			Строки = Себестоимость.НайтиСтроки(Новый Структура("Номенклатура, Свойство",
				СтрокаСостава.Номенклатура, СтрокаСостава.Свойство));
			Если Строки.Количество() > 0 И Строки[0].Количество <> 0 Тогда
				СтрокаБлока.Стоимость = СтрокаБлока.Стоимость
					+ Окр(Строки[0].Стоимость * СтрокаСостава.Количество / Строки[0].Количество, 2);
			КонецЕсли;
		КонецЦикла;
		СтоимостьПоСпецификациям = СтоимостьПоСпецификациям + СтрокаБлока.Стоимость;
	КонецЦикла;

	КоличествоБлоков = Блоки.Итог("Количество");
	Распределено = 0;
	Для Индекс = 0 По Блоки.Количество() - 1 Цикл
		СтрокаБлока = Блоки[Индекс];
		Если Индекс = Блоки.Количество() - 1 Тогда
			СтрокаБлока.Стоимость = СтоимостьВсего - Распределено;
		Иначе
			СтрокаБлока.Стоимость = СтрокаБлока.Стоимость
				+ Окр((СтоимостьВсего - СтоимостьПоСпецификациям) * СтрокаБлока.Количество / КоличествоБлоков, 2);
		КонецЕсли;
		Распределено = Распределено + СтрокаБлока.Стоимость;

		Движение = Движения.ОстаткиТоваров.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Подразделение = ПодразделениеПоступления;
		Движение.Номенклатура = СтрокаБлока.СистемныйБлок;
		Движение.Количество = СтрокаБлока.Количество;
		Движение.Стоимость = СтрокаБлока.Стоимость;

		Движение = Движения.ПартииТоваров.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Подразделение = ПодразделениеПоступления;
		Движение.Номенклатура = СтрокаБлока.СистемныйБлок;
		Движение.Партия = Ссылка;
		Движение.Количество = СтрокаБлока.Количество;
		Движение.Стоимость = СтрокаБлока.Стоимость;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
