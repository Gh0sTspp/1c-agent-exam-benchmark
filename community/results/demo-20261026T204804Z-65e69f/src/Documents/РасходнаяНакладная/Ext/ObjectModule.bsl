#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если ЗначениеЗаполнено(Склад) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Строка Из СписокНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(Строка.Подразделение) Тогда
			УчетСервер.ОбщегоНазначенияСообщить(СтрШаблон(
				"Строка %1: укажите подразделение (оперативный учет) или склад документа (бухгалтерский учет)",
				Строка.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СуммаПоДокументу = СписокНоменклатуры.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	ПровестиПоОперативномуУчету(Отказ);
	Если Не Отказ И ЗначениеЗаполнено(Склад) Тогда
		ПровестиПоБухгалтерскомуУчету(Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Оперативный учет: строки с указанным подразделением списываются по учетной политике подразделения.
//
Процедура ПровестиПоОперативномуУчету(Отказ)

	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Строки.Подразделение КАК Подразделение,
	|	Строки.Номенклатура КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.СвойстваНоменклатуры.ПустаяСсылка) КАК Свойство,
	|	СУММА(Строки.Количество) КАК Количество,
	|	СУММА(Строки.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТСписание
	|ИЗ
	|	Документ.РасходнаяНакладная.СписокНоменклатуры КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|	И Строки.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Подразделение,
	|	Строки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Сп.Подразделение КАК Подразделение,
	|	Сп.Номенклатура КАК Номенклатура,
	|	Сп.Сумма КАК Сумма
	|ИЗ
	|	ВТСписание КАК Сп";
	Выручка = Запрос.Выполнить().Выгрузить();
	Если Выручка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Себестоимость = УчетСервер.СписатьТовары(Движения, МенеджерВТ, МоментВремени(), Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаСебестоимости Из Себестоимость Цикл
		Отбор = Новый Структура("Подразделение, Номенклатура", СтрокаСебестоимости.Подразделение, СтрокаСебестоимости.Номенклатура);
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Подразделение = СтрокаСебестоимости.Подразделение;
		Движение.Номенклатура = СтрокаСебестоимости.Номенклатура;
		Движение.Количество = СтрокаСебестоимости.Количество;
		Движение.Себестоимость = СтрокаСебестоимости.Стоимость;
		Движение.Выручка = Выручка.НайтиСтроки(Отбор)[0].Сумма;
	КонецЦикла;
	Движения.Продажи.Записывать = Истина;

КонецПроцедуры

// Бухгалтерский учет: списание товара, при нехватке - его аналогов в порядке артикулов.
// Себестоимость - средняя в разрезе номенклатуры (по всем складам).
//
Процедура ПровестиПоБухгалтерскомуУчету(Отказ)

	СчетТовары = ПланыСчетов.Управленческий.Товары;
	ВидНоменклатура = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
	ВидСклады = ПланыВидовХарактеристик.ВидыСубконто.Склады;
	ВидЗаказанная = ПланыВидовХарактеристик.ВидыСубконто.ЗаказаннаяНоменклатура;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.Управленческий");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Счет", СчетТовары);
	Блокировка.Заблокировать();

	ВидыСубконтоНоменклатура = Новый Массив;
	ВидыСубконтоНоменклатура.Добавить(ВидНоменклатура);
	ВидыСубконтоНоменклатураСклад = Новый Массив;
	ВидыСубконтоНоменклатураСклад.Добавить(ВидНоменклатура);
	ВидыСубконтоНоменклатураСклад.Добавить(ВидСклады);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	Запрос.УстановитьПараметр("Склад", Склад);
	Запрос.УстановитьПараметр("СчетТовары", СчетТовары);
	Запрос.УстановитьПараметр("ВидыСубконтоНоменклатура", ВидыСубконтоНоменклатура);
	Запрос.УстановитьПараметр("ВидыСубконтоНоменклатураСклад", ВидыСубконтоНоменклатураСклад);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Строки.Номенклатура КАК Номенклатура,
	|	СУММА(Строки.Количество) КАК Количество,
	|	СУММА(Строки.Сумма) КАК Сумма
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	Документ.РасходнаяНакладная.СписокНоменклатуры КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	Строки.Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Товары.Номенклатура КАК Товар,
	|	Товары.Номенклатура КАК Списываемый,
	|	0 КАК Приоритет
	|ПОМЕСТИТЬ ВТКандидаты
	|ИЗ
	|	ВТТовары КАК Товары
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Товары.Номенклатура,
	|	Аналоги.Номенклатура,
	|	1
	|ИЗ
	|	ВТТовары КАК Товары
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГруппыАналогов КАК ГруппаТовара
	|		ПО Товары.Номенклатура = ГруппаТовара.Номенклатура
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ГруппыАналогов КАК Аналоги
	|		ПО ГруппаТовара.Группа = Аналоги.Группа
	|			И Товары.Номенклатура <> Аналоги.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Списываемый
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Кандидаты.Товар КАК Товар,
	|	Товары.Количество КАК КоличествоТовара,
	|	Товары.Сумма КАК СуммаТовара,
	|	Кандидаты.Списываемый КАК Списываемый,
	|	Кандидаты.Приоритет КАК Приоритет,
	|	Кандидаты.Списываемый.Артикул КАК Артикул,
	|	ЕСТЬNULL(ОстаткиНаСкладе.КоличествоОстаток, 0) КАК КоличествоНаСкладе,
	|	ЕСТЬNULL(ОстаткиВсего.КоличествоОстаток, 0) КАК КоличествоВсего,
	|	ЕСТЬNULL(ОстаткиВсего.СуммаОстаток, 0) КАК СуммаВсего
	|ИЗ
	|	ВТКандидаты КАК Кандидаты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТовары КАК Товары
	|		ПО Кандидаты.Товар = Товары.Номенклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Управленческий.Остатки(
	|				&МоментВремени,
	|				Счет = &СчетТовары,
	|				&ВидыСубконтоНоменклатураСклад,
	|				Субконто1 В
	|						(ВЫБРАТЬ
	|							К.Списываемый
	|						ИЗ
	|							ВТКандидаты КАК К)
	|					И Субконто2 = &Склад) КАК ОстаткиНаСкладе
	|		ПО Кандидаты.Списываемый = ОстаткиНаСкладе.Субконто1
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Управленческий.Остатки(
	|				&МоментВремени,
	|				Счет = &СчетТовары,
	|				&ВидыСубконтоНоменклатура,
	|				Субконто1 В
	|					(ВЫБРАТЬ
	|						К.Списываемый
	|					ИЗ
	|						ВТКандидаты КАК К)) КАК ОстаткиВсего
	|		ПО Кандидаты.Списываемый = ОстаткиВсего.Субконто1
	|
	|УПОРЯДОЧИТЬ ПО
	|	Товар,
	|	Приоритет,
	|	Артикул";
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Выборка = Запрос.Выполнить().Выбрать();

	// Учет уже списанного этим документом (один товар может быть аналогом нескольких строк).
	Использовано = Новый Соответствие;

	ЕстьЗапись = Выборка.Следующий();
	Пока ЕстьЗапись Цикл

		Товар = Выборка.Товар;
		ОсталосьСписать = Выборка.КоличествоТовара;
		СуммаТовара = Выборка.СуммаТовара;
		КоличествоТовара = Выборка.КоличествоТовара;
		ВыручкаРаспределено = 0;

		Пока ЕстьЗапись И Выборка.Товар = Товар Цикл

			Списываемый = Выборка.Списываемый;
			Использование = Использовано[Списываемый];
			Если Использование = Неопределено Тогда
				Использование = Новый Структура("Количество, Сумма", 0, 0);
				Использовано.Вставить(Списываемый, Использование);
			КонецЕсли;

			Доступно = Выборка.КоличествоНаСкладе - Использование.Количество;
			Если ОсталосьСписать > 0 И Доступно > 0 Тогда

				Списано = Мин(ОсталосьСписать, Доступно);
				КоличествоВсего = Выборка.КоличествоВсего - Использование.Количество;
				СуммаВсего = Выборка.СуммаВсего - Использование.Сумма;
				Если Списано >= КоличествоВсего Тогда
					Себестоимость = СуммаВсего;
				Иначе
					Себестоимость = Окр(СуммаВсего * Списано / КоличествоВсего, 2);
				КонецЕсли;
				Использование.Количество = Использование.Количество + Списано;
				Использование.Сумма = Использование.Сумма + Себестоимость;
				ОсталосьСписать = ОсталосьСписать - Списано;

				Если ОсталосьСписать = 0 Тогда
					ВыручкаСтроки = СуммаТовара - ВыручкаРаспределено;
				Иначе
					ВыручкаСтроки = Окр(СуммаТовара * Списано / КоличествоТовара, 2);
				КонецЕсли;
				ВыручкаРаспределено = ВыручкаРаспределено + ВыручкаСтроки;

				// Дт Прибыли и убытки - Кт Товары: себестоимость
				Проводка = Движения.Управленческий.Добавить();
				Проводка.Период = Дата;
				Проводка.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
				Проводка.СубконтоДт[ВидНоменклатура] = Списываемый;
				Проводка.СубконтоДт[ВидЗаказанная] = Товар;
				Проводка.КоличествоДт = Списано;
				Проводка.СчетКт = СчетТовары;
				Проводка.СубконтоКт[ВидНоменклатура] = Списываемый;
				Проводка.СубконтоКт[ВидСклады] = Склад;
				Проводка.КоличествоКт = Списано;
				Проводка.Сумма = Себестоимость;

				// Дт Покупатели - Кт Прибыли и убытки: выручка в продажных ценах
				Проводка = Движения.Управленческий.Добавить();
				Проводка.Период = Дата;
				Проводка.СчетДт = ПланыСчетов.Управленческий.Покупатели;
				Проводка.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
				Проводка.СубконтоКт[ВидНоменклатура] = Списываемый;
				Проводка.СубконтоКт[ВидЗаказанная] = Товар;
				Проводка.Сумма = ВыручкаСтроки;

			КонецЕсли;
			ЕстьЗапись = Выборка.Следующий();

		КонецЦикла;

		Если ОсталосьСписать > 0 Тогда
			Отказ = Истина;
			УчетСервер.ОбщегоНазначенияСообщить(СтрШаблон(
				"Недостаточно товара ""%1"" и его аналогов на складе ""%2"": не хватает %3",
				Товар, Склад, ОсталосьСписать));
		КонецЕсли;

	КонецЦикла;

	Движения.Управленческий.Записывать = Истина;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
