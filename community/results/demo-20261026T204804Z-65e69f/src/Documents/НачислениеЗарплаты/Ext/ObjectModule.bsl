#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Премия = ПланыВидовРасчета.ОсновныеНачисления.ПремияРуководителю;
	Для Каждого Строка Из ОсновныеНачисления Цикл
		Если Строка.ДатаОкончания < Строка.ДатаНачала Тогда
			Сообщить(СтрШаблон("Строка %1: дата окончания меньше даты начала", Строка.НомерСтроки));
			Отказ = Истина;
		ИначеЕсли (Строка.ВидРасчета = Тариф Или Строка.ВидРасчета = Премия)
			И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда
			Сообщить(СтрШаблон("Строка %1: начисления по тарифу и премии вводятся в пределах одного месяца", Строка.НомерСтроки));
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрРасчета.ОсновныеНачисления.НаборЗаписей");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Регистратор", Ссылка);
	Блокировка.Заблокировать();

	СформироватьЗаписи();
	Движения.ОсновныеНачисления.Записать();

	РассчитатьТариф();
	РассчитатьПремию();
	РассчитатьКомандировки();
	ПерепровестиВытесненныеНачисления();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует записи регистра расчета по строкам документа.
// Командировка разбивается по месяцам: период регистрации каждой части - месяц ее периода действия.
//
Процедура СформироватьЗаписи()

	Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Премия = ПланыВидовРасчета.ОсновныеНачисления.ПремияРуководителю;
	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;

	Набор = Движения.ОсновныеНачисления;
	Набор.Очистить();
	Для Каждого Строка Из ОсновныеНачисления Цикл

		Если Строка.ВидРасчета = Командировка Тогда
			МесяцНачала = НачалоМесяца(Строка.ДатаНачала);
			Месяц = МесяцНачала;
			Пока Месяц <= Строка.ДатаОкончания Цикл
				Запись = Набор.Добавить();
				ЗаполнитьЗапись(Запись, Строка, Месяц,
					Макс(Строка.ДатаНачала, Месяц), Мин(КонецДня(Строка.ДатаОкончания), КонецМесяца(Месяц)));
				// База командировки - три месяца, предшествующие началу командировки.
				Запись.БазовыйПериодНачало = ДобавитьМесяц(МесяцНачала, -3);
				Запись.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(МесяцНачала, -1));
				Месяц = ДобавитьМесяц(Месяц, 1);
			КонецЦикла;
		Иначе
			Месяц = НачалоМесяца(Строка.ДатаНачала);
			Запись = Набор.Добавить();
			ЗаполнитьЗапись(Запись, Строка, Месяц, Строка.ДатаНачала, КонецДня(Строка.ДатаОкончания));
			Если Строка.ВидРасчета = Премия Тогда
				// База премии - начисления по тарифу за предыдущий месяц.
				Запись.БазовыйПериодНачало = ДобавитьМесяц(Месяц, -1);
				Запись.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(Месяц, -1));
			КонецЕсли;
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьЗапись(Запись, Строка, ПериодРегистрации, Начало, Окончание)

	Запись.ПериодРегистрации = ПериодРегистрации;
	Запись.ВидРасчета = Строка.ВидРасчета;
	Запись.Сотрудник = Строка.Сотрудник;
	Запись.Подразделение = Строка.Подразделение;
	Запись.ПериодДействияНачало = НачалоДня(Начало);
	Запись.ПериодДействияКонец = КонецДня(Окончание);

КонецПроцедуры

// Тариф: ставка на начало расчетного периода * фактически отработанные часы по графику подразделения.
//
Процедура РассчитатьТариф()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Тариф", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.НомерСтроки КАК НомерСтроки,
	|	Данные.Сотрудник КАК Сотрудник,
	|	Данные.Подразделение КАК Подразделение,
	|	Данные.ПериодРегистрации КАК ПериодРегистрации,
	|	ЕСТЬNULL(Данные.ЗначениеФактическийПериодДействия, 0) КАК Часы,
	|	ЕСТЬNULL(Данные.ДниФактическийПериодДействия, 0) КАК Дни
	|ПОМЕСТИТЬ ВТДанные
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(
	|			Регистратор = &Ссылка
	|				И ВидРасчета = &Тариф) КАК Данные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.НомерСтроки КАК НомерСтроки,
	|	МАКСИМУМ(Ставки.Период) КАК Период
	|ПОМЕСТИТЬ ВТПериодыСтавок
	|ИЗ
	|	ВТДанные КАК Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСотрудниках КАК Ставки
	|		ПО Данные.Сотрудник = Ставки.Сотрудник
	|			И Данные.Подразделение = Ставки.Подразделение
	|			И (Ставки.Период <= Данные.ПериодРегистрации)
	|
	|СГРУППИРОВАТЬ ПО
	|	Данные.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Данные.НомерСтроки КАК НомерСтроки,
	|	Данные.Часы КАК Часы,
	|	Данные.Дни КАК Дни,
	|	ЕСТЬNULL(Ставки.Оклад, 0) КАК Ставка
	|ИЗ
	|	ВТДанные КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПериодыСтавок КАК Периоды
	|		ПО Данные.НомерСтроки = Периоды.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСотрудниках КАК Ставки
	|		ПО Данные.Сотрудник = Ставки.Сотрудник
	|			И Данные.Подразделение = Ставки.Подразделение
	|			И (Периоды.Период = Ставки.Период)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Набор = Движения.ОсновныеНачисления;
	Пока Выборка.Следующий() Цикл
		Запись = Набор[Выборка.НомерСтроки - 1];
		Запись.Часы = Выборка.Часы;
		Запись.Дни = Выборка.Дни;
		Запись.Результат = Окр(Выборка.Ставка * Выборка.Часы, 2);
	КонецЦикла;
	Набор.Записать();

КонецПроцедуры

// Премия руководителю: процент по шкале стажа от начислений по тарифу сотрудников подразделения
// за предыдущий месяц (без начислений самого руководителя). При командировке премия вытесняется
// пропорционально времени командировки.
//
Процедура РассчитатьПремию()

	ИзмеренияПодразделения = Новый Массив;
	ИзмеренияПодразделения.Добавить("Подразделение");
	ИзмеренияСотрудника = Новый Массив;
	ИзмеренияСотрудника.Добавить("Сотрудник");
	ИзмеренияСотрудника.Добавить("Подразделение");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.ПремияРуководителю);
	Запрос.УстановитьПараметр("ИзмеренияПодразделения", ИзмеренияПодразделения);
	Запрос.УстановитьПараметр("ИзмеренияСотрудника", ИзмеренияСотрудника);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.НомерСтроки КАК НомерСтроки,
	|	Данные.ПериодРегистрации КАК ПериодРегистрации,
	|	Данные.Сотрудник.ДатаНачалаСтажа КАК ДатаНачалаСтажа,
	|	ЕСТЬNULL(Данные.ЗначениеПериодДействия, 0) КАК ЧасыПлан,
	|	ЕСТЬNULL(Данные.ЗначениеФактическийПериодДействия, 0) КАК ЧасыФакт,
	|	ЕСТЬNULL(БазаПодразделения.РезультатБаза, 0) КАК БазаПодразделения,
	|	ЕСТЬNULL(БазаСотрудника.РезультатБаза, 0) КАК БазаСотрудника
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(
	|			Регистратор = &Ссылка
	|				И ВидРасчета = &Премия) КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(
	|				&ИзмеренияПодразделения,
	|				&ИзмеренияПодразделения,
	|				,
	|				Регистратор = &Ссылка
	|					И ВидРасчета = &Премия) КАК БазаПодразделения
	|		ПО Данные.НомерСтроки = БазаПодразделения.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(
	|				&ИзмеренияСотрудника,
	|				&ИзмеренияСотрудника,
	|				,
	|				Регистратор = &Ссылка
	|					И ВидРасчета = &Премия) КАК БазаСотрудника
	|		ПО Данные.НомерСтроки = БазаСотрудника.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Шкала.СтажОтЛет КАК СтажОтЛет,
	|	Шкала.ПроцентПремии КАК ПроцентПремии
	|ИЗ
	|	РегистрСведений.ШкалаПремий КАК Шкала
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтажОтЛет УБЫВ";
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[0].Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Шкала = Результаты[1].Выгрузить();

	Набор = Движения.ОсновныеНачисления;
	Пока Выборка.Следующий() Цикл
		Стаж = УчетСервер.ПолныхЛет(Выборка.ДатаНачалаСтажа, Выборка.ПериодРегистрации);
		Процент = 0;
		Для Каждого СтрокаШкалы Из Шкала Цикл
			Если Стаж >= СтрокаШкалы.СтажОтЛет Тогда
				Процент = СтрокаШкалы.ПроцентПремии;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Доля = ?(Выборка.ЧасыПлан = 0, 0, Выборка.ЧасыФакт / Выборка.ЧасыПлан);
		Запись = Набор[Выборка.НомерСтроки - 1];
		Запись.СтажЛет = Стаж;
		Запись.ПроцентПремии = Процент;
		Запись.Часы = Выборка.ЧасыФакт;
		Запись.Результат = Окр((Выборка.БазаПодразделения - Выборка.БазаСотрудника) * Процент / 100 * Доля, 2);
	КонецЦикла;
	Набор.Записать();

КонецПроцедуры

// Командировка: дневная ставка (начисления за три предыдущих месяца / отработанные в них дни)
// * дни командировки по графику подразделения, из которого сотрудник направлен.
//
Процедура РассчитатьКомандировки()

	Измерения = Новый Массив;
	Измерения.Добавить("Сотрудник");
	Измерения.Добавить("Подразделение");

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Запрос.УстановитьПараметр("Измерения", Измерения);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Данные.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(Данные.ДниФактическийПериодДействия, 0) КАК Дни,
	|	ЕСТЬNULL(Данные.ЗначениеФактическийПериодДействия, 0) КАК Часы,
	|	ЕСТЬNULL(База.РезультатБаза, 0) КАК БазаСумма,
	|	ЕСТЬNULL(База.ДниБаза, 0) КАК БазаДни
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(
	|			Регистратор = &Ссылка
	|				И ВидРасчета = &Командировка) КАК Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(
	|				&Измерения,
	|				&Измерения,
	|				,
	|				Регистратор = &Ссылка
	|					И ВидРасчета = &Командировка) КАК База
	|		ПО Данные.НомерСтроки = База.НомерСтроки";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Набор = Движения.ОсновныеНачисления;
	Пока Выборка.Следующий() Цикл
		Запись = Набор[Выборка.НомерСтроки - 1];
		Запись.Дни = Выборка.Дни;
		Запись.Часы = Выборка.Часы;
		Если Выборка.БазаДни > 0 Тогда
			Запись.Результат = Окр(Выборка.БазаСумма / Выборка.БазаДни * Выборка.Дни, 2);
		КонецЕсли;
	КонецЦикла;
	Набор.Записать();

КонецПроцедуры

// Командировка может быть введена задним числом: начисления по тарифу и премии других документов,
// фактический период действия которых изменился из-за вытеснения, пересчитываются перепроведением.
//
Процедура ПерепровестиВытесненныеНачисления()

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Запрос.УстановитьПараметр("Тариф", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.ПремияРуководителю);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Строки.Сотрудник КАК Сотрудник,
	|	Строки.Подразделение КАК Подразделение
	|ПОМЕСТИТЬ ВТКомандировки
	|ИЗ
	|	Документ.НачислениеЗарплаты.ОсновныеНачисления КАК Строки
	|ГДЕ
	|	Строки.Ссылка = &Ссылка
	|	И Строки.ВидРасчета = &Командировка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Данные.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(
	|			Регистратор <> &Ссылка
	|				И ВидРасчета В (&Тариф, &Премия)
	|				И (Сотрудник, Подразделение) В
	|					(ВЫБРАТЬ
	|						Т.Сотрудник,
	|						Т.Подразделение
	|					ИЗ
	|						ВТКомандировки КАК Т)) КАК Данные
	|ГДЕ
	|	Данные.Часы <> ЕСТЬNULL(Данные.ЗначениеФактическийПериодДействия, 0)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументОбъект = Выборка.Регистратор.ПолучитьОбъект();
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
