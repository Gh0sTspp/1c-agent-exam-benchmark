#Область ПрограммныйИнтерфейс

// Заполняет график работы подразделений: 8 часов в рабочий день, 0 - в выходной.
//
// Параметры:
//  ДатаНачала, ДатаОкончания - Дата - период заполнения.
//  ВыходныеДни - Строка - номера дней недели, являющихся выходными (например, "67").
//  Подразделение - СправочникСсылка.Подразделения, Неопределено - если не указано, заполняются все подразделения.
//
Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение = Неопределено) Экспорт

	Подразделения = Новый Массив;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Подразделения.Добавить(Подразделение);
	Иначе
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Подразделения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Подразделения КАК Подразделения
		|ГДЕ
		|	НЕ Подразделения.ЭтоГруппа");
		Подразделения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;

	Для Каждого ТекущееПодразделение Из Подразделения Цикл
		ТекущаяДата = НачалоДня(ДатаНачала);
		Пока ТекущаяДата <= ДатаОкончания Цикл
			НаборЗаписей = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Подразделение.Установить(ТекущееПодразделение);
			НаборЗаписей.Отбор.Дата.Установить(ТекущаяДата);
			Запись = НаборЗаписей.Добавить();
			Запись.Подразделение = ТекущееПодразделение;
			Запись.Дата = ТекущаяДата;
			Запись.Значение = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(ТекущаяДата))) > 0, 0, 8);
			НаборЗаписей.Записать();
			ТекущаяДата = ТекущаяДата + 86400;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#КонецЕсли
