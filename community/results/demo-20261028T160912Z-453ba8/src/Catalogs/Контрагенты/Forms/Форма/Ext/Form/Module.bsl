#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    СформироватьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
    СформироватьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
    СохранитьИПерестроитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьИПерестроитьПоля()
    ПеренестиСведенияВТаблицуФормы();
    СформироватьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПеренестиСведенияВТаблицуФормы()
    Для Каждого Поле Из ДополнительныеПоля Цикл
        СтрокаСведений = Неопределено;
        Для Каждого Стр Из Объект.Сведения Цикл Если Стр.ВидСведений = Поле.ВидСведений Тогда СтрокаСведений = Стр; Прервать; КонецЕсли; КонецЦикла;
        Если СтрокаСведений = Неопределено Тогда СтрокаСведений = Объект.Сведения.Добавить(); СтрокаСведений.ВидСведений = Поле.ВидСведений; КонецЕсли;
        СтрокаСведений.Значение = ЭтотОбъект[Поле.Имя];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СформироватьДополнительныеПоля()
    УдаляемыеРеквизиты = Новый Массив;
    Для Каждого Поле Из ДополнительныеПоля Цикл
        Элемент = Элементы.Найти(Поле.Имя);
        Если Элемент <> Неопределено Тогда Элементы.Удалить(Элемент); КонецЕсли;
        УдаляемыеРеквизиты.Добавить(Поле.Имя);
    КонецЦикла;
    ДополнительныеПоля.Очистить();
    Если УдаляемыеРеквизиты.Количество() > 0 Тогда ИзменитьРеквизиты(Новый Массив, УдаляемыеРеквизиты); КонецЕсли;
    Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Список.ВидСведений ПОМЕСТИТЬ Виды
    |ИЗ Справочник.Сотрудники.ДополнительныеСведения КАК Список ГДЕ Список.Ссылка = &Менеджер;
    |ВЫБРАТЬ ВидСведений, ВидСведений.Наименование КАК Наименование, ВидСведений.ТипЗначения КАК ТипЗначения ИЗ Виды");
    Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
    Список = Запрос.Выполнить().Выгрузить();
    Реквизиты = Новый Массив;
    Для Каждого Вид Из Список Цикл
        Если Не ЗначениеЗаполнено(Вид.ВидСведений) Тогда Продолжить; КонецЕсли;
        Поле = ДополнительныеПоля.Добавить();
        Поле.Имя = "Доп_" + СтрЗаменить(Строка(Вид.ВидСведений.УникальныйИдентификатор()), "-", ""); Поле.ВидСведений = Вид.ВидСведений;
        Реквизиты.Добавить(Новый РеквизитФормы(Поле.Имя, Вид.ТипЗначения, , Вид.Наименование));
    КонецЦикла;
    Если Реквизиты.Количество() = 0 Тогда Возврат; КонецЕсли;
    ИзменитьРеквизиты(Реквизиты);
    Для Каждого Поле Из ДополнительныеПоля Цикл
        Вид = Список.Найти(Поле.ВидСведений, "ВидСведений");
        Элемент = Элементы.Добавить(Поле.Имя, Тип("ПолеФормы"), Элементы.ГруппаДополнительныхПолей);
        Элемент.Вид = ВидПоляФормы.ПолеВвода; Элемент.ПутьКДанным = Поле.Имя; Элемент.Заголовок = Вид.Наименование;
        Для Каждого Стр Из Объект.Сведения Цикл Если Стр.ВидСведений = Поле.ВидСведений Тогда ЭтотОбъект[Поле.Имя] = Стр.Значение; Прервать; КонецЕсли; КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    // Сохраняем и скрытые значения прежнего менеджера: смена менеджера не теряет введенную информацию.
    Для Каждого Поле Из ДополнительныеПоля Цикл
        СтрокаСведений = ТекущийОбъект.Сведения.Найти(Поле.ВидСведений, "ВидСведений");
        Если СтрокаСведений = Неопределено Тогда СтрокаСведений = ТекущийОбъект.Сведения.Добавить(); СтрокаСведений.ВидСведений = Поле.ВидСведений; КонецЕсли;
        СтрокаСведений.Значение = ЭтотОбъект[Поле.Имя];
    КонецЦикла;
КонецПроцедуры
