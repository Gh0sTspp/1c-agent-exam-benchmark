Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    РасчетыСервер.Провести(ЭтотОбъект, Отказ);
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
    Исходные = ОсновныеНачисления.Выгрузить();
    УчетСервер.ЗаблокироватьОстатки(Исходные, "РегистрРасчета.Начисления", "Подразделение");
    Движения.Начисления.Очистить();
    Движения.Начисления.Записать();
    РасчетыСервер.РассчитатьПодразделения(Исходные.ВыгрузитьКолонку("Подразделение"));
КонецПроцедуры
