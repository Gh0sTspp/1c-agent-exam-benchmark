Функция ЗапросТаблица(Текст, Параметры = Неопределено) Экспорт
    Запрос = Новый Запрос(Текст);
    Если Параметры <> Неопределено Тогда
        Для Каждого П Из Параметры Цикл
            Запрос.УстановитьПараметр(П.Ключ, П.Значение);
        КонецЦикла;
    КонецЕсли;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ОшибкаСтроки(Текст, Отказ) Экспорт
    Отказ = Истина;
    Сообщение = Новый СообщениеПользователю;
    Сообщение.Текст = Текст;
    Сообщение.Сообщить();
КонецПроцедуры

Процедура ЗаблокироватьОстатки(Таблица, Регистр, Поля) Экспорт
    Если Таблица.Количество() = 0 Тогда Возврат; КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(Регистр);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = Таблица;
    Для Каждого Поле Из СтрРазделить(Поля, ",") Цикл
        Элемент.ИспользоватьИзИсточникаДанных(Поле, Поле);
    КонецЦикла;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция СуммаСтроки(Строка)
    Если Строка.Сумма <> 0 Тогда Возврат Строка.Сумма; КонецЕсли;
    Возврат Окр(Строка.Количество * Строка.Цена, 2);
КонецФункции

Процедура Приход(Документ, Отказ) Экспорт
    Если Документ.СписокНоменклатуры.Количество() = 0 Тогда ОшибкаСтроки("Заполните товары приходной накладной", Отказ); Возврат; КонецЕсли;
    ОУ = Документ.Движения.ОстаткиНоменклатуры;
    БУ = Документ.Движения.УправленческийУчет;
    ОУ.Записывать = Истина; БУ.Записывать = Истина; ОУ.Очистить(); БУ.Очистить();
    Для Каждого Стр Из Документ.СписокНоменклатуры Цикл
        Если Стр.Количество <= 0 Или Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда
            ОшибкаСтроки("Приход, строка " + Стр.НомерСтроки + ": укажите товар и положительное количество", Отказ);
            Продолжить;
        КонецЕсли;
        Сумма = СуммаСтроки(Стр);
        Если Сумма < 0 Тогда ОшибкаСтроки("Сумма прихода не может быть отрицательной", Отказ); Продолжить; КонецЕсли;
        Подразделение = ?(ЗначениеЗаполнено(Стр.Подразделение), Стр.Подразделение, Документ.Подразделение);
        Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Документ.Склад) Тогда ОшибкаСтроки("Укажите подразделение или склад прихода", Отказ); Продолжить; КонецЕсли;
        Если ЗначениеЗаполнено(Подразделение) Тогда
            Дв = ОУ.Добавить(); Дв.Период = Документ.Дата;
            Дв.ВидДвижения = ВидДвиженияНакопления.Приход;
            Дв.Номенклатура = Стр.Номенклатура; Дв.Свойство = Стр.Свойство;
            Дв.Подразделение = Подразделение; Дв.Партия = Документ.Ссылка;
            Дв.Количество = Стр.Количество; Дв.Стоимость = Сумма;
        КонецЕсли;
        Если ЗначениеЗаполнено(Документ.Склад) Тогда
            Дв = БУ.Добавить(); Дв.Период = Документ.Дата;
            Дв.СчетДт = ПланыСчетов.Управленческий.Товары;
            Дв.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Дв.НоменклатураДт = Стр.Номенклатура; Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад;
            Дв.КоличествоДт = Стр.Количество; Дв.Сумма = Сумма;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ПодготовитьОУ(Документ, Потребности)
    ЗаблокироватьОстатки(Потребности, "РегистрНакопления.ОстаткиНоменклатуры", "Подразделение,Номенклатура,Свойство");
    // Старая версия движений исключается до чтения: повторное проведение идемпотентно.
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    П = Новый Структура("Момент,Подразделения,Товары", Документ.МоментВремени(), Потребности.ВыгрузитьКолонку("Подразделение"), Потребности.ВыгрузитьКолонку("Номенклатура"));
    Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия, КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |УПОРЯДОЧИТЬ ПО Партия.Дата, Партия", П);
КонецФункции

Функция СписатьОУ(Документ, Остатки, Подразделение, Товар, Свойство, Количество, Метод, Отказ)
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
    Партии = Остатки.НайтиСтроки(Отбор);
    Всего = 0; Стоимость = 0;
    Для Каждого Партия Из Партии Цикл Всего = Всего + Партия.Количество; Стоимость = Стоимость + Партия.Стоимость; КонецЦикла;
    Если Всего < Количество Тогда
        ОшибкаСтроки("Недостаточно " + Товар + ", свойство " + Свойство + ", подразделение " + Подразделение + ". Не хватает " + (Количество - Всего), Отказ);
        Возврат 0;
    КонецЕсли;
    СуммаСписания = 0; Осталось = Количество;
    Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
        // Средняя стоимость снимается пропорционально со всех партий; последняя забирает округление.
        ЦелеваяСумма = ?(Количество = Всего, Стоимость, Окр(Стоимость * Количество / Всего, 2));
        НакопленноеКоличество = 0; НакопленнаяСтоимость = 0;
        Для Индекс = 0 По Партии.Количество() - 1 Цикл
            Партия = Партии[Индекс];
            НакопленноеКоличество = НакопленноеКоличество + Партия.Количество;
            НакопленнаяСтоимость = НакопленнаяСтоимость + Партия.Стоимость;
            // Разность округленных накопленных долей сохраняет итог и не дает отрицательной последней доли.
            РаспределенноеКоличество = ?(Индекс = Партии.Количество() - 1, Количество, Окр(НакопленноеКоличество * Количество / Всего, 3));
            РаспределеннаяСтоимость = ?(Индекс = Партии.Количество() - 1, ЦелеваяСумма, Окр(НакопленнаяСтоимость * Количество / Всего, 2));
            К = РаспределенноеКоличество - (Количество - Осталось);
            С = РаспределеннаяСтоимость - СуммаСписания;
            ДобавитьРасходОУ(Документ, Партия, К, С);
            Осталось = Осталось - К; СуммаСписания = СуммаСписания + С;
        КонецЦикла;
    Иначе
        Для Счетчик = 0 По Партии.Количество() - 1 Цикл
            Индекс = ?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, Партии.Количество() - 1 - Счетчик, Счетчик);
            Партия = Партии[Индекс]; К = Мин(Осталось, Партия.Количество);
            Если К <= 0 Тогда Продолжить; КонецЕсли;
            С = ?(К = Партия.Количество, Партия.Стоимость, Окр(Партия.Стоимость * К / Партия.Количество, 2));
            ДобавитьРасходОУ(Документ, Партия, К, С);
            Осталось = Осталось - К; СуммаСписания = СуммаСписания + С;
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Возврат СуммаСписания;
КонецФункции

Процедура ДобавитьРасходОУ(Документ, Партия, К, С)
    Если К = 0 И С = 0 Тогда Возврат; КонецЕсли;
    Дв = Документ.Движения.ОстаткиНоменклатуры.Добавить();
    Дв.Период = Документ.Дата; Дв.ВидДвижения = ВидДвиженияНакопления.Расход;
    ЗаполнитьЗначенияСвойств(Дв, Партия, "Подразделение,Номенклатура,Свойство,Партия");
    Дв.Количество = К; Дв.Стоимость = С;
    Партия.Количество = Партия.Количество - К; Партия.Стоимость = Партия.Стоимость - С;
КонецПроцедуры

Функция ТаблицаПотребностей()
    Т = Новый ТаблицаЗначений;
    Т.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Т.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Т.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
    Т.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    Возврат Т;
КонецФункции

Процедура Сборка(Документ, Отказ) Экспорт
    Если Документ.СистемныеБлоки.Количество() = 0 Тогда ОшибкаСтроки("Укажите выпускаемые системные блоки", Отказ); Возврат; КонецЕсли;
    Если Не ЗначениеЗаполнено(Документ.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Документ.ПодразделениеПолучатель) Тогда
        ОшибкаСтроки("Укажите оба подразделения сборки", Отказ); Возврат;
    КонецЕсли;
    Спецификации = ЗапросТаблица("ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период ПОМЕСТИТЬ ПоследниеСпецификации
    |ИЗ РегистрСведений.Спецификации ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки) СГРУППИРОВАТЬ ПО СистемныйБлок
    |ИНДЕКСИРОВАТЬ ПО СистемныйБлок;
    |ВЫБРАТЬ Состав.СистемныйБлок, Состав.Номенклатура, Состав.Свойство, Состав.Количество
    |ИЗ РегистрСведений.Спецификации КАК Состав ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследниеСпецификации КАК Последние
    |ПО Состав.СистемныйБлок = Последние.СистемныйБлок И Состав.Период = Последние.Период",
        Новый Структура("Дата,Блоки", Документ.Дата, Документ.СистемныеБлоки.ВыгрузитьКолонку("Номенклатура")));
    Потребности = ТаблицаПотребностей();
    // Себестоимость каждой спецификации рассчитывается отдельно; добавки распределяются по числу блоков.
    Расшифровка = Новый ТаблицаЗначений;
    Расшифровка.Колонки.Добавить("Блок"); Расшифровка.Колонки.Добавить("Деталь"); Расшифровка.Колонки.Добавить("Свойство"); Расшифровка.Колонки.Добавить("Количество"); Расшифровка.Колонки.Добавить("Стоимость");
    Блоки = Документ.СистемныеБлоки.Выгрузить(); Блоки.Свернуть("Номенклатура", "Количество");
    Для Каждого Блок Из Блоки Цикл
        Если Блок.Количество <= 0 Тогда ОшибкаСтроки("Количество блоков должно быть положительным", Отказ); Возврат; КонецЕсли;
        Детали = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Блок.Номенклатура));
        Если Детали.Количество() = 0 Тогда ОшибкаСтроки("Нет действующей спецификации для " + Блок.Номенклатура, Отказ); Возврат; КонецЕсли;
        Для Каждого Деталь Из Детали Цикл
            Р = Расшифровка.Добавить(); Р.Блок = Блок.Номенклатура; Р.Деталь = Деталь.Номенклатура; Р.Свойство = Деталь.Свойство; Р.Количество = Деталь.Количество * Блок.Количество;
        КонецЦикла;
    КонецЦикла;
    Для Каждого Деталь Из Документ.ДополнительныеДетали Цикл
        Если Деталь.Количество <= 0 Тогда ОшибкаСтроки("Количество дополнительных деталей должно быть положительным", Отказ); Возврат; КонецЕсли;
        Р = Расшифровка.Добавить(); Р.Блок = Справочники.Номенклатура.ПустаяСсылка(); Р.Деталь = Деталь.Номенклатура; Р.Свойство = Деталь.Свойство; Р.Количество = Деталь.Количество;
    КонецЦикла;
    Для Каждого Р Из Расшифровка Цикл
        П = Потребности.Добавить(); П.Подразделение = Документ.ПодразделениеИсточник; П.Номенклатура = Р.Деталь; П.Свойство = Р.Свойство; П.Количество = Р.Количество;
    КонецЦикла;
    Потребности.Свернуть("Подразделение,Номенклатура,Свойство", "Количество");
    Остатки = ПодготовитьОУ(Документ, Потребности);
    Для Каждого Р Из Расшифровка Цикл
        Р.Стоимость = СписатьОУ(Документ, Остатки, Документ.ПодразделениеИсточник, Р.Деталь, Р.Свойство, Р.Количество, Перечисления.УчетнаяПолитика.ПоСредней, Отказ);
    КонецЦикла;
    Если Отказ Тогда Возврат; КонецЕсли;
    Добавки = 0;
    Для Каждого Р Из Расшифровка Цикл Если Не ЗначениеЗаполнено(Р.Блок) Тогда Добавки = Добавки + Р.Стоимость; КонецЕсли; КонецЦикла;
    ОстатокДобавок = Добавки; ОстатокКоличества = Блоки.Итог("Количество");
    Для Каждого Блок Из Блоки Цикл
        С = 0; Для Каждого Р Из Расшифровка.НайтиСтроки(Новый Структура("Блок", Блок.Номенклатура)) Цикл С = С + Р.Стоимость; КонецЦикла;
        Доля = ?(Блок.Количество = ОстатокКоличества, ОстатокДобавок, Окр(Добавки * Блок.Количество / Блоки.Итог("Количество"), 2));
        ОстатокДобавок = ОстатокДобавок - Доля; ОстатокКоличества = ОстатокКоличества - Блок.Количество;
        Дв = Документ.Движения.ОстаткиНоменклатуры.Добавить(); Дв.Период = Документ.Дата; Дв.ВидДвижения = ВидДвиженияНакопления.Приход;
        Дв.Подразделение = Документ.ПодразделениеПолучатель; Дв.Номенклатура = Блок.Номенклатура; Дв.Партия = Документ.Ссылка; Дв.Количество = Блок.Количество; Дв.Стоимость = С + Доля;
    КонецЦикла;
    Если Не Отказ Тогда ПроверитьОстаткиОУ(Документ, Потребности, Отказ); КонецЕсли;
КонецПроцедуры

Процедура Продажа(Документ, Отказ) Экспорт
    Если Документ.СписокНоменклатуры.Количество() = 0 Тогда ОшибкаСтроки("Заполните товары расходной накладной", Отказ); Возврат; КонецЕсли;
    Товары = Документ.СписокНоменклатуры.Выгрузить();
    Для Каждого Стр Из Товары Цикл
        Если Стр.Количество <= 0 Или Не ЗначениеЗаполнено(Стр.Номенклатура) Тогда ОшибкаСтроки("Продажа: укажите товар и положительное количество", Отказ); Возврат; КонецЕсли;
        Если Не ЗначениеЗаполнено(Стр.Подразделение) Тогда Стр.Подразделение = Документ.Подразделение; КонецЕсли;
        Если Не ЗначениеЗаполнено(Стр.Подразделение) И Не ЗначениеЗаполнено(Документ.Склад) Тогда ОшибкаСтроки("Укажите подразделение или склад продажи", Отказ); Возврат; КонецЕсли;
        Если Стр.Сумма < 0 Или Стр.Цена < 0 Тогда ОшибкаСтроки("Сумма и цена продажи не могут быть отрицательными", Отказ); Возврат; КонецЕсли;
        Если Стр.Сумма = 0 Тогда Стр.Сумма = Окр(Стр.Количество * Стр.Цена, 2); КонецЕсли;
    КонецЦикла;
    Потребности = ТаблицаПотребностей();
    Для Каждого Стр Из Товары Цикл
        Если ЗначениеЗаполнено(Стр.Подразделение) Тогда П = Потребности.Добавить(); ЗаполнитьЗначенияСвойств(П, Стр); КонецЕсли;
    КонецЦикла;
    Документ.Движения.ПродажиОУ.Записывать = Истина; Документ.Движения.ПродажиБУ.Записывать = Истина;
    Документ.Движения.ПродажиОУ.Очистить(); Документ.Движения.ПродажиБУ.Очистить();
    Документ.Движения.ОстаткиНоменклатуры.Записывать = Истина; Документ.Движения.ОстаткиНоменклатуры.Очистить();
    Документ.Движения.УправленческийУчет.Записывать = Истина; Документ.Движения.УправленческийУчет.Очистить();
    Если Потребности.Количество() > 0 Тогда
        Остатки = ПодготовитьОУ(Документ, Потребности);
        Политики = ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))", Новый Структура("Дата,Подразделения", Документ.Дата, Потребности.ВыгрузитьКолонку("Подразделение")));
        Для Каждого Стр Из Товары Цикл
            Если Не ЗначениеЗаполнено(Стр.Подразделение) Тогда Продолжить; КонецЕсли;
            Политика = Политики.Найти(Стр.Подразделение, "Подразделение");
            Если Политика = Неопределено Тогда ОшибкаСтроки("Не задана учетная политика: " + Стр.Подразделение, Отказ); Продолжить; КонецЕсли;
            С = СписатьОУ(Документ, Остатки, Стр.Подразделение, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Политика.Метод, Отказ);
            Дв = Документ.Движения.ПродажиОУ.Добавить(); Дв.Период = Документ.Дата; Дв.Номенклатура = Стр.Номенклатура; Дв.Количество = Стр.Количество; Дв.Себестоимость = С; Дв.Выручка = Стр.Сумма;
        КонецЦикла;
    КонецЕсли;
    Если Отказ Тогда Возврат; КонецЕсли;
    Если ЗначениеЗаполнено(Документ.Склад) Тогда ПродажаБУ(Документ, Товары, Отказ); КонецЕсли;
    Если Не Отказ Тогда ПроверитьОстаткиОУ(Документ, Потребности, Отказ); КонецЕсли;
КонецПроцедуры

Функция ГруппаАналогов(Товар, Связи)
    Результат = Новый Массив; Результат.Добавить(Товар); Индекс = 0;
    Пока Индекс < Результат.Количество() Цикл
        Текущий = Результат[Индекс];
        Для Каждого Связь Из Связи Цикл
            Если Связь.Товар = Текущий И Результат.Найти(Связь.Аналог) = Неопределено Тогда Результат.Добавить(Связь.Аналог); КонецЕсли;
            Если Связь.Аналог = Текущий И Результат.Найти(Связь.Товар) = Неопределено Тогда Результат.Добавить(Связь.Товар); КонецЕсли;
        КонецЦикла;
        Индекс = Индекс + 1;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ПродажаБУ(Документ, Товары, Отказ)
    Связи = ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
    ВсеТовары = Новый Массив; Группы = Новый Соответствие;
    Для Каждого Стр Из Товары Цикл
        Если Группы.Получить(Стр.Номенклатура) = Неопределено Тогда
            Группа = ГруппаАналогов(Стр.Номенклатура, Связи); Группы.Вставить(Стр.Номенклатура, Группа);
            Для Каждого Т Из Группа Цикл Если ВсеТовары.Найти(Т) = Неопределено Тогда ВсеТовары.Добавить(Т); КонецЕсли; КонецЦикла;
        КонецЕсли;
    КонецЦикла;
    Ключи = Новый ТаблицаЗначений; Ключи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Для Каждого Т Из ВсеТовары Цикл Ключи.Добавить().Номенклатура = Т; КонецЦикла;
    // Стоимость средняя по номенклатуре во всех складах: блокировка также охватывает все склады этих товаров.
    ЗаблокироватьОстатки(Ключи, "РегистрБухгалтерии.УправленческийУчет", "Номенклатура");
    Движения = Документ.Движения.УправленческийУчет; Движения.Записывать = Истина; Движения.Очистить(); Движения.Записать();
    П = Новый Структура("Момент,Счет,Товары", Документ.МоментВремени(), ПланыСчетов.Управленческий.Товары, ВсеТовары);
    ВидыСубконто = Новый Массив; ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады); П.Вставить("ВидыСубконто", ВидыСубконто);
    Остатки = ЗапросТаблица("ВЫБРАТЬ Номенклатура, Субконто1 КАК Склад, КоличествоОстаток КАК Количество ИЗ РегистрБухгалтерии.УправленческийУчет.Остатки(&Момент, Счет = &Счет, &ВидыСубконто, Номенклатура В (&Товары))", П);
    Итоги = ЗапросТаблица("ВЫБРАТЬ Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Стоимость ИЗ РегистрБухгалтерии.УправленческийУчет.Остатки(&Момент, Счет = &Счет, , Номенклатура В (&Товары))", П);
    Артикулы = ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Номенклатура, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Товары) УПОРЯДОЧИТЬ ПО Артикул, Ссылка", Новый Структура("Товары", ВсеТовары));
    Для Каждого Стр Из Товары Цикл
        Кандидаты = Новый Массив; Кандидаты.Добавить(Стр.Номенклатура);
        Группа = Группы.Получить(Стр.Номенклатура);
        Для Каждого Артикул Из Артикулы Цикл Если Артикул.Номенклатура <> Стр.Номенклатура И Группа.Найти(Артикул.Номенклатура) <> Неопределено Тогда Кандидаты.Добавить(Артикул.Номенклатура); КонецЕсли; КонецЦикла;
        Осталось = Стр.Количество; ВыручкаОсталась = Стр.Сумма;
        Для Каждого Кандидат Из Кандидаты Цикл
            Доступные = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Кандидат, Документ.Склад));
            Если Доступные.Количество() = 0 Тогда Продолжить; КонецЕсли;
            Остаток = Доступные[0]; К = Мин(Макс(0, Остаток.Количество), Осталось);
            Если К = 0 Тогда Продолжить; КонецЕсли;
            Итог = Итоги.Найти(Кандидат, "Номенклатура");
            Если Итог = Неопределено Или Итог.Количество <= 0 Тогда ОшибкаСтроки("Некорректные остатки бухгалтерского учета: " + Кандидат, Отказ); Возврат; КонецЕсли;
            С = ?(К = Итог.Количество, Итог.Стоимость, Окр(Итог.Стоимость * К / Итог.Количество, 2));
            В = ?(К = Осталось, ВыручкаОсталась, Окр(Стр.Сумма * К / Стр.Количество, 2));
            Остаток.Количество = Остаток.Количество - К; Итог.Количество = Итог.Количество - К; Итог.Стоимость = Итог.Стоимость - С;
            Осталось = Осталось - К; ВыручкаОсталась = ВыручкаОсталась - В;
            Дв = Движения.Добавить(); Дв.Период = Документ.Дата; Дв.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Дв.СчетКт = ПланыСчетов.Управленческий.Товары;
            Дв.НоменклатураКт = Кандидат; Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Документ.Склад; Дв.КоличествоКт = К; Дв.Сумма = С;
            Дв = Движения.Добавить(); Дв.Период = Документ.Дата; Дв.СчетДт = ПланыСчетов.Управленческий.Покупатели; Дв.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; Дв.Сумма = В;
            Продажа = Документ.Движения.ПродажиБУ.Добавить(); Продажа.Период = Документ.Дата; Продажа.Номенклатура = Стр.Номенклатура; Продажа.Продано = Кандидат; Продажа.Количество = К; Продажа.Себестоимость = С; Продажа.Выручка = В;
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
        КонецЦикла;
        Если Осталось > 0 Тогда ОшибкаСтроки("Недостаточно товара и его аналогов на складе " + Документ.Склад + ": " + Стр.Номенклатура + ", не хватает " + Осталось, Отказ); Возврат; КонецЕсли;
    КонецЦикла;
    ПроверитьОстаткиБУ(Документ, ВсеТовары, Отказ);
КонецПроцедуры

Функция ТабличныйОтчет(Таблица, Заголовок, Вид, ЗаголовокХарактеристики = "Производитель") Экспорт
    Док = Новый ТабличныйДокумент; Док.АвтоМасштаб = Истина;
    Док.Область(1, 1, 1, 8).Объединить(); Док.Область(1, 1).Текст = Заголовок;
    Док.Область(1, 1).Шрифт = Новый Шрифт(, 14, Истина);
    Если Вид = "Ведомость" Тогда
        Заголовки = СтрРазделить("Производитель;Товар;Нач. ост.;Приход;Расход;Кон. ост.", ";");
        Поля = СтрРазделить("Характеристика;Номенклатура;НачальныйОстаток;Приход;Расход;КонечныйОстаток", ";");
        Заголовки[0] = ЗаголовокХарактеристики;
        Количества = СтрРазделить("НачальноеКоличество;ПриходКоличество;РасходКоличество;КонечноеКоличество", ";");
    ИначеЕсли Вид = "ПродажиТоваров" Тогда
        Заголовки = СтрРазделить("Номенклатура;Продано;Кол-во;Себест-сть;Продажа;Прибыль", ";");
        Поля = СтрРазделить("Номенклатура;Продано;Количество;Себестоимость;Выручка;Прибыль", ";");
    ИначеЕсли Вид = "Премии" Тогда
        Заголовки = СтрРазделить("Сотрудник;Трудовой стаж;% премии;Сумма премии", ";");
        Поля = СтрРазделить("Сотрудник;Стаж;Процент;СуммаПремии", ";");
    Иначе
        Заголовки = СтрРазделить("Номенклатура;Кол-во;Себест-сть;Продажа;Прибыль", ";");
        Поля = СтрРазделить("Номенклатура;Количество;Себестоимость;Выручка;Прибыль", ";");
    КонецЕсли;
    Для Индекс = 0 По Заголовки.Количество() - 1 Цикл
        Область = Док.Область(3, Индекс + 1); Область.Текст = Заголовки[Индекс]; Область.Шрифт = Новый Шрифт(, , Истина);
        Док.Область(, Индекс + 1, , Индекс + 1).ШиринаКолонки = ?(Индекс < 2, 28, 18);
    КонецЦикла;
    Номер = 4; ПредыдущаяГруппа = Неопределено;
    Для Каждого Стр Из Таблица Цикл
        Если Вид = "ПродажиТоваров" И ПредыдущаяГруппа <> Стр.Номенклатура Тогда
            ПредыдущаяГруппа = Стр.Номенклатура;
            Док.Область(Номер, 1).Текст = Строка(Стр.Номенклатура);
            ИтогиГруппы = Новый Структура("Количество,Себестоимость,Выручка,Прибыль", 0, 0, 0, 0);
            Для Каждого Деталь Из Таблица.НайтиСтроки(Новый Структура("Номенклатура", Стр.Номенклатура)) Цикл
                Для Каждого Итог Из ИтогиГруппы Цикл ИтогиГруппы[Итог.Ключ] = ИтогиГруппы[Итог.Ключ] + Деталь[Итог.Ключ]; КонецЦикла;
            КонецЦикла;
            Для Индекс = 2 По Поля.Количество() - 1 Цикл Док.Область(Номер, Индекс + 1).Текст = Строка(ИтогиГруппы[Поля[Индекс]]); КонецЦикла;
            Док.Область(Номер, 1, Номер, Поля.Количество()).Шрифт = Новый Шрифт(, , Истина);
            Номер = Номер + 1;
        ИначеЕсли Вид = "Ведомость" И ПредыдущаяГруппа <> Стр.Характеристика Тогда
            ПредыдущаяГруппа = Стр.Характеристика;
            Док.Область(Номер, 1).Текст = Строка(Стр.Характеристика);
            Док.Область(Номер, 1, Номер, Поля.Количество()).Шрифт = Новый Шрифт(, , Истина);
            Номер = Номер + 1;
        КонецЕсли;
        Для Индекс = 0 По Поля.Количество() - 1 Цикл
            Если Вид = "Ведомость" И Индекс >= 2 Тогда
                Док.Область(Номер, Индекс + 1).Текст = Формат(Стр[Количества[Индекс - 2]], "ЧГ=0") + Символы.ПС + Формат(Стр[Поля[Индекс]], "ЧДЦ=2");
            Иначе
                Док.Область(Номер, Индекс + 1).Текст = Строка(Стр[Поля[Индекс]]);
            КонецЕсли;
        КонецЦикла;
        Если Вид = "Ведомость" Или Вид = "ПродажиТоваров" Тогда Док.Область(Номер, 1).Текст = ""; КонецЕсли;
        Если Вид = "Ведомость" Тогда Док.Область(Номер, 1, Номер, Поля.Количество()).ВысотаСтроки = 30; КонецЕсли;
        Номер = Номер + 1;
    КонецЦикла;
    Док.Область(Номер, 1).Текст = "ИТОГО:";
    Для Индекс = 1 По Поля.Количество() - 1 Цикл
        Если Таблица.Колонки[Поля[Индекс]].ТипЗначения.СодержитТип(Тип("Число")) Тогда
            Если Вид <> "Премии" Или Поля[Индекс] = "СуммаПремии" Тогда Док.Область(Номер, Индекс + 1).Текст = Формат(Таблица.Итог(Поля[Индекс]), "ЧДЦ=2"); КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Если Вид = "Ведомость" Тогда
        Для Индекс = 2 По Поля.Количество() - 1 Цикл
            Док.Область(Номер, Индекс + 1).Текст = Формат(Таблица.Итог(Количества[Индекс - 2]), "ЧГ=0") + Символы.ПС + Формат(Таблица.Итог(Поля[Индекс]), "ЧДЦ=2");
        КонецЦикла;
        Док.Область(Номер, 1, Номер, Поля.Количество()).ВысотаСтроки = 30;
    КонецЕсли;
    Док.Область(3, 1, Номер, Поля.Количество()).Обвести(Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1));
    Возврат Док;
КонецФункции

Процедура ПроверитьОстаткиОУ(Документ, Потребности, Отказ)
    Если Потребности.Количество() = 0 Тогда Возврат; КонецЕсли;
    Документ.Движения.ОстаткиНоменклатуры.БлокироватьДляИзменения = Истина;
    Документ.Движения.ОстаткиНоменклатуры.Записать();
    П = Новый Структура("Граница,Подразделения,Товары", Новый Граница(Документ.МоментВремени(), ВидГраницы.Включая), Потребности.ВыгрузитьКолонку("Подразделение"), Потребности.ВыгрузитьКолонку("Номенклатура"));
    Ошибки = ЗапросТаблица("ВЫБРАТЬ Номенклатура, Подразделение, Свойство, КоличествоОстаток, СтоимостьОстаток
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Граница, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |ГДЕ КоличествоОстаток < 0 ИЛИ СтоимостьОстаток < 0", П);
    Для Каждого Стр Из Ошибки Цикл ОшибкаСтроки("Отрицательный остаток после записи: " + Стр.Номенклатура + ", " + Стр.Подразделение, Отказ); КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОстаткиБУ(Документ, Товары, Отказ)
    Документ.Движения.УправленческийУчет.БлокироватьДляИзменения = Истина;
    Документ.Движения.УправленческийУчет.Записать();
    Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    П = Новый Структура("Граница,Товары,Склад,Счет,Виды", Новый Граница(Документ.МоментВремени(), ВидГраницы.Включая), Товары, Документ.Склад, ПланыСчетов.Управленческий.Товары, Виды);
    Ошибки = ЗапросТаблица("ВЫБРАТЬ Номенклатура, КоличествоОстаток
    |ИЗ РегистрБухгалтерии.УправленческийУчет.Остатки(&Граница, Счет = &Счет, &Виды, Номенклатура В (&Товары) И Субконто1 = &Склад)
    |ГДЕ КоличествоОстаток < 0", П);
    Для Каждого Стр Из Ошибки Цикл ОшибкаСтроки("Отрицательный остаток после записи БУ: " + Стр.Номенклатура, Отказ); КонецЦикла;
КонецПроцедуры
