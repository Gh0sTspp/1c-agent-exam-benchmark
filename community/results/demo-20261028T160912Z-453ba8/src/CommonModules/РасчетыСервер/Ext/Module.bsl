Процедура НастроитьВидыРасчета()
    // Связи предопределенных расчетов восстанавливаются и в базе, полученной из каркасного DT.
    ПВР = ПланыВидовРасчета.ОсновныеНачисления;
    Тариф = ПВР.Тариф.ПолучитьОбъект(); Премия = ПВР.Премия.ПолучитьОбъект(); Командировка = ПВР.Командировка.ПолучитьОбъект();
    Если Тариф.ВытесняющиеВидыРасчета.Найти(ПВР.Командировка, "ВидРасчета") = Неопределено Тогда
        Тариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПВР.Командировка; Тариф.Записать();
    КонецЕсли;
    Изменен = Ложь;
    Если Премия.ВытесняющиеВидыРасчета.Найти(ПВР.Командировка, "ВидРасчета") = Неопределено Тогда Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = ПВР.Командировка; Изменен = Истина; КонецЕсли;
    Если Премия.БазовыеВидыРасчета.Найти(ПВР.Тариф, "ВидРасчета") = Неопределено Тогда Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = ПВР.Тариф; Изменен = Истина; КонецЕсли;
    Если Изменен Тогда Премия.Записать(); КонецЕсли;
    Изменен = Ложь;
    Для Каждого Имя Из СтрРазделить("Тариф,Премия,Командировка", ",") Цикл
        Если Командировка.БазовыеВидыРасчета.Найти(ПВР[Имя], "ВидРасчета") = Неопределено Тогда Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = ПВР[Имя]; Изменен = Истина; КонецЕсли;
    КонецЦикла;
    Если Изменен Тогда Командировка.Записать(); КонецЕсли;
КонецПроцедуры

Процедура Провести(Документ, Отказ) Экспорт
    НастроитьВидыРасчета();
    Исходные = Документ.ОсновныеНачисления.Выгрузить();
    // Повторяющаяся строка ввода начисления не создает повторную оплату тех же дней.
    Исходные.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    УчетСервер.ЗаблокироватьОстатки(Исходные, "РегистрРасчета.Начисления", "Подразделение");
    Набор = Документ.Движения.Начисления; Набор.Записывать = Истина; Набор.Очистить(); Набор.Записать();
    Для Каждого Стр Из Исходные Цикл
        Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Или Стр.ДатаОкончания < Стр.ДатаНачала Или Не ЗначениеЗаполнено(Стр.ДатаНачала) Тогда
            УчетСервер.ОшибкаСтроки("Начисление: проверьте сотрудника, подразделение и даты", Отказ); Возврат;
        КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия И Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
            УчетСервер.ОшибкаСтроки("Допустимы тариф, премия или командировка", Отказ); Возврат;
        КонецЕсли;
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
            УчетСервер.ОшибкаСтроки("Тариф и премия вводятся в пределах календарного месяца", Отказ); Возврат;
        КонецЕсли;
        Начало = НачалоДня(Стр.ДатаНачала);
        Пока Начало <= Стр.ДатаОкончания Цикл
            Дв = Набор.Добавить(); Дв.Сотрудник = Стр.Сотрудник; Дв.Подразделение = Стр.Подразделение; Дв.ВидРасчета = Стр.ВидРасчета;
            Дв.ПериодДействияНачало = Начало; Дв.ПериодДействияКонец = Мин(КонецМесяца(Начало), КонецДня(Стр.ДатаОкончания));
            Дв.ПериодРегистрации = ?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, Макс(НачалоМесяца(Документ.Дата), НачалоМесяца(Начало)), НачалоМесяца(Начало));
            Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), ?(Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, -3, -1));
            Дв.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            Начало = КонецМесяца(Начало) + 1;
        КонецЦикла;
    КонецЦикла;
    // Специализированное дополнение платформы сторнирует вытесненные записи прошлой регистрации.
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого Стр Из Дополнение Цикл
        Дв = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Дв, Стр);
        Дв.Сторно = Истина;
        Дв.ПериодРегистрации = Стр.ПериодРегистрацииСторно;
        Дв.ПериодДействияНачало = Стр.ПериодДействияНачалоСторно;
        Дв.ПериодДействияКонец = Стр.ПериодДействияКонецСторно;
    КонецЦикла;
    Набор.Записать();
    РассчитатьПодразделения(Исходные.ВыгрузитьКолонку("Подразделение"));
    // Запись других наборов выполняется общей процедурой; текущая коллекция должна содержать рассчитанную версию.
    Набор.Прочитать();
КонецПроцедуры

Процедура РассчитатьПодразделения(Подразделения) Экспорт
    Если Подразделения.Количество() = 0 Тогда Возврат; КонецЕсли;
    П = Новый Структура("Подразделения", Подразделения);
    Данные = УчетСервер.ЗапросТаблица("ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления ГДЕ Подразделение В (&Подразделения) УПОРЯДОЧИТЬ ПО ПериодДействияНачало, Регистратор, НомерСтроки", П);
    Если Данные.Количество() = 0 Тогда Возврат; КонецЕсли;
    Регистраторы = Данные.Скопировать(, "Регистратор"); Регистраторы.Свернуть("Регистратор");
    // Перезаписываем полный набор регистратора, сохраняя строки других подразделений того же документа.
    Данные = УчетСервер.ЗапросТаблица("ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления ГДЕ Регистратор В (&Регистраторы) УПОРЯДОЧИТЬ ПО ПериодДействияНачало, Регистратор, НомерСтроки", Новый Структура("Регистраторы", Регистраторы.ВыгрузитьКолонку("Регистратор")));
    П.Вставить("Подразделения", Данные.ВыгрузитьКолонку("Подразделение"));
    П.Вставить("Регистраторы", Регистраторы.ВыгрузитьКолонку("Регистратор"));
    Графики = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы, ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК Дни, ЕСТЬNULL(ДниПериодДействия, 0) КАК ДниПлан, ЕСТЬNULL(ДниПериодРегистрации, 0) КАК НормаМесяца
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))", П);
    Ставки = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Период, Сотрудник, Подразделение, Ставка ИЗ РегистрСведений.ТарифныеСтавки ГДЕ Подразделение В (&Подразделения) УПОРЯДОЧИТЬ ПО Период УБЫВ", П);
    Сотрудники = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Сотрудник, НачалоСтажа ИЗ Справочник.Сотрудники ГДЕ Ссылка В (&Сотрудники)", Новый Структура("Сотрудники", Данные.ВыгрузитьКолонку("Сотрудник")));
    Шкала = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж УБЫВ");
Для Каждого Стр Из Данные Цикл
        Г = Графики.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки));
        Стр.Часы = 0; Стр.Дни = 0; Стр.Результат = 0;
        Если Не Стр.Сторно И Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
            Стр.НормаДней = 0;
            Для Каждого График Из Г Цикл Стр.НормаДней = Стр.НормаДней + График.НормаМесяца; КонецЦикла;
        КонецЕсли;
        Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Стр.Ставка = 0;
            Для Каждого Ставка Из Ставки Цикл
                Если Ставка.Сотрудник = Стр.Сотрудник И Ставка.Подразделение = Стр.Подразделение И Ставка.Период <= НачалоМесяца(Стр.ПериодДействияНачало) Тогда Стр.Ставка = Ставка.Ставка; Прервать; КонецЕсли;
            КонецЦикла;
            Для Каждого График Из Г Цикл Стр.Часы = Стр.Часы + График.Часы; Стр.Дни = Стр.Дни + График.Дни; КонецЦикла;
            Стр.Результат = Окр(Стр.Ставка * Стр.Часы, 2) * ?(Стр.Сторно, -1, 1);
            Стр.Дни = Стр.Дни * ?(Стр.Сторно, -1, 1); Стр.Часы = Стр.Часы * ?(Стр.Сторно, -1, 1);
        КонецЕсли;
        Сотрудник = Сотрудники.Найти(Стр.Сотрудник, "Сотрудник"); Стр.Стаж = 0; Стр.Процент = 0;
        Если Сотрудник <> Неопределено И ЗначениеЗаполнено(Сотрудник.НачалоСтажа) Тогда
            ДатаСтажа = НачалоМесяца(Стр.ПериодДействияНачало);
            Стр.Стаж = Год(ДатаСтажа) - Год(Сотрудник.НачалоСтажа);
            Если ДобавитьМесяц(Сотрудник.НачалоСтажа, Стр.Стаж * 12) > ДатаСтажа Тогда Стр.Стаж = Стр.Стаж - 1; КонецЕсли;
            Стр.Стаж = Макс(Стр.Стаж, 0);
        КонецЕсли;
        Для Каждого Порог Из Шкала Цикл Если Порог.Стаж <= Стр.Стаж Тогда Стр.Процент = Порог.Процент; Прервать; КонецЕсли; КонецЦикла;
    КонецЦикла;
    ЗаписатьРасчеты(Данные, Регистраторы);
    П.Вставить("ОсновныеИзмерения", СтрРазделить("Подразделение", ",")); П.Вставить("БазовыеИзмерения", СтрРазделить("Подразделение", ","));
    П.Вставить("Разрезы", СтрРазделить("Сотрудник", ",")); П.Вставить("Вид", ПланыВидовРасчета.ОсновныеНачисления.Премия);
    БазаПремии = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, СотрудникРазрез, ЕСТЬNULL(РезультатБаза, 0) КАК База
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&ОсновныеИзмерения, &БазовыеИзмерения, &Разрезы, Регистратор В (&Регистраторы) И ВидРасчета = &Вид)", П);
    Для Каждого Стр Из Данные Цикл
        Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        База = 0;
        Для Каждого Б Из БазаПремии.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки)) Цикл
            Если Б.СотрудникРазрез <> Стр.Сотрудник Тогда База = База + Б.База; КонецЕсли;
        КонецЦикла;
        Г = Графики.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки));
        Факт = 0; План = 0; Для Каждого График Из Г Цикл Факт = Факт + График.Дни; План = План + График.ДниПлан; КонецЦикла;
        План = Стр.НормаДней;
        Стр.Результат = ?(План = 0, 0, Окр(База * Стр.Процент / 100 * Факт / План, 2)) * ?(Стр.Сторно, -1, 1);
    КонецЦикла;
    ЗаписатьРасчеты(Данные, Регистраторы);
    // Последовательные месяцы командировки зависят от уже рассчитанных предыдущих месяцев.
    Месяцы = Новый Массив;
    Для Каждого Стр Из Данные Цикл Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка И Месяцы.Найти(НачалоМесяца(Стр.ПериодДействияНачало)) = Неопределено Тогда Месяцы.Добавить(НачалоМесяца(Стр.ПериодДействияНачало)); КонецЕсли; КонецЦикла;
    П.Вставить("ОсновныеИзмерения", СтрРазделить("Сотрудник", ",")); П.Вставить("БазовыеИзмерения", СтрРазделить("Сотрудник", ",")); П.Вставить("Разрезы", Новый Массив); П.Вставить("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
    Для Каждого Месяц Из Месяцы Цикл
        П.Вставить("Месяц", Месяц);
        БазаКомандировки = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Регистратор, НомерСтроки, ЕСТЬNULL(РезультатБаза, 0) КАК База, ЕСТЬNULL(ДниБаза, 0) КАК Дни
        |ИЗ РегистрРасчета.Начисления.БазаНачисления(&ОсновныеИзмерения, &БазовыеИзмерения, &Разрезы, Регистратор В (&Регистраторы) И ВидРасчета = &Вид И ПериодДействия = &Месяц)", П);
        Для Каждого Стр Из Данные Цикл
            Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Или НачалоМесяца(Стр.ПериодДействияНачало) <> Месяц Тогда Продолжить; КонецЕсли;
            Б = БазаКомандировки.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки));
            База = 0; Дни = 0; Для Каждого БазаСтрока Из Б Цикл База = База + БазаСтрока.База; Дни = Дни + БазаСтрока.Дни; КонецЦикла;
            Факт = 0; Для Каждого График Из Графики.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки)) Цикл Факт = Факт + График.Дни; КонецЦикла;
            Стр.Результат = ?(Дни = 0, 0, Окр(База / Дни * Факт, 2));
        КонецЦикла;
        ЗаписатьРасчеты(Данные, Регистраторы);
    КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьРасчеты(Данные, Регистраторы)
    Для Каждого Регистратор Из Регистраторы Цикл
        Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Регистратор.Регистратор);
        Набор.Загрузить(Данные.Скопировать(Новый Структура("Регистратор", Регистратор.Регистратор)));
        Набор.Записать(, Ложь);
    КонецЦикла;
КонецПроцедуры
