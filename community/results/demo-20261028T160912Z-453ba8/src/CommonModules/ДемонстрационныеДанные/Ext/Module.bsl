Функция Элемент(ИмяСправочника, Наименование)
    Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Объект = Справочники[ИмяСправочника].СоздатьЭлемент(); Объект.Наименование = Наименование; Объект.Записать(); Возврат Объект.Ссылка;
КонецФункции

Функция ДокументДемо(Имя, Номер, ДатаДокумента)
    Ссылка = Документы[Имя].НайтиПоНомеру(Номер, ДатаДокумента);
    Если ЗначениеЗаполнено(Ссылка) Тогда Объект = Ссылка.ПолучитьОбъект(); Иначе Объект = Документы[Имя].СоздатьДокумент(); Объект.Номер = Номер; КонецЕсли;
    Объект.Дата = ДатаДокумента; Возврат Объект;
КонецФункции

Процедура СтрокаТовара(Документ, Товар, Количество, Сумма, Свойство = Неопределено, Подразделение = Неопределено)
    Стр = Документ.СписокНоменклатуры.Добавить(); Стр.Номенклатура = Товар; Стр.Количество = Количество; Стр.Сумма = Сумма; Стр.Цена = Сумма / Количество;
    Если Свойство <> Неопределено Тогда Стр.Свойство = Свойство; КонецЕсли;
    Если Подразделение <> Неопределено Тогда Стр.Подразделение = Подразделение; КонецЕсли;
КонецПроцедуры

Процедура Начисление(Документ, Сотрудник, Подразделение, Вид, Начало, Конец)
    Стр = Документ.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Сотрудник; Стр.Подразделение = Подразделение; Стр.ВидРасчета = Вид; Стр.ДатаНачала = Начало; Стр.ДатаОкончания = Конец;
КонецПроцедуры

Процедура Заполнить() Экспорт
    Цех = Элемент("Подразделения", "ДЕМО Основной цех"); Магазин = Элемент("Подразделения", "ДЕМО Магазин"); Склад = Элемент("Склады", "ДЕМО Основной склад");
    Деталь = Элемент("Номенклатура", "ДЕМО Видеокарта"); Блок = Элемент("Номенклатура", "ДЕМО Системный блок");
    Свойство = Элемент("СвойстваНоменклатуры", "ДЕМО ASUS"); О = Свойство.ПолучитьОбъект(); О.Номенклатура = Деталь; О.Записать();
    ПВХ = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Производитель", Истина);
    Если Не ЗначениеЗаполнено(ПВХ) Тогда О = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); О.Наименование = "Производитель"; О.ТипЗначения = Новый ОписаниеТипов("Строка"); О.Записать(); ПВХ = О.Ссылка; КонецЕсли;
    З = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи(); З.Свойство = Свойство; З.Характеристика = ПВХ; З.Значение = "ASUS"; З.Записать();
    Для Каждого Подразделение Из Новый Массив Цикл КонецЦикла;
    Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Политика.Период = Дата(2026, 1, 1); Политика.Подразделение = Цех; Политика.Метод = Перечисления.УчетнаяПолитика.ФИФО; Политика.Записать();
    Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Политика.Период = Дата(2026, 1, 1); Политика.Подразделение = Магазин; Политика.Метод = Перечисления.УчетнаяПолитика.ПоСредней; Политика.Записать();
    Спецификация = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи(); Спецификация.Период = Дата(2026, 1, 5); Спецификация.СистемныйБлок = Блок; Спецификация.Номенклатура = Деталь; Спецификация.Свойство = Свойство; Спецификация.Количество = 2; Спецификация.Записать();
    Приход = ДокументДемо("ПриходнаяНакладная", "ДЕМОПР01", Дата(2026, 1, 10, 9, 0, 0)); Приход.СписокНоменклатуры.Очистить(); Приход.Подразделение = Цех;
    СтрокаТовара(Приход, Деталь, 10, 1000, Свойство); Приход.Записать(РежимЗаписиДокумента.Проведение);
    Сборка = ДокументДемо("Сборка", "ДЕМОСБ01", Дата(2026, 1, 11, 9, 0, 0)); Сборка.ПодразделениеИсточник = Цех; Сборка.ПодразделениеПолучатель = Магазин; Сборка.СистемныеБлоки.Очистить(); Сборка.ДополнительныеДетали.Очистить();
    Стр = Сборка.СистемныеБлоки.Добавить(); Стр.Номенклатура = Блок; Стр.Количество = 2;
    Стр = Сборка.ДополнительныеДетали.Добавить(); Стр.Номенклатура = Деталь; Стр.Свойство = Свойство; Стр.Количество = 2; Сборка.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = ДокументДемо("РасходнаяНакладная", "ДЕМОРС01", Дата(2026, 1, 12, 9, 0, 0)); Продажа.СписокНоменклатуры.Очистить(); Продажа.Подразделение = Магазин;
    СтрокаТовара(Продажа, Блок, 1, 700); Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Товар = Элемент("Номенклатура", "ДЕМО Портсигар"); Аналог1 = Элемент("Номенклатура", "ДЕМО Портсигар импортный"); Аналог2 = Элемент("Номенклатура", "ДЕМО Портсигар отечественный");
    О = Товар.ПолучитьОбъект(); О.Артикул = "001"; О.Записать(); О = Аналог1.ПолучитьОбъект(); О.Артикул = "002"; О.Записать(); О = Аналог2.ПолучитьОбъект(); О.Артикул = "003"; О.Записать();
    З = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); З.Товар = Товар; З.Аналог = Аналог1; З.Записать(); З = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); З.Товар = Аналог1; З.Аналог = Аналог2; З.Записать();
    Приход = ДокументДемо("ПриходнаяНакладная", "ДЕМОПР02", Дата(2026, 1, 10, 10, 0, 0)); Приход.СписокНоменклатуры.Очистить(); Приход.Склад = Склад;
    СтрокаТовара(Приход, Товар, 1, 50); СтрокаТовара(Приход, Аналог1, 3, 210); СтрокаТовара(Приход, Аналог2, 2, 180); Приход.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = ДокументДемо("РасходнаяНакладная", "ДЕМОРС02", Дата(2026, 1, 12, 10, 0, 0)); Продажа.СписокНоменклатуры.Очистить(); Продажа.Склад = Склад;
    СтрокаТовара(Продажа, Товар, 2, 200); СтрокаТовара(Продажа, Товар, 3, 300); Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Операция = ДокументДемо("Операция", "ДЕМОБУ01", Дата(2026, 1, 9, 10, 0, 0)); Операция.Проводки.Очистить();
    Стр = Операция.Проводки.Добавить(); Стр.СчетДт = ПланыСчетов.Управленческий.Касса; Стр.СчетКт = ПланыСчетов.Управленческий.Поставщики; Стр.Сумма = 1000; Операция.Записать(РежимЗаписиДокумента.Проведение);
    Работник = Элемент("Сотрудники", "ДЕМО Петров"); Руководитель = Элемент("Сотрудники", "ДЕМО Иванов");
    О = Работник.ПолучитьОбъект(); О.НачалоСтажа = Дата(2025, 6, 1); О.Записать(); О = Руководитель.ПолучитьОбъект(); О.НачалоСтажа = Дата(2020, 1, 1); О.Записать();
    З = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); З.Период = Дата(2026, 1, 1); З.Сотрудник = Работник; З.Подразделение = Цех; З.Ставка = 100; З.Записать();
    З = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); З.Период = Дата(2026, 1, 1); З.Сотрудник = Руководитель; З.Подразделение = Цех; З.Ставка = 200; З.Записать();
    Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Шкала.Стаж = 0; Шкала.Процент = 5; Шкала.Записать(); Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Шкала.Стаж = 1; Шкала.Процент = 10; Шкала.Записать(); Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Шкала.Стаж = 3; Шкала.Процент = 15; Шкала.Записать();
    График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); График.Отбор.Подразделение.Установить(Цех);
    ДатаГрафика = Дата(2026, 1, 1);
    Пока ДатаГрафика <= Дата(2026, 4, 30) Цикл
        Стр = График.Добавить(); Стр.Дата = ДатаГрафика; Стр.Подразделение = Цех; Стр.Значение = ?(ДеньНедели(ДатаГрафика) <= 5, 8, 0); ДатаГрафика = ДатаГрафика + 86400;
    КонецЦикла; График.Записать();
    ПВР = ПланыВидовРасчета.ОсновныеНачисления;
    Для Месяц = 1 По 3 Цикл
        Начало = Дата(2026, Месяц, 1); Зарплата = ДокументДемо("НачислениеЗарплаты", "ДЕМОЗП0" + Месяц, КонецМесяца(Начало)); Зарплата.ОсновныеНачисления.Очистить();
        Начисление(Зарплата, Работник, Цех, ПВР.Тариф, Начало, КонецМесяца(Начало)); Начисление(Зарплата, Руководитель, Цех, ПВР.Тариф, Начало, КонецМесяца(Начало));
        Начисление(Зарплата, Руководитель, Цех, ПВР.Премия, Начало, КонецМесяца(Начало)); Зарплата.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;
    Зарплата = ДокументДемо("НачислениеЗарплаты", "ДЕМОЗП04", Дата(2026, 4, 30)); Зарплата.ОсновныеНачисления.Очистить();
    Начисление(Зарплата, Работник, Цех, ПВР.Тариф, Дата(2026, 4, 1), Дата(2026, 4, 30)); Начисление(Зарплата, Работник, Цех, ПВР.Командировка, Дата(2026, 4, 6), Дата(2026, 4, 8)); Зарплата.Записать(РежимЗаписиДокумента.Проведение);
    Контрагент = Элемент("Контрагенты", "ДЕМО Завод Сатурн"); О = Контрагент.ПолучитьОбъект(); О.Менеджер = Руководитель; О.Записать();
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Срок кредита, дни", Истина);
    Если Не ЗначениеЗаполнено(Вид) Тогда О = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); О.Наименование = "Срок кредита, дни"; О.ТипЗначения = Новый ОписаниеТипов("Число"); О.Записать(); Вид = О.Ссылка; КонецЕсли;
    О = Руководитель.ПолучитьОбъект(); Если О.ДополнительныеСведения.Найти(Вид, "ВидСведений") = Неопределено Тогда О.ДополнительныеСведения.Добавить().ВидСведений = Вид; О.Записать(); КонецЕсли;
    О = Контрагент.ПолучитьОбъект(); Стр = О.Сведения.Найти(Вид, "ВидСведений"); Если Стр = Неопределено Тогда Стр = О.Сведения.Добавить(); Стр.ВидСведений = Вид; КонецЕсли; Стр.Значение = 10; О.Записать();
    Для Каждого ИмяСведения Из СтрРазделить("Валюта кредита,Регион", ",") Цикл
        Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(ИмяСведения, Истина);
        Если Не ЗначениеЗаполнено(Вид) Тогда
            О = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент(); О.Наименование = ИмяСведения;
            О.ТипЗначения = Новый ОписаниеТипов(?(ИмяСведения = "Регион", "Строка", "СправочникСсылка.Валюты")); О.Записать(); Вид = О.Ссылка;
        КонецЕсли;
        О = Руководитель.ПолучитьОбъект();
        Если О.ДополнительныеСведения.Найти(Вид, "ВидСведений") = Неопределено Тогда О.ДополнительныеСведения.Добавить().ВидСведений = Вид; О.Записать(); КонецЕсли;
    КонецЦикла;
    ДругойМенеджер = Элемент("Сотрудники", "ДЕМО Сидоров"); О = ДругойМенеджер.ПолучитьОбъект();
    Если О.ДополнительныеСведения.Найти(Вид, "ВидСведений") = Неопределено Тогда О.ДополнительныеСведения.Добавить().ВидСведений = Вид; О.Записать(); КонецЕсли;
КонецПроцедуры

