Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Движения.Начисления.Записывать = Истина;
 Движения.Начисления.Записать();
 Для Каждого Строка Из ОсновныеНачисления Цикл
  Если Не ЗначениеЗаполнено(Строка.Сотрудник) Или Не ЗначениеЗаполнено(Строка.Подразделение) Или Не ЗначениеЗаполнено(Строка.ВидРасчета) Или Строка.ДатаНачала > Строка.ДатаОкончания Тогда
   Отказ = Истина; Сообщить("Некорректная строка начисления"); Продолжить;
  КонецЕсли;
  Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда
   Отказ = Истина; Сообщить("Тариф и премия вводятся в пределах месяца"); Продолжить;
  КонецЕсли;
  Начало = НачалоДня(Строка.ДатаНачала);
  Пока Начало <= Строка.ДатаОкончания Цикл
   Конец = Мин(КонецМесяца(Начало), КонецДня(Строка.ДатаОкончания));
   Движение = Движения.Начисления.Добавить();
   Движение.ПериодРегистрации = НачалоМесяца(Начало);
   Движение.ПериодДействияНачало = Начало; Движение.ПериодДействияКонец = Конец;
   Движение.ВидРасчета = Строка.ВидРасчета; Движение.Сотрудник = Строка.Сотрудник; Движение.Подразделение = Строка.Подразделение;
   Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
    Движение.Результат = Тариф(Строка.Сотрудник, Строка.Подразделение, Начало, Конец);
   ИначеЕсли Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
    Движение.Результат = Премия(Строка.Сотрудник, Строка.Подразделение, Начало, Конец);
   ИначеЕсли Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
    Движение.Результат = Командировка(Строка.Сотрудник, Строка.Подразделение, Начало, Конец);
   КонецЕсли;
   Начало = НачалоМесяца(ДобавитьМесяц(Начало, 1));
  КонецЦикла;
 КонецЦикла;
КонецПроцедуры

Функция Часы(Подразделение, Начало, Конец, Дни = Ложь)
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ СУММА(ВЫБОР КОГДА &Дни И График.Значение > 0 ТОГДА 1 КОГДА &Дни ТОГДА 0 ИНАЧЕ График.Значение КОНЕЦ) КАК Значение
 |ИЗ РегистрСведений.ГрафикиРаботы КАК График
 |ГДЕ График.Подразделение = &Подразделение И График.Дата МЕЖДУ &Начало И &Конец";
 Запрос.УстановитьПараметр("Подразделение", Подразделение); Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец); Запрос.УстановитьПараметр("Дни", Дни);
 Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий(); Возврат ?(Выборка.Значение = NULL, 0, Выборка.Значение);
КонецФункции

Функция Тариф(Сотрудник, Подразделение, Начало, Конец)
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ Сведения.Оклад КАК Ставка ИЗ РегистрСведений.СведенияОСотрудниках.СрезПоследних(&Дата, Сотрудник = &Сотрудник И Подразделение = &Подразделение) КАК Сведения";
 Запрос.УстановитьПараметр("Дата", НачалоМесяца(Начало)); Запрос.УстановитьПараметр("Сотрудник", Сотрудник); Запрос.УстановитьПараметр("Подразделение", Подразделение);
 Выборка = Запрос.Выполнить().Выбрать(); Если Не Выборка.Следующий() Тогда Возврат 0; КонецЕсли;
 Возврат Окр(Выборка.Ставка * ЧасыБезКомандировок(Сотрудник, Подразделение, Начало, Конец), 2);
КонецФункции

Функция ЧасыБезКомандировок(Сотрудник, Подразделение, Начало, Конец)
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ Начисления.ПериодДействияНачало КАК Начало, Начисления.ПериодДействияКонец КАК Конец ИЗ РегистрРасчета.Начисления КАК Начисления
 |ГДЕ Начисления.Сотрудник = &Сотрудник И Начисления.Подразделение = &Подразделение И Начисления.ВидРасчета = &Вид И Начисления.ПериодДействияНачало <= &Конец И Начисления.ПериодДействияКонец >= &Начало";
 Запрос.УстановитьПараметр("Сотрудник", Сотрудник); Запрос.УстановитьПараметр("Подразделение", Подразделение); Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка); Запрос.УстановитьПараметр("Начало", Начало); Запрос.УстановитьПараметр("Конец", Конец);
 Периоды = Запрос.Выполнить().Выгрузить(); ДатаДня = НачалоДня(Начало); Результат = 0;
 Пока ДатаДня <= Конец Цикл
  ВКомандировке = Ложь;
  Для Каждого Период Из Периоды Цикл
   Если ДатаДня >= НачалоДня(Период.Начало) И ДатаДня <= КонецДня(Период.Конец) Тогда ВКомандировке = Истина; Прервать; КонецЕсли;
  КонецЦикла;
  Если Не ВКомандировке Тогда
   Для Каждого Строка Из ОсновныеНачисления Цикл
    Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка И Строка.Сотрудник = Сотрудник И Строка.Подразделение = Подразделение И ДатаДня >= НачалоДня(Строка.ДатаНачала) И ДатаДня <= КонецДня(Строка.ДатаОкончания) Тогда ВКомандировке = Истина; Прервать; КонецЕсли;
   КонецЦикла;
  КонецЕсли;
  Если Не ВКомандировке Тогда Результат = Результат + Часы(Подразделение, ДатаДня, КонецДня(ДатаДня)); КонецЕсли;
  ДатаДня = ДатаДня + 86400;
 КонецЦикла;
 Возврат Результат;
КонецФункции

Функция Премия(Сотрудник, Подразделение, Начало, Конец)
 Стаж = 0; Если ЗначениеЗаполнено(Сотрудник.ДатаНачалаСтажа) Тогда Стаж = Макс(0, Год(Начало) - Год(Сотрудник.ДатаНачалаСтажа) - ?(Формат(Начало, "ДФ=MMdd") < Формат(Сотрудник.ДатаНачалаСтажа, "ДФ=MMdd"), 1, 0)); КонецЕсли;
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Шкала.Процент КАК Процент ИЗ РегистрСведений.ШкалаПремий КАК Шкала ГДЕ Шкала.Стаж <= &Стаж УПОРЯДОЧИТЬ ПО Шкала.Стаж УБЫВ";
 Запрос.УстановитьПараметр("Стаж", Стаж); Выборка = Запрос.Выполнить().Выбрать(); Если Не Выборка.Следующий() Тогда Возврат 0; КонецЕсли; Процент = Выборка.Процент;
 Запрос.Текст = "ВЫБРАТЬ СУММА(Начисления.Результат) КАК Сумма ИЗ РегистрРасчета.Начисления КАК Начисления
 |ГДЕ Начисления.ПериодРегистрации = &Месяц И Начисления.Подразделение = &Подразделение И Начисления.Сотрудник <> &Сотрудник И Начисления.ВидРасчета = &Вид";
 Запрос.УстановитьПараметр("Месяц", НачалоМесяца(ДобавитьМесяц(Начало, -1))); Запрос.УстановитьПараметр("Подразделение", Подразделение); Запрос.УстановитьПараметр("Сотрудник", Сотрудник); Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
 Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий(); База = ?(Выборка.Сумма = NULL, 0, Выборка.Сумма);
 ВсегоЧасов = Часы(Подразделение, Начало, Конец); Если ВсегоЧасов = 0 Тогда Возврат 0; КонецЕсли;
 Возврат Окр(База * Процент / 100 * ЧасыБезКомандировок(Сотрудник, Подразделение, Начало, Конец) / ВсегоЧасов, 2);
КонецФункции

Функция Командировка(Сотрудник, Подразделение, Начало, Конец)
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ СУММА(Начисления.Результат) КАК Сумма ИЗ РегистрРасчета.Начисления КАК Начисления ГДЕ Начисления.Сотрудник = &Сотрудник И Начисления.ПериодРегистрации >= &Начало И Начисления.ПериодРегистрации < &Конец";
 Граница = НачалоМесяца(Начало); Предыдущие = ДобавитьМесяц(Граница, -3);
 Запрос.УстановитьПараметр("Сотрудник", Сотрудник); Запрос.УстановитьПараметр("Начало", Предыдущие); Запрос.УстановитьПараметр("Конец", Граница);
 Выборка = Запрос.Выполнить().Выбрать(); Выборка.Следующий(); Дни = Часы(Подразделение, Предыдущие, Граница - 1, Истина);
 Если Дни = 0 Или Выборка.Сумма = NULL Тогда Возврат 0; КонецЕсли;
 Возврат Окр(Выборка.Сумма / Дни * Часы(Подразделение, Начало, Конец, Истина), 2);
КонецФункции
