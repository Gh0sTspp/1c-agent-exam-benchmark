Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Движения.ОстаткиНоменклатуры.Записывать = Истина;
 Движения.ПартииНоменклатуры.Записывать = Истина;
 Если ЗначениеЗаполнено(Склад) Тогда Движения.Проводки.Записывать = Истина; КонецЕсли;
 Для Каждого Строка Из СписокНоменклатуры Цикл
  Подразд = ?(ЗначениеЗаполнено(Строка.Подразделение), Строка.Подразделение, Подразделение);
  Если ЗначениеЗаполнено(Склад) Тогда
   Проводка = Движения.Проводки.Добавить(); Проводка.Период = Дата;
   Проводка.СчетДт = ПланыСчетов.Управленческий.Товары; Проводка.СчетКт = ПланыСчетов.Управленческий.Поставщики;
   Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Строка.Номенклатура;
   Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Склад;
   Проводка.КоличествоДт = Строка.Количество; Проводка.Сумма = ?(Строка.Сумма <> 0, Строка.Сумма, Строка.Цена * Строка.Количество);
  КонецЕсли;
  Если Не ЗначениеЗаполнено(Подразд) И ЗначениеЗаполнено(Склад) Тогда Продолжить; КонецЕсли;
  Если Не ЗначениеЗаполнено(Подразд) Или Не ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество <= 0 Тогда
   Отказ = Истина; Сообщить("Не заполнены подразделение, номенклатура или количество"); Продолжить;
  КонецЕсли;
  Движение = Движения.ОстаткиНоменклатуры.ДобавитьПриход();
  Движение.Период = Дата; Движение.Подразделение = Подразд; Движение.Номенклатура = Строка.Номенклатура;
  Движение.Свойство = Строка.Свойство; Движение.Количество = Строка.Количество;
  Движение.Стоимость = ?(Строка.Сумма <> 0, Строка.Сумма, Строка.Цена * Строка.Количество);
  Партия = Движения.ПартииНоменклатуры.ДобавитьПриход();
  ЗаполнитьЗначенияСвойств(Партия, Движение); Партия.Партия = Ссылка;
 КонецЦикла;
КонецПроцедуры
