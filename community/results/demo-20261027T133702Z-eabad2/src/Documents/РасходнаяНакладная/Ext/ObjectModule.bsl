Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Движения.ОстаткиНоменклатуры.Записывать = Истина;
 Движения.ПартииНоменклатуры.Записывать = Истина;
 Движения.ПродажиОперативные.Записывать = Истина;
 Если ЗначениеЗаполнено(Склад) Тогда БухгалтерскаяПродажа(Отказ); КонецЕсли;
 Для Каждого Строка Из СписокНоменклатуры Цикл
  Подразд = ?(ЗначениеЗаполнено(Строка.Подразделение), Строка.Подразделение, Подразделение);
  Если Не ЗначениеЗаполнено(Подразд) И ЗначениеЗаполнено(Склад) Тогда Продолжить; КонецЕсли;
  Стоимость = Списать(Подразд, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Отказ);
  ДвижениеПродажи = Движения.ПродажиОперативные.Добавить();
  ДвижениеПродажи.Период = Дата; ДвижениеПродажи.Номенклатура = Строка.Номенклатура;
  ДвижениеПродажи.Количество = Строка.Количество; ДвижениеПродажи.Стоимость = Стоимость;
  ДвижениеПродажи.Выручка = ?(Строка.Сумма <> 0, Строка.Сумма, Строка.Количество * Строка.Цена);
 КонецЦикла;
КонецПроцедуры

Процедура БухгалтерскаяПродажа(Отказ)
 Движения.Проводки.Записывать = Истина;
 Движения.ПродажиБухгалтерские.Записывать = Истина;
 Блокировка = Новый БлокировкаДанных; Элемент = Блокировка.Добавить("РегистрБухгалтерии.Проводки");
 Элемент.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары); Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
 Движения.Проводки.Записать();
 Связи = Новый Запрос("ВЫБРАТЬ Аналоги.Товар КАК Товар, Аналоги.Аналог КАК Аналог ИЗ РегистрСведений.Аналоги КАК Аналоги");
 ТаблицаСвязей = Связи.Выполнить().Выгрузить();
 Для Каждого Строка Из СписокНоменклатуры Цикл
  Список = Новый Массив; Список.Добавить(Строка.Номенклатура); Индекс = 0;
  Пока Индекс < Список.Количество() Цикл
   Для Каждого Связь Из ТаблицаСвязей Цикл
    Сосед = Неопределено;
    Если Связь.Товар = Список[Индекс] Тогда Сосед = Связь.Аналог; ИначеЕсли Связь.Аналог = Список[Индекс] Тогда Сосед = Связь.Товар; КонецЕсли;
    Если Сосед <> Неопределено И Список.Найти(Сосед) = Неопределено Тогда Список.Добавить(Сосед); КонецЕсли;
   КонецЦикла;
   Индекс = Индекс + 1;
  КонецЦикла;
  Кандидаты = Новый ТаблицаЗначений; Кандидаты.Колонки.Добавить("Товар"); Кандидаты.Колонки.Добавить("Артикул");
  Для Каждого Товар Из Список Цикл
   Если Товар <> Строка.Номенклатура Тогда Кандидат = Кандидаты.Добавить(); Кандидат.Товар = Товар; Кандидат.Артикул = Товар.Артикул; КонецЕсли;
  КонецЦикла;
  Кандидаты.Сортировать("Артикул"); Кандидат = Кандидаты.Вставить(0); Кандидат.Товар = Строка.Номенклатура;
  Осталось = Строка.Количество;
  Для Каждого Кандидат Из Кандидаты Цикл
   Если Осталось <= 0 Тогда Прервать; КонецЕсли;
   Движения.Проводки.Записать();
   Запрос = Новый Запрос;
   Запрос.Текст = "ВЫБРАТЬ Остатки.Субконто2 КАК Склад, Остатки.КоличествоОстатокДт КАК Количество, Остатки.СуммаОстатокДт КАК Стоимость
   |ИЗ РегистрБухгалтерии.Проводки.Остатки(&Момент, Счет = &Счет, &Виды, Субконто1 = &Товар) КАК Остатки";
   Виды = Новый Массив; Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура); Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склад);
   Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Включая)); Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары); Запрос.УстановитьПараметр("Виды", Виды); Запрос.УстановитьПараметр("Товар", Кандидат.Товар);
   Выборка = Запрос.Выполнить().Выбрать(); ВсегоКоличество = 0; ВсегоСтоимость = 0; НаСкладе = 0;
   Пока Выборка.Следующий() Цикл
    ВсегоКоличество = ВсегоКоличество + Выборка.Количество; ВсегоСтоимость = ВсегоСтоимость + Выборка.Стоимость;
    Если Выборка.Склад = Склад Тогда НаСкладе = НаСкладе + Выборка.Количество; КонецЕсли;
   КонецЦикла;
   Если НаСкладе <= 0 Или ВсегоКоличество <= 0 Тогда Продолжить; КонецЕсли;
   Количество = Мин(Осталось, НаСкладе); Стоимость = ?(Количество = ВсегоКоличество, ВсегоСтоимость, Окр(ВсегоСтоимость * Количество / ВсегоКоличество, 2));
   Проводка = Движения.Проводки.Добавить(); Проводка.Период = Дата; Проводка.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки; Проводка.СчетКт = ПланыСчетов.Управленческий.Товары;
   Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Кандидат.Товар; Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Склад; Проводка.КоличествоКт = Количество; Проводка.Сумма = Стоимость;
   Продажа = Движения.ПродажиБухгалтерские.Добавить(); Продажа.Период = Дата; Продажа.Запрошенный = Строка.Номенклатура; Продажа.Проданный = Кандидат.Товар; Продажа.Количество = Количество; Продажа.Стоимость = Стоимость;
   Продажа.Выручка = Окр(?(Строка.Сумма <> 0, Строка.Сумма, Строка.Цена * Строка.Количество) * Количество / Строка.Количество, 2);
   Осталось = Осталось - Количество;
  КонецЦикла;
  Если Осталось > 0 Тогда Отказ = Истина; Сообщить("Недостаточно товара и аналогов: " + Строка.Номенклатура); КонецЕсли;
  Проводка = Движения.Проводки.Добавить(); Проводка.Период = Дата; Проводка.СчетДт = ПланыСчетов.Управленческий.Покупатели; Проводка.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
  Проводка.Сумма = ?(Строка.Сумма <> 0, Строка.Сумма, Строка.Цена * Строка.Количество);
 КонецЦикла;
КонецПроцедуры

Функция Списать(Подразд, Номенклатура, Свойство, Количество, Отказ)
 Если Количество <= 0 Или Не ЗначениеЗаполнено(Подразд) Или Не ЗначениеЗаполнено(Номенклатура) Тогда
  Отказ = Истина; Сообщить("Не заполнены подразделение, номенклатура или количество"); Возврат 0;
 КонецЕсли;
 Блокировка = Новый БлокировкаДанных;
 Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
 Элемент.УстановитьЗначение("Подразделение", Подразд); Элемент.УстановитьЗначение("Номенклатура", Номенклатура); Элемент.УстановитьЗначение("Свойство", Свойство);
 Элемент.Режим = РежимБлокировкиДанных.Исключительный; Блокировка.Заблокировать();
 Движения.ОстаткиНоменклатуры.Записать();
 Запрос = Новый Запрос;
 Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Количество, ЕСТЬNULL(Остатки.СтоимостьОстаток, 0) КАК Стоимость
 |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент, Подразделение = &Подразделение И Номенклатура = &Номенклатура И Свойство = &Свойство) КАК Остатки";
 Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Включая));
 Запрос.УстановитьПараметр("Подразделение", Подразд); Запрос.УстановитьПараметр("Номенклатура", Номенклатура); Запрос.УстановитьПараметр("Свойство", Свойство);
 Выборка = Запрос.Выполнить().Выбрать();
 Если Не Выборка.Следующий() Тогда Отказ = Истина; Сообщить("Нет остатка " + Номенклатура); Возврат 0; КонецЕсли;
 Если Выборка.Количество < Количество Тогда Отказ = Истина; Сообщить("Недостаточно остатка " + Номенклатура); Возврат 0; КонецЕсли;
 Стоимость = ?(Выборка.Количество = Количество, Выборка.Стоимость, Окр(Выборка.Стоимость * Количество / Выборка.Количество, 2));

 Метод = Перечисления.УчетнаяПолитика.ПоСредней;
 ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1 Политика.Способ КАК Способ ИЗ РегистрСведений.УчетныеПолитикиПодразделений.СрезПоследних(&Дата, Подразделение = &Подразделение) КАК Политика";
 ЗапросПолитики = Новый Запрос(ТекстЗапроса); ЗапросПолитики.УстановитьПараметр("Дата", Дата); ЗапросПолитики.УстановитьПараметр("Подразделение", Подразд);
 ВыборПолитики = ЗапросПолитики.Выполнить().Выбрать(); Если ВыборПолитики.Следующий() Тогда Метод = ВыборПолитики.Способ; КонецЕсли;
 Движения.ПартииНоменклатуры.Записать();
 ЗапросПартий = Новый Запрос;
 ЗапросПартий.Текст = "ВЫБРАТЬ Партии.Партия КАК Партия, Партии.КоличествоОстаток КАК Количество, Партии.СтоимостьОстаток КАК Стоимость
 |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(&Момент, Подразделение = &Подразделение И Номенклатура = &Номенклатура И Свойство = &Свойство) КАК Партии
 |ГДЕ Партии.КоличествоОстаток > 0
 |УПОРЯДОЧИТЬ ПО Партии.Партия.Дата, Партии.Партия";
 ЗапросПартий.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Включая)); ЗапросПартий.УстановитьПараметр("Подразделение", Подразд); ЗапросПартий.УстановитьПараметр("Номенклатура", Номенклатура); ЗапросПартий.УстановитьПараметр("Свойство", Свойство);
 Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда ЗапросПартий.Текст = СтрЗаменить(ЗапросПартий.Текст, "Партии.Партия.Дата, Партии.Партия", "Партии.Партия.Дата УБЫВ, Партии.Партия УБЫВ"); КонецЕсли;
 Партии = ЗапросПартий.Выполнить().Выгрузить();
 Осталось = Количество; СтоимостьПартий = 0; ВсегоПартий = Партии.Итог("Количество");
 Для Каждого СтрокаПартии Из Партии Цикл
  Если Осталось <= 0 Тогда Прервать; КонецЕсли;
  Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
   Доля = ?(ВсегоПартий = СтрокаПартии.Количество, Осталось, Мин(Осталось, Окр(Количество * СтрокаПартии.Количество / Выборка.Количество, 0)));
  Иначе Доля = Мин(Осталось, СтрокаПартии.Количество); КонецЕсли;
  Если Доля <= 0 Тогда ВсегоПартий = ВсегоПартий - СтрокаПартии.Количество; Продолжить; КонецЕсли;
  Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
   СуммаПартии = ?(Доля = Осталось, Стоимость - СтоимостьПартий, Окр(Стоимость * Доля / Количество, 2));
  Иначе
   СуммаПартии = ?(Доля = СтрокаПартии.Количество, СтрокаПартии.Стоимость, Окр(СтрокаПартии.Стоимость * Доля / СтрокаПартии.Количество, 2));
  КонецЕсли;
  ДвижениеПартии = Движения.ПартииНоменклатуры.ДобавитьРасход(); ДвижениеПартии.Период = Дата; ДвижениеПартии.Подразделение = Подразд; ДвижениеПартии.Номенклатура = Номенклатура; ДвижениеПартии.Свойство = Свойство; ДвижениеПартии.Партия = СтрокаПартии.Партия; ДвижениеПартии.Количество = Доля; ДвижениеПартии.Стоимость = СуммаПартии;
  СтоимостьПартий = СтоимостьПартий + СуммаПартии; Осталось = Осталось - Доля; ВсегоПартий = ВсегоПартий - СтрокаПартии.Количество;
 КонецЦикла;
 Если Осталось > 0 Тогда Отказ = Истина; Сообщить("Недостаточно партий " + Номенклатура); Возврат 0; КонецЕсли;
 Если Метод <> Перечисления.УчетнаяПолитика.ПоСредней Тогда Стоимость = СтоимостьПартий; КонецЕсли;
 Движение = Движения.ОстаткиНоменклатуры.ДобавитьРасход();
 Движение.Период = Дата; Движение.Подразделение = Подразд; Движение.Номенклатура = Номенклатура; Движение.Свойство = Свойство;
 Движение.Количество = Количество; Движение.Стоимость = Стоимость;
 Возврат Стоимость;
КонецФункции
