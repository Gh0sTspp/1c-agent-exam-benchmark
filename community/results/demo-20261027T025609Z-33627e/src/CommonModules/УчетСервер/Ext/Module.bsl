
Процедура Блокировка(ИмяРегистра) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить(ИмяРегистра);
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
КонецПроцедуры


Функция СуммаСтроки(Строка) Экспорт
    Если НЕ ЗначениеЗаполнено(Строка.Номенклатура) Тогда
        ВызватьИсключение "Укажите номенклатуру.";
    КонецЕсли;
    Если Строка.Количество <= 0 Тогда
        ВызватьИсключение "Количество должно быть положительным.";
    КонецЕсли;
    Если Строка.Сумма < 0 Или Строка.Цена < 0 Тогда
        ВызватьИсключение "Цена и сумма не могут быть отрицательными.";
    КонецЕсли;
    Если Строка.Сумма <> 0 Тогда Возврат Строка.Сумма; КонецЕсли;
    Возврат Окр(Строка.Количество * Строка.Цена, 2);
КонецФункции

Процедура ОчиститьДвижения(Документ) Экспорт
    Для Каждого Набор Из Документ.Движения Цикл
        Набор.Записывать = Истина;
        Набор.Очистить();
    КонецЦикла;
    Документ.Движения.Записать();
    Для Каждого Набор Из Документ.Движения Цикл
        Набор.Записывать = Истина;
    КонецЦикла;
КонецПроцедуры

Функция ОстаткиОУ(Документ, Подразделения) Экспорт
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Номенклатура, Подразделение, Свойство, Партия,
    | Партия.Дата КАК ДатаПартии,
    | КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
    | Подразделение В (&Подразделения))
    |ГДЕ КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО ДатаПартии, Партия");
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция Политики(Дата, Подразделения) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Метод
    |ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция МетодСписания(ТаблицаПолитик, Подразделение) Экспорт
    Строка = ТаблицаПолитик.Найти(Подразделение, "Подразделение");
    Если Строка = Неопределено Тогда
        ВызватьИсключение "Для подразделения не задана учетная политика.";
    КонецЕсли;
    Возврат Строка.Метод;
КонецФункции

Функция СписатьОУ(Документ, Остатки, Подразделение, Товар, Свойство, Количество, Метод) Экспорт
    Если Количество <= 0 Тогда ВызватьИсключение "Количество должно быть положительным."; КонецЕсли;
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
    ВсеПартии = Остатки.НайтиСтроки(Отбор);
    Партии = Новый Массив;
    Для Каждого СтрокаПартии Из ВсеПартии Цикл
        Если СтрокаПартии.Количество > 0 Тогда Партии.Добавить(СтрокаПартии); КонецЕсли;
    КонецЦикла;
    Всего = 0; СтоимостьВсего = 0;
    Для Каждого Партия Из Партии Цикл
        Всего = Всего + Партия.Количество;
        СтоимостьВсего = СтоимостьВсего + Партия.Стоимость;
    КонецЦикла;
    Если Всего < Количество Тогда
        ВызватьИсключение "Недостаточно запаса: " + Строка(Товар) + ", " + Строка(Подразделение) + ".";
    КонецЕсли;
    Осталось = Количество; СтоимостьСписания = 0;
    Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
        Обратные = Новый Массив;
        Индекс = Партии.Количество() - 1;
        Пока Индекс >= 0 Цикл
            Обратные.Добавить(Партии[Индекс]); Индекс = Индекс - 1;
        КонецЦикла;
        Партии = Обратные;
    КонецЕсли;
    НомерПартии = 0;
    Распределение = Новый Массив;
    Для Каждого Партия Из Партии Цикл
        НомерПартии = НомерПартии + 1;
        Если Осталось <= 0 Или Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
        Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
            Списать = Мин(Партия.Количество, Окр(Количество * Партия.Количество / Всего, 3));
            Если НомерПартии = Партии.Количество() Тогда Списать = Мин(Партия.Количество, Осталось); КонецЕсли;
        Иначе
            Списать = Мин(Осталось, Партия.Количество);
        КонецЕсли;
        Списать = Мин(Осталось, Списать);
        Если Списать = 0 Тогда Продолжить; КонецЕсли;
        Сумма = ?(Списать = Партия.Количество, Партия.Стоимость,
            Окр(Партия.Стоимость * Списать / Партия.Количество, 2));
        Движение = Документ.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
        Движение.Период = Документ.Дата;
        Движение.Номенклатура = Товар;
        Движение.Подразделение = Подразделение;
        Движение.Свойство = Свойство;
        Движение.Партия = Партия.Партия;
        Движение.Количество = Списать;
        Движение.Стоимость = Сумма;
        Распределение.Добавить(Новый Структура("Партия,Движение", Партия, Движение));
        Партия.Количество = Партия.Количество - Списать;
        Партия.Стоимость = Партия.Стоимость - Сумма;
        Осталось = Осталось - Списать; СтоимостьСписания = СтоимостьСписания + Сумма;
    КонецЦикла;
    Если Осталось > 0 Тогда ВызватьИсключение "Не удалось распределить количество по партиям."; КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.Средняя Тогда
        ЦелеваяСтоимость = ?(Количество = Всего, СтоимостьВсего, Окр(СтоимостьВсего * Количество / Всего, 2));
        Разница = ЦелеваяСтоимость - СтоимостьСписания;
        Для Каждого РаспределениеПартии Из Распределение Цикл
            Если Разница = 0 Тогда Прервать; КонецЕсли;
            Партия = РаспределениеПартии.Партия;
            Движение = РаспределениеПартии.Движение;
            Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Корректировка = ?(Разница > 0, Мин(Разница, Партия.Стоимость), Макс(Разница, -Движение.Стоимость));
            Движение.Стоимость = Движение.Стоимость + Корректировка;
            Партия.Стоимость = Партия.Стоимость - Корректировка;
            Разница = Разница - Корректировка;
        КонецЦикла;
        Если Разница <> 0 Тогда ВызватьИсключение "Ошибка распределения стоимости по партиям."; КонецЕсли;
        СтоимостьСписания = ЦелеваяСтоимость;
    КонецЕсли;
    Возврат СтоимостьСписания;
КонецФункции

Процедура ПриходОУ(Документ, Подразделение, Товар, Свойство, Количество, Стоимость) Экспорт
    Если Количество <= 0 Или Стоимость < 0 Тогда ВызватьИсключение "Неверное количество или сумма прихода."; КонецЕсли;
    Движение = Документ.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
    Движение.Период = Документ.Дата;
    Движение.Подразделение = Подразделение;
    Движение.Номенклатура = Товар;
    Движение.Свойство = Свойство;
    Движение.Партия = Документ.Ссылка;
    Движение.Количество = Количество;
    Движение.Стоимость = Стоимость;
КонецПроцедуры

Процедура Продажа(Документ, Товар, Продано, Количество, Себестоимость, Выручка, БУ) Экспорт
    Движение = Документ.Движения.ПродажиТоваров.Добавить();
    Движение.Период = Документ.Дата;
    Движение.Номенклатура = Товар;
    Движение.Продано = Продано;
    Движение.БухгалтерскийУчет = БУ;
    Движение.Количество = Количество;
    Движение.Себестоимость = Себестоимость;
    Движение.Выручка = Выручка;
КонецПроцедуры

Процедура Проводка(Документ, Дебет, Кредит, ТоварДт, ТоварКт, СкладДт, СкладКт, КолДт, КолКт, Сумма, Заказано = Неопределено, Продано = Неопределено) Экспорт
    Движение = Документ.Движения.Учет.Добавить();
    Движение.Период = Документ.Дата;
    Движение.СчетДт = Дебет;
    Движение.СчетКт = Кредит;
    Если Дебет = ПланыСчетов.Управленческий.Товары Тогда
        Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = ТоварДт;
        Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = СкладДт;
    КонецЕсли;
    Если Кредит = ПланыСчетов.Управленческий.Товары Тогда
        Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = ТоварКт;
        Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = СкладКт;
    КонецЕсли;
    Если Дебет = ПланыСчетов.Управленческий.ПрибылиУбытки Тогда
        Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = ?(Заказано = Неопределено, ТоварДт, Заказано);
        Движение.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = ?(Продано = Неопределено, ТоварДт, Продано);
    КонецЕсли;
    Если Кредит = ПланыСчетов.Управленческий.ПрибылиУбытки Тогда
        Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = ?(Заказано = Неопределено, ТоварКт, Заказано);
        Движение.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = ?(Продано = Неопределено, ТоварКт, Продано);
    КонецЕсли;
    Движение.КоличествоДт = КолДт;
    Движение.КоличествоКт = КолКт;
    Движение.Сумма = Сумма;
КонецПроцедуры

Процедура Приход(Документ) Экспорт
    Если ЗначениеЗаполнено(Документ.Склад) Тогда
        Блокировка("РегистрБухгалтерии.Учет");
    Иначе
        Блокировка("РегистрНакопления.ОстаткиНоменклатуры");
    КонецЕсли;
    ОчиститьДвижения(Документ);
    Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
        Сумма = СуммаСтроки(Строка);
        Если ЗначениеЗаполнено(Документ.Склад) Тогда
            Проводка(Документ, ПланыСчетов.Управленческий.Товары, ПланыСчетов.Управленческий.Поставщики,
                Строка.Номенклатура, Неопределено, Документ.Склад, Неопределено, Строка.Количество, 0, Сумма);
        Иначе
            Подразделение = ?(ЗначениеЗаполнено(Строка.Подразделение), Строка.Подразделение, Документ.Подразделение);
            ПриходОУ(Документ, Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Сумма);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Процедура Расход(Документ) Экспорт
    Если ЗначениеЗаполнено(Документ.Склад) Тогда
        РасходБУ(Документ);
        Возврат;
    КонецЕсли;
    Блокировка("РегистрНакопления.ОстаткиНоменклатуры");
    ОчиститьДвижения(Документ);
    Подразделения = Документ.СписокНоменклатуры.Выгрузить().ВыгрузитьКолонку("Подразделение");
    Подразделения.Добавить(Документ.Подразделение);
    Остатки = ОстаткиОУ(Документ, Подразделения);
    ТаблицаПолитик = Политики(Документ.Дата, Подразделения);
    Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
        Подразделение = ?(ЗначениеЗаполнено(Строка.Подразделение), Строка.Подразделение, Документ.Подразделение);
        Себестоимость = СписатьОУ(Документ, Остатки, Подразделение, Строка.Номенклатура, Строка.Свойство,
            Строка.Количество, МетодСписания(ТаблицаПолитик, Подразделение));
        Продажа(Документ, Строка.Номенклатура, Строка.Номенклатура, Строка.Количество, Себестоимость, СуммаСтроки(Строка), Ложь);
    КонецЦикла;
КонецПроцедуры

Процедура Собрать(Документ) Экспорт
    Блокировка("РегистрНакопления.ОстаткиНоменклатуры");
    ОчиститьДвижения(Документ);
    Подразделения = Новый Массив; Подразделения.Добавить(Документ.ПодразделениеИсточник);
    Остатки = ОстаткиОУ(Документ, Подразделения);
    ТаблицаПолитик = Политики(Документ.Дата, Подразделения);
    Метод = МетодСписания(ТаблицаПолитик, Документ.ПодразделениеИсточник);
    Запрос = Новый Запрос(
    "ВЫБРАТЬ С.СистемныйБлок, С.Номенклатура, С.Свойство, С.Количество
    |ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ
    | (ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
    |  ИЗ РегистрСведений.Спецификации
    |  ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки)
    |  СГРУППИРОВАТЬ ПО СистемныйБлок) КАК Версии
    |ПО С.СистемныйБлок = Версии.СистемныйБлок И С.Период = Версии.Период");
    Запрос.УстановитьПараметр("Дата", Документ.Дата);
    Запрос.УстановитьПараметр("Блоки", Документ.Блоки.Выгрузить().ВыгрузитьКолонку("Номенклатура"));
    Спецификации = Запрос.Выполнить().Выгрузить();
    СтоимостьДополнений = 0; КоличествоБлоков = 0;
    Для Каждого Строка Из Документ.Блоки Цикл
        Если Строка.Количество <= 0 Тогда ВызватьИсключение "Количество блоков должно быть положительным."; КонецЕсли;
        КоличествоБлоков = КоличествоБлоков + Строка.Количество;
    КонецЦикла;
    Если КоличествоБлоков = 0 Тогда ВызватьИсключение "Не указаны собираемые блоки."; КонецЕсли;
    Для Каждого Строка Из Документ.ДополнительныеДетали Цикл
        СтоимостьДополнений = СтоимостьДополнений + СписатьОУ(Документ, Остатки,
            Документ.ПодразделениеИсточник, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Метод);
    КонецЦикла;
    ОстатокДополнений = СтоимостьДополнений; Номер = 0;
    Для Каждого Строка Из Документ.Блоки Цикл
        Номер = Номер + 1;
        Детали = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Строка.Номенклатура));
        Если Детали.Количество() = 0 Тогда ВызватьИсключение "Не задана спецификация блока: " + Строка(Строка.Номенклатура); КонецЕсли;
        Стоимость = 0;
        Для Каждого Деталь Из Детали Цикл
            Стоимость = Стоимость + СписатьОУ(Документ, Остатки, Документ.ПодразделениеИсточник,
                Деталь.Номенклатура, Деталь.Свойство, Деталь.Количество * Строка.Количество, Метод);
        КонецЦикла;
        Дополнение = ?(Номер = Документ.Блоки.Количество(), ОстатокДополнений,
            Окр(СтоимостьДополнений * Строка.Количество / КоличествоБлоков, 2));
        ОстатокДополнений = ОстатокДополнений - Дополнение;
        ПриходОУ(Документ, Документ.ПодразделениеПолучатель, Строка.Номенклатура,
            Справочники.СвойстваНоменклатуры.ПустаяСсылка(), Строка.Количество, Стоимость + Дополнение);
    КонецЦикла;
КонецПроцедуры

Функция ГруппаАналогов(Товар, Связи) Экспорт
    Группа = Новый Массив; Группа.Добавить(Товар);
    Изменено = Истина;
    Пока Изменено Цикл
        Изменено = Ложь;
        Для Каждого Связь Из Связи Цикл
            Если Группа.Найти(Связь.Товар) <> Неопределено И Группа.Найти(Связь.Аналог) = Неопределено Тогда
                Группа.Добавить(Связь.Аналог); Изменено = Истина;
            КонецЕсли;
            Если Группа.Найти(Связь.Аналог) <> Неопределено И Группа.Найти(Связь.Товар) = Неопределено Тогда
                Группа.Добавить(Связь.Товар); Изменено = Истина;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Возврат Группа;
КонецФункции

Процедура РасходБУ(Документ) Экспорт
    Блокировка("РегистрБухгалтерии.Учет");
    ОчиститьДвижения(Документ);
    Запрос = Новый Запрос(
    "ВЫБРАТЬ Субконто1 КАК Номенклатура, Субконто2 КАК Склад, КоличествоОстаток КАК Количество
    |ИЗ РегистрБухгалтерии.Учет.Остатки(&Момент, Счет = &Счет, &Виды, )");
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
    Виды = Новый Массив;
    Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Склады);
    Запрос.УстановитьПараметр("Виды", Виды);
    Остатки = Запрос.Выполнить().Выгрузить();
    Виды = Новый Массив;
    Виды.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
    Запрос.УстановитьПараметр("Виды", Виды);
    Запрос.Текст = "ВЫБРАТЬ Субконто1 КАК Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Стоимость
    |ИЗ РегистрБухгалтерии.Учет.Остатки(&Момент, Счет = &Счет, &Виды, )";
    Себестоимости = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги";
    Связи = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ Ссылка КАК Номенклатура, Артикул ИЗ Справочник.Номенклатура
    |ГДЕ НЕ ЭтоГруппа УПОРЯДОЧИТЬ ПО Артикул, Номенклатура";
    Товары = Запрос.Выполнить().Выгрузить();
    ПустойТовар = Справочники.Номенклатура.ПустаяСсылка();
    ПустойСклад = Справочники.Склады.ПустаяСсылка();
    Для Каждого Строка Из Документ.СписокНоменклатуры Цикл
        ВыручкаСтроки = СуммаСтроки(Строка);
        Группа = ГруппаАналогов(Строка.Номенклатура, Связи);
        Порядок = Новый Массив; Порядок.Добавить(Строка.Номенклатура);
        Для Каждого Товар Из Товары Цикл
            Если Товар.Номенклатура <> Строка.Номенклатура И Группа.Найти(Товар.Номенклатура) <> Неопределено Тогда
                Порядок.Добавить(Товар.Номенклатура);
            КонецЕсли;
        КонецЦикла;
        Осталось = Строка.Количество; ОстатокВыручки = ВыручкаСтроки;
        Для Каждого Товар Из Порядок Цикл
            Если Осталось = 0 Тогда Прервать; КонецЕсли;
            Запасы = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Товар));
            СтоимостьПоТовару = Себестоимости.Найти(Товар, "Номенклатура");
            Если СтоимостьПоТовару = Неопределено Тогда Продолжить; КонецЕсли;
            Всего = СтоимостьПоТовару.Количество;
            СтоимостьВсего = СтоимостьПоТовару.Стоимость; НаСкладе = Неопределено;
            Для Каждого Запас Из Запасы Цикл
                Если Запас.Склад = Документ.Склад Тогда НаСкладе = Запас; КонецЕсли;
            КонецЦикла;
            Если НаСкладе = Неопределено Или Всего <= 0 Тогда Продолжить; КонецЕсли;
            Списать = Мин(Осталось, НаСкладе.Количество);
            Если Списать <= 0 Тогда Продолжить; КонецЕсли;
            Стоимость = ?(Списать = Всего, СтоимостьВсего, Окр(СтоимостьВсего * Списать / Всего, 2));
            Выручка = ?(Списать = Осталось, ОстатокВыручки, Окр(ВыручкаСтроки * Списать / Строка.Количество, 2));
            Проводка(Документ, ПланыСчетов.Управленческий.ПрибылиУбытки, ПланыСчетов.Управленческий.Товары,
                ПустойТовар, Товар, ПустойСклад, Документ.Склад, Списать, Списать, Стоимость, Строка.Номенклатура, Товар);
            Проводка(Документ, ПланыСчетов.Управленческий.Покупатели, ПланыСчетов.Управленческий.ПрибылиУбытки,
                ПустойТовар, ПустойТовар, ПустойСклад, ПустойСклад, 0, 0, Выручка, Строка.Номенклатура, Товар);
            НаСкладе.Количество = НаСкладе.Количество - Списать;
            СтоимостьПоТовару.Количество = СтоимостьПоТовару.Количество - Списать;
            СтоимостьПоТовару.Стоимость = СтоимостьПоТовару.Стоимость - Стоимость;
            Продажа(Документ, Строка.Номенклатура, Товар, Списать, Стоимость, Выручка, Истина);
            Осталось = Осталось - Списать; ОстатокВыручки = ОстатокВыручки - Выручка;
        КонецЦикла;
        Если Осталось > 0 Тогда ВызватьИсключение "Недостаточно товара и его аналогов: " + Строка(Строка.Номенклатура); КонецЕсли;
    КонецЦикла;
КонецПроцедуры

Функция ДанныеГрафика(Ссылка) Экспорт
    Запрос = Новый Запрос("ВЫБРАТЬ НомерСтроки,
    | ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК Часы,
    | ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК Дни,
    | ЕСТЬNULL(ДниПериодДействия, 0) КАК ДниПериода
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор = &Док)");
    Запрос.УстановитьПараметр("Док", Ссылка);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция БазаНачислений(Ссылка, ПоСотруднику) Экспорт
    Измерения = Новый Массив; Разрезы = Новый Массив;
    Если ПоСотруднику Тогда
        Измерения.Добавить("Сотрудник");
    Иначе
        Измерения.Добавить("Подразделение");
        Разрезы.Добавить("Сотрудник");
    КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ * ИЗ
    | РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы, Регистратор = &Док)");
    Запрос.УстановитьПараметр("Док", Ссылка);
    Запрос.УстановитьПараметр("Измерения", Измерения);
    Запрос.УстановитьПараметр("Разрезы", Разрезы);
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура Начислить(Документ) Экспорт
    НастроитьВидыРасчета();
    Блокировка("РегистрРасчета.Начисления");
    ОчиститьДвижения(Документ);
    Набор = Документ.Движения.Начисления;
    Для Каждого Строка Из Документ.ОсновныеНачисления Цикл
        Если НЕ ЗначениеЗаполнено(Строка.Сотрудник) Или НЕ ЗначениеЗаполнено(Строка.Подразделение)
            Или Строка.ДатаОкончания < Строка.ДатаНачала Тогда
            ВызватьИсключение "Проверьте сотрудника, подразделение и период начисления.";
        КонецЕсли;
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
            И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия вводятся в пределах одного месяца.";
        КонецЕсли;
        Начало = НачалоДня(Строка.ДатаНачала);
        Пока Начало <= Строка.ДатаОкончания Цикл
            Конец = Мин(КонецМесяца(Начало), КонецДня(Строка.ДатаОкончания));
            Запись = Набор.Добавить();
            Запись.ПериодРегистрации = ?(Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка,
                Макс(НачалоМесяца(Документ.Дата), НачалоМесяца(Начало)), НачалоМесяца(Начало));
            Запись.ПериодДействияНачало = Начало;
            Запись.ПериодДействияКонец = Конец;
            Запись.Сотрудник = Строка.Сотрудник;
            Запись.Подразделение = Строка.Подразделение;
            Запись.ВидРасчета = Строка.ВидРасчета;
            Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало),
                ?(Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка, -3, -1));
            Запись.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            Начало = Конец + 1;
        КонецЦикла;
    КонецЦикла;
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого Строка Из Дополнение Цикл
        Запись = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Запись, Строка, , "Регистратор,НомерСтроки");
        Запись.Сторно = Истина;
        Запись.ПериодРегистрации = Строка.ПериодРегистрацииСторно;
        Запись.ПериодДействияНачало = Строка.ПериодДействияНачалоСторно;
        Запись.ПериодДействияКонец = Строка.ПериодДействияКонецСторно;
    КонецЦикла;
    Набор.Записать();
    ПересчитатьВытесненные(Документ);
    График = ДанныеГрафика(Документ.Ссылка);
    Запрос = Новый Запрос("ВЫБРАТЬ Ссылка КАК Сотрудник, НачалоСтажа ИЗ Справочник.ФизическиеЛица
    |ГДЕ Ссылка В (&Сотрудники)");
    Запрос.УстановитьПараметр("Сотрудники", Документ.ОсновныеНачисления.Выгрузить().ВыгрузитьКолонку("Сотрудник"));
    Сотрудники = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ Период, Сотрудник, Ставка ИЗ РегистрСведений.ТарифныеСтавки
    |ГДЕ Сотрудник В (&Сотрудники) УПОРЯДОЧИТЬ ПО Период УБЫВ";
    Ставки = Запрос.Выполнить().Выгрузить();
    Запрос.Текст = "ВЫБРАТЬ СтажОт, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО СтажОт";
    Шкала = Запрос.Выполнить().Выгрузить();
    Для Каждого Запись Из Набор Цикл
        Данные = График.Найти(Запись.НомерСтроки, "НомерСтроки");
        Если Данные = Неопределено Тогда Продолжить; КонецЕсли;
        Запись.Дни = ?(Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад, Данные.Дни, 0);
        Если Запись.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
            Если НЕ Запись.Сторно Тогда
                НайденныеСтавки = Ставки.НайтиСтроки(Новый Структура("Сотрудник", Запись.Сотрудник));
                Для Каждого Ставка Из НайденныеСтавки Цикл
                    Если Ставка.Период <= НачалоМесяца(Запись.ПериодДействияНачало) Тогда
                        Запись.Ставка = Ставка.Ставка; Прервать;
                    КонецЕсли;
                КонецЦикла;
            КонецЕсли;
            Запись.Результат = Окр(Запись.Ставка * Данные.Часы, 2);
            Если Запись.Сторно Тогда Запись.Результат = -Запись.Результат; Запись.Дни = -Запись.Дни; КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    Набор.Записать(Истина, Истина);
    БазаПремий = БазаНачислений(Документ.Ссылка, Ложь);
    Для Каждого Запись Из Набор Цикл
        Если Запись.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        ДанныеСотрудника = Сотрудники.Найти(Запись.Сотрудник, "Сотрудник");
        Запись.Стаж = 0;
        Если ДанныеСотрудника <> Неопределено И ЗначениеЗаполнено(ДанныеСотрудника.НачалоСтажа) Тогда
            Запись.Стаж = Макс(0, Год(Запись.ПериодДействияНачало) - Год(ДанныеСотрудника.НачалоСтажа));
            Если ДобавитьМесяц(ДанныеСотрудника.НачалоСтажа, Запись.Стаж * 12) > НачалоМесяца(Запись.ПериодДействияНачало) Тогда
                Запись.Стаж = Макс(0, Запись.Стаж - 1);
            КонецЕсли;
        КонецЕсли;
        Для Каждого Ступень Из Шкала Цикл
            Если Запись.Стаж >= Ступень.СтажОт Тогда Запись.Процент = Ступень.Процент; КонецЕсли;
        КонецЦикла;
        База = 0;
        Для Каждого СтрокаБазы Из БазаПремий.НайтиСтроки(Новый Структура("НомерСтроки", Запись.НомерСтроки)) Цикл
            Если СтрокаБазы.СотрудникРазрез <> Запись.Сотрудник Тогда
                База = База + СтрокаБазы.РезультатБаза;
            КонецЕсли;
        КонецЦикла;
        Данные = График.Найти(Запись.НомерСтроки, "НомерСтроки");
        Доля = 0;
        Если Данные <> Неопределено И Данные.ДниПериода <> 0 Тогда Доля = Данные.Дни / Данные.ДниПериода; КонецЕсли;
        Запись.База = База;
        Запись.Результат = Окр(База * Запись.Процент / 100 * Доля, 2);
        // Премия не добавляет отработанных дней к расчету средней.
        Запись.Дни = 0;
        Если Запись.Сторно Тогда Запись.Результат = -Запись.Результат; КонецЕсли;
    КонецЦикла;
    Набор.Записать(Истина, Истина);
    БазаКомандировок = БазаНачислений(Документ.Ссылка, Истина);
    Порядок = Набор.Выгрузить();
    Порядок.Сортировать("ПериодДействияНачало,НомерСтроки");
    РассчитанныеКомандировки = Новый Массив;
    Для Каждого СтрокаПорядка Из Порядок Цикл
        Если СтрокаПорядка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        Запись = Набор[СтрокаПорядка.НомерСтроки - 1];
        База = БазаКомандировок.Найти(Запись.НомерСтроки, "НомерСтроки");
        СуммаБазы = 0; ДниБазы = 0;
        Если База <> Неопределено Тогда
            СуммаБазы = База.РезультатБаза; ДниБазы = База.ДниБаза;
        КонецЕсли;
        Для Каждого Ранее Из РассчитанныеКомандировки Цикл
            Если Ранее.Сотрудник = Запись.Сотрудник
                И Ранее.ПериодДействияНачало >= Запись.БазовыйПериодНачало
                И Ранее.ПериодДействияКонец <= Запись.БазовыйПериодКонец Тогда
                СуммаБазы = СуммаБазы + Ранее.Результат;
            КонецЕсли;
        КонецЦикла;
        Запись.Результат = 0;
        Если ДниБазы <> 0 Тогда
            ДанныеКомандировки = График.Найти(Запись.НомерСтроки, "НомерСтроки");
            Если ДанныеКомандировки <> Неопределено Тогда
                Запись.Результат = Окр(СуммаБазы / ДниБазы * ДанныеКомандировки.Дни, 2);
            КонецЕсли;
        КонецЕсли;
        Запись.Дни = 0;
        РассчитанныеКомандировки.Добавить(Запись);
    КонецЦикла;
    Набор.Записать(Истина, Истина);
КонецПроцедуры

Процедура НастроитьВидыРасчета() Экспорт
    План = ПланыВидовРасчета.ОсновныеНачисления;
    Оклад = План.Оклад.ПолучитьОбъект();
    Если Оклад.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        Оклад.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = План.Командировка;
        Оклад.Записать();
    КонецЕсли;
    Премия = План.Премия.ПолучитьОбъект();
    Если Премия.БазовыеВидыРасчета.Количество() = 0 Тогда
        Премия.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Оклад;
        Премия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = План.Командировка;
        Премия.Записать();
    КонецЕсли;
    Командировка = План.Командировка.ПолучитьОбъект();
    Если Командировка.БазовыеВидыРасчета.Количество() = 0 Тогда
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Оклад;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Премия;
        Командировка.БазовыеВидыРасчета.Добавить().ВидРасчета = План.Командировка;
        Командировка.Записать();
    КонецЕсли;
КонецПроцедуры


Процедура ПересчитатьВытесненные(Документ) Экспорт
    Периоды = Новый Массив;
    Для Каждого СтрокаДокумента Из Документ.ОсновныеНачисления Цикл
        Если СтрокаДокумента.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        Месяц = НачалоМесяца(СтрокаДокумента.ДатаНачала);
        Пока Месяц <= СтрокаДокумента.ДатаОкончания Цикл
            Регистрация = Макс(Месяц, НачалоМесяца(Документ.Дата));
            Если Периоды.Найти(Регистрация) = Неопределено Тогда Периоды.Добавить(Регистрация); КонецЕсли;
            Месяц = ДобавитьМесяц(Месяц, 1);
        КонецЦикла;
    КонецЦикла;
    Если Периоды.Количество() = 0 Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор ИЗ
    | РегистрРасчета.Начисления.ДанныеГрафика(Сотрудник В (&Сотрудники)
    | И Регистратор <> &Док И ПериодРегистрации В (&Периоды))");
    Запрос.УстановитьПараметр("Сотрудники", Документ.ОсновныеНачисления.Выгрузить().ВыгрузитьКолонку("Сотрудник"));
    Запрос.УстановитьПараметр("Док", Документ.Ссылка);
    Запрос.УстановитьПараметр("Периоды", Периоды);
    Регистраторы = Запрос.Выполнить().Выгрузить();
    Если Регистраторы.Количество() = 0 Тогда Возврат; КонецЕсли;
    // Для замещения набора нужны все его строки, включая других сотрудников.
    Запрос.Текст = "ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))";
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы.ВыгрузитьКолонку("Регистратор"));
    Таблица = Запрос.Выполнить().Выгрузить();
    Измененные = Новый Массив;
    Для Каждого Строка Из Таблица Цикл
        СтарыйРезультат = Строка.Результат; СтарыеДни = Строка.Дни;
        Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад Тогда
            Строка.Результат = Окр(Строка.Ставка * Строка.ЗначениеФактическийПериодДействия, 2);
            Строка.Дни = Строка.ДниФактическийПериодДействия;
            Если Строка.Сторно Тогда Строка.Результат = -Строка.Результат; Строка.Дни = -Строка.Дни; КонецЕсли;
        ИначеЕсли Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
            Строка.Результат = 0;
            Если Строка.ДниПериодДействия > 0 Тогда
                Строка.Результат = Окр(Строка.База * Строка.Процент / 100
                    * Строка.ДниФактическийПериодДействия / Строка.ДниПериодДействия, 2);
            КонецЕсли;
            Если Строка.Сторно Тогда Строка.Результат = -Строка.Результат; КонецЕсли;
        КонецЕсли;
        Если (СтарыйРезультат <> Строка.Результат Или СтарыеДни <> Строка.Дни)
            И Измененные.Найти(Строка.Регистратор) = Неопределено Тогда
            Измененные.Добавить(Строка.Регистратор);
        КонецЕсли;
    КонецЦикла;
    Для Каждого Регистратор Из Измененные Цикл
        Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(Регистратор);
        Набор.Загрузить(Таблица.Скопировать(Таблица.НайтиСтроки(Новый Структура("Регистратор", Регистратор))));
        Набор.Записать();
    КонецЦикла;
КонецПроцедуры

Функция ПечатнаяФормаОтчета(Данные, Заголовок) Экспорт
    Если Данные.Колонки.Найти("НачальныйОстаток") <> Неопределено Тогда Возврат ПечатнаяВедомость(Данные, Заголовок); КонецЕсли;
    Если Данные.Колонки.Найти("Продано") <> Неопределено Тогда Возврат ПечатныеПродажиАналогов(Данные, Заголовок); КонецЕсли;
    ПечатнаяФорма = Новый ТабличныйДокумент;
    ПечатнаяФорма.АвтоМасштаб = Истина;
    Колонок = Данные.Колонки.Количество();
    Если Колонок = 0 Тогда Возврат ПечатнаяФорма; КонецЕсли;
    ПечатнаяФорма.Область(1, 1, 1, Колонок).Объединить();
    ПечатнаяФорма.Область(1, 1).Текст = Заголовок;
    ПечатнаяФорма.Область(1, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);
    Заголовки = Новый Соответствие;
    Заголовки.Вставить("Номенклатура", "Номенклатура");
    Заголовки.Вставить("Характеристика", "Характеристика");
    Заголовки.Вставить("НачальныйОстатокКоличество", "Нач. остаток, кол.");
    Заголовки.Вставить("НачальныйОстаток", "Нач. остаток, сумма");
    Заголовки.Вставить("ПриходКоличество", "Приход, кол.");
    Заголовки.Вставить("Приход", "Приход, сумма");
    Заголовки.Вставить("РасходКоличество", "Расход, кол.");
    Заголовки.Вставить("Расход", "Расход, сумма");
    Заголовки.Вставить("КонечныйОстатокКоличество", "Кон. остаток, кол.");
    Заголовки.Вставить("КонечныйОстаток", "Кон. остаток, сумма");
    Заголовки.Вставить("Количество", "Количество");
    Заголовки.Вставить("Себестоимость", "Себестоимость");
    Заголовки.Вставить("Выручка", "Продажа");
    Заголовки.Вставить("Прибыль", "Прибыль");
    Заголовки.Вставить("Продано", "Продано");
    Заголовки.Вставить("Сотрудник", "Сотрудник");
    Заголовки.Вставить("Стаж", "Трудовой стаж, лет");
    Заголовки.Вставить("Процент", "% премии");
    Заголовки.Вставить("СуммаПремии", "Сумма премии");
    НомерКолонки = 0; Итоги = Новый Массив;
    Для Каждого Колонка Из Данные.Колонки Цикл
        НомерКолонки = НомерКолонки + 1;
        Название = Заголовки.Получить(Колонка.Имя);
        ПечатнаяФорма.Область(3, НомерКолонки).Текст = ?(Название = Неопределено, Колонка.Имя, Название);
        ПечатнаяФорма.Область(3, НомерКолонки).Шрифт = Новый Шрифт("Arial", 10, Истина);
        ПечатнаяФорма.Область(, НомерКолонки).ШиринаКолонки = 18;
        Итоги.Добавить(0);
    КонецЦикла;
    НомерСтроки = 4;
    Для Каждого Строка Из Данные Цикл
        НомерКолонки = 0;
        Для Каждого Колонка Из Данные.Колонки Цикл
            НомерКолонки = НомерКолонки + 1;
            Значение = Строка[Колонка.Имя];
            Если ТипЗнч(Значение) = Тип("Число") Тогда
                ПечатнаяФорма.Область(НомерСтроки, НомерКолонки).Текст = Формат(Значение, "ЧДЦ=2");
                Если Колонка.Имя <> "Стаж" И Колонка.Имя <> "Процент" Тогда
                    Итоги[НомерКолонки - 1] = Итоги[НомерКолонки - 1] + Значение;
                КонецЕсли;
            Иначе
                ПечатнаяФорма.Область(НомерСтроки, НомерКолонки).Текст = Строка(Значение);
            КонецЕсли;
        КонецЦикла;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    ПечатнаяФорма.Область(НомерСтроки, 1).Текст = "ИТОГО:";
    Для НомерКолонки = 2 По Колонок Цикл
        Если Итоги[НомерКолонки - 1] <> 0 Тогда
            ПечатнаяФорма.Область(НомерСтроки, НомерКолонки).Текст = Формат(Итоги[НомерКолонки - 1], "ЧДЦ=2");
        КонецЕсли;
    КонецЦикла;
    ПечатнаяФорма.Область(НомерСтроки, 1, НомерСтроки, Колонок).Шрифт = Новый Шрифт("Arial", 10, Истина);
    Возврат ПечатнаяФорма;
КонецФункции

Функция ШапкаПечатногоОтчета(Заголовок, Колонки)
    Результат = Новый ТабличныйДокумент;
    Результат.АвтоМасштаб = Истина;
    Результат.Область(1, 1, 1, Колонки.Количество()).Объединить();
    Результат.Область(1, 1).Текст = Заголовок;
    Результат.Область(1, 1).Шрифт = Новый Шрифт("Arial", 12, Истина);
    Для Номер = 1 По Колонки.Количество() Цикл
        Результат.Область(3, Номер).Текст = Колонки[Номер - 1];
        Результат.Область(3, Номер).Шрифт = Новый Шрифт("Arial", 10, Истина);
        Результат.Область(, Номер).ШиринаКолонки = ?(Номер <= 2, 24, 16);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПечатнаяВедомость(Данные, Заголовок)
    Колонки = СтрРазделить("Характеристика|Товар|Нач. ост.|Приход|Расход|Кон. ост.", "|");
    Результат = ШапкаПечатногоОтчета(Заголовок, Колонки);
    Данные.Сортировать("Характеристика,Номенклатура");
    ПредыдущаяХарактеристика = Неопределено; СтрокаВывода = 4;
    Для Каждого Строка Из Данные Цикл
        Если ПредыдущаяХарактеристика <> Строка.Характеристика Тогда
            Результат.Область(СтрокаВывода, 1).Текст = Строка(Строка.Характеристика);
            Результат.Область(СтрокаВывода, 1).Шрифт = Новый Шрифт("Arial", 10, Истина);
            СтрокаВывода = СтрокаВывода + 1; ПредыдущаяХарактеристика = Строка.Характеристика;
        КонецЕсли;
        Результат.Область(СтрокаВывода, 2).Текст = Строка(Строка.Номенклатура);
        Результат.Область(СтрокаВывода, 3).Текст = Формат(Строка.НачальныйОстатокКоличество, "ЧДЦ=3;ЧН=;");
        Результат.Область(СтрокаВывода, 4).Текст = Формат(Строка.ПриходКоличество, "ЧДЦ=3;ЧН=;");
        Результат.Область(СтрокаВывода, 5).Текст = Формат(Строка.РасходКоличество, "ЧДЦ=3;ЧН=;");
        Результат.Область(СтрокаВывода, 6).Текст = Формат(Строка.КонечныйОстатокКоличество, "ЧДЦ=3;ЧН=;");
        СтрокаВывода = СтрокаВывода + 1;
        Результат.Область(СтрокаВывода, 3).Текст = Формат(Строка.НачальныйОстаток, "ЧДЦ=2;ЧН=;");
        Результат.Область(СтрокаВывода, 4).Текст = Формат(Строка.Приход, "ЧДЦ=2;ЧН=;");
        Результат.Область(СтрокаВывода, 5).Текст = Формат(Строка.Расход, "ЧДЦ=2;ЧН=;");
        Результат.Область(СтрокаВывода, 6).Текст = Формат(Строка.КонечныйОстаток, "ЧДЦ=2;ЧН=;");
        СтрокаВывода = СтрокаВывода + 1;
    КонецЦикла;
    Возврат Результат;
КонецФункции

Функция ПечатныеПродажиАналогов(Данные, Заголовок)
    Колонки = СтрРазделить("Номенклатура|Продано|Кол-во|Себест-сть|Продажа|Прибыль", "|");
    Результат = ШапкаПечатногоОтчета(Заголовок, Колонки);
    Группы = Данные.Скопировать();
    Группы.Свернуть("Номенклатура", "Количество,Себестоимость,Выручка,Прибыль");
    Группы.Сортировать("Номенклатура");
    СтрокаВывода = 4;
    Для Каждого Группа Из Группы Цикл
        Результат.Область(СтрокаВывода, 1).Текст = Строка(Группа.Номенклатура);
        Результат.Область(СтрокаВывода, 3).Текст = Формат(Группа.Количество, "ЧДЦ=3");
        Результат.Область(СтрокаВывода, 4).Текст = Формат(Группа.Себестоимость, "ЧДЦ=2");
        Результат.Область(СтрокаВывода, 5).Текст = Формат(Группа.Выручка, "ЧДЦ=2");
        Результат.Область(СтрокаВывода, 6).Текст = Формат(Группа.Прибыль, "ЧДЦ=2");
        Результат.Область(СтрокаВывода, 1, СтрокаВывода, 6).Шрифт = Новый Шрифт("Arial", 10, Истина);
        СтрокаВывода = СтрокаВывода + 1;
        Для Каждого Строка Из Данные.НайтиСтроки(Новый Структура("Номенклатура", Группа.Номенклатура)) Цикл
            Результат.Область(СтрокаВывода, 2).Текст = Строка(Строка.Продано);
            Результат.Область(СтрокаВывода, 3).Текст = Формат(Строка.Количество, "ЧДЦ=3");
            Результат.Область(СтрокаВывода, 4).Текст = Формат(Строка.Себестоимость, "ЧДЦ=2");
            Результат.Область(СтрокаВывода, 5).Текст = Формат(Строка.Выручка, "ЧДЦ=2");
            Результат.Область(СтрокаВывода, 6).Текст = Формат(Строка.Прибыль, "ЧДЦ=2");
            СтрокаВывода = СтрокаВывода + 1;
        КонецЦикла;
    КонецЦикла;
    Возврат Результат;
КонецФункции
