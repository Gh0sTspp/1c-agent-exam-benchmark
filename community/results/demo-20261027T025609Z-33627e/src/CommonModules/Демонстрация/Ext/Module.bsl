
Функция Элемент(ИмяСправочника, Наименование) Экспорт
    Менеджер = Справочники[ИмяСправочника];
    Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
    Если НЕ Ссылка.Пустая() Тогда Возврат Ссылка; КонецЕсли;
    Объект = Менеджер.СоздатьЭлемент();
    Объект.Наименование = Наименование;
    Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Процедура СтрокаНакладной(Документ, Товар, Количество, Цена, Свойство = Неопределено)
    Строка = Документ.СписокНоменклатуры.Добавить();
    Строка.Номенклатура = Товар;
    Строка.Количество = Количество;
    Строка.Цена = Цена;
    Строка.Сумма = Окр(Количество * Цена, 2);
    Если Свойство <> Неопределено Тогда Строка.Свойство = Свойство; КонецЕсли;
КонецПроцедуры

Процедура Заполнить() Экспорт
    УчетСервер.НастроитьВидыРасчета();
    Цех = Элемент("Подразделения", "Демо основной цех");
    Магазин = Элемент("Подразделения", "Демо магазин");
    Склад = Элемент("Склады", "Демо склад");
    Деталь = Элемент("Номенклатура", "Демо видеокарта");
    Блок = Элемент("Номенклатура", "Демо системный блок");
    Принтер = Элемент("Номенклатура", "Демо принтер");
    Аналог = Элемент("Номенклатура", "Демо принтер аналог");
    Объект = Принтер.ПолучитьОбъект(); Объект.Артикул = "100"; Объект.Записать();
    Объект = Аналог.ПолучитьОбъект(); Объект.Артикул = "200"; Объект.Записать();
    Свойство = Элемент("СвойстваНоменклатуры", "Демо ASUS");
    Объект = Свойство.ПолучитьОбъект(); Объект.Номенклатура = Деталь; Объект.Записать();
    Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Производитель");
    Если Вид.Пустая() Тогда
        Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
        Объект.Наименование = "Производитель"; Объект.ТипЗначения = Новый ОписаниеТипов("Строка");
        Объект.Записать(); Вид = Объект.Ссылка;
    КонецЕсли;
    ЗначениеСвойства = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
    ЗначениеСвойства.Свойство = Свойство; ЗначениеСвойства.Характеристика = Вид; ЗначениеСвойства.Значение = "ASUS"; ЗначениеСвойства.Записать();
    Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
    Политика.Период = Дата(2014, 1, 1); Политика.Подразделение = Цех; Политика.Метод = Перечисления.УчетнаяПолитика.ФИФО; Политика.Записать();
    Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Политика.Период = Дата(2014, 1, 1);
    Политика.Подразделение = Магазин; Политика.Метод = Перечисления.УчетнаяПолитика.Средняя; Политика.Записать();
    Спецификация = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
    Спецификация.Период = Дата(2014, 1, 6); Спецификация.СистемныйБлок = Блок;
    Спецификация.Номенклатура = Деталь; Спецификация.Свойство = Свойство; Спецификация.Количество = 2; Спецификация.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
    Приход.Дата = Дата(2014, 1, 7, 10, 0, 0); Приход.Подразделение = Цех;
    СтрокаНакладной(Приход, Деталь, 10, 1000, Свойство);
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Сборка = Документы.Сборка.СоздатьДокумент();
    Сборка.Дата = Дата(2014, 1, 8, 10, 0, 0); Сборка.ПодразделениеИсточник = Цех; Сборка.ПодразделениеПолучатель = Магазин;
    Строка = Сборка.Блоки.Добавить(); Строка.Номенклатура = Блок; Строка.Количество = 2;
    Строка = Сборка.ДополнительныеДетали.Добавить(); Строка.Номенклатура = Деталь; Строка.Свойство = Свойство; Строка.Количество = 1;
    Сборка.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
    Продажа.Дата = Дата(2014, 1, 9, 10, 0, 0); Продажа.Подразделение = Магазин;
    СтрокаНакладной(Продажа, Блок, 1, 4000);
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Связь.Товар = Принтер; Связь.Аналог = Аналог; Связь.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент(); Приход.Дата = Дата(2014, 1, 10, 10, 0, 0); Приход.Склад = Склад;
    СтрокаНакладной(Приход, Принтер, 2, 500); СтрокаНакладной(Приход, Аналог, 4, 550);
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент(); Продажа.Дата = Дата(2014, 1, 11, 10, 0, 0); Продажа.Склад = Склад;
    СтрокаНакладной(Продажа, Принтер, 3, 800); Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Операция = Документы.Операция.СоздатьДокумент(); Операция.Дата = Дата(2014, 1, 12);
    Строка = Операция.Проводки.Добавить(); Строка.СчетДт = ПланыСчетов.Управленческий.Покупатели;
    Строка.СчетКт = ПланыСчетов.Управленческий.Поставщики; Строка.Сумма = 100;
    Операция.Записать(РежимЗаписиДокумента.Проведение);
    Работник = Элемент("ФизическиеЛица", "Демо сотрудник"); Руководитель = Элемент("ФизическиеЛица", "Демо руководитель");
    Объект = Работник.ПолучитьОбъект(); Объект.НачалоСтажа = Дата(2010, 1, 1); Объект.Записать();
    Объект = Руководитель.ПолучитьОбъект(); Объект.НачалоСтажа = Дата(2008, 1, 1);
    Объект.ДополнительныеСведения.Очистить(); Объект.ДополнительныеСведения.Добавить().ВидСведения = Вид; Объект.Записать();
    Контрагент = Элемент("Контрагенты", "Демо покупатель");
    Объект = Контрагент.ПолучитьОбъект(); Объект.Менеджер = Руководитель; Объект.Записать();
    График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей(); График.Отбор.Подразделение.Установить(Цех);
    День = Дата(2013, 10, 1);
    Пока День <= Дата(2014, 6, 30) Цикл
        Запись = График.Добавить(); Запись.Подразделение = Цех; Запись.Дата = День;
        Запись.Значение = ?(ДеньНедели(День) <= 5, 8, 0); Запись.Дни = ?(Запись.Значение > 0, 1, 0);
        День = День + 86400;
    КонецЦикла; График.Записать();
    Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Ставка.Период = Дата(2013, 1, 1);
    Ставка.Сотрудник = Работник; Ставка.Ставка = 100; Ставка.Записать();
    Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Ставка.Период = Дата(2013, 1, 1);
    Ставка.Сотрудник = Руководитель; Ставка.Ставка = 150; Ставка.Записать();
    Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
    Шкала.СтажОт = 0; Шкала.Процент = 5; Шкала.Записать();
    Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
    Шкала.СтажОт = 1; Шкала.Процент = 10; Шкала.Записать();
    Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
    Шкала.СтажОт = 3; Шкала.Процент = 15; Шкала.Записать();
    Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент(); Начисление.Дата = Дата(2014, 2, 28);
    Для НомерМесяца = 1 По 2 Цикл
        Начало = Дата(2014, НомерМесяца, 1);
        Строка = Начисление.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Работник; Строка.Подразделение = Цех;
        Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад; Строка.ДатаНачала = Начало; Строка.ДатаОкончания = КонецМесяца(Начало);
        Строка = Начисление.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Руководитель; Строка.Подразделение = Цех;
        Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Оклад; Строка.ДатаНачала = Начало; Строка.ДатаОкончания = КонецМесяца(Начало);
    КонецЦикла;
    Начисление.Записать(РежимЗаписиДокумента.Проведение);
    Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент(); Начисление.Дата = Дата(2014, 3, 31);
    Строка = Начисление.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Руководитель; Строка.Подразделение = Цех;
    Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия; Строка.ДатаНачала = Дата(2014, 3, 1); Строка.ДатаОкончания = Дата(2014, 3, 31);
    Строка = Начисление.ОсновныеНачисления.Добавить(); Строка.Сотрудник = Работник; Строка.Подразделение = Цех;
    Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка; Строка.ДатаНачала = Дата(2014, 3, 10); Строка.ДатаОкончания = Дата(2014, 3, 14);
    Начисление.Записать(РежимЗаписиДокумента.Проведение);
    ПримерФормы = ДанныеФормы();
    Объект = ПримерФормы.Контрагент.ПолучитьОбъект();
    Объект.ДополнительныеСведения.Очистить();
    Для Каждого Сведение Из Объект.Менеджер.ДополнительныеСведения Цикл
        Строка = Объект.ДополнительныеСведения.Добавить();
        Строка.ВидСведения = Сведение.ВидСведения;
    КонецЦикла;
    Объект.ДополнительныеСведения[0].Значение = ПримерФормы.Валюта;
    Объект.ДополнительныеСведения[1].Значение = 10;
    Объект.ДополнительныеСведения[2].Значение = ПримерФормы.Регион;
    Объект.Записать();
КонецПроцедуры

Функция ДанныеФормы() Экспорт
    Менеджер = Элемент("ФизическиеЛица", "Демо менеджер формы");
    Контрагент = Элемент("Контрагенты", "Демо контрагент формы");
    Валюта = Элемент("Валюты", "Демо валюта");
    Регион = Элемент("ЗначенияХарактеристик", "Демо Москва");
    Виды = Новый Массив;
    Для Номер = 1 По 3 Цикл
        Имя = ?(Номер = 1, "Валюта кредита", ?(Номер = 2, "Срок кредита, дни", "Регион"));
        Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Имя, Истина);
        Если Вид.Пустая() Тогда
            Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
            Объект.Наименование = Имя;
            Объект.ТипЗначения = Новый ОписаниеТипов(?(Номер = 1, "СправочникСсылка.Валюты",
                ?(Номер = 2, "Число", "СправочникСсылка.ЗначенияХарактеристик")));
            Объект.Записать(); Вид = Объект.Ссылка;
        КонецЕсли;
        Виды.Добавить(Вид);
    КонецЦикла;
    Объект = Менеджер.ПолучитьОбъект();
    Объект.ДополнительныеСведения.Очистить();
    Для Каждого Вид Из Виды Цикл Объект.ДополнительныеСведения.Добавить().ВидСведения = Вид; КонецЦикла;
    Объект.Записать();
    Объект = Контрагент.ПолучитьОбъект(); Объект.Менеджер = Менеджер; Объект.Записать();
    Возврат Новый Структура("Контрагент,Валюта,Регион", Контрагент, Валюта, Регион);
КонецФункции

Функция ПроверитьЗначенияФормы(Контрагент) Экспорт
    Объект = Контрагент.ПолучитьОбъект();
    Если Объект.ДополнительныеСведения.Количество() <> 3 Тогда
        ВызватьИсключение "Не сохранились три дополнительных сведения.";
    КонецЕсли;
    Если Объект.ДополнительныеСведения[1].Значение <> 10 Тогда
        ВызватьИсключение "Не сохранилось числовое значение.";
    КонецЕсли;
    Возврат "PASS: три типизированных поля записаны через управляемую форму.";
КонецФункции
