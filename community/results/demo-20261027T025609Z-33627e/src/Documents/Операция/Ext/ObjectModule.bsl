
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    УчетСервер.Блокировка("РегистрБухгалтерии.Учет");
    УчетСервер.ОчиститьДвижения(ЭтотОбъект);
    Для Каждого Строка Из Проводки Цикл
        УчетСервер.Проводка(ЭтотОбъект, Строка.СчетДт, Строка.СчетКт,
            Строка.НоменклатураДт, Строка.НоменклатураКт, Строка.СкладДт, Строка.СкладКт,
            Строка.КоличествоДт, Строка.КоличествоКт, Строка.Сумма);
    КонецЦикла;
КонецПроцедуры
