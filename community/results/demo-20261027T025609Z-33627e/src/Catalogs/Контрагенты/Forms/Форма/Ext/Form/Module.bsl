&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПостроитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    ПерестроитьПоляНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПерестроитьПоляНаСервере()
    СохранитьЗначения(Объект);
    ПостроитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьЗначения(ОбъектДанных)
    Для Каждого Поле Из ПоляСведений Цикл
        СтрокаЗначения = Неопределено;
        Для Каждого Строка Из ОбъектДанных.ДополнительныеСведения Цикл
            Если Строка.ВидСведения = Поле.ВидСведения Тогда СтрокаЗначения = Строка; Прервать; КонецЕсли;
        КонецЦикла;
        Если СтрокаЗначения = Неопределено Тогда
            СтрокаЗначения = ОбъектДанных.ДополнительныеСведения.Добавить();
            СтрокаЗначения.ВидСведения = Поле.ВидСведения;
        КонецЕсли;
        СтрокаЗначения.Значение = ЭтотОбъект[Поле.Имя];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьПоля()
    Удаляемые = Новый Массив;
    Для Каждого Поле Из ПоляСведений Цикл
        Элемент = Элементы.Найти(Поле.Имя);
        Если Элемент <> Неопределено Тогда Элементы.Удалить(Элемент); КонецЕсли;
        Удаляемые.Добавить(Поле.Имя);
    КонецЦикла;
    ПоляСведений.Очистить();
    Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(, Удаляемые); КонецЕсли;
    Если НЕ ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
    Запрос = Новый Запрос("ВЫБРАТЬ ВидСведения, ВидСведения.Наименование КАК Заголовок,
    | ВидСведения.ТипЗначения КАК ТипЗначения
    |ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка = &Менеджер
    |УПОРЯДОЧИТЬ ПО НомерСтроки");
    Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
    Виды = Запрос.Выполнить().Выгрузить();
    Новые = Новый Массив;
    Номер = 0;
    Для Каждого Вид Из Виды Цикл
        Номер = Номер + 1; Имя = "Сведение" + Формат(Номер, "ЧГ=0");
        Новые.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения, , Вид.Заголовок));
        Поле = ПоляСведений.Добавить(); Поле.Имя = Имя; Поле.ВидСведения = Вид.ВидСведения;
    КонецЦикла;
    Если Новые.Количество() = 0 Тогда Возврат; КонецЕсли;
    ИзменитьРеквизиты(Новые);
    Номер = 0;
    Для Каждого Вид Из Виды Цикл
        Номер = Номер + 1; Имя = "Сведение" + Формат(Номер, "ЧГ=0");
        Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.Сведения);
        Поле.Вид = ВидПоляФормы.ПолеВвода;
        Поле.ПутьКДанным = Имя; Поле.Заголовок = Вид.Заголовок;
        Для Каждого Строка Из Объект.ДополнительныеСведения Цикл
            Если Строка.ВидСведения = Вид.ВидСведения Тогда ЭтотОбъект[Имя] = Строка.Значение; Прервать; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьЗначения(ТекущийОбъект);
КонецПроцедуры
