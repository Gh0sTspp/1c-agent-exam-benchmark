
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
 Движения.Управленческий.Очистить();
 Движения.Управленческий.Записывать = Истина;
 Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, ВидСубконто ИЗ ПланСчетов.Управленческий.ВидыСубконто ГДЕ Ссылка В (&Счета)");
 Счета = Проводки.ВыгрузитьКолонку("СчетДт");
 Для Каждого Счет Из Проводки.ВыгрузитьКолонку("СчетКт") Цикл Счета.Добавить(Счет); КонецЦикла;
 Запрос.УстановитьПараметр("Счета", Счета);
 Аналитика = Запрос.Выполнить().Выгрузить();
 Для Каждого Стр Из Проводки Цикл
  Если Не ЗначениеЗаполнено(Стр.СчетДт) Или Не ЗначениеЗаполнено(Стр.СчетКт) Тогда ВызватьИсключение "Укажите счета проводки"; КонецЕсли;
  Дв = Движения.Управленческий.Добавить();
  ЗаполнитьЗначенияСвойств(Дв, Стр, "СчетДт,СчетКт,КоличествоДт,КоличествоКт,Сумма");
  Дв.Период = Дата;
  Для Каждого Сторона Из Новый Структура("Дт,Кт", Стр.СчетДт, Стр.СчетКт) Цикл
   Виды = Аналитика.НайтиСтроки(Новый Структура("Ссылка", Сторона.Значение));
   Для Каждого Вид Из Виды Цикл
    Если Вид.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Склад Тогда Значение = Стр["Склад" + Сторона.Ключ];
    ИначеЕсли Вид.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Заказано Тогда Значение = Стр["Заказано" + Сторона.Ключ];
    Иначе Значение = Стр["Номенклатура" + Сторона.Ключ]; КонецЕсли;
    Дв["Субконто" + Сторона.Ключ][Вид.ВидСубконто] = Значение;
   КонецЦикла;
  КонецЦикла;
 КонецЦикла;
КонецПроцедуры
