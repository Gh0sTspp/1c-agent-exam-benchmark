
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
 ОбновитьПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
 МенеджерИзмененНаСервере();
КонецПроцедуры

&НаСервере
Процедура МенеджерИзмененНаСервере()
 СохранитьПоляВТаблицу();
 ОбновитьПоля();
КонецПроцедуры

&НаСервере
Процедура СохранитьПоляВТаблицу()
 Для Каждого Поле Из СписокПолей Цикл
  Найдено = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Поле.ВидСведений));
  Если Найдено.Количество() = 0 Тогда
   Стр = Объект.ДополнительныеСведения.Добавить();
   Стр.ВидСведений = Поле.ВидСведений;
  Иначе Стр = Найдено[0]; КонецЕсли;
  Стр.Значение = ЭтотОбъект[Поле.Имя];
 КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоля()
 Удаляемые = Новый Массив;
 Для Каждого Поле Из СписокПолей Цикл
  Элементы.Удалить(Элементы.Найти(Поле.Имя));
  Удаляемые.Добавить(Поле.Имя);
 КонецЦикла;
 СписокПолей.Очистить();
 Если Удаляемые.Количество() > 0 Тогда ИзменитьРеквизиты(Новый Массив, Удаляемые); КонецЕсли;
 Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда Возврат; КонецЕсли;
 Запрос = Новый Запрос(
 "ВЫБРАТЬ С.ВидСведений, С.ВидСведений.Наименование КАК Заголовок,
 | С.ВидСведений.ТипЗначения КАК ТипЗначения
 |ИЗ (ВЫБРАТЬ РАЗЛИЧНЫЕ ВидСведений
 | ИЗ Справочник.Сотрудники.ДополнительныеСведения ГДЕ Ссылка = &Менеджер) КАК С");
 Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
 Виды = Запрос.Выполнить().Выгрузить();
 НовыеРеквизиты = Новый Массив;
 Индекс = 0;
 Для Каждого Вид Из Виды Цикл
  Индекс = Индекс + 1;
  Имя = "ДопСведение" + Формат(Индекс, "ЧГ=0");
  НовыеРеквизиты.Добавить(Новый РеквизитФормы(Имя, Вид.ТипЗначения, , Вид.Заголовок));
  Стр = СписокПолей.Добавить();
  Стр.Имя = Имя; Стр.ВидСведений = Вид.ВидСведений;
 КонецЦикла;
 Если НовыеРеквизиты.Количество() > 0 Тогда ИзменитьРеквизиты(НовыеРеквизиты); КонецЕсли;
 Для Индекс = 0 По Виды.Количество() - 1 Цикл
  Вид = Виды[Индекс];
  Имя = СписокПолей[Индекс].Имя;
  Поле = Элементы.Добавить(Имя, Тип("ПолеФормы"), Элементы.ДополнительныеПоля);
  Поле.Вид = ВидПоляФормы.ПолеВвода;
  Поле.ПутьКДанным = Имя;
  Поле.Заголовок = Вид.Заголовок;
  Найдено = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведений", Вид.ВидСведений));
  Если Найдено.Количество() > 0 Тогда ЭтотОбъект[Имя] = Найдено[0].Значение; КонецЕсли;
 КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
 Для Каждого Поле Из СписокПолей Цикл
  Стр = ТекущийОбъект.ДополнительныеСведения.Найти(Поле.ВидСведений, "ВидСведений");
  Если Стр = Неопределено Тогда
   Стр = ТекущийОбъект.ДополнительныеСведения.Добавить();
   Стр.ВидСведений = Поле.ВидСведений;
  КонецЕсли;
  Стр.Значение = ЭтотОбъект[Поле.Имя];
 КонецЦикла;
КонецПроцедуры
