
Функция СуммаСтроки(Стр) Экспорт
 Если Стр.Сумма <> 0 Тогда Возврат Стр.Сумма; КонецЕсли;
 Возврат Окр(Стр.Количество * Стр.Цена, 2);
КонецФункции

Процедура ПроверитьСтроки(Таблица) Экспорт
 Для Каждого Стр Из Таблица Цикл
  Если Не ЗначениеЗаполнено(Стр.Номенклатура) Или Стр.Количество <= 0 Тогда
   ВызватьИсключение "Не заполнена номенклатура или количество не положительно, строка " + Стр.НомерСтроки;
  КонецЕсли;
 КонецЦикла;
КонецПроцедуры

Процедура ЗаблокироватьРегистр(Имя) Экспорт
 Блокировка = Новый БлокировкаДанных;
 Элемент = Блокировка.Добавить(Имя);
 Элемент.Режим = РежимБлокировкиДанных.Исключительный;
 Блокировка.Заблокировать();
КонецПроцедуры

Процедура Приход(Док, Отказ) Экспорт
 Док.Движения.ОстаткиНоменклатуры.Очистить();
 Док.Движения.Управленческий.Очистить();
 ПроверитьСтроки(Док.СписокНоменклатуры);
 ОУ = Док.ОперативныйУчет Или ЗначениеЗаполнено(Док.Подразделение);
 БУ = Док.БухгалтерскийУчет Или ЗначениеЗаполнено(Док.Склад);
 Если Не ОУ И Не БУ Тогда ВызватьИсключение "Укажите подразделение или склад"; КонецЕсли;
 Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
 Док.Движения.Управленческий.Записывать = Истина;
 Для Каждого Стр Из Док.СписокНоменклатуры Цикл
  Сумма = СуммаСтроки(Стр);
  Если Сумма < 0 Тогда ВызватьИсключение "Отрицательная сумма прихода"; КонецЕсли;
  Если ОУ Тогда
   Если Не ЗначениеЗаполнено(Док.Подразделение) Тогда ВызватьИсключение "Не заполнено подразделение"; КонецЕсли;
   Дв = Док.Движения.ОстаткиНоменклатуры.Добавить();
   Дв.Период = Док.Дата;
   Дв.ВидДвижения = ВидДвиженияНакопления.Приход;
   Дв.Подразделение = Док.Подразделение;
   Дв.Номенклатура = Стр.Номенклатура;
   Дв.Свойство = Стр.Свойство;
   Дв.Партия = Док.Ссылка;
   Дв.Количество = Стр.Количество;
   Дв.Стоимость = Сумма;
  КонецЕсли;
  Если БУ Тогда
   Если Не ЗначениеЗаполнено(Док.Склад) Тогда ВызватьИсключение "Не заполнен склад"; КонецЕсли;
   Дв = Док.Движения.Управленческий.Добавить();
   Дв.Период = Док.Дата;
   Дв.СчетДт = ПланыСчетов.Управленческий.Товары;
   Дв.СчетКт = ПланыСчетов.Управленческий.Поставщики;
   Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Стр.Номенклатура;
   Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Док.Склад;
   Дв.КоличествоДт = Стр.Количество;
   Дв.Сумма = Сумма;
  КонецЕсли;
 КонецЦикла;
КонецПроцедуры

Функция ОстаткиОУ(Док, Подразделения, Товары) Экспорт
 Запрос = Новый Запрос(
 "ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
 | КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
 |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Граница,
 | Подразделение В (&Подразделения) И Номенклатура В (&Товары))
 |ГДЕ КоличествоОстаток > 0
 |УПОРЯДОЧИТЬ ПО Партия.Дата, Партия");
 Запрос.УстановитьПараметр("Граница", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая));
 Запрос.УстановитьПараметр("Подразделения", Подразделения);
 Запрос.УстановитьПараметр("Товары", Товары);
 Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Функция СписатьОУ(Док, Остатки, Подразделение, Товар, Свойство, Количество, Метод) Экспорт
 Кандидаты = Остатки.НайтиСтроки(Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство));
 Партии = Новый Массив;
 Доступно = 0; СтоимостьОстатка = 0;
 Для Каждого Партия Из Кандидаты Цикл
  Если Партия.Количество > 0 Тогда
   Партии.Добавить(Партия);
   Доступно = Доступно + Партия.Количество;
   СтоимостьОстатка = СтоимостьОстатка + Партия.Стоимость;
  КонецЕсли;
 КонецЦикла;
 Если Доступно < Количество Тогда
  ВызватьИсключение "Недостаточно " + Строка(Товар) + ", свойство " + Строка(Свойство)
   + ", подразделение " + Строка(Подразделение) + ". Требуется " + Количество + ", доступно " + Доступно;
 КонецЕсли;
 Осталось = Количество;
 Стоимость = 0;
 ЦелеваяСтоимость = Окр(СтоимостьОстатка * Количество / Доступно, 2);
 Для Индекс = 0 По Партии.Количество() - 1 Цикл
  Номер = Индекс;
  Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда Номер = Партии.Количество() - 1 - Индекс; КонецЕсли;
  Партия = Партии[Номер];
  Если Партия.Количество <= 0 Тогда Продолжить; КонецЕсли;
  Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
   Если Индекс = Партии.Количество() - 1 Тогда Списано = Осталось;
   Иначе Списано = Мин(Партия.Количество, Окр(Количество * Партия.Количество / Доступно, 3), Осталось); КонецЕсли;
  Иначе Списано = Мин(Осталось, Партия.Количество); КонецЕсли;
  Если Списано <= 0 Тогда Продолжить; КонецЕсли;
  Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
   Если Индекс = Партии.Количество() - 1 Тогда Сумма = ЦелеваяСтоимость - Стоимость;
   Иначе Сумма = Окр(Партия.Стоимость * Количество / Доступно, 2); КонецЕсли;
  ИначеЕсли Списано = Партия.Количество Тогда Сумма = Партия.Стоимость;
  Иначе Сумма = Окр(Партия.Стоимость * Списано / Партия.Количество, 2); КонецЕсли;
  Дв = Док.Движения.ОстаткиНоменклатуры.Добавить();
  Дв.Период = Док.Дата;
  Дв.ВидДвижения = ВидДвиженияНакопления.Расход;
  ЗаполнитьЗначенияСвойств(Дв, Партия, "Подразделение,Номенклатура,Свойство,Партия");
  Дв.Количество = Списано;
  Дв.Стоимость = Сумма;
  Партия.Количество = Партия.Количество - Списано;
  Партия.Стоимость = Партия.Стоимость - Сумма;
  Осталось = Осталось - Списано;
  Стоимость = Стоимость + Сумма;
  Если Осталось = 0 Тогда Прервать; КонецЕсли;
 КонецЦикла;
 Если Осталось <> 0 Тогда ВызватьИсключение "Ошибка распределения количества по партиям"; КонецЕсли;
 Возврат Стоимость;
КонецФункции

Процедура Продажа(Док, Отказ) Экспорт
 Док.Движения.ОстаткиНоменклатуры.Очистить();
 Док.Движения.Продажи.Очистить();
 Док.Движения.Управленческий.Очистить();
 ПроверитьСтроки(Док.СписокНоменклатуры);
 ОУ = Док.ОперативныйУчет;
 Для Каждого Стр Из Док.СписокНоменклатуры Цикл ОУ = ОУ Или ЗначениеЗаполнено(Стр.Подразделение); КонецЦикла;
 БУ = Док.БухгалтерскийУчет Или ЗначениеЗаполнено(Док.Склад);
 Если Не ОУ И Не БУ Тогда ВызватьИсключение "Укажите подразделения или склад"; КонецЕсли;
 Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
 Док.Движения.Продажи.Записывать = Истина;
 Док.Движения.Управленческий.Записывать = Истина;
 Если ОУ Тогда
  ЗаблокироватьРегистр("РегистрНакопления.ОстаткиНоменклатуры");
  Док.Движения.ОстаткиНоменклатуры.Записать();
  Подразделения = Док.СписокНоменклатуры.ВыгрузитьКолонку("Подразделение");
  Товары = Док.СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура");
  Остатки = ОстаткиОУ(Док, Подразделения, Товары);
  Запрос = Новый Запрос("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))");
  Запрос.УстановитьПараметр("Дата", Док.Дата);
  Запрос.УстановитьПараметр("Подразделения", Подразделения);
  Политики = Запрос.Выполнить().Выгрузить();
  Для Каждого Стр Из Док.СписокНоменклатуры Цикл
   Политика = Политики.Найти(Стр.Подразделение, "Подразделение");
   Если Политика = Неопределено Тогда ВызватьИсключение "Не задана учетная политика подразделения " + Стр.Подразделение; КонецЕсли;
   Стоимость = СписатьОУ(Док, Остатки, Стр.Подразделение, Стр.Номенклатура, Стр.Свойство, Стр.Количество, Политика.Метод);
   Дв = Док.Движения.Продажи.Добавить();
   Дв.Период = Док.Дата;
   ЗаполнитьЗначенияСвойств(Дв, Стр, "Номенклатура,Подразделение,Количество");
   Дв.Себестоимость = Стоимость;
   Дв.Выручка = СуммаСтроки(Стр);
  КонецЦикла;
 КонецЕсли;
 Если БУ Тогда ПродажаБУ(Док); КонецЕсли;
КонецПроцедуры

Процедура Сборка(Док, Отказ) Экспорт
 Док.Движения.ОстаткиНоменклатуры.Очистить();
 ПроверитьСтроки(Док.СистемныеБлоки);
 ПроверитьСтроки(Док.ДополнительныеДетали);
 Если Док.СистемныеБлоки.Количество() = 0 Тогда ВызватьИсключение "Нет выпускаемых системных блоков"; КонецЕсли;
 Если Не ЗначениеЗаполнено(Док.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(Док.ПодразделениеПолучатель) Тогда
  ВызватьИсключение "Укажите оба подразделения сборки";
 КонецЕсли;
 ЗаблокироватьРегистр("РегистрНакопления.ОстаткиНоменклатуры");
 Док.Движения.ОстаткиНоменклатуры.Записывать = Истина;
 Док.Движения.ОстаткиНоменклатуры.Записать();
 Запрос = Новый Запрос(
 "ВЫБРАТЬ С.СистемныйБлок, С.Деталь КАК Номенклатура, С.Свойство, С.Количество
 |ИЗ РегистрСведений.Спецификации КАК С
 | ВНУТРЕННЕЕ СОЕДИНЕНИЕ
 | (ВЫБРАТЬ СистемныйБлок, МАКСИМУМ(Период) КАК Период
 | ИЗ РегистрСведений.Спецификации
 | ГДЕ Период <= &Дата И СистемныйБлок В (&Блоки)
 | СГРУППИРОВАТЬ ПО СистемныйБлок) КАК Версии
 | ПО С.СистемныйБлок = Версии.СистемныйБлок И С.Период = Версии.Период");
 Запрос.УстановитьПараметр("Дата", Док.Дата);
 Запрос.УстановитьПараметр("Блоки", Док.СистемныеБлоки.ВыгрузитьКолонку("Номенклатура"));
 Состав = Запрос.Выполнить().Выгрузить();
 Потребности = Состав.СкопироватьКолонки("СистемныйБлок,Номенклатура,Свойство,Количество");
 ВсегоВыпуск = Док.СистемныеБлоки.Итог("Количество");
 Для Каждого Блок Из Док.СистемныеБлоки Цикл
  Детали = Состав.НайтиСтроки(Новый Структура("СистемныйБлок", Блок.Номенклатура));
  Если Детали.Количество() = 0 Тогда ВызватьИсключение "Нет спецификации для " + Блок.Номенклатура; КонецЕсли;
  Для Каждого Деталь Из Детали Цикл
   Новая = Потребности.Добавить();
   ЗаполнитьЗначенияСвойств(Новая, Деталь);
   Новая.Количество = Деталь.Количество * Блок.Количество;
  КонецЦикла;
 КонецЦикла;
 Для Каждого Деталь Из Док.ДополнительныеДетали Цикл
  Новая = Потребности.Добавить();
  ЗаполнитьЗначенияСвойств(Новая, Деталь, "Номенклатура,Свойство,Количество");
 КонецЦикла;
 Подразделения = Новый Массив;
 Подразделения.Добавить(Док.ПодразделениеИсточник);
 Остатки = ОстаткиОУ(Док, Подразделения, Потребности.ВыгрузитьКолонку("Номенклатура"));
 Стоимости = Новый Соответствие;
 ДопСтоимость = 0;
 Для Каждого Деталь Из Потребности Цикл
  Стоимость = СписатьОУ(Док, Остатки, Док.ПодразделениеИсточник, Деталь.Номенклатура, Деталь.Свойство, Деталь.Количество, Перечисления.УчетнаяПолитика.ПоСредней);
  Если ЗначениеЗаполнено(Деталь.СистемныйБлок) Тогда
   Старая = Стоимости.Получить(Деталь.СистемныйБлок);
   Если Старая = Неопределено Тогда Старая = 0; КонецЕсли;
   Стоимости.Вставить(Деталь.СистемныйБлок, Старая + Стоимость);
  Иначе ДопСтоимость = ДопСтоимость + Стоимость; КонецЕсли;
 КонецЦикла;
 Блоки = Док.СистемныеБлоки.Выгрузить();
 Блоки.Свернуть("Номенклатура", "Количество");
 ОстДоп = ДопСтоимость;
 Для Индекс = 0 По Блоки.Количество() - 1 Цикл
  Блок = Блоки[Индекс];
  Если Индекс = Блоки.Количество() - 1 Тогда Доля = ОстДоп;
  Иначе Доля = Окр(ДопСтоимость * Блок.Количество / ВсегоВыпуск, 2); КонецЕсли;
  ОстДоп = ОстДоп - Доля;
  Дв = Док.Движения.ОстаткиНоменклатуры.Добавить();
  Дв.Период = Док.Дата;
  Дв.ВидДвижения = ВидДвиженияНакопления.Приход;
  Дв.Подразделение = Док.ПодразделениеПолучатель;
  Дв.Номенклатура = Блок.Номенклатура;
  Дв.Партия = Док.Ссылка;
  Дв.Количество = Блок.Количество;
  Дв.Стоимость = Стоимости.Получить(Блок.Номенклатура) + Доля;
 КонецЦикла;
КонецПроцедуры

Функция ГруппаАналогов(Товар, Связи)
 Группа = Новый Массив;
 Группа.Добавить(Товар);
 Индекс = 0;
 Пока Индекс < Группа.Количество() Цикл
  Текущий = Группа[Индекс];
  Для Каждого Связь Из Связи Цикл
   Если Связь.Товар = Текущий И Группа.Найти(Связь.Аналог) = Неопределено Тогда Группа.Добавить(Связь.Аналог); КонецЕсли;
   Если Связь.Аналог = Текущий И Группа.Найти(Связь.Товар) = Неопределено Тогда Группа.Добавить(Связь.Товар); КонецЕсли;
  КонецЦикла;
  Индекс = Индекс + 1;
 КонецЦикла;
 Возврат Группа;
КонецФункции

Процедура ПродажаБУ(Док)
 ЗаблокироватьРегистр("РегистрБухгалтерии.Управленческий");
 Док.Движения.Управленческий.Записать();
 Запрос = Новый Запрос("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги");
 Связи = Запрос.Выполнить().Выгрузить();
 ВсеТовары = Новый Массив;
 Группы = Новый Соответствие;
 Для Каждого Стр Из Док.СписокНоменклатуры Цикл
  Группа = ГруппаАналогов(Стр.Номенклатура, Связи);
  Группы.Вставить(Стр.Номенклатура, Группа);
  Для Каждого Товар Из Группа Цикл
   Если ВсеТовары.Найти(Товар) = Неопределено Тогда ВсеТовары.Добавить(Товар); КонецЕсли;
  КонецЦикла;
 КонецЦикла;
 Запрос = Новый Запрос(
 "ВЫБРАТЬ Субконто1 КАК Номенклатура, Субконто2 КАК Склад, КоличествоОстаток КАК Количество
 |ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Граница, Счет = &Счет, , Субконто1 В (&Товары) И Субконто2 = &Склад)");
 Запрос.УстановитьПараметр("Граница", Новый Граница(Док.МоментВремени(), ВидГраницы.Исключая));
 Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
 Запрос.УстановитьПараметр("Товары", ВсеТовары);
 Запрос.УстановитьПараметр("Склад", Док.Склад);
 Остатки = Запрос.Выполнить().Выгрузить();
 Средние = Новый Соответствие;
 Запрос.Текст = "ВЫБРАТЬ Субконто1 КАК Номенклатура, КоличествоОстаток КАК Количество, СуммаОстаток КАК Стоимость ИЗ РегистрБухгалтерии.Управленческий.Остатки(&Граница, Счет = &Счет, , Субконто1 В (&Товары))";
 Итоги = Запрос.Выполнить().Выгрузить();
 Для Каждого Итог Из Итоги Цикл
  Если Итог.Количество > 0 Тогда Средние.Вставить(Итог.Номенклатура, Итог.Стоимость / Итог.Количество); КонецЕсли;
 КонецЦикла;
 Запрос = Новый Запрос("ВЫБРАТЬ Ссылка, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Товары) УПОРЯДОЧИТЬ ПО Артикул, Ссылка");
 Запрос.УстановитьПараметр("Товары", ВсеТовары);
 Порядок = Запрос.Выполнить().Выгрузить();
 Для Каждого Стр Из Док.СписокНоменклатуры Цикл
  Кандидаты = Новый Массив;
  Кандидаты.Добавить(Стр.Номенклатура);
  Группа = Группы.Получить(Стр.Номенклатура);
  Для Каждого Позиция Из Порядок Цикл
   Если Позиция.Ссылка <> Стр.Номенклатура И Группа.Найти(Позиция.Ссылка) <> Неопределено Тогда Кандидаты.Добавить(Позиция.Ссылка); КонецЕсли;
  КонецЦикла;
  Осталось = Стр.Количество;
  ОстВыручка = СуммаСтроки(Стр);
  Для Каждого Товар Из Кандидаты Цикл
   СтрокиОстатков = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Товар, Док.Склад));
   Для Каждого Остаток Из СтрокиОстатков Цикл
    Если Остаток.Количество <= 0 Тогда Продолжить; КонецЕсли;
    Количество = Мин(Осталось, Остаток.Количество);
    Если Количество <= 0 Тогда Прервать; КонецЕсли;
    Итог = Итоги.Найти(Товар, "Номенклатура");
    Если Количество = Итог.Количество Тогда Стоимость = Итог.Стоимость;
    Иначе Стоимость = Окр(Количество * Средние.Получить(Товар), 2); КонецЕсли;
    Если Количество = Осталось Тогда Выручка = ОстВыручка;
    Иначе Выручка = Окр(СуммаСтроки(Стр) * Количество / Стр.Количество, 2); КонецЕсли;
    Дв = Док.Движения.Управленческий.Добавить();
    Дв.Период = Док.Дата;
    Дв.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
    Дв.СчетКт = ПланыСчетов.Управленческий.Товары;
    Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Товар;
    Дв.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Заказано] = Стр.Номенклатура;
    Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = Товар;
    Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Склад] = Док.Склад;
    Дв.КоличествоКт = Количество;
    Дв.КоличествоДт = Количество;
    Дв.Сумма = Стоимость;
    Дв = Док.Движения.Управленческий.Добавить();
    Дв.Период = Док.Дата;
    Дв.СчетДт = ПланыСчетов.Управленческий.Покупатели;
    Дв.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
    Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Продано] = Товар;
    Дв.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Заказано] = Стр.Номенклатура;
    Дв.Сумма = Выручка;
    Остаток.Количество = Остаток.Количество - Количество;
    Итог.Количество = Итог.Количество - Количество;
    Итог.Стоимость = Итог.Стоимость - Стоимость;
    Осталось = Осталось - Количество;
    ОстВыручка = ОстВыручка - Выручка;
    Если Осталось = 0 Тогда Прервать; КонецЕсли;
   КонецЦикла;
   Если Осталось = 0 Тогда Прервать; КонецЕсли;
  КонецЦикла;
  Если Осталось > 0 Тогда ВызватьИсключение "Недостаточно товара и аналогов на складе: " + Стр.Номенклатура + ", не хватает " + Осталось; КонецЕсли;
 КонецЦикла;
КонецПроцедуры


Функция ПечатнаяФорма(Таблица, Заголовок) Экспорт
 Док = Новый ТабличныйДокумент;
 Док.АвтоМасштаб = Истина;
 Если Таблица.Колонки.Найти("НачКоличество") <> Неопределено Тогда
  Док.Область(1,1).Текст = "Ведомость по подразделению";
  Заголовки = Новый Массив;
  Заголовки.Добавить("Характеристика"); Заголовки.Добавить("Товар");
  Заголовки.Добавить("Нач. ост."); Заголовки.Добавить("Приход"); Заголовки.Добавить("Расход"); Заголовки.Добавить("Кон. ост.");
  Для Индекс = 0 По Заголовки.Количество() - 1 Цикл Док.Область(3,Индекс+1).Текст = Заголовки[Индекс]; КонецЦикла;
  Таблица.Сортировать("Характеристика,Номенклатура");
  Номер = 4; Предыдущая = Неопределено;
  Для Каждого Стр Из Таблица Цикл
   Если Предыдущая <> Стр.Характеристика Тогда
    Док.Область(Номер,1).Текст = Строка(Стр.Характеристика); Номер = Номер + 1; Предыдущая = Стр.Характеристика;
   КонецЕсли;
   Док.Область(Номер,2).Текст = Строка(Стр.Номенклатура);
   Док.Область(Номер,3).Текст = Строка(Стр.НачКоличество);
   Док.Область(Номер,4).Текст = Строка(Стр.ПриходКоличество);
   Док.Область(Номер,5).Текст = Строка(Стр.РасходКоличество);
   Док.Область(Номер,6).Текст = Строка(Стр.КонКоличество); Номер = Номер + 1;
   Док.Область(Номер,3).Текст = Формат(Стр.НачОстаток,"ЧДЦ=2");
   Док.Область(Номер,4).Текст = Формат(Стр.Приход,"ЧДЦ=2");
   Док.Область(Номер,5).Текст = Формат(Стр.Расход,"ЧДЦ=2");
   Док.Область(Номер,6).Текст = Формат(Стр.КонОстаток,"ЧДЦ=2"); Номер = Номер + 1;
  КонецЦикла;
 ИначеЕсли Таблица.Колонки.Найти("Продано") <> Неопределено Тогда
  Док.Область(1,1).Текст = "Продажи товаров и аналогов";
  Заголовки = Новый Массив;
  Заголовки.Добавить("Номенклатура"); Заголовки.Добавить("Продано"); Заголовки.Добавить("Кол-во");
  Заголовки.Добавить("Себестоимость"); Заголовки.Добавить("Продажа"); Заголовки.Добавить("Прибыль");
  Для Индекс = 0 По Заголовки.Количество() - 1 Цикл Док.Область(3,Индекс+1).Текст = Заголовки[Индекс]; КонецЦикла;
  Таблица.Сортировать("Номенклатура,Продано");
  Итоги = Таблица.Скопировать(); Итоги.Свернуть("Номенклатура","Количество,Себестоимость,Выручка,Прибыль");
  Номер = 4; Предыдущая = Неопределено;
  Для Каждого Стр Из Таблица Цикл
   Если Предыдущая <> Стр.Номенклатура Тогда
    Итог = Итоги.Найти(Стр.Номенклатура,"Номенклатура");
    Док.Область(Номер,1).Текст = Строка(Стр.Номенклатура);
    Док.Область(Номер,3).Текст = Строка(Итог.Количество);
    Док.Область(Номер,4).Текст = Формат(Итог.Себестоимость,"ЧДЦ=2");
    Док.Область(Номер,5).Текст = Формат(Итог.Выручка,"ЧДЦ=2");
    Док.Область(Номер,6).Текст = Формат(Итог.Прибыль,"ЧДЦ=2");
    Номер = Номер + 1; Предыдущая = Стр.Номенклатура;
   КонецЕсли;
   Док.Область(Номер,2).Текст = Строка(Стр.Продано);
   Док.Область(Номер,3).Текст = Строка(Стр.Количество);
   Док.Область(Номер,4).Текст = Формат(Стр.Себестоимость,"ЧДЦ=2");
   Док.Область(Номер,5).Текст = Формат(Стр.Выручка,"ЧДЦ=2");
   Док.Область(Номер,6).Текст = Формат(Стр.Прибыль,"ЧДЦ=2");
   Номер = Номер + 1;
  КонецЦикла;
 Иначе
  Если Таблица.Колонки.Найти("СуммаПремии") <> Неопределено Тогда Док.Область(1,1).Текст = "Премии за месяц";
  Иначе Док.Область(1,1).Текст = "Продажи"; КонецЕсли;
  Имена = Новый Соответствие;
  Имена.Вставить("Номенклатура","Номенклатура"); Имена.Вставить("Количество","Кол-во");
  Имена.Вставить("Себестоимость","Себестоимость"); Имена.Вставить("Выручка","Продажа"); Имена.Вставить("Прибыль","Прибыль");
  Имена.Вставить("Сотрудник","Сотрудник"); Имена.Вставить("Стаж","Трудовой стаж"); Имена.Вставить("Процент","% премии"); Имена.Вставить("СуммаПремии","Сумма премии");
  Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл
   Док.Область(3,Индекс + 1).Текст = Имена.Получить(Таблица.Колонки[Индекс].Имя);
  КонецЦикла;
  Номер = 4;
  Для Каждого Стр Из Таблица Цикл
   Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл Док.Область(Номер,Индекс+1).Текст = Строка(Стр[Индекс]); КонецЦикла;
   Номер = Номер + 1;
  КонецЦикла;
  Док.Область(Номер,1).Текст = "Итого:";
  Для Индекс = 0 По Таблица.Колонки.Количество() - 1 Цикл
   Колонка = Таблица.Колонки[Индекс];
   Если Колонка.ТипЗначения.СодержитТип(Тип("Число")) И Колонка.Имя <> "Стаж" И Колонка.Имя <> "Процент" Тогда
    Док.Область(Номер,Индекс+1).Текст = Строка(Таблица.Итог(Колонка.Имя));
   КонецЕсли;
  КонецЦикла;
 КонецЕсли;
 Док.Область(2,1).Текст = Заголовок;
 Док.Область(1,1,Номер,1).ШиринаКолонки = 28;
 Док.Область(1,2,Номер,2).ШиринаКолонки = 28;
 Возврат Док;
КонецФункции
