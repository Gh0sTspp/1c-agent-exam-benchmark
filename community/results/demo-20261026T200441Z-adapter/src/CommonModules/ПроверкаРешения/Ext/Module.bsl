Функция ВыполнитьДемонстрацию() Экспорт
 Попытка
  ДемонстрационныеДанные.Заполнить();
  Возврат "DEMO_OK";
 Исключение
  Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
 КонецПопытки;
КонецФункции

Функция ПроверитьОтчет(Имя) Экспорт
 Возврат ДемонстрационныеДанные.ReportDiagnostics(Имя);
КонецФункции


Процедура Утверждение(Условие, Текст)
 Если Не Условие Тогда ВызватьИсключение Текст; КонецЕсли;
КонецПроцедуры

Функция НовыйЭлемент(Имя, Наименование)
 Объект = Справочники[Имя].СоздатьЭлемент();
 Объект.Наименование = Наименование; Объект.Записать();
 Возврат Объект.Ссылка;
КонецФункции

Процедура ТоварнаяСтрока(Док, Товар, Количество, Сумма, Подразделение = Неопределено)
 Стр = Док.СписокНоменклатуры.Добавить();
 Стр.Номенклатура = Товар; Стр.Количество = Количество; Стр.Сумма = Сумма;
 Если Подразделение <> Неопределено Тогда Стр.Подразделение = Подразделение; КонецЕсли;
КонецПроцедуры

Функция ПроверитьБУ() Экспорт
 НачатьТранзакцию();
 Попытка
  Склад1 = НовыйЭлемент("Склады", "Проверка БУ 1");
  Склад2 = НовыйЭлемент("Склады", "Проверка БУ 2");
  А = НовыйЭлемент("Номенклатура", "Проверка А");
  Б = НовыйЭлемент("Номенклатура", "Проверка Б");
  В = НовыйЭлемент("Номенклатура", "Проверка В");
  Объект = Б.ПолучитьОбъект(); Объект.Артикул = "001"; Объект.Записать();
  Объект = В.ПолучитьОбъект(); Объект.Артикул = "002"; Объект.Записать();
  Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Связь.Товар = А; Связь.Аналог = Б; Связь.Записать();
  Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Связь.Товар = Б; Связь.Аналог = В; Связь.Записать();
  Док = Документы.Операция.СоздатьДокумент(); Док.Дата = Дата(2015,1,1);
  Стр = Док.Проводки.Добавить(); Стр.СчетДт = ПланыСчетов.Управленческий.Товары;
  Стр.СчетКт = ПланыСчетов.Управленческий.Поставщики; Стр.НоменклатураДт = А;
  Стр.СкладДт = Склад1; Стр.КоличествоДт = 1; Стр.Сумма = 100; Док.Записать(РежимЗаписиДокумента.Проведение);
  Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2015,1,2); Док.Склад = Склад1;
  ТоварнаяСтрока(Док, Б, 2, 200); ТоварнаяСтрока(Док, В, 2, 600); Док.Записать(РежимЗаписиДокумента.Проведение);
  Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2015,1,3); Док.Склад = Склад2;
  ТоварнаяСтрока(Док, Б, 2, 600); Док.Записать(РежимЗаписиДокумента.Проведение);
  Док = Документы.РасходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2015,1,4); Док.Склад = Склад1;
  ТоварнаяСтрока(Док, А, 2, 1000); ТоварнаяСтрока(Док, А, 2, 1000);
  Док.Записать(РежимЗаписиДокумента.Проведение); Док.Записать(РежимЗаписиДокумента.Проведение);
  Отчет = Отчеты.ПродажиТоваровИАналогов.Создать();
  Таблица = Отчет.Данные(Дата(2015,1,1), Дата(2015,1,31));
  Строки = Таблица.НайтиСтроки(Новый Структура("Номенклатура", А));
  Стоимость = 0; Выручка = 0; Количество = 0;
  Для Каждого Стр Из Строки Цикл Стоимость = Стоимость + Стр.Себестоимость; Выручка = Выручка + Стр.Выручка; Количество = Количество + Стр.Количество; КонецЦикла;
  Утверждение(Стоимость = 800, "Средняя себестоимость и транзитивные аналоги: ожидалось 800, получено " + Стоимость);
  Утверждение(Выручка = 2000 И Количество = 4, "Выручка, дубли строк или повторное проведение");
  ОтменитьТранзакцию();
  Возврат "BU_OK: транзитивные аналоги, артикулы, два склада, средняя стоимость, ручная операция, дубли строк, повторное проведение";
 Исключение
  Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); ОтменитьТранзакцию(); Возврат Текст;
 КонецПопытки;
КонецФункции

Функция ПроверитьОУ(Метод) Экспорт
 НачатьТранзакцию();
 Попытка
  Цех = НовыйЭлемент("Подразделения", "Проверка ОУ");
  Товар = НовыйЭлемент("Номенклатура", "Проверка ОУ");
  Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Политика.Период = Дата(2015,1,1); Политика.Подразделение = Цех;
  Политика.Метод = Перечисления.УчетнаяПолитика[Метод]; Политика.Записать();
  Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2015,1,1); Док.Подразделение = Цех;
  ТоварнаяСтрока(Док, Товар, 1, 100); Док.Записать(РежимЗаписиДокумента.Проведение);
  Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2015,1,2); Док.Подразделение = Цех;
  ТоварнаяСтрока(Док, Товар, 2, 500); Док.Записать(РежимЗаписиДокумента.Проведение);
  Док = Документы.РасходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2015,1,3);
  ТоварнаяСтрока(Док, Товар, 1, 1000, Цех); ТоварнаяСтрока(Док, Товар, 1, 1000, Цех);
  Док.Записать(РежимЗаписиДокумента.Проведение); Док.Записать(РежимЗаписиДокумента.Проведение);
  Отчет = Отчеты.ПродажиОперативные.Создать(); Таблица = Отчет.Данные(Дата(2015,1,1), Дата(2015,1,31));
  Стр = Таблица.Найти(Товар, "Номенклатура");
  Ожидание = 400; Если Метод = "ФИФО" Тогда Ожидание = 350; ИначеЕсли Метод = "ЛИФО" Тогда Ожидание = 500; КонецЕсли;
  Утверждение(Стр.Себестоимость = Ожидание, "Метод " + Метод + ": ожидалось " + Ожидание + ", получено " + Стр.Себестоимость);
  Док.Записать(РежимЗаписиДокумента.ОтменаПроведения);
  Ведомость = Отчеты.ВедомостьПоПодразделению.Создать(); Таблица = Ведомость.Данные(Дата(2015,1,1), Дата(2015,1,31), Цех);
  Утверждение(Таблица.Итог("КонКоличество") = 3 И Таблица.Итог("КонОстаток") = 600, "Отмена продажи не восстановила остаток");
  ОтменитьТранзакцию();
  Возврат "OU_OK " + Метод + ": себестоимость, дубли, повторное проведение, отмена";
 Исключение
  Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); ОтменитьТранзакцию(); Возврат Текст;
 КонецПопытки;
КонецФункции

Функция ПроверитьЗарплату() Экспорт
 НачатьТранзакцию();
 Попытка
  Командировка = Документы.НачислениеЗарплаты.НайтиПоНомеру("ДМО-КМ1", Дата(2014,4,1)).ПолучитьОбъект();
  Командировка.Записать(РежимЗаписиДокумента.ОтменаПроведения);
  Руководитель = Справочники.Сотрудники.НайтиПоНаименованию("Демо: руководитель", Истина);
  Запрос = Новый Запрос("ВЫБРАТЬ СУММА(Результат) КАК Результат ИЗ РегистрРасчета.Начисления ГДЕ Сотрудник = &Сотрудник И ПериодРегистрации = &Период И ВидРасчета = &Вид");
  Запрос.УстановитьПараметр("Сотрудник", Руководитель); Запрос.УстановитьПараметр("Период", Дата(2014,2,1));
  Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
  Таблица = Запрос.Выполнить().Выгрузить(); Утверждение(Таблица[0].Результат = 16000, "Отмена командировки: тариф не восстановлен");
  Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Премия);
  Таблица = Запрос.Выполнить().Выгрузить(); Утверждение(Таблица[0].Результат = 2760, "Отмена командировки: премия не восстановлена");
  Док = Документы.НачислениеЗарплаты.НайтиПоНомеру("ДМО-ЗП2", Дата(2014,1,31)).ПолучитьОбъект();
  Стр = Док.ОсновныеНачисления.Добавить(); ЗаполнитьЗначенияСвойств(Стр, Док.ОсновныеНачисления[0]);
  Док.Записать(РежимЗаписиДокумента.Проведение);
  Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
  Запрос.УстановитьПараметр("Период", Дата(2014,1,1));
  Таблица = Запрос.Выполнить().Выгрузить(); Утверждение(Таблица[0].Результат = 18400, "Дубли начислений");
  ОтменитьТранзакцию();
  Возврат "PR_OK: отмена командировки, восстановление тарифа и премии, дубли начислений";
 Исключение
  Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); ОтменитьТранзакцию(); Возврат Текст;
 КонецПопытки;
КонецФункции

Функция ПроверитьОтказПриНехватке(Бухгалтерский) Экспорт
 НачатьТранзакцию();
 ОшибкаОжидалась = Ложь;
 Попытка
  Товар = НовыйЭлемент("Номенклатура", "Проверка нехватки");
  Подразделение = Неопределено;
  Если Бухгалтерский Тогда Склад = НовыйЭлемент("Склады", "Проверка нехватки");
  Иначе
   Подразделение = НовыйЭлемент("Подразделения", "Проверка нехватки");
   Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
   Политика.Период = Дата(2016,1,1); Политика.Подразделение = Подразделение; Политика.Метод = Перечисления.УчетнаяПолитика.ФИФО; Политика.Записать();
  КонецЕсли;
  Док = Документы.ПриходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2016,1,1);
  Если Бухгалтерский Тогда Док.Склад = Склад; Иначе Док.Подразделение = Подразделение; КонецЕсли;
  ТоварнаяСтрока(Док, Товар, 1, 100); Док.Записать(РежимЗаписиДокумента.Проведение);
  Док = Документы.РасходнаяНакладная.СоздатьДокумент(); Док.Дата = Дата(2016,1,2);
  Если Бухгалтерский Тогда Док.Склад = Склад; КонецЕсли;
  ТоварнаяСтрока(Док, Товар, 0.5, 100, Подразделение); ТоварнаяСтрока(Док, Товар, 1000, 2000, Подразделение);
  Попытка Док.Записать(РежимЗаписиДокумента.Проведение);
  Исключение ОшибкаОжидалась = Истина; КонецПопытки;
  ОтменитьТранзакцию();
  Если Не ОшибкаОжидалась Тогда Возврат "FAIL: документ с нехваткой проведен"; КонецЕсли;
  Возврат "SHORTAGE_OK: нехватка во второй строке вызывает отказ и откат";
 Исключение
  Текст = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); ОтменитьТранзакцию(); Возврат Текст;
 КонецПопытки;
КонецФункции

Функция ПроверитьПечать(КаталогРезультата) Экспорт
 Попытка
  Для Каждого Имя Из Новый Структура("А,Б,В,Г","ПродажиОперативные","ПродажиТоваровИАналогов","ВедомостьПоПодразделению","Премии") Цикл
   Отчет = Отчеты[Имя.Значение].Создать();
   Если Имя.Значение = "ВедомостьПоПодразделению" Тогда
    Данные = Отчет.Данные(Дата(2014,1,1),Дата(2014,3,31),Справочники.Подразделения.НайтиПоНаименованию("Демо: основной цех",Истина));
   ИначеЕсли Имя.Значение = "Премии" Тогда Данные = Отчет.Данные(Дата(2014,1,1),Дата(2014,1,31));
   Иначе Данные = Отчет.Данные(Дата(2014,1,1),Дата(2014,3,31)); КонецЕсли;
   Док = УчетСервер.ПечатнаяФорма(Данные,"Демонстрационный пример, 2014 год");
   Док.Записать(КаталогРезультата + "/" + Имя.Значение + ".pdf",ТипФайлаТабличногоДокумента.PDF);
  КонецЦикла;
  Возврат "PRINT_OK: четыре PDF сформированы";
 Исключение Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()); КонецПопытки;
КонецФункции
