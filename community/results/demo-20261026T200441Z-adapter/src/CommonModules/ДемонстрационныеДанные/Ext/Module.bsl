
Функция Элемент(ИмяСправочника, Наименование)
 Менеджер = Справочники[ИмяСправочника];
 Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
 Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
 Объект = Менеджер.СоздатьЭлемент();
 Объект.Наименование = Наименование;
 Объект.Записать();
 Возврат Объект.Ссылка;
КонецФункции

Функция ВидСведений(Наименование, ТипЗначения)
 Ссылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Наименование, Истина);
 Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
 Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
 Объект.Наименование = Наименование;
 Объект.ТипЗначения = Новый ОписаниеТипов(ТипЗначения);
 Объект.Записать();
 Возврат Объект.Ссылка;
КонецФункции

Функция ДокументДемо(Имя, Номер, Дата)
 Ссылка = Документы[Имя].НайтиПоНомеру(Номер, Дата);
 Если ЗначениеЗаполнено(Ссылка) Тогда Объект = Ссылка.ПолучитьОбъект();
 Иначе Объект = Документы[Имя].СоздатьДокумент(); Объект.Номер = Номер; КонецЕсли;
 Объект.Дата = Дата;
 Возврат Объект;
КонецФункции

Процедура СтрокаТовара(Док, Товар, Свойство, Количество, Цена)
 Стр = Док.СписокНоменклатуры.Добавить();
 Стр.Номенклатура = Товар; Стр.Свойство = Свойство;
 Стр.Количество = Количество; Стр.Цена = Цена; Стр.Сумма = Количество * Цена;
КонецПроцедуры

Процедура Заполнить() Экспорт
 Цех = Элемент("Подразделения", "Демо: основной цех");
 Продажи = Элемент("Подразделения", "Демо: отдел продаж");
 Склад = Элемент("Склады", "Демо: основной склад");
 Деталь = Элемент("Номенклатура", "Демо: процессор");
 Блок = Элемент("Номенклатура", "Демо: системный блок");
 Товар = Элемент("Номенклатура", "Демо: принтер");
 Аналог = Элемент("Номенклатура", "Демо: принтер аналог");
 Для Каждого Позиция Из Новый Структура("А,Б", Товар, Аналог) Цикл
  Объект = Позиция.Значение.ПолучитьОбъект();
  Объект.Артикул = "Демо-" + Позиция.Ключ; Объект.Записать();
 КонецЦикла;
 Свойство = Элемент("СвойстваНоменклатуры", "Демо: ASUS");
 Объект = Свойство.ПолучитьОбъект(); Объект.Номенклатура = Деталь; Объект.Записать();
 Производитель = ВидСведений("Демо: производитель", "Строка");
 Запись = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
 Запись.Свойство = Свойство; Запись.Характеристика = Производитель; Запись.Значение = "ASUS"; Запись.Записать();
 Для Каждого Подразделение Из Новый Структура("А,Б", Цех, Продажи) Цикл
  Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
  Запись.Период = Дата(2014,1,1); Запись.Подразделение = Подразделение.Значение;
  Запись.Метод = Перечисления.УчетнаяПолитика.ФИФО; Запись.Записать();
 КонецЦикла;
 Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
 Запись.Период = Дата(2014,1,6); Запись.СистемныйБлок = Блок;
 Запись.Деталь = Деталь; Запись.Свойство = Свойство; Запись.Количество = 2; Запись.Записать();
 Запись = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
 Запись.Товар = Товар; Запись.Аналог = Аналог; Запись.Записать();
 Для Номер = 1 По 2 Цикл
  Док = ДокументДемо("ПриходнаяНакладная", "ДМО-ОУ" + Номер, Дата(2014,1,Номер));
  Док.СписокНоменклатуры.Очистить(); Док.Подразделение = Цех;
  СтрокаТовара(Док, Деталь, Свойство, 10, 1000 + Номер * 100);
  Док.Записать(РежимЗаписиДокумента.Проведение);
 КонецЦикла;
 Док = ДокументДемо("Сборка", "ДМО-СБ1", Дата(2014,1,7));
 Док.ПодразделениеИсточник = Цех; Док.ПодразделениеПолучатель = Продажи;
 Док.СистемныеБлоки.Очистить(); Док.ДополнительныеДетали.Очистить();
 Стр = Док.СистемныеБлоки.Добавить(); Стр.Номенклатура = Блок; Стр.Количество = 2;
 Стр = Док.ДополнительныеДетали.Добавить(); Стр.Номенклатура = Деталь; Стр.Свойство = Свойство; Стр.Количество = 1;
 Док.Записать(РежимЗаписиДокумента.Проведение);
 Док = ДокументДемо("РасходнаяНакладная", "ДМО-ОУ1", Дата(2014,1,8));
 Док.СписокНоменклатуры.Очистить();
 СтрокаТовара(Док, Блок, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 1, 5000);
 Док.СписокНоменклатуры[0].Подразделение = Продажи;
 Док.Записать(РежимЗаписиДокумента.Проведение);
 Док = ДокументДемо("ПриходнаяНакладная", "ДМО-БУ1", Дата(2014,1,1,12,0,0));
 Док.СписокНоменклатуры.Очистить(); Док.Склад = Склад;
 СтрокаТовара(Док, Товар, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 2, 100);
 СтрокаТовара(Док, Аналог, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 5, 120);
 Док.Записать(РежимЗаписиДокумента.Проведение);
 Док = ДокументДемо("Операция", "ДМО-БУ1", Дата(2014,1,2,12,0,0));
 Док.Проводки.Очистить();
 Стр = Док.Проводки.Добавить();
 Стр.СчетДт = ПланыСчетов.Управленческий.Товары; Стр.СчетКт = ПланыСчетов.Управленческий.Поставщики;
 Стр.НоменклатураДт = Товар; Стр.СкладДт = Склад; Стр.КоличествоДт = 1; Стр.Сумма = 130;
 Док.Записать(РежимЗаписиДокумента.Проведение);
 Док = ДокументДемо("РасходнаяНакладная", "ДМО-БУ1", Дата(2014,1,9));
 Док.СписокНоменклатуры.Очистить(); Док.Склад = Склад;
 СтрокаТовара(Док, Товар, Справочники.СвойстваНоменклатуры.ПустаяСсылка(), 4, 200);
 Док.Записать(РежимЗаписиДокумента.Проведение);
 ЗаполнитьЗарплатуИФормы(Цех);
КонецПроцедуры

Процедура ЗаполнитьЗарплатуИФормы(Цех)
 Работник = Элемент("Сотрудники", "Демо: сотрудник");
 Руководитель = Элемент("Сотрудники", "Демо: руководитель");
 Для Каждого Позиция Из Новый Структура("Работник,Руководитель", Работник, Руководитель) Цикл
  Объект = Позиция.Значение.ПолучитьОбъект();
  Объект.НачалоСтажа = Дата(2009,1,1); Объект.Записать();
  Запись = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи();
  Запись.Период = Дата(2013,10,1); Запись.Сотрудник = Позиция.Значение;
  Запись.Подразделение = Цех; Запись.Ставка = 100; Запись.Записать();
 КонецЦикла;
 Для Каждого Ступень Из Новый Структура("А,Б,В", 0, 1, 3) Цикл
  Запись = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
  Запись.Стаж = Ступень.Значение; Запись.Процент = 5;
  Если Ступень.Значение = 1 Тогда Запись.Процент = 10; ИначеЕсли Ступень.Значение = 3 Тогда Запись.Процент = 15; КонецЕсли;
  Запись.Записать();
 КонецЦикла;
 Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
 Набор.Отбор.Подразделение.Установить(Цех);
 День = Дата(2013,10,1);
 Пока День <= Дата(2014,4,30) Цикл
  Запись = Набор.Добавить(); Запись.Подразделение = Цех; Запись.Дата = День;
  Если ДеньНедели(День) <= 5 Тогда Запись.Значение = 8; КонецЕсли;
  День = День + 86400;
 КонецЦикла;
 Набор.Записать();
 Для Номер = 1 По 4 Цикл
  Месяц = ДобавитьМесяц(Дата(2013,12,1), Номер - 1);
  Док = ДокументДемо("НачислениеЗарплаты", "ДМО-ЗП" + Номер, КонецМесяца(Месяц));
  Док.ОсновныеНачисления.Очистить();
  Для Каждого Позиция Из Новый Структура("Работник,Руководитель", Работник, Руководитель) Цикл
   Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Позиция.Значение;
   Стр.Подразделение = Цех; Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
   Стр.ДатаНачала = Месяц; Стр.ДатаОкончания = КонецМесяца(Месяц);
  КонецЦикла;
  Если Номер > 1 Тогда
   Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Руководитель; Стр.Подразделение = Цех;
   Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия;
   Стр.ДатаНачала = Месяц; Стр.ДатаОкончания = КонецМесяца(Месяц);
  КонецЕсли;
  Док.Записать(РежимЗаписиДокумента.Проведение);
 КонецЦикла;
 Док = ДокументДемо("НачислениеЗарплаты", "ДМО-КМ1", Дата(2014,4,1));
 Док.ОсновныеНачисления.Очистить();
 Стр = Док.ОсновныеНачисления.Добавить(); Стр.Сотрудник = Руководитель; Стр.Подразделение = Цех;
 Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
 Стр.ДатаНачала = Дата(2014,2,20); Стр.ДатаОкончания = Дата(2014,3,5);
 Док.Записать(РежимЗаписиДокумента.Проведение);
 Валюта = ВидСведений("Валюта кредита", "СправочникСсылка.Валюты");
 Срок = ВидСведений("Срок кредита, дни", "Число");
 Регион = ВидСведений("Регион", "Строка");
 Объект = Руководитель.ПолучитьОбъект(); Объект.ДополнительныеСведения.Очистить();
 Стр = Объект.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Валюта;
 Стр = Объект.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Срок;
 Стр = Объект.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Регион;
 Объект.Записать();
 Контрагент = Элемент("Контрагенты", "Демо: завод Сатурн");
 Объект = Контрагент.ПолучитьОбъект(); Объект.Менеджер = Руководитель;
 Объект.ДополнительныеСведения.Очистить();
 Стр = Объект.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Срок; Стр.Значение = 10;
 Стр = Объект.ДополнительныеСведения.Добавить(); Стр.ВидСведений = Регион; Стр.Значение = "Москва";
 Объект.Записать();
КонецПроцедуры

Функция RunDemo() Экспорт
 Попытка
  Заполнить();
  Возврат "DEMO_OK";
 Исключение
  Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
 КонецПопытки;
КонецФункции

Функция ReportDiagnostics(Имя) Экспорт
 Попытка
  Отчет = Отчеты[Имя].Создать();
  Если Имя = "ВедомостьПоПодразделению" Тогда
   Данные = Отчет.Данные(Дата(2014,1,1), Дата(2014,3,31), Справочники.Подразделения.НайтиПоНаименованию("Демо: основной цех", Истина));
  ИначеЕсли Имя = "Премии" Тогда
   Данные = Отчет.Данные(Дата(2014,1,1), Дата(2014,1,31));
  Иначе Данные = Отчет.Данные(Дата(2014,1,1), Дата(2014,3,31)); КонецЕсли;
  Текст = Имя + ": " + Данные.Количество() + " строк";
  Для Каждого Стр Из Данные Цикл
   Текст = Текст + Символы.ПС;
   Для Каждого Кол Из Данные.Колонки Цикл
    Текст = Текст + Кол.Имя + "=" + Строка(Стр[Кол.Имя]) + "; ";
   КонецЦикла;
  КонецЦикла;
  Возврат Текст;
 Исключение
  Возврат ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
 КонецПопытки;
КонецФункции
