
Процедура НастроитьВидыРасчета() Экспорт
 Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф.ПолучитьОбъект();
 Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия.ПолучитьОбъект();
 Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка.ПолучитьОбъект();
 Виды = Новый Массив; Виды.Добавить(Тариф); Виды.Добавить(Премия); Виды.Добавить(Командировка);
 Для Каждого ОбъектВида Из Виды Цикл
  Изменено = Ложь;
  Если ОбъектВида.Ссылка <> Командировка.Ссылка Тогда
   Если ОбъектВида.ВытесняющиеВидыРасчета.Найти(Командировка.Ссылка, "ВидРасчета") = Неопределено Тогда
    Стр = ОбъектВида.ВытесняющиеВидыРасчета.Добавить(); Стр.ВидРасчета = Командировка.Ссылка; Изменено = Истина;
   КонецЕсли;
  КонецЕсли;
  БазовыеВиды = Новый Массив;
  Если ОбъектВида.Ссылка = Премия.Ссылка Тогда БазовыеВиды.Добавить(Тариф.Ссылка);
  ИначеЕсли ОбъектВида.Ссылка = Командировка.Ссылка Тогда
   БазовыеВиды.Добавить(Тариф.Ссылка); БазовыеВиды.Добавить(Премия.Ссылка); БазовыеВиды.Добавить(Командировка.Ссылка);
  КонецЕсли;
  Для Каждого БазовыйВид Из БазовыеВиды Цикл
   Если ОбъектВида.БазовыеВидыРасчета.Найти(БазовыйВид, "ВидРасчета") = Неопределено Тогда
    Стр = ОбъектВида.БазовыеВидыРасчета.Добавить(); Стр.ВидРасчета = БазовыйВид; Изменено = Истина;
   КонецЕсли;
  КонецЦикла;
  Если Изменено Тогда ОбъектВида.Записать(); КонецЕсли;
 КонецЦикла;
КонецПроцедуры

Процедура Провести(Док, Отказ) Экспорт
 УчетСервер.ЗаблокироватьРегистр("РегистрРасчета.Начисления");
 НастроитьВидыРасчета();
 Набор = Док.Движения.Начисления;
 Набор.Очистить();
 Набор.Записывать = Истина;
 СтрокиНачислений = Док.ОсновныеНачисления.Выгрузить();
 СтрокиНачислений.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания", "Размер");
 Для Каждого Стр Из СтрокиНачислений Цикл
  Если Не ЗначениеЗаполнено(Стр.Сотрудник) Или Не ЗначениеЗаполнено(Стр.Подразделение) Или Не ЗначениеЗаполнено(Стр.ВидРасчета) Тогда
   ВызватьИсключение "Не заполнены сотрудник, подразделение или вид расчета";
  КонецЕсли;
  Если Не ЗначениеЗаполнено(Стр.ДатаНачала) Или Стр.ДатаОкончания < Стр.ДатаНачала Тогда
   ВызватьИсключение "Неверный период начисления";
  КонецЕсли;
  Если Стр.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
   И НачалоМесяца(Стр.ДатаНачала) <> НачалоМесяца(Стр.ДатаОкончания) Тогда
   ВызватьИсключение "Тариф и премия вводятся только в пределах месяца";
  КонецЕсли;
  Начало = НачалоДня(Стр.ДатаНачала);
  Пока Начало <= Стр.ДатаОкончания Цикл
   Конец = Мин(КонецМесяца(Начало), КонецДня(Стр.ДатаОкончания));
   Дв = Набор.Добавить();
   Дв.ПериодРегистрации = НачалоМесяца(Начало);
   Дв.Коэффициент = 1;
   Дв.ПериодДействияНачало = Начало;
   Дв.ПериодДействияКонец = Конец;
   Дв.Сотрудник = Стр.Сотрудник;
   Дв.Подразделение = Стр.Подразделение;
   Дв.ВидРасчета = Стр.ВидРасчета;
   Если Дв.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
    Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
    Дв.БазовыйПериодКонец = КонецМесяца(Дв.БазовыйПериодНачало);
   ИначеЕсли Дв.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
    Дв.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -3);
    Дв.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
   КонецЕсли;
   Начало = КонецМесяца(Начало) + 1;
  КонецЦикла;
 КонецЦикла;
 // Запись нужна до расчета, чтобы платформа построила фактический период действия.
 Набор.Записать();
 РассчитатьВсе();
 // Результаты уже записаны наборами, повторная автоматическая запись не нужна.
 Набор.Записывать = Ложь;
КонецПроцедуры

Функция СтажЛет(ДатаНачала, НаДату) Экспорт
 Если Не ЗначениеЗаполнено(ДатаНачала) Тогда Возврат 0; КонецЕсли;
 Стаж = Год(НаДату) - Год(ДатаНачала);
 Если ДобавитьМесяц(ДатаНачала, Стаж * 12) > НаДату Тогда Стаж = Стаж - 1; КонецЕсли;
 Возврат Макс(0, Стаж);
КонецФункции


Процедура РассчитатьВсе() Экспорт
 // Данные графика получаются только специализированной виртуальной таблицей.
 Запрос = Новый Запрос(
 "ВЫБРАТЬ Регистратор, НомерСтроки, Активность, Сторно, ПериодРегистрации,
 | ПериодДействияНачало, ПериодДействияКонец, БазовыйПериодНачало, БазовыйПериодКонец,
 | ВидРасчета, Сотрудник, Подразделение, Результат, Дни, Часы, Стаж, Процент, Коэффициент,
 | Сотрудник.НачалоСтажа КАК НачалоСтажа,
 | ЕСТЬNULL(ЗначениеФактическийПериодДействия, 0) КАК ФактЧасы,
 | ЕСТЬNULL(ДниФактическийПериодДействия, 0) КАК ФактДни,
 | ЕСТЬNULL(ЗначениеПериодРегистрации, 0) КАК Норма
 |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Активность)
 |УПОРЯДОЧИТЬ ПО ПериодРегистрации, ВидРасчета, Регистратор, НомерСтроки");
 Данные = Запрос.Выполнить().Выгрузить();
 Если Данные.Количество() = 0 Тогда Возврат; КонецЕсли;
 Данные.Индексы.Добавить("Регистратор,НомерСтроки");
 Данные.Индексы.Добавить("ПериодРегистрации");
 Минимум = Данные[0].ПериодРегистрации;
 Максимум = Данные[Данные.Количество() - 1].ПериодРегистрации;
 Запрос = Новый Запрос("ВЫБРАТЬ Период, Сотрудник, Подразделение, Ставка ИЗ РегистрСведений.ТарифныеСтавки ГДЕ Сотрудник В (&Сотрудники) И Период <= &Конец УПОРЯДОЧИТЬ ПО Период");
 Запрос.УстановитьПараметр("Сотрудники", Данные.ВыгрузитьКолонку("Сотрудник"));
 Запрос.УстановитьПараметр("Конец", Максимум);
 Ставки = Запрос.Выполнить().Выгрузить();
 Запрос = Новый Запрос("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж");
 Шкала = Запрос.Выполнить().Выгрузить();
 // Разрезы сохраняют идентификаторы записей базы. Ресурс Коэффициент=1 позволяет
 // получить платформенный вес включения каждой записи в базу. Это позволяет
 // обновить зависимые месяцы в памяти без чтения БД в цикле по месяцам.
 Разрезы = Новый Массив;
 Разрезы.Добавить("Регистратор"); Разрезы.Добавить("НомерСтроки");
 Измерения = Новый Массив; Измерения.Добавить("Подразделение");
 Запрос = Новый Запрос(
 "ВЫБРАТЬ Регистратор, НомерСтроки, РегистраторРазрез КАК БазаРегистратор,
 | НомерСтрокиРазрез КАК БазаНомерСтроки, КоэффициентБаза КАК Вес
 |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы, ВидРасчета = &Вид)");
 Запрос.УстановитьПараметр("Измерения", Измерения); Запрос.УстановитьПараметр("Разрезы", Разрезы);
 Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Премия);
 БазаПремий = Запрос.Выполнить().Выгрузить();
 Измерения = Новый Массив; Измерения.Добавить("Сотрудник");
 Запрос.УстановитьПараметр("Измерения", Измерения);
 Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
 БазаКомандировок = Запрос.Выполнить().Выгрузить();
 БазаПремий.Индексы.Добавить("Регистратор,НомерСтроки");
 БазаКомандировок.Индексы.Добавить("Регистратор,НомерСтроки");
 Месяц = Минимум;
 Пока Месяц <= Максимум Цикл
  ЗаМесяц = Данные.НайтиСтроки(Новый Структура("ПериодРегистрации", Месяц));
  Для Каждого Стр Из ЗаМесяц Цикл
   Стр.Результат = 0; Стр.Часы = Стр.ФактЧасы; Стр.Дни = Стр.ФактДни; Стр.Процент = 0;
   Стр.Стаж = СтажЛет(Стр.НачалоСтажа, Месяц);
   Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
    Ставка = 0;
    Для Каждого Тариф Из Ставки Цикл
     Если Тариф.Сотрудник = Стр.Сотрудник И Тариф.Подразделение = Стр.Подразделение И Тариф.Период <= Месяц Тогда Ставка = Тариф.Ставка; КонецЕсли;
    КонецЦикла;
    Стр.Результат = Окр(Стр.Часы * Ставка, 2);
   КонецЕсли;
  КонецЦикла;
  Для Каждого Стр Из ЗаМесяц Цикл
   Если Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
    Для Каждого Ступень Из Шкала Цикл Если Ступень.Стаж <= Стр.Стаж Тогда Стр.Процент = Ступень.Процент; КонецЕсли; КонецЦикла;
    База = 0;
    Связи = БазаПремий.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки));
    Для Каждого Связь Из Связи Цикл
     Источники = Данные.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Связь.БазаРегистратор, Связь.БазаНомерСтроки));
     Для Каждого Источник Из Источники Цикл
      Если Источник.Сотрудник <> Стр.Сотрудник Тогда База = База + Источник.Результат * Связь.Вес; КонецЕсли;
     КонецЦикла;
    КонецЦикла;
    Если Стр.Норма > 0 Тогда Стр.Результат = Окр(База * Стр.Процент / 100 * Стр.Часы / Стр.Норма, 2); КонецЕсли;
   ИначеЕсли Стр.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
    База = 0; ДниБазы = 0;
    Связи = БазаКомандировок.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Стр.Регистратор, Стр.НомерСтроки));
    Для Каждого Связь Из Связи Цикл
     Источники = Данные.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Связь.БазаРегистратор, Связь.БазаНомерСтроки));
     Для Каждого Источник Из Источники Цикл
      База = База + Источник.Результат * Связь.Вес;
      Если Источник.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда ДниБазы = ДниБазы + Источник.Дни * Связь.Вес; КонецЕсли;
     КонецЦикла;
    КонецЦикла;
    Если ДниБазы > 0 Тогда Стр.Результат = Окр(База / ДниБазы * Стр.Дни, 2); КонецЕсли;
   КонецЕсли;
  КонецЦикла;
  Месяц = ДобавитьМесяц(Месяц, 1);
 КонецЦикла;
 Регистраторы = Новый Соответствие;
 Для Каждого Стр Из Данные Цикл
  Набор = Регистраторы.Получить(Стр.Регистратор);
  Если Набор = Неопределено Тогда
   Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей(); Набор.Отбор.Регистратор.Установить(Стр.Регистратор);
   Регистраторы.Вставить(Стр.Регистратор, Набор);
  КонецЕсли;
  Дв = Набор.Добавить(); ЗаполнитьЗначенияСвойств(Дв, Стр);
 КонецЦикла;
 Для Каждого Пара Из Регистраторы Цикл Пара.Значение.Записать(); КонецЦикла;
КонецПроцедуры
