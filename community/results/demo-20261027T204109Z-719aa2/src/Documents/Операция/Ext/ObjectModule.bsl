Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.Хозрасчетный.Очистить();
	Движения.Хозрасчетный.Записывать = Истина;
	Для Каждого СтрокаПроводки Из Проводки Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроводки.СчетДт) Или Не ЗначениеЗаполнено(СтрокаПроводки.СчетКт) Тогда
			Отказ = Истина;
			Сообщить("Укажите оба счета проводки");
			Продолжить;
		КонецЕсли;
		Если СтрокаПроводки.СчетДт = ПланыСчетов.Управленческий.Товары
			И СтрокаПроводки.СчетКт = ПланыСчетов.Управленческий.Товары
			И (СтрокаПроводки.НоменклатураДт <> СтрокаПроводки.НоменклатураКт
				Или СтрокаПроводки.СкладДт <> СтрокаПроводки.СкладКт) Тогда
			Отказ = Истина;
			Сообщить("Проводка между разными аналитиками товаров пока не поддерживается");
			Продолжить;
		КонецЕсли;
		Движение = Движения.Хозрасчетный.Добавить();
		Движение.Период = Дата;
		Движение.СчетДт = СтрокаПроводки.СчетДт;
		Движение.СчетКт = СтрокаПроводки.СчетКт;
		Если СтрокаПроводки.СчетКт = ПланыСчетов.Управленческий.Товары
			И СтрокаПроводки.СчетДт <> ПланыСчетов.Управленческий.Товары Тогда
			Движение.Номенклатура = СтрокаПроводки.НоменклатураКт;
			Движение.Склад = СтрокаПроводки.СкладКт;
			Движение.Количество = СтрокаПроводки.КоличествоКт;
		Иначе
			Движение.Номенклатура = СтрокаПроводки.НоменклатураДт;
			Движение.Склад = СтрокаПроводки.СкладДт;
			Движение.Количество = СтрокаПроводки.КоличествоДт;
		КонецЕсли;
		Движение.Сумма = СтрокаПроводки.Сумма;
	КонецЦикла;
КонецПроцедуры
