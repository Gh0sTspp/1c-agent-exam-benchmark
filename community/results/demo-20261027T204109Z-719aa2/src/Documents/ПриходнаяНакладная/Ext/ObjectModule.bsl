Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Склад) Тогда
		Отказ = Истина;
		Сообщить("Укажите подразделение или склад");
		Возврат;
	КонецЕсли;
	Если СписокНоменклатуры.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщить("Не указаны товары");
		Возврат;
	КонецЕсли;
	Движения.ОстаткиНоменклатуры.Очистить();
	Движения.Партии.Очистить();
	Движения.Хозрасчетный.Очистить();
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Движения.Партии.Записывать = Истина;
	Движения.Хозрасчетный.Записывать = Истина;
	Для Каждого СтрокаТоваров Из СписокНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Тогда
			Отказ = Истина;
			Сообщить("Укажите номенклатуру");
			Продолжить;
		КонецЕсли;
		Если СтрокаТоваров.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщить("Количество должно быть положительным");
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Подразделение) Тогда
			Движение = Движения.ОстаткиНоменклатуры.ДобавитьПриход();
			Движение.Период = Дата;
			Движение.Подразделение = Подразделение;
			Движение.Номенклатура = СтрокаТоваров.Номенклатура;
			Движение.Свойство = СтрокаТоваров.Свойство;
			Движение.Количество = СтрокаТоваров.Количество;
			Движение.Стоимость = СтрокаТоваров.Сумма;
			Движение = Движения.Партии.ДобавитьПриход();
			Движение.Период = Дата;
			Движение.Подразделение = Подразделение;
			Движение.Номенклатура = СтрокаТоваров.Номенклатура;
			Движение.Свойство = СтрокаТоваров.Свойство;
			Движение.Партия = Ссылка;
			Движение.Количество = СтрокаТоваров.Количество;
			Движение.Стоимость = СтрокаТоваров.Сумма;
		КонецЕсли;
		Если ЗначениеЗаполнено(Склад) Тогда
			ДвижениеБух = Движения.Хозрасчетный.Добавить();
			ДвижениеБух.Период = Дата;
			ДвижениеБух.СчетДт = ПланыСчетов.Управленческий.Товары;
			ДвижениеБух.СчетКт = ПланыСчетов.Управленческий.Поставщики;
			ДвижениеБух.Номенклатура = СтрокаТоваров.Номенклатура;
			ДвижениеБух.Склад = Склад;
			ДвижениеБух.Количество = СтрокаТоваров.Количество;
			ДвижениеБух.Сумма = СтрокаТоваров.Сумма;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементПартий = Блокировка.Добавить("РегистрНакопления.Партии");
	ЭлементПартий.Режим = РежимБлокировкиДанных.Исключительный;
	Счета = Блокировка.Добавить("РегистрБухгалтерии.Хозрасчетный");
	Счета.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Партии.Регистратор КАК Регистратор
		|ИЗ РегистрНакопления.Партии КАК Партии
		|ГДЕ Партии.Партия = &Партия
		| И Партии.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	Запрос.УстановитьПараметр("Партия", Ссылка);
	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Отказ = Истина;
		Сообщить("Нельзя отменить приход: его партия уже использована. Сначала отмените последующие документы.");
		Возврат;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Расход.Регистратор КАК Регистратор
		|ИЗ РегистрБухгалтерии.Хозрасчетный КАК Приход
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрБухгалтерии.Хозрасчетный КАК Расход
		| ПО Приход.Номенклатура = Расход.Номенклатура
		| И Приход.Склад = Расход.Склад
		|ГДЕ Приход.Регистратор = &Документ И Приход.СчетДт = &Товары
		| И Расход.СчетКт = &Товары И Расход.Период >= Приход.Период
		| И Расход.Регистратор <> &Документ";
	Запрос.УстановитьПараметр("Документ", Ссылка);
	Запрос.УстановитьПараметр("Товары", ПланыСчетов.Управленческий.Товары);
	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Отказ = Истина;
		Сообщить("Нельзя отменить приход: по товару и складу есть последующие кредитовые проводки.");
	КонецЕсли;
КонецПроцедуры
