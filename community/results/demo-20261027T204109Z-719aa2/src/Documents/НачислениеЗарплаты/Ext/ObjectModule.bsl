Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Движения.Начисления.Очистить();
	Движения.Начисления.Записать();
	Движения.Начисления.Записывать = Истина;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрРасчета.Начисления");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Строки = ОсновныеНачисления.Выгрузить();
	Строки.Сортировать("ДатаНачала");
	Для Каждого СтрокаНачисления Из Строки Цикл
		Если Не ЗначениеЗаполнено(СтрокаНачисления.Сотрудник)
			Или Не ЗначениеЗаполнено(СтрокаНачисления.Подразделение)
			Или Не ЗначениеЗаполнено(СтрокаНачисления.ВидРасчета)
			Или Не ЗначениеЗаполнено(СтрокаНачисления.ДатаНачала)
			Или Не ЗначениеЗаполнено(СтрокаНачисления.ДатаОкончания) Тогда
			Отказ = Истина;
			Сообщить("Заполните сотрудника, подразделение, вид расчета и период");
			Возврат;
		КонецЕсли;
		Если СтрокаНачисления.ДатаНачала > СтрокаНачисления.ДатаОкончания Тогда
			Отказ = Истина;
			Сообщить("Дата окончания раньше даты начала");
			Возврат;
		КонецЕсли;
		Если СтрокаНачисления.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
			И НачалоМесяца(СтрокаНачисления.ДатаНачала) <> НачалоМесяца(СтрокаНачисления.ДатаОкончания) Тогда
			Отказ = Истина;
			Сообщить("Тариф и премия должны находиться в одном месяце");
			Возврат;
		КонецЕсли;
		Начало = СтрокаНачисления.ДатаНачала;
		Пока Начало <= СтрокаНачисления.ДатаОкончания Цикл
			Конец = КонецДня(?(КонецМесяца(Начало) < СтрокаНачисления.ДатаОкончания,
				КонецМесяца(Начало), СтрокаНачисления.ДатаОкончания));
			Движение = Движения.Начисления.Добавить();
			Движение.ПериодРегистрации = НачалоМесяца(Начало);
			Движение.ВидРасчета = СтрокаНачисления.ВидРасчета;
			Движение.Сотрудник = СтрокаНачисления.Сотрудник;
			Движение.Подразделение = СтрокаНачисления.Подразделение;
			Движение.Начало = НачалоДня(Начало);
			Движение.Окончание = НачалоДня(Конец);
			Если СтрокаНачисления.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
				Ставка = РегистрыСведений.ТарифныеСтавки.ПолучитьПоследнее(
					НачалоМесяца(Начало), Новый Структура("Сотрудник,Подразделение",
					СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение));
				Движение.Результат = Окр(Ставка.Ставка * ПоказательГрафика(
					СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение, Начало, Конец, Ложь, Истина), 2);
			ИначеЕсли СтрокаНачисления.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда
				Движение.Стаж = СтажВГодах(СтрокаНачисления.Сотрудник, НачалоМесяца(Начало));
				Движение.Процент = ПроцентПремии(Движение.Стаж);
				База = БазаПремии(СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение, Начало);
				Норма = ПоказательГрафика(СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение,
					НачалоМесяца(Начало), КонецМесяца(Начало), Ложь, Ложь);
				Факт = ПоказательГрафика(СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение,
					Начало, Конец, Ложь, Истина);
				Если Норма > 0 Тогда
					Движение.Результат = Окр(База * Движение.Процент / 100 * Факт / Норма, 2);
				КонецЕсли;
			ИначеЕсли СтрокаНачисления.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
				НачалоБазы = НачалоМесяца(ДобавитьМесяц(Начало, -3));
				КонецБазы = КонецМесяца(ДобавитьМесяц(Начало, -1));
				База = БазаКомандировки(СтрокаНачисления.Сотрудник, НачалоБазы, КонецБазы);
				ДниБазы = ДниРаботыВБазе(СтрокаНачисления.Сотрудник, НачалоБазы, КонецБазы);
				ДниКомандировки = ПоказательГрафика(СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение,
					Начало, Конец, Истина, Истина, Ложь);
				Если ДниБазы > 0 Тогда
					Движение.Результат = Окр(База / ДниБазы * ДниКомандировки, 2);
				КонецЕсли;
				СторнироватьВытеснение(СтрокаНачисления.Сотрудник, СтрокаНачисления.Подразделение, Начало, Конец);
			Иначе
				Отказ = Истина;
				Сообщить("Неизвестный вид начисления");
				Возврат;
			КонецЕсли;
			Если СтрокаНачисления.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
								Движение.Результат = Движение.Результат - СуммаСторноИсточника(Ссылка, Движения.Начисления.Количество());
			КонецЕсли;
			Движения.Начисления.Записать();
			Начало = НачалоДня(Конец) + 86400;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция ПоказательГрафика(Сотрудник, Подразделение, Начало, Конец, Дни, ИсключатьКомандировки, УчитыватьСтрокиДокумента = Истина)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ График.Дата КАК Дата, График.Значение КАК Часы
		|ИЗ РегистрСведений.ГрафикиРаботы КАК График
		|ГДЕ График.Подразделение = &Подразделение И График.Дата МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	График = Запрос.Выполнить().Выгрузить();
	Командировки = Новый ТаблицаЗначений;
	Если ИсключатьКомандировки Тогда
		Запрос.Текст = "ВЫБРАТЬ Начисления.Начало КАК Начало, Начисления.Окончание КАК Окончание
			|ИЗ РегистрРасчета.Начисления КАК Начисления
			|ГДЕ Начисления.Сотрудник = &Сотрудник И Начисления.Подразделение = &Подразделение
						| И Начисления.ВидРасчета = &Вид И НЕ Начисления.ЭтоСторно
			| И Начисления.Начало <= &Конец И Начисления.Окончание >= &Начало";
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
		Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
		Командировки = Запрос.Выполнить().Выгрузить();
	КонецЕсли;
	Результат = 0;
	Для Каждого День Из График Цикл
		Если День.Часы <= 0 Тогда
			Продолжить;
		КонецЕсли;
		ВКомандировке = Ложь;
		Если ИсключатьКомандировки Тогда
			Для Каждого Командировка Из Командировки Цикл
				Если День.Дата >= Командировка.Начало И День.Дата <= Командировка.Окончание Тогда
					ВКомандировке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если УчитыватьСтрокиДокумента Тогда
			Для Каждого СтрокаДокумента Из ОсновныеНачисления Цикл
				Если СтрокаДокумента.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка
					И СтрокаДокумента.Сотрудник = Сотрудник И СтрокаДокумента.Подразделение = Подразделение
					И День.Дата >= СтрокаДокумента.ДатаНачала И День.Дата <= СтрокаДокумента.ДатаОкончания Тогда
					ВКомандировке = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		Если Не ВКомандировке Тогда
			Результат = Результат + ?(Дни, 1, День.Часы);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтажВГодах(Сотрудник, НаДату)
	Начало = Сотрудник.НачалоСтажа;
	Если Не ЗначениеЗаполнено(Начало) Или Начало > НаДату Тогда
		Возврат 0;
	КонецЕсли;
	Годы = Год(НаДату) - Год(Начало);
	Если ДобавитьМесяц(Начало, Годы * 12) > НаДату Тогда
		Годы = Годы - 1;
	КонецЕсли;
	Возврат Годы;
КонецФункции

Функция ПроцентПремии(Стаж)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Шкала.Процент КАК Процент
		|ИЗ РегистрСведений.ШкалаПремий КАК Шкала
		|ГДЕ Шкала.Стаж <= &Стаж УПОРЯДОЧИТЬ ПО Шкала.Стаж УБЫВ";
	Запрос.УстановитьПараметр("Стаж", Стаж);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Процент;
	КонецЕсли;
	Возврат 0;
КонецФункции

Функция БазаПремии(Сотрудник, Подразделение, Начало)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(Начисления.Результат), 0) КАК Результат
		|ИЗ РегистрРасчета.Начисления КАК Начисления
		|ГДЕ Начисления.ПериодРегистрации = &Месяц И Начисления.Подразделение = &Подразделение
		| И Начисления.Сотрудник <> &Сотрудник И Начисления.ВидРасчета = &Вид";
	Запрос.УстановитьПараметр("Месяц", НачалоМесяца(ДобавитьМесяц(Начало, -1)));
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Результат;
КонецФункции

Функция БазаКомандировки(Сотрудник, Начало, Конец)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(Начисления.Результат), 0) КАК Результат
		|ИЗ РегистрРасчета.Начисления КАК Начисления
		|ГДЕ Начисления.Сотрудник = &Сотрудник И Начисления.ПериодРегистрации МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Результат;
КонецФункции

Процедура СторнироватьВытеснение(Сотрудник, Подразделение, Начало, Конец)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Начисления.Регистратор КАК Источник,
		| Начисления.НомерСтроки КАК Номер, Начисления.ВидРасчета КАК Вид,
		| Начисления.Начало КАК Начало, Начисления.Окончание КАК Окончание,
		| Начисления.Результат КАК Результат, Начисления.Стаж КАК Стаж, Начисления.Процент КАК Процент
		|ИЗ РегистрРасчета.Начисления КАК Начисления
		|ГДЕ Начисления.Сотрудник = &Сотрудник И Начисления.Подразделение = &Подразделение
		| И Начисления.Регистратор <> &Документ И НЕ Начисления.ЭтоСторно
		| И Начисления.ВидРасчета В (&Виды) И Начисления.Начало <= &Конец И Начисления.Окончание >= &Начало";
	Виды = Новый Массив;
	Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Виды.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Премия);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Запрос.УстановитьПараметр("Документ", Ссылка);
	Запрос.УстановитьПараметр("Виды", Виды);
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Исходные = Запрос.Выполнить().Выгрузить();
	Для Каждого Исходная Из Исходные Цикл
		НачалоПересечения = ?(Исходная.Начало > Начало, Исходная.Начало, Начало);
		КонецПересечения = ?(Исходная.Окончание < Конец, Исходная.Окончание, Конец);
		ПотеряЧасов = ПоказательГрафика(Сотрудник, Подразделение, НачалоПересечения,
			КонецПересечения, Ложь, Истина, Ложь);
		Если ПотеряЧасов <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Исходная.Вид = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
			Ставка = РегистрыСведений.ТарифныеСтавки.ПолучитьПоследнее(
				НачалоМесяца(Исходная.Начало), Новый Структура("Сотрудник,Подразделение", Сотрудник, Подразделение));
			СуммаСторно = Окр(Ставка.Ставка * ПотеряЧасов, 2);
		Иначе
			ЗапросСторно = Новый Запрос;
			ЗапросСторно.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(Начисления.Результат), 0) КАК Результат
				|ИЗ РегистрРасчета.Начисления КАК Начисления
				|ГДЕ Начисления.ЭтоСторно И Начисления.ИсточникСторно = &Источник
				| И Начисления.НомерСтрокиИсточника = &Номер";
			ЗапросСторно.УстановитьПараметр("Источник", Исходная.Источник);
			ЗапросСторно.УстановитьПараметр("Номер", Исходная.Номер);
			ВыборкаСторно = ЗапросСторно.Выполнить().Выбрать();
			ВыборкаСторно.Следующий();
			ЧасыДоКомандировки = ПоказательГрафика(Сотрудник, Подразделение,
				Исходная.Начало, Исходная.Окончание, Ложь, Истина, Ложь);
			Если ЧасыДоКомандировки <= 0 Тогда
				Продолжить;
			КонецЕсли;
			СуммаСторно = Окр((Исходная.Результат + ВыборкаСторно.Результат) * ПотеряЧасов / ЧасыДоКомандировки, 2);
		КонецЕсли;
		Если СуммаСторно = 0 Тогда
			Продолжить;
		КонецЕсли;
		Сторно = Движения.Начисления.Добавить();
		Сторно.ПериодРегистрации = НачалоМесяца(Исходная.Начало);
		Сторно.ВидРасчета = Исходная.Вид;
		Сторно.Сотрудник = Сотрудник;
		Сторно.Подразделение = Подразделение;
		Сторно.Начало = Исходная.Начало;
		Сторно.Окончание = Исходная.Окончание;
		Сторно.ЭтоСторно = Истина;
		Сторно.ИсточникСторно = Исходная.Источник;
		Сторно.НомерСтрокиИсточника = Исходная.Номер;
		Сторно.Стаж = Исходная.Стаж;
		Сторно.Процент = Исходная.Процент;
		Сторно.Результат = -СуммаСторно;
	КонецЦикла;
КонецПроцедуры

Функция ДниРаботыВБазе(Сотрудник, Начало, Конец)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ График.Дата КАК Дата, График.Подразделение КАК Подразделение
		|ИЗ РегистрСведений.ГрафикиРаботы КАК График
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрРасчета.Начисления КАК Начисления
		| ПО Начисления.Подразделение = График.Подразделение
		| И График.Дата >= Начисления.Начало И График.Дата <= Начисления.Окончание
		|ГДЕ Начисления.Сотрудник = &Сотрудник И Начисления.ВидРасчета = &Тариф
		| И НЕ Начисления.ЭтоСторно И График.Значение > 0 И График.Дата МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Тариф", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Запрос.УстановитьПараметр("Начало", НачалоДня(Начало));
	Запрос.УстановитьПараметр("Конец", КонецДня(Конец));
	Дни = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ Начисления.Начало КАК Начало, Начисления.Окончание КАК Окончание,
		| Начисления.Подразделение КАК Подразделение
		|ИЗ РегистрРасчета.Начисления КАК Начисления
		|ГДЕ Начисления.Сотрудник = &Сотрудник И Начисления.ВидРасчета = &Вид
		| И НЕ Начисления.ЭтоСторно И Начисления.Начало <= &Конец И Начисления.Окончание >= &Начало";
	Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Командировки = Запрос.Выполнить().Выгрузить();
	РабочиеДаты = Новый Соответствие;
	Для Каждого День Из Дни Цикл
		ВКомандировке = Ложь;
		Для Каждого Командировка Из Командировки Цикл
			Если Командировка.Подразделение = День.Подразделение
				И День.Дата >= Командировка.Начало И День.Дата <= Командировка.Окончание Тогда
				ВКомандировке = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрокаДокумента Из ОсновныеНачисления Цикл
			Если СтрокаДокумента.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка
				И СтрокаДокумента.Сотрудник = Сотрудник И СтрокаДокумента.Подразделение = День.Подразделение
				И День.Дата >= СтрокаДокумента.ДатаНачала И День.Дата <= СтрокаДокумента.ДатаОкончания Тогда
				ВКомандировке = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Не ВКомандировке Тогда
			РабочиеДаты.Вставить(День.Дата, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат РабочиеДаты.Количество();
КонецФункции

Функция СуммаСторноИсточника(Источник, Номер)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ЕСТЬNULL(СУММА(Начисления.Результат), 0) КАК Результат
		|ИЗ РегистрРасчета.Начисления КАК Начисления
		|ГДЕ Начисления.ЭтоСторно И Начисления.ИсточникСторно = &Источник
		| И Начисления.НомерСтрокиИсточника = &Номер";
	Запрос.УстановитьПараметр("Источник", Источник);
	Запрос.УстановитьПараметр("Номер", Номер);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Результат;
КонецФункции
