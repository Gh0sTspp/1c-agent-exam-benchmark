Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если СписокНоменклатуры.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщить("Не указаны товары");
		Возврат;
	КонецЕсли;
	Для Каждого СтрокаПроверки Из СписокНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(СтрокаПроверки.Номенклатура) Или СтрокаПроверки.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщить("Укажите номенклатуру и положительное количество");
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Движения.ОстаткиНоменклатуры.Очистить();
	Движения.Партии.Очистить();
	Движения.Продажи.Очистить();
	Движения.ПродажиБух.Очистить();
	Движения.Хозрасчетный.Очистить();
	Движения.ОстаткиНоменклатуры.Записать();
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Движения.Партии.Записать();
	Движения.Партии.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	Движения.ПродажиБух.Записывать = Истина;
	Движения.Хозрасчетный.Записывать = Истина;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементПартий = Блокировка.Добавить("РегистрНакопления.Партии");
	ЭлементПартий.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Если ЗначениеЗаполнено(Склад) Тогда
		ПровестиБухгалтерскийУчет(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Подразделения = Новый Массив;
	Товары = Новый Массив;
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Подразделение) Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаТовара.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщить("Количество должно быть положительным");
			Возврат;
		КонецЕсли;
		Если Подразделения.Найти(СтрокаТовара.Подразделение) = Неопределено Тогда
			Подразделения.Добавить(СтрокаТовара.Подразделение);
		КонецЕсли;
		Если Товары.Найти(СтрокаТовара.Номенклатура) = Неопределено Тогда
			Товары.Добавить(СтрокаТовара.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Если Товары.Количество() = 0 Тогда
		Если Не ЗначениеЗаполнено(Склад) Тогда
			Отказ = Истина;
			Сообщить("Укажите склад или подразделение в строках");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Остатки.Подразделение, Остатки.Номенклатура,
		| СУММА(Остатки.КоличествоОстаток) КАК Количество, СУММА(Остатки.СтоимостьОстаток) КАК Стоимость
		|ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
		| Подразделение В (&Подразделения) И Номенклатура В (&Товары)) КАК Остатки
		|СГРУППИРОВАТЬ ПО Остатки.Подразделение, Остатки.Номенклатура";
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Подразделения", Подразделения);
	Запрос.УстановитьПараметр("Товары", Товары);

	Остатки = Запрос.Выполнить().Выгрузить();
	Остатки.Индексы.Добавить("Подразделение,Номенклатура");
	Запрос.Текст = "ВЫБРАТЬ Партии.Подразделение, Партии.Номенклатура, Партии.Свойство, Партии.Партия,
		| Партии.КоличествоОстаток КАК Количество, Партии.СтоимостьОстаток КАК Стоимость,
		| Партии.Партия.Дата КАК ДатаПартии
		|ИЗ РегистрНакопления.Партии.Остатки(&Момент,
		| Подразделение В (&Подразделения) И Номенклатура В (&Товары)) КАК Партии
		|ГДЕ Партии.КоличествоОстаток > 0 УПОРЯДОЧИТЬ ПО ДатаПартии, Партия, Свойство";
	Партии = Запрос.Выполнить().Выгрузить();
	Партии.Индексы.Добавить("Подразделение,Номенклатура");
	Запрос.Текст = "ВЫБРАТЬ Политика.Подразделение, Политика.Метод
		|ИЗ РегистрСведений.УчетнаяПолитика.СрезПоследних(&Дата, Подразделение В (&Подразделения)) КАК Политика";
	Запрос.УстановитьПараметр("Дата", Дата);
	Политики = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		Если Не ЗначениеЗаполнено(СтрокаТовара.Подразделение) Тогда
			Продолжить;
		КонецЕсли;
		Ключ = Новый Структура("Подразделение,Номенклатура", СтрокаТовара.Подразделение, СтрокаТовара.Номенклатура);
		НайденныеОстатки = Остатки.НайтиСтроки(Ключ);
		Если НайденныеОстатки.Количество() = 0 Тогда
			Отказ = Истина;
			Сообщить("Нет остатка: " + СтрокаТовара.Номенклатура);
			Возврат;
		КонецЕсли;
		Остаток = НайденныеОстатки[0];
		Если Остаток.Количество < СтрокаТовара.Количество Тогда
			Отказ = Истина;
			Сообщить("Недостаточно товара: " + СтрокаТовара.Номенклатура);
			Возврат;
		КонецЕсли;
		Метод = Перечисления.МетодыОценки.Средняя;
		НайденнаяПолитика = Политики.Найти(СтрокаТовара.Подразделение, "Подразделение");
		Если НайденнаяПолитика <> Неопределено Тогда
			Метод = НайденнаяПолитика.Метод;
		КонецЕсли;
		Стоимость = СписатьПартииВПамяти(СтрокаТовара, Партии, Метод, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		Остаток.Количество = Остаток.Количество - СтрокаТовара.Количество;
		Остаток.Стоимость = Остаток.Стоимость - Стоимость;

				Продажа = Движения.Продажи.Добавить();
		Продажа.Период = Дата;
		Продажа.Номенклатура = СтрокаТовара.Номенклатура;
		Продажа.Количество = СтрокаТовара.Количество;
		Продажа.Стоимость = Стоимость;
		Продажа.Выручка = СтрокаТовара.Сумма;
	КонецЦикла;
КонецПроцедуры

Процедура ПровестиБухгалтерскийУчет(Отказ)
	Движения.Хозрасчетный.Записать();
	Движения.Хозрасчетный.Записывать = Истина;
	Движения.ПродажиБух.Записывать = Истина;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.Хозрасчетный");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос("ВЫБРАТЬ Аналоги.Номенклатура, Аналоги.Аналог ИЗ РегистрСведений.Аналоги КАК Аналоги");
	Связи = Запрос.Выполнить().Выгрузить();
	КандидатыПоТовару = Новый Соответствие;
	ВсеКандидаты = Новый Массив;
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		Если СтрокаТовара.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщить("Количество должно быть положительным");
			Возврат;
		КонецЕсли;
		Кандидаты = КандидатыПоТовару.Получить(СтрокаТовара.Номенклатура);
		Если Кандидаты = Неопределено Тогда
			Кандидаты = НайтиАналоги(СтрокаТовара.Номенклатура, Связи);
			КандидатыПоТовару.Вставить(СтрокаТовара.Номенклатура, Кандидаты);
		КонецЕсли;
		Для Каждого Товар Из Кандидаты Цикл
			Если ВсеКандидаты.Найти(Товар) = Неопределено Тогда
				ВсеКандидаты.Добавить(Товар);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если ВсеКандидаты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ Номенклатура.Ссылка КАК Товар ИЗ Справочник.Номенклатура КАК Номенклатура
		|ГДЕ Номенклатура.Ссылка В (&Кандидаты) УПОРЯДОЧИТЬ ПО Номенклатура.Артикул, Номенклатура.Ссылка";
	Запрос.УстановитьПараметр("Кандидаты", ВсеКандидаты);
	ОтсортированныеТовары = Запрос.Выполнить().Выгрузить();
	Запрос.Текст = "ВЫБРАТЬ Остатки.Номенклатура КАК Номенклатура, Остатки.Склад КАК Склад,
		| Остатки.КоличествоОстаток КАК Количество, Остатки.СуммаОстаток КАК Стоимость
		|ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, Номенклатура В (&Кандидаты)) КАК Остатки";
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Счет", ПланыСчетов.Управленческий.Товары);
	Остатки = Запрос.Выполнить().Выгрузить();
	Остатки.Индексы.Добавить("Номенклатура");
	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
		Кандидаты = КандидатыПоТовару.Получить(СтрокаТовара.Номенклатура);
		Порядок = Новый Массив;
		Порядок.Добавить(СтрокаТовара.Номенклатура);
		Для Каждого СтрокаПорядка Из ОтсортированныеТовары Цикл
			Если СтрокаПорядка.Товар <> СтрокаТовара.Номенклатура И Кандидаты.Найти(СтрокаПорядка.Товар) <> Неопределено Тогда
				Порядок.Добавить(СтрокаПорядка.Товар);
			КонецЕсли;
		КонецЦикла;
		Осталось = СтрокаТовара.Количество;
		ОстатокВыручки = СтрокаТовара.Сумма;
		Для Каждого Товар Из Порядок Цикл
			Если Осталось <= 0 Тогда
				Прервать;
			КонецЕсли;
			СтрокиОстатков = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Товар));
			Всего = 0;
			ВсегоСтоимость = 0;
			СтрокаСклада = Неопределено;
			Для Каждого Остаток Из СтрокиОстатков Цикл
				Всего = Всего + Остаток.Количество;
				ВсегоСтоимость = ВсегоСтоимость + Остаток.Стоимость;
				Если Остаток.Склад = Склад Тогда
					СтрокаСклада = Остаток;
				КонецЕсли;
			КонецЦикла;
			Если СтрокаСклада = Неопределено Или Всего <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Если СтрокаСклада.Количество <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Количество = ?(Осталось < СтрокаСклада.Количество, Осталось, СтрокаСклада.Количество);
			Стоимость = ?(Количество = Всего, ВсегоСтоимость, Окр(ВсегоСтоимость * Количество / Всего, 2));
			Выручка = ?(Количество = Осталось, ОстатокВыручки,
				Окр(СтрокаТовара.Сумма * Количество / СтрокаТовара.Количество, 2));
			Осталось = Осталось - Количество;
			ОстатокВыручки = ОстатокВыручки - Выручка;
			СтрокаСклада.Количество = СтрокаСклада.Количество - Количество;
			СтрокаСклада.Стоимость = СтрокаСклада.Стоимость - Стоимость;
			Движение = Движения.Хозрасчетный.Добавить();
			Движение.Период = Дата;
			Движение.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
			Движение.СчетКт = ПланыСчетов.Управленческий.Товары;
			Движение.Номенклатура = Товар;
			Движение.Склад = Склад;
			Движение.Количество = Количество;
			Движение.Сумма = Стоимость;
			Движение = Движения.Хозрасчетный.Добавить();
			Движение.Период = Дата;
			Движение.СчетДт = ПланыСчетов.Управленческий.Покупатели;
			Движение.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
			Движение.Номенклатура = СтрокаТовара.Номенклатура;
			Движение.Склад = Склад;
			Движение.Сумма = Выручка;
						Продажа = Движения.ПродажиБух.Добавить();
			Продажа.Период = Дата;
			Продажа.Заказано = СтрокаТовара.Номенклатура;
			Продажа.Продано = Товар;
			Продажа.Количество = Количество;
			Продажа.Стоимость = Стоимость;
			Продажа.Выручка = Выручка;
		КонецЦикла;
		Если Осталось > 0 Тогда
			Отказ = Истина;
			Сообщить("Недостаточно товара и аналогов: " + СтрокаТовара.Номенклатура);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НайтиАналоги(Товар, Связи)
	Кандидаты = Новый Массив;
	Кандидаты.Добавить(Товар);
	Индекс = 0;
	Пока Индекс < Кандидаты.Количество() Цикл
		Текущий = Кандидаты[Индекс];
		Для Каждого Связь Из Связи Цикл
			Сосед = Неопределено;
			Если Связь.Номенклатура = Текущий Тогда
				Сосед = Связь.Аналог;
			ИначеЕсли Связь.Аналог = Текущий Тогда
				Сосед = Связь.Номенклатура;
			КонецЕсли;
			Если Сосед <> Неопределено И Кандидаты.Найти(Сосед) = Неопределено Тогда
				Кандидаты.Добавить(Сосед);
			КонецЕсли;
		КонецЦикла;
		Индекс = Индекс + 1;
	КонецЦикла;
	Возврат Кандидаты;
КонецФункции

Функция СписатьПартииВПамяти(СтрокаТовара, Партии, Метод, Отказ)
	Ключ = Новый Структура("Подразделение,Номенклатура", СтрокаТовара.Подразделение, СтрокаТовара.Номенклатура);
	Найденные = Партии.НайтиСтроки(Ключ);
	Доступные = Новый Массив;
	Всего = 0;
	ВсегоСтоимость = 0;
	Для Каждого Партия Из Найденные Цикл
		Если Партия.Количество > 0 Тогда
			Доступные.Добавить(Партия);
			Всего = Всего + Партия.Количество;
			ВсегоСтоимость = ВсегоСтоимость + Партия.Стоимость;
		КонецЕсли;
	КонецЦикла;
	Если Всего < СтрокаТовара.Количество Тогда
		Отказ = Истина;
		Сообщить("Недостаточно партий: " + СтрокаТовара.Номенклатура);
		Возврат 0;
	КонецЕсли;
	Средняя = Метод <> Перечисления.МетодыОценки.FIFO И Метод <> Перечисления.МетодыОценки.LIFO;
	Если Средняя Тогда
		ПорядокСвойств = Новый Массив;
		Для Каждого Партия Из Доступные Цикл
			Если ПорядокСвойств.Найти(Партия.Свойство) = Неопределено Тогда
				ПорядокСвойств.Добавить(Партия.Свойство);
			КонецЕсли;
		КонецЦикла;
		УпорядоченныеПартии = Новый Массив;
		Для Каждого Свойство Из ПорядокСвойств Цикл
			Для Каждого Партия Из Доступные Цикл
				Если Партия.Свойство = Свойство Тогда
					УпорядоченныеПартии.Добавить(Партия);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Доступные = УпорядоченныеПартии;
	КонецЕсли;
	Осталось = СтрокаТовара.Количество;
	Стоимость = 0;
	ОсталосьСтоимости = ?(СтрокаТовара.Количество = Всего, ВсегоСтоимость,
		Окр(ВсегоСтоимость * СтрокаТовара.Количество / Всего, 2));
	Обработано = 0;
	Индекс = ?(Метод = Перечисления.МетодыОценки.LIFO, Доступные.Количество() - 1, 0);
	Шаг = ?(Метод = Перечисления.МетодыОценки.LIFO, -1, 1);
	Пока Индекс >= 0 И Индекс < Доступные.Количество() Цикл
		Если Не Средняя И Осталось <= 0 Тогда
			Прервать;
		КонецЕсли;
		Партия = Доступные[Индекс];
		Обработано = Обработано + 1;
		Если Не Средняя Тогда
			Количество = ?(Осталось < Партия.Количество, Осталось, Партия.Количество);
			СтоимостьПартии = ?(Количество = Партия.Количество, Партия.Стоимость,
				Окр(Партия.Стоимость * Количество / Партия.Количество, 2));
		Иначе
			Количество = ?(Осталось < Партия.Количество, Осталось, Партия.Количество);
			Количество = ?(Количество > Осталось, Осталось, Количество);
			Количество = ?(Количество > Партия.Количество, Партия.Количество, Количество);
			СтоимостьПартии = ?(Обработано = Доступные.Количество(), ОсталосьСтоимости,
				Окр(Партия.Стоимость * СтрокаТовара.Количество / Всего, 2));
			СтоимостьПартии = ?(СтоимостьПартии > ОсталосьСтоимости, ОсталосьСтоимости, СтоимостьПартии);
			СтоимостьПартии = ?(СтоимостьПартии > Партия.Стоимость, Партия.Стоимость, СтоимостьПартии);
			ОсталосьСтоимости = ОсталосьСтоимости - СтоимостьПартии;
		КонецЕсли;
		Если Количество > 0 Или СтоимостьПартии > 0 Тогда
			Стоимость = Стоимость + СтоимостьПартии;
			Осталось = Осталось - Количество;
			Партия.Количество = Партия.Количество - Количество;
			Партия.Стоимость = Партия.Стоимость - СтоимостьПартии;
			Движение = Движения.Партии.ДобавитьРасход();
			Движение.Период = Дата;
			Движение.Подразделение = СтрокаТовара.Подразделение;
			Движение.Номенклатура = СтрокаТовара.Номенклатура;
			Движение.Партия = Партия.Партия;
			Движение.Свойство = Партия.Свойство;
			Движение.Количество = Количество;
			Движение.Стоимость = СтоимостьПартии;
			ОстатокДвижение = Движения.ОстаткиНоменклатуры.ДобавитьРасход();
			ОстатокДвижение.Период = Дата;
			ОстатокДвижение.Подразделение = СтрокаТовара.Подразделение;
			ОстатокДвижение.Номенклатура = СтрокаТовара.Номенклатура;
			ОстатокДвижение.Свойство = Партия.Свойство;
			ОстатокДвижение.Количество = Количество;
			ОстатокДвижение.Стоимость = СтоимостьПартии;
		КонецЕсли;
		Индекс = Индекс + Шаг;
	КонецЦикла;
	Если Средняя И ОсталосьСтоимости > 0 Тогда
		Для Каждого Партия Из Доступные Цикл
			ДопСтоимость = ?(Партия.Стоимость < ОсталосьСтоимости, Партия.Стоимость, ОсталосьСтоимости);
			Если ДопСтоимость <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Партия.Стоимость = Партия.Стоимость - ДопСтоимость;
			ОсталосьСтоимости = ОсталосьСтоимости - ДопСтоимость;
			Стоимость = Стоимость + ДопСтоимость;
			Движение = Движения.Партии.ДобавитьРасход();
			Движение.Период = Дата;
			Движение.Подразделение = СтрокаТовара.Подразделение;
			Движение.Номенклатура = СтрокаТовара.Номенклатура;
			Движение.Партия = Партия.Партия;
			Движение.Свойство = Партия.Свойство;
			Движение.Стоимость = ДопСтоимость;
			ОстатокДвижение = Движения.ОстаткиНоменклатуры.ДобавитьРасход();
			ОстатокДвижение.Период = Дата;
			ОстатокДвижение.Подразделение = СтрокаТовара.Подразделение;
			ОстатокДвижение.Номенклатура = СтрокаТовара.Номенклатура;
			ОстатокДвижение.Свойство = Партия.Свойство;
			ОстатокДвижение.Стоимость = ДопСтоимость;
			Если ОсталосьСтоимости = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Осталось > 0 Или (Средняя И ОсталосьСтоимости > 0) Тогда
		Отказ = Истина;
		Сообщить("Не удалось распределить количество и стоимость по партиям");
		Возврат 0;
	КонецЕсли;
	Если Средняя Тогда
		ПеренестиСтоимостьПустыхПартий(Доступные, СтрокаТовара.Подразделение, СтрокаТовара.Номенклатура);
	КонецЕсли;
	Возврат Стоимость;
КонецФункции

Процедура ПеренестиСтоимостьПустыхПартий(Партии, Подразделение, Номенклатура)
	Получатель = Неопределено;
	Для Каждого Партия Из Партии Цикл
		Если Партия.Количество > 0 Тогда
			Получатель = Партия;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Получатель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Партия Из Партии Цикл
		Если Партия.Количество <> 0 Или Партия.Стоимость <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Сумма = Партия.Стоимость;
		Партия.Стоимость = 0;
		Получатель.Стоимость = Получатель.Стоимость + Сумма;
		Расход = Движения.Партии.ДобавитьРасход();
		Расход.Период = Дата;
		Расход.Подразделение = Подразделение;
		Расход.Номенклатура = Номенклатура;
		Расход.Партия = Партия.Партия;
		Расход.Свойство = Партия.Свойство;
		Расход.Стоимость = Сумма;
		Приход = Движения.Партии.ДобавитьПриход();
		Приход.Период = Дата;
		Приход.Подразделение = Подразделение;
		Приход.Номенклатура = Номенклатура;
		Приход.Партия = Получатель.Партия;
		Приход.Свойство = Получатель.Свойство;
		Приход.Стоимость = Сумма;
		Если Партия.Свойство <> Получатель.Свойство Тогда
			РасходОстатков = Движения.ОстаткиНоменклатуры.ДобавитьРасход();
			РасходОстатков.Период = Дата;
			РасходОстатков.Подразделение = Подразделение;
			РасходОстатков.Номенклатура = Номенклатура;
			РасходОстатков.Свойство = Партия.Свойство;
			РасходОстатков.Стоимость = Сумма;
			ПриходОстатков = Движения.ОстаткиНоменклатуры.ДобавитьПриход();
			ПриходОстатков.Период = Дата;
			ПриходОстатков.Подразделение = Подразделение;
			ПриходОстатков.Номенклатура = Номенклатура;
			ПриходОстатков.Свойство = Получатель.Свойство;
			ПриходОстатков.Стоимость = Сумма;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
