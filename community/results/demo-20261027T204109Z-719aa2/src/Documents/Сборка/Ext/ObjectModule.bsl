Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Блоки.Количество() = 0 Тогда
		Отказ = Истина;
		Сообщить("Не указаны собираемые блоки");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ПодразделениеИсточник) Или Не ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда
		Отказ = Истина;
		Сообщить("Укажите подразделения источника и получателя");
		Возврат;
	КонецЕсли;
	Потребность = Новый ТаблицаЗначений;
	Потребность.Колонки.Добавить("Номенклатура");
	Потребность.Колонки.Добавить("Свойство");
	Потребность.Колонки.Добавить("Количество");
	Распределение = Новый ТаблицаЗначений;
	Распределение.Колонки.Добавить("НомерБлока");
	Распределение.Колонки.Добавить("Номенклатура");
	Распределение.Колонки.Добавить("Свойство");
	Распределение.Колонки.Добавить("Количество");
	Распределение.Колонки.Добавить("Стоимость");
	ВсегоБлоков = 0;
	ИменаБлоков = Новый Массив;
	Для Каждого Блок Из Блоки Цикл
		Если ИменаБлоков.Найти(Блок.Номенклатура) = Неопределено Тогда
			ИменаБлоков.Добавить(Блок.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	БлокировкаСпецификаций = Новый БлокировкаДанных;
	ЭлементСпецификаций = БлокировкаСпецификаций.Добавить("РегистрСведений.Спецификации");
	ЭлементСпецификаций.Режим = РежимБлокировкиДанных.Исключительный;
	БлокировкаСпецификаций.Заблокировать();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Версия.Блок КАК Блок, МАКСИМУМ(Версия.Период) КАК Период
		|ПОМЕСТИТЬ ПоследниеВерсии
		|ИЗ РегистрСведений.Спецификации КАК Версия
		|ГДЕ Версия.Блок В (&Блоки) И Версия.Период <= &Дата
		|СГРУППИРОВАТЬ ПО Версия.Блок;
		|ВЫБРАТЬ Спецификация.Блок КАК Блок, Спецификация.Деталь КАК Деталь,
		| Спецификация.Свойство КАК Свойство, Спецификация.Количество КАК Количество
		|ИЗ РегистрСведений.Спецификации КАК Спецификация
		| ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоследниеВерсии КАК Версии
		| ПО Спецификация.Блок = Версии.Блок И Спецификация.Период = Версии.Период";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Блоки", ИменаБлоков);
	Спецификации = Запрос.Выполнить().Выгрузить();
	Спецификации.Индексы.Добавить("Блок");
	Для Каждого Блок Из Блоки Цикл
				Если Не ЗначениеЗаполнено(Блок.Номенклатура) Или Блок.Количество <= 0 Тогда
			Отказ = Истина;
						Сообщить("Укажите блок и положительное количество");
			Продолжить;
		КонецЕсли;
		ВсегоБлоков = ВсегоБлоков + Блок.Количество;
		Состав = Спецификации.НайтиСтроки(Новый Структура("Блок", Блок.Номенклатура));
		ЕстьСостав = Состав.Количество() > 0;
		Для Каждого Выборка Из Состав Цикл
			СтрокаПотребности = Потребность.Добавить();
			СтрокаПотребности.Номенклатура = Выборка.Деталь;
			СтрокаПотребности.Свойство = Выборка.Свойство;
			СтрокаПотребности.Количество = Выборка.Количество * Блок.Количество;
			Доля = Распределение.Добавить();
			Доля.НомерБлока = Блок.НомерСтроки;
			Доля.Номенклатура = СтрокаПотребности.Номенклатура;
			Доля.Свойство = СтрокаПотребности.Свойство;
			Доля.Количество = СтрокаПотребности.Количество;
		КонецЦикла;
		Если Не ЕстьСостав Тогда
			Отказ = Истина;
			Сообщить("Не найдена спецификация: " + Блок.Номенклатура);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Деталь Из ДополнительныеДетали Цикл
		Если Не ЗначениеЗаполнено(Деталь.Номенклатура) Или Деталь.Количество <= 0 Тогда
			Отказ = Истина;
			Сообщить("Укажите дополнительную деталь и положительное количество");
			Продолжить;
		КонецЕсли;
		СтрокаПотребности = Потребность.Добавить();
		СтрокаПотребности.Номенклатура = Деталь.Номенклатура;
		СтрокаПотребности.Свойство = Деталь.Свойство;
		СтрокаПотребности.Количество = Деталь.Количество;
		Доля = Распределение.Добавить();
		Доля.НомерБлока = 0;
		Доля.Номенклатура = Деталь.Номенклатура;
		Доля.Свойство = Деталь.Свойство;
		Доля.Количество = Деталь.Количество;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Потребность.Свернуть("Номенклатура,Свойство", "Количество");
	Движения.ОстаткиНоменклатуры.Очистить();
	Движения.Партии.Очистить();
	Движения.ОстаткиНоменклатуры.Записать();
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	Движения.Партии.Записать();
	Движения.Партии.Записывать = Истина;
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементПартий = Блокировка.Добавить("РегистрНакопления.Партии");
	ЭлементПартий.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	ИменаДеталей = Потребность.ВыгрузитьКолонку("Номенклатура");
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ Остатки.Номенклатура, Остатки.Свойство,
		| Остатки.КоличествоОстаток КАК Количество, Остатки.СтоимостьОстаток КАК Стоимость
		|ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(&Момент,
		| Подразделение = &Подразделение И Номенклатура В (&Детали)) КАК Остатки";
	Запрос.УстановитьПараметр("Момент", Новый Граница(МоментВремени(), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Подразделение", ПодразделениеИсточник);
	Запрос.УстановитьПараметр("Детали", ИменаДеталей);
	Остатки = Запрос.Выполнить().Выгрузить();
	Остатки.Индексы.Добавить("Номенклатура,Свойство");
	Запрос.Текст = "ВЫБРАТЬ Партии.Номенклатура, Партии.Свойство, Партии.Партия,
		| Партии.КоличествоОстаток КАК Количество, Партии.СтоимостьОстаток КАК Стоимость
		|ИЗ РегистрНакопления.Партии.Остатки(&Момент,
		| Подразделение = &Подразделение И Номенклатура В (&Детали)) КАК Партии
		|ГДЕ Партии.КоличествоОстаток > 0";
	Партии = Запрос.Выполнить().Выгрузить();
	Партии.Индексы.Добавить("Номенклатура,Свойство");
	ОбщаяСтоимость = 0;
	Для Каждого Позиция Из Потребность Цикл
		НайденныеОстатки = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Свойство", Позиция.Номенклатура, Позиция.Свойство));
		Если НайденныеОстатки.Количество() = 0 Тогда
			Отказ = Истина;
			Сообщить("Нет детали: " + Позиция.Номенклатура);
			Продолжить;
		КонецЕсли;
		Остаток = НайденныеОстатки[0];
		Если Позиция.Количество <= 0 Или Остаток.Количество < Позиция.Количество Тогда
			Отказ = Истина;
			Сообщить("Недостаточно детали: " + Позиция.Номенклатура);
			Продолжить;
		КонецЕсли;
				Стоимость = СписатьПартииДеталей(Позиция, Партии, Отказ);
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		ОбщаяСтоимость = ОбщаяСтоимость + Стоимость;
		Доли = Распределение.НайтиСтроки(Новый Структура("Номенклатура,Свойство", Позиция.Номенклатура, Позиция.Свойство));
		ОстатокСтоимостьДетали = Стоимость;
		ОстатокКоличествоДетали = Позиция.Количество;
		Для Каждого Доля Из Доли Цикл
			Доля.Стоимость = ?(Доля.Количество = ОстатокКоличествоДетали, ОстатокСтоимостьДетали,
				Окр(Стоимость * Доля.Количество / Позиция.Количество, 2));
			ОстатокСтоимостьДетали = ОстатокСтоимостьДетали - Доля.Стоимость;
			ОстатокКоличествоДетали = ОстатокКоличествоДетали - Доля.Количество;
		КонецЦикла;
		Движение = Движения.ОстаткиНоменклатуры.ДобавитьРасход();
		Движение.Период = Дата;
		Движение.Подразделение = ПодразделениеИсточник;
		Движение.Номенклатура = Позиция.Номенклатура;
		Движение.Свойство = Позиция.Свойство;
		Движение.Количество = Позиция.Количество;
		Движение.Стоимость = Стоимость;
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	ДополнительнаяСтоимость = 0;
	Для Каждого Доля Из Распределение Цикл
		Если Доля.НомерБлока = 0 Тогда
			ДополнительнаяСтоимость = ДополнительнаяСтоимость + Доля.Стоимость;
		КонецЕсли;
	КонецЦикла;
	ОстатокДополнительнойСтоимости = ДополнительнаяСтоимость;
	ОстатокБлоков = ВсегоБлоков;
	Для Каждого Блок Из Блоки Цикл
		Стоимость = 0;
		Для Каждого Доля Из Распределение Цикл
			Если Доля.НомерБлока = Блок.НомерСтроки Тогда
				Стоимость = Стоимость + Доля.Стоимость;
			КонецЕсли;
		КонецЦикла;
		ДопСтоимость = ?(ОстатокБлоков = Блок.Количество, ОстатокДополнительнойСтоимости,
			Окр(ДополнительнаяСтоимость * Блок.Количество / ВсегоБлоков, 2));
		Стоимость = Стоимость + ДопСтоимость;
		ОстатокДополнительнойСтоимости = ОстатокДополнительнойСтоимости - ДопСтоимость;
		ОстатокБлоков = ОстатокБлоков - Блок.Количество;
		Движение = Движения.ОстаткиНоменклатуры.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Подразделение = ПодразделениеПолучатель;
		Движение.Номенклатура = Блок.Номенклатура;
		Движение.Количество = Блок.Количество;
		Движение.Стоимость = Стоимость;
		Партия = Движения.Партии.ДобавитьПриход();
		Партия.Период = Дата;
		Партия.Подразделение = ПодразделениеПолучатель;
		Партия.Номенклатура = Блок.Номенклатура;
		Партия.Партия = Ссылка;
		Партия.Количество = Блок.Количество;
		Партия.Стоимость = Стоимость;
	КонецЦикла;
КонецПроцедуры

Функция СписатьПартииДеталей(Позиция, Партии, Отказ)
	Строки = Партии.НайтиСтроки(Новый Структура("Номенклатура,Свойство", Позиция.Номенклатура, Позиция.Свойство));
	Доступные = Новый Массив;
	Всего = 0;
	ВсегоСтоимость = 0;
	Для Каждого Партия Из Строки Цикл
		Если Партия.Количество > 0 Тогда
			Доступные.Добавить(Партия);
			Всего = Всего + Партия.Количество;
			ВсегоСтоимость = ВсегоСтоимость + Партия.Стоимость;
		КонецЕсли;
	КонецЦикла;
	Если Всего < Позиция.Количество Тогда
		Отказ = Истина;
		Сообщить("Недостаточно партий детали: " + Позиция.Номенклатура);
		Возврат 0;
	КонецЕсли;
	Осталось = Позиция.Количество;
	ОсталосьСтоимости = ?(Позиция.Количество = Всего, ВсегоСтоимость,
		Окр(ВсегоСтоимость * Позиция.Количество / Всего, 2));
	Стоимость = 0;
	Номер = 0;
	Для Каждого Партия Из Доступные Цикл
		Номер = Номер + 1;
		Количество = ?(Номер = Доступные.Количество(), Осталось,
			Окр(Позиция.Количество * Партия.Количество / Всего, 2));
		Количество = ?(Количество > Осталось, Осталось, Количество);
		Количество = ?(Количество > Партия.Количество, Партия.Количество, Количество);
		Сумма = ?(Номер = Доступные.Количество(), ОсталосьСтоимости,
			Окр(Партия.Стоимость * Позиция.Количество / Всего, 2));
		Сумма = ?(Сумма > ОсталосьСтоимости, ОсталосьСтоимости, Сумма);
		Сумма = ?(Сумма > Партия.Стоимость, Партия.Стоимость, Сумма);
		Если Количество > 0 Или Сумма > 0 Тогда
			Осталось = Осталось - Количество;
			ОсталосьСтоимости = ОсталосьСтоимости - Сумма;
			Стоимость = Стоимость + Сумма;
			Партия.Количество = Партия.Количество - Количество;
			Партия.Стоимость = Партия.Стоимость - Сумма;
			Движение = Движения.Партии.ДобавитьРасход();
			Движение.Период = Дата;
			Движение.Подразделение = ПодразделениеИсточник;
			Движение.Номенклатура = Позиция.Номенклатура;
			Движение.Свойство = Позиция.Свойство;
			Движение.Партия = Партия.Партия;
			Движение.Количество = Количество;
			Движение.Стоимость = Сумма;
		КонецЕсли;
	КонецЦикла;
	Если ОсталосьСтоимости > 0 Тогда
		Для Каждого Партия Из Доступные Цикл
			ДопСтоимость = ?(Партия.Стоимость < ОсталосьСтоимости, Партия.Стоимость, ОсталосьСтоимости);
			Если ДопСтоимость <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Партия.Стоимость = Партия.Стоимость - ДопСтоимость;
			ОсталосьСтоимости = ОсталосьСтоимости - ДопСтоимость;
			Стоимость = Стоимость + ДопСтоимость;
			Движение = Движения.Партии.ДобавитьРасход();
			Движение.Период = Дата;
			Движение.Подразделение = ПодразделениеИсточник;
			Движение.Номенклатура = Позиция.Номенклатура;
			Движение.Свойство = Позиция.Свойство;
			Движение.Партия = Партия.Партия;
			Движение.Стоимость = ДопСтоимость;
			Если ОсталосьСтоимости = 0 Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Осталось > 0 Или ОсталосьСтоимости > 0 Тогда
		Отказ = Истина;
		Сообщить("Не удалось распределить детали и стоимость по партиям");
		Возврат 0;
	КонецЕсли;
	ПеренестиСтоимостьПустыхПартий(Доступные, Позиция);
	Возврат Стоимость;
КонецФункции

Процедура ПеренестиСтоимостьПустыхПартий(Партии, Позиция)
	Получатель = Неопределено;
	Для Каждого Партия Из Партии Цикл
		Если Партия.Количество > 0 Тогда
			Получатель = Партия;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Получатель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Партия Из Партии Цикл
		Если Партия.Количество <> 0 Или Партия.Стоимость <= 0 Тогда
			Продолжить;
		КонецЕсли;
		Сумма = Партия.Стоимость;
		Партия.Стоимость = 0;
		Получатель.Стоимость = Получатель.Стоимость + Сумма;
		Расход = Движения.Партии.ДобавитьРасход();
		Расход.Период = Дата;
		Расход.Подразделение = ПодразделениеИсточник;
		Расход.Номенклатура = Позиция.Номенклатура;
		Расход.Свойство = Позиция.Свойство;
		Расход.Партия = Партия.Партия;
		Расход.Стоимость = Сумма;
		Приход = Движения.Партии.ДобавитьПриход();
		Приход.Период = Дата;
		Приход.Подразделение = ПодразделениеИсточник;
		Приход.Номенклатура = Позиция.Номенклатура;
		Приход.Свойство = Позиция.Свойство;
		Приход.Партия = Получатель.Партия;
		Приход.Стоимость = Сумма;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементПартий = Блокировка.Добавить("РегистрНакопления.Партии");
	ЭлементПартий.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1 Партии.Регистратор КАК Регистратор
		|ИЗ РегистрНакопления.Партии КАК Партии
		|ГДЕ Партии.Партия = &Партия
		| И Партии.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)";
	Запрос.УстановитьПараметр("Партия", Ссылка);
	Если Запрос.Выполнить().Выбрать().Следующий() Тогда
		Отказ = Истина;
		Сообщить("Нельзя отменить сборку: её продукция уже использована. Сначала отмените последующие документы.");
	КонецЕсли;
