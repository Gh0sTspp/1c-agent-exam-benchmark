#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент) Экспорт
	ОбновитьДополнительныеПоляНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьДополнительныеПоляНаСервере()
	СохранитьДополнительныеПоля();
	ПостроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	СохранитьДополнительныеПоля();
		ТекущийОбъект.ДополнительныеСведения.Очистить();
	Для Каждого СтрокаСведения Из Объект.ДополнительныеСведения Цикл
		НоваяСтрока = ТекущийОбъект.ДополнительныеСведения.Добавить();
		НоваяСтрока.ВидСведения = СтрокаСведения.ВидСведения;
		НоваяСтрока.Значение = СтрокаСведения.Значение;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ИмяПоляСведения(Вид)
	Возврат "Доп" + СтрЗаменить(Строка(Вид.УникальныйИдентификатор()), "-", "");
КонецФункции

&НаСервере
Процедура СохранитьДополнительныеПоля()
	Для Каждого СтрокаСведения Из Объект.ДополнительныеСведения Цикл
		Если Не ЗначениеЗаполнено(СтрокаСведения.ВидСведения) Тогда
			Продолжить;
		КонецЕсли;
		Имя = ИмяПоляСведения(СтрокаСведения.ВидСведения);
		Если Элементы.Найти(Имя) <> Неопределено Тогда
			СтрокаСведения.Значение = ЭтаФорма[Имя];
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПостроитьДополнительныеПоля()
	Удаляемые = Новый Массив;
	Для Каждого СтрокаСведения Из Объект.ДополнительныеСведения Цикл
		Если ЗначениеЗаполнено(СтрокаСведения.ВидСведения) Тогда
			Имя = ИмяПоляСведения(СтрокаСведения.ВидСведения);
			Элемент = Элементы.Найти(Имя);
			Если Элемент <> Неопределено Тогда
				Элементы.Удалить(Элемент);
				Удаляемые.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Удаляемые.Количество() > 0 Тогда
		ИзменитьРеквизиты(, Удаляемые);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Менеджер) Тогда
		Возврат;
	КонецЕсли;
	Менеджер = Объект.Менеджер.ПолучитьОбъект();
	Добавляемые = Новый Массив;
	Имена = Новый Массив;
	Для Каждого Настройка Из Менеджер.ДополнительныеСведения Цикл
		Если Не ЗначениеЗаполнено(Настройка.ВидСведения) Тогда
			Продолжить;
		КонецЕсли;
		Имя = ИмяПоляСведения(Настройка.ВидСведения);
		Если Имена.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Имена.Добавить(Имя);
				Добавляемые.Добавить(Новый РеквизитФормы(Имя, Настройка.ВидСведения.ТипЗначения));
	КонецЦикла;
	Если Добавляемые.Количество() > 0 Тогда
		ИзменитьРеквизиты(Добавляемые);
	КонецЕсли;
	Для Каждого Настройка Из Менеджер.ДополнительныеСведения Цикл
		Если Не ЗначениеЗаполнено(Настройка.ВидСведения) Тогда
			Продолжить;
		КонецЕсли;
		Имя = ИмяПоляСведения(Настройка.ВидСведения);
		Если Элементы.Найти(Имя) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Элемент = Элементы.Добавить(Имя, Тип("ПолеФормы"));
		Элемент.Вид = ВидПоляФормы.ПолеВвода;
		Элемент.ПутьКДанным = Имя;
		Элемент.Заголовок = Строка(Настройка.ВидСведения);
		СтрокаЗначения = Неопределено;
		Для Каждого СуществующаяСтрока Из Объект.ДополнительныеСведения Цикл
			Если СуществующаяСтрока.ВидСведения = Настройка.ВидСведения Тогда
				СтрокаЗначения = СуществующаяСтрока;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если СтрокаЗначения = Неопределено Тогда
			СтрокаЗначения = Объект.ДополнительныеСведения.Добавить();
			СтрокаЗначения.ВидСведения = Настройка.ВидСведения;
		КонецЕсли;
		ЭтаФорма[Имя] = СтрокаЗначения.Значение;
	КонецЦикла;
КонецПроцедуры
