Процедура ПередЗаписью(Отказ, Замещение)
		Если ЭтотОбъект.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить("РегистрСведений.Спецификации");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Блокировка.Заблокировать();
	Блоки = Новый Массив;
	Начало = Неопределено;
	Конец = Неопределено;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если Блоки.Найти(Запись.Блок) = Неопределено Тогда
			Блоки.Добавить(Запись.Блок);
		КонецЕсли;
		НачалоЗаписи = НачалоНедели(Запись.Период);
		КонецЗаписи = КонецНедели(Запись.Период);
		Если Начало = Неопределено Или НачалоЗаписи < Начало Тогда
			Начало = НачалоЗаписи;
		КонецЕсли;
		Если Конец = Неопределено Или КонецЗаписи > Конец Тогда
			Конец = КонецЗаписи;
		КонецЕсли;
		Для Каждого ДругаяЗапись Из ЭтотОбъект Цикл
			Если Запись.Блок = ДругаяЗапись.Блок
				И НачалоНедели(Запись.Период) = НачалоНедели(ДругаяЗапись.Период)
				И НачалоДня(Запись.Период) <> НачалоДня(ДругаяЗапись.Период) Тогда
				Отказ = Истина;
				Сообщить("Спецификация блока может изменяться только один раз в неделю");
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Спецификация.Блок КАК Блок, Спецификация.Период КАК Период
		|ИЗ РегистрСведений.Спецификации КАК Спецификация
		|ГДЕ Спецификация.Блок В (&Блоки) И Спецификация.Период МЕЖДУ &Начало И &Конец";
	Запрос.УстановитьПараметр("Блоки", Блоки);
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("Конец", Конец);
	Существующие = Запрос.Выполнить().Выгрузить();
	Существующие.Индексы.Добавить("Блок");
	Для Каждого Запись Из ЭтотОбъект Цикл
		Для Каждого Существующая Из Существующие.НайтиСтроки(Новый Структура("Блок", Запись.Блок)) Цикл
			Если НачалоНедели(Существующая.Период) = НачалоНедели(Запись.Период)
				И НачалоДня(Существующая.Период) <> НачалоДня(Запись.Период) Тогда
				Отказ = Истина;
				Сообщить("Спецификация блока уже менялась на этой неделе");
				Возврат;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры
