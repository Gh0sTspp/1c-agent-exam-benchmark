Процедура СоздатьПримерАналогов()
	СкладОбъект = Справочники.Склады.СоздатьЭлемент();
	СкладОбъект.Наименование = "Проверка аналогов";
	СкладОбъект.Записать();
	Товары = Новый Массив;
	Для Индекс = 1 По 3 Цикл
		Товар = Справочники.Номенклатура.СоздатьЭлемент();
		Товар.Наименование = "Аналог " + Индекс;
		Товар.Артикул = "A" + Индекс;
		Товар.Записать();
		Товары.Добавить(Товар.Ссылка);
	КонецЦикла;
	Для Индекс = 0 По 1 Цикл
		Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
		Связь.Номенклатура = Товары[Индекс];
		Связь.Аналог = Товары[Индекс + 1];
		Связь.Записать();
	КонецЦикла;
	Для Индекс = 1 По 2 Цикл
		Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
		Приход.Дата = Дата(2024, 3, Индекс);
		Приход.Склад = СкладОбъект.Ссылка;
		СтрокаТовара = Приход.СписокНоменклатуры.Добавить();
		СтрокаТовара.Номенклатура = Товары[Индекс];
		СтрокаТовара.Количество = 1;
		СтрокаТовара.Сумма = 100 * Индекс;
		Приход.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;
	Расход = Документы.РасходнаяНакладная.СоздатьДокумент();
	Расход.Дата = Дата(2024, 3, 3);
	Расход.Склад = СкладОбъект.Ссылка;
	СтрокаТовара = Расход.СписокНоменклатуры.Добавить();
	СтрокаТовара.Номенклатура = Товары[0];
	СтрокаТовара.Количество = 2;
	СтрокаТовара.Сумма = 500;
	Расход.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры






