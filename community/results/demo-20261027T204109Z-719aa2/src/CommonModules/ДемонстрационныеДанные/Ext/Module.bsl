Процедура Заполнить() Экспорт
	Подразделение = Справочники.Подразделения.НайтиПоНаименованию("Демо цех", Истина);
	Если Подразделение.Пустая() Тогда
		Объект = Справочники.Подразделения.СоздатьЭлемент();
		Объект.Наименование = "Демо цех";
		Объект.Записать();
		Подразделение = Объект.Ссылка;
	КонецЕсли;
	Склад = Справочники.Склады.НайтиПоНаименованию("Демо склад", Истина);
	Если Склад.Пустая() Тогда
		Объект = Справочники.Склады.СоздатьЭлемент();
		Объект.Наименование = "Демо склад";
		Объект.Записать();
		Склад = Объект.Ссылка;
	КонецЕсли;
	Товар = Справочники.Номенклатура.НайтиПоНаименованию("Демо деталь", Истина);
	Если Товар.Пустая() Тогда
		Объект = Справочники.Номенклатура.СоздатьЭлемент();
		Объект.Наименование = "Демо деталь";
		Объект.Артикул = "DEMO-01";
		Объект.Записать();
		Товар = Объект.Ссылка;
	КонецЕсли;
	Свойство = Справочники.СвойстваНоменклатуры.СоздатьЭлемент();
	Свойство.Наименование = "Демо свойство";
	Свойство.Записать();
	Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
	Вид.Наименование = "Производитель";
	Вид.ТипЗначения = Новый ОписаниеТипов("Строка");
	Вид.Записать();
	ЗначениеСвойства = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
	ЗначениеСвойства.Свойство = Свойство.Ссылка;
	ЗначениеСвойства.Характеристика = Вид.Ссылка;
	ЗначениеСвойства.Значение = "ASUS";
	ЗначениеСвойства.Записать();
	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2024, 1, 10);
	Приход.Подразделение = Подразделение;
	Приход.Склад = Склад;
	СтрокаТовара = Приход.СписокНоменклатуры.Добавить();
	СтрокаТовара.Номенклатура = Товар;
	СтрокаТовара.Свойство = Свойство.Ссылка;
	СтрокаТовара.Количество = 10;
	СтрокаТовара.Цена = 100;
	СтрокаТовара.Сумма = 1000;
	Приход.Записать(РежимЗаписиДокумента.Проведение);
	СоздатьПримерСборки();
	СоздатьПримерПродажи();
	СоздатьПримерТарифа();
	СоздатьПримерРасчетов();
	СоздатьПримерАналогов();
	Операция = Документы.Операция.СоздатьДокумент();
	Операция.Дата = Дата(2024, 4, 1);
	Проводка = Операция.Проводки.Добавить();
	Проводка.СчетДт = ПланыСчетов.Управленческий.Поставщики;
	Проводка.СчетКт = ПланыСчетов.Управленческий.Покупатели;
	Проводка.Сумма = 50;
	Операция.Записать(РежимЗаписиДокумента.Проведение);
	ВидСведения = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
	ВидСведения.Наименование = "Регион";
	ВидСведения.ТипЗначения = Новый ОписаниеТипов("Строка");
	ВидСведения.Записать();
	Менеджер = Справочники.ФизическиеЛица.СоздатьЭлемент();
	Менеджер.Наименование = "Демо менеджер";
	Настройка = Менеджер.ДополнительныеСведения.Добавить();
	Настройка.ВидСведения = ВидСведения.Ссылка;
	Менеджер.Записать();
	Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
	Контрагент.Наименование = "Демо контрагент";
	Контрагент.Менеджер = Менеджер.Ссылка;
	Сведение = Контрагент.ДополнительныеСведения.Добавить();
	Сведение.ВидСведения = ВидСведения.Ссылка;
	Сведение.Значение = "Москва";
	Контрагент.Записать();
КонецПроцедуры


