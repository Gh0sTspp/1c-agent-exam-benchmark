#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда) Экспорт
	СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
	Таблица = Отчеты.Ведомость.СформироватьДанные(НачалоДня(НачалоПериода), КонецДня(КонецПериода), Подразделение);
	Дерево = Новый ДеревоЗначений;
	Для Каждого Имя Из СтрРазделить("Характеристика,Номенклатура,НачальныйОстаток,Приход,Расход,КонечныйОстаток", ",") Цикл
		Дерево.Колонки.Добавить(Имя);
	КонецЦикла;
	Группы = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Ключ = Строка(СтрокаТаблицы.ВидХарактеристики) + "|" + Строка(СтрокаТаблицы.Характеристика);
		Группа = Группы.Получить(Ключ);
		Если Группа = Неопределено Тогда
			Группа = Дерево.Строки.Добавить();
			Группа.Характеристика = Строка(СтрокаТаблицы.Характеристика);
			Группы.Вставить(Ключ, Группа);
		КонецЕсли;
		Количество = Группа.Строки.Добавить();
		Количество.Номенклатура = СтрокаТаблицы.Номенклатура;
		Количество.НачальныйОстаток = СтрокаТаблицы.НачальноеКоличество;
		Количество.Приход = СтрокаТаблицы.ПриходКоличество;
		Количество.Расход = СтрокаТаблицы.РасходКоличество;
		Количество.КонечныйОстаток = СтрокаТаблицы.КонечноеКоличество;
		Стоимость = Группа.Строки.Добавить();
		Стоимость.НачальныйОстаток = СтрокаТаблицы.НачальнаяСтоимость;
		Стоимость.Приход = СтрокаТаблицы.ПриходСтоимость;
		Стоимость.Расход = СтрокаТаблицы.РасходСтоимость;
		Стоимость.КонечныйОстаток = СтрокаТаблицы.КонечнаяСтоимость;
	КонецЦикла;
	ЗначениеВРеквизитФормы(Дерево, "Отображение");
КонецПроцедуры






