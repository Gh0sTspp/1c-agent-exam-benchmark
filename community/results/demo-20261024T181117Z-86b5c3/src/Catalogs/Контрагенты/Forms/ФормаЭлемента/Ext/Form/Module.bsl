#Область ОбработчикиСобытийФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    ПерестроитьДополнительныеПоля();
КонецПроцедуры

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)
    ОбновитьПоляМенеджера();
КонецПроцедуры

&НаСервере
Процедура ОбновитьПоляМенеджера()
    СохранитьЗначенияВТаблицу(Объект.ДополнительныеСведения);
    ПерестроитьДополнительныеПоля();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
    СохранитьЗначенияВТаблицу(ТекущийОбъект.ДополнительныеСведения);
КонецПроцедуры

&НаСервере
Процедура СохранитьЗначенияВТаблицу(Таблица)
    Для Каждого Поле Из СоставДополнительныхПолей Цикл
        НайденнаяСтрока = Неопределено;
        Для Каждого Строка Из Таблица Цикл
            Если Строка.ВидСведения = Поле.ВидСведения Тогда НайденнаяСтрока = Строка; Прервать; КонецЕсли;
        КонецЦикла;
        Если НайденнаяСтрока = Неопределено Тогда
            НайденнаяСтрока = Таблица.Добавить();
            НайденнаяСтрока.ВидСведения = Поле.ВидСведения;
        КонецЕсли;
        НайденнаяСтрока.Значение = ЭтотОбъект[Поле.ИмяПоля];
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПерестроитьДополнительныеПоля()
    Удаляемые = Новый Массив;
    Для Каждого Поле Из СоставДополнительныхПолей Цикл
        Элемент = Элементы.Найти(Поле.ИмяПоля);
        Если Элемент <> Неопределено Тогда Элементы.Удалить(Элемент); КонецЕсли;
        Удаляемые.Добавить(Поле.ИмяПоля);
    КонецЦикла;
    СоставДополнительныхПолей.Очистить();
    ВидыСведений = УчетСервер.ЗапросТаблица(
    "ВЫБРАТЬ Ссылка КАК ВидСведения, Наименование КАК Заголовок, ТипЗначения
    |ИЗ ПланВидовХарактеристик.СвойстваОбъектов
    |ГДЕ Ссылка В (ВЫБРАТЬ ВидСведения ИЗ Справочник.ФизическиеЛица.ДополнительныеСведения ГДЕ Ссылка = &Менеджер)
    |УПОРЯДОЧИТЬ ПО Заголовок", Новый Структура("Менеджер", Объект.Менеджер));
    Добавляемые = Новый Массив;
    Для Каждого Вид Из ВидыСведений Цикл
        ИмяПоля = "ДопСведение_" + СтрЗаменить(Строка(Вид.ВидСведения.УникальныйИдентификатор()), "-", "");
        Добавляемые.Добавить(Новый РеквизитФормы(ИмяПоля, Вид.ТипЗначения));
        Описание = СоставДополнительныхПолей.Добавить();
        Описание.ИмяПоля = ИмяПоля;
        Описание.ВидСведения = Вид.ВидСведения;
    КонецЦикла;
    ИзменитьРеквизиты(Добавляемые, Удаляемые);
    Для Каждого Вид Из ВидыСведений Цикл
        Описания = СоставДополнительныхПолей.НайтиСтроки(Новый Структура("ВидСведения", Вид.ВидСведения));
        ИмяПоля = Описания[0].ИмяПоля;
        Элемент = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), Элементы.ГруппаДополнительныхСведений);
        Элемент.Вид = ВидПоляФормы.ПолеВвода;
        Элемент.ПутьКДанным = ИмяПоля;
        Элемент.Заголовок = Вид.Заголовок;
        Сохраненные = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("ВидСведения", Вид.ВидСведения));
        Если Сохраненные.Количество() > 0 Тогда
            ЭтотОбъект[ИмяПоля] = Сохраненные[0].Значение;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры

