&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
    НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
    КонецПериода = КонецМесяца(НачалоПериода);
    Реквизиты = Новый Массив;
    Реквизиты.Добавить(Новый РеквизитФормы("Результат", Новый ОписаниеТипов("ТабличныйДокумент")));
    ИзменитьРеквизиты(Реквизиты);
    Поле = Элементы.Добавить("Результат", Тип("ПолеФормы"));
    Поле.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
    Поле.ПутьКДанным = "Результат";
    Поле.Высота = 20;
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
    СформироватьНаСервере();
КонецПроцедуры

&НаСервере
Процедура СформироватьНаСервере()
    Данные = Отчеты.ПродажиТоваров.СформироватьДанные(НачалоПериода, КонецПериода);
    Заголовок = "Продажи с " + Формат(НачалоПериода, "ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода, "ДФ=dd.MM.yyyy");
    ЭтотОбъект["Результат"] = УчетСервер.ПечатныйОтчет(Данные, "ПродажиТоваров", Заголовок);
КонецПроцедуры
