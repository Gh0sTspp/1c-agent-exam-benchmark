Функция Элемент(ИмяСправочника, Наименование)
    Ссылка = Справочники[ИмяСправочника].НайтиПоНаименованию(Наименование, Истина);
    Если ЗначениеЗаполнено(Ссылка) Тогда Возврат Ссылка; КонецЕсли;
    Объект = Справочники[ИмяСправочника].СоздатьЭлемент();
    Объект.Наименование = Наименование;
    Объект.Записать();
    Возврат Объект.Ссылка;
КонецФункции

Процедура СтрокаТовара(ДокументОбъект, Товар, Свойство, Количество, Цена, Подразделение = Неопределено)
    Строка = ДокументОбъект.СписокНоменклатуры.Добавить();
    Строка.Номенклатура = Товар;
    Если Свойство <> Неопределено Тогда Строка.Свойство = Свойство; КонецЕсли;
    Если Подразделение <> Неопределено Тогда Строка.Подразделение = Подразделение; КонецЕсли;
    Строка.Количество = Количество;
    Строка.Цена = Цена;
    Строка.Сумма = Количество * Цена;
КонецПроцедуры

Процедура СтрокаНачисления(ДокументОбъект, Сотрудник, Подразделение, Вид, Начало, Конец)
    Строка = ДокументОбъект.ОсновныеНачисления.Добавить();
    Строка.Сотрудник = Сотрудник;
    Строка.Подразделение = Подразделение;
    Строка.ВидРасчета = Вид;
    Строка.ДатаНачала = Начало;
    Строка.ДатаОкончания = Конец;
    Строка.ПериодРегистрации = НачалоМесяца(ДокументОбъект.Дата);
КонецПроцедуры

Процедура Заполнить() Экспорт
    Если ЗначениеЗаполнено(Документы.ПриходнаяНакладная.НайтиПоНомеру("ДЕМО00001", Дата(2014,1,2))) Тогда Возврат; КонецЕсли;
    НачатьТранзакцию();
    Попытка
        Цех = Элемент("Подразделения", "Демо: основной цех");
        Магазин = Элемент("Подразделения", "Демо: магазин");
        Склад = Элемент("Склады", "Демо: основной склад");
        Поставщик = Элемент("Контрагенты", "Демо: поставщик");
        Деталь = Элемент("Номенклатура", "Демо: материнская плата");
        Блок = Элемент("Номенклатура", "Демо: системный блок");
        Принтер = Элемент("Номенклатура", "Демо: принтер");
        Аналог = Элемент("Номенклатура", "Демо: принтер аналог");
        Объект = Деталь.ПолучитьОбъект(); Объект.Артикул = "Д001"; Объект.Записать();
        Объект = Блок.ПолучитьОбъект(); Объект.Артикул = "Б001"; Объект.Записать();
        Объект = Принтер.ПолучитьОбъект(); Объект.Артикул = "П001"; Объект.Записать();
        Объект = Аналог.ПолучитьОбъект(); Объект.Артикул = "П002"; Объект.Записать();
        Характеристика = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию("Производитель");
        Если Не ЗначениеЗаполнено(Характеристика) Тогда
            Вид = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
            Вид.Наименование = "Производитель";
            Вид.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150));
            Вид.Записать(); Характеристика = Вид.Ссылка;
        КонецЕсли;
        Свойство = Элемент("СвойстваНоменклатуры", "Демо: ASUS");
        Объект = Свойство.ПолучитьОбъект(); Объект.Номенклатура = Деталь; Объект.Записать();
        Значение = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
        Значение.Свойство = Свойство; Значение.Характеристика = Характеристика; Значение.Значение = "ASUS"; Значение.Записать();
        Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
        Политика.Период = Дата(2014,1,1); Политика.Подразделение = Цех; Политика.Метод = Перечисления.УчетнаяПолитика.ФИФО; Политика.Записать();
        Политика = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи(); Политика.Период = Дата(2014,1,1); Политика.Подразделение = Магазин; Политика.Метод = Перечисления.УчетнаяПолитика.ЛИФО; Политика.Записать();
        Спецификация = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
        Спецификация.Период = Дата(2013,12,30); Спецификация.СистемныйБлок = Блок;
        Спецификация.Деталь = Деталь; Спецификация.Свойство = Свойство; Спецификация.Количество = 2; Спецификация.Записать();
        Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи(); Связь.Товар = Принтер; Связь.Аналог = Аналог; Связь.Записать();
        Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
        Приход.Дата = Дата(2014,1,2,12,0,0); Приход.Номер = "ДЕМО00001"; Приход.Склад = Склад; Приход.Подразделение = Цех; Приход.Контрагент = Поставщик;
        СтрокаТовара(Приход, Деталь, Свойство, 10, 100);
        СтрокаТовара(Приход, Принтер, Неопределено, 2, 1000);
        СтрокаТовара(Приход, Аналог, Неопределено, 5, 1200);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
        Приход.Дата = Дата(2014,1,3,12,0,0); Приход.Номер = "ДЕМО00002"; Приход.Подразделение = Цех;
        СтрокаТовара(Приход, Деталь, Свойство, 10, 200);
        Приход.Записать(РежимЗаписиДокумента.Проведение);
        Сборка = Документы.Сборка.СоздатьДокумент();
        Сборка.Дата = Дата(2014,1,6,12,0,0); Сборка.ПодразделениеИсточник = Цех; Сборка.ПодразделениеПолучатель = Магазин;
        Строка = Сборка.СистемныеБлоки.Добавить(); Строка.Номенклатура = Блок; Строка.Количество = 2;
        Строка = Сборка.ДополнительныеДетали.Добавить(); Строка.Номенклатура = Деталь; Строка.Свойство = Свойство; Строка.Количество = 1;
        Сборка.Записать(РежимЗаписиДокумента.Проведение);
        Расход = Документы.РасходнаяНакладная.СоздатьДокумент();
        Расход.Дата = Дата(2014,1,7,12,0,0); Расход.Номер = "ДЕМО00001";
        СтрокаТовара(Расход, Блок, Неопределено, 1, 1000, Магазин);
        СтрокаТовара(Расход, Принтер, Неопределено, 1, 1500, Цех);
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        Расход = Документы.РасходнаяНакладная.СоздатьДокумент();
        Расход.Дата = Дата(2014,1,8,12,0,0); Расход.Номер = "ДЕМО00002"; Расход.Склад = Склад;
        СтрокаТовара(Расход, Принтер, Неопределено, 4, 1500);
        Расход.Записать(РежимЗаписиДокумента.Проведение);
        Операция = Документы.Операция.СоздатьДокумент(); Операция.Дата = Дата(2014,1,1,12,0,0);
        Строка = Операция.Проводки.Добавить(); Строка.СчетДт = ПланыСчетов.Управленческий.Касса;
        Строка.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки; Строка.Сумма = 10000;
        Операция.Записать(РежимЗаписиДокумента.Проведение);
        Работник = Элемент("ФизическиеЛица", "Демо: сотрудник");
        Руководитель = Элемент("ФизическиеЛица", "Демо: руководитель");
        Объект = Работник.ПолучитьОбъект(); Объект.НачалоСтажа = Дата(2010,1,1); Объект.Записать();
        Объект = Руководитель.ПолучитьОбъект(); Объект.НачалоСтажа = Дата(2012,1,1);
        Если Объект.ДополнительныеСведения.Количество() = 0 Тогда Объект.ДополнительныеСведения.Добавить().ВидСведения = Характеристика; КонецЕсли;
        Объект.Записать();
        Объект = Поставщик.ПолучитьОбъект(); Объект.Менеджер = Руководитель; Объект.Записать();
        НастроитьДополнительныеСведения(Руководитель, Поставщик);
        Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи();
        Ставка.Период = Дата(2013,1,1); Ставка.Сотрудник = Работник; Ставка.Ставка = 100; Ставка.Записать();
        Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи(); Ставка.Период = Дата(2013,1,1); Ставка.Сотрудник = Руководитель; Ставка.Ставка = 200; Ставка.Записать();
        Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
        Шкала.Стаж = 0; Шкала.Процент = 5; Шкала.Записать();
        Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Шкала.Стаж = 1; Шкала.Процент = 10; Шкала.Записать();
        Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи(); Шкала.Стаж = 3; Шкала.Процент = 15; Шкала.Записать();
        График = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
        График.Отбор.Подразделение.Установить(Цех);
        День = Дата(2013,10,1);
        Пока День <= Дата(2014,4,30) Цикл
            Запись = График.Добавить(); Запись.Подразделение = Цех; Запись.Дата = День;
            Запись.Значение = ?(ДеньНедели(День) <= 5, 8, 0); Запись.Дни = ?(Запись.Значение > 0, 1, 0);
            День = День + 86400;
        КонецЦикла;
        График.Записать();
        Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент(); Начисление.Дата = Дата(2014,1,31,12,0,0);
        СтрокаНачисления(Начисление, Работник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Дата(2014,1,1), Дата(2014,1,31));
        СтрокаНачисления(Начисление, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Дата(2014,1,1), Дата(2014,1,31));
        Начисление.Записать(РежимЗаписиДокумента.Проведение);
        Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент(); Начисление.Дата = Дата(2014,2,28,12,0,0);
        СтрокаНачисления(Начисление, Работник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Дата(2014,2,1), Дата(2014,2,28));
        СтрокаНачисления(Начисление, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Тариф, Дата(2014,2,1), Дата(2014,2,28));
        СтрокаНачисления(Начисление, Руководитель, Цех, ПланыВидовРасчета.ОсновныеНачисления.Премия, Дата(2014,2,1), Дата(2014,2,28));
        Начисление.Записать(РежимЗаписиДокумента.Проведение);
        Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент(); Начисление.Дата = Дата(2014,4,4,12,0,0);
        СтрокаНачисления(Начисление, Работник, Цех, ПланыВидовРасчета.ОсновныеНачисления.Командировка, Дата(2014,3,28), Дата(2014,4,4));
        Начисление.Записать(РежимЗаписиДокумента.Проведение);
        ЗафиксироватьТранзакцию();
    Исключение
        ОтменитьТранзакцию();
        ВызватьИсключение;
    КонецПопытки;
КонецПроцедуры



Процедура НастроитьДополнительныеСведения(Менеджер, Контрагент) Экспорт
    Описания = Новый Массив;
    Описания.Добавить(Новый Структура("Имя,Тип,Значение", "Валюта кредита", Новый ОписаниеТипов("СправочникСсылка.Валюты"), Справочники.Валюты.НайтиПоНаименованию("Доллар США", Истина)));
    Описания.Добавить(Новый Структура("Имя,Тип,Значение", "Срок кредита, дни", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,0)), 10));
    Описания.Добавить(Новый Структура("Имя,Тип,Значение", "Регион", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150)), "Москва"));
    ОбъектМенеджера = Менеджер.ПолучитьОбъект(); ОбъектМенеджера.ДополнительныеСведения.Очистить();
    ОбъектКонтрагента = Контрагент.ПолучитьОбъект(); ОбъектКонтрагента.ДополнительныеСведения.Очистить();
    Для Каждого Описание Из Описания Цикл
        Вид = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Описание.Имя, Истина);
        Если Не ЗначениеЗаполнено(Вид) Тогда
            ОбъектВида = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
            ОбъектВида.Наименование = Описание.Имя;
            ОбъектВида.ТипЗначения = Описание.Тип;
            ОбъектВида.Записать(); Вид = ОбъектВида.Ссылка;
        КонецЕсли;
        ОбъектМенеджера.ДополнительныеСведения.Добавить().ВидСведения = Вид;
        Строка = ОбъектКонтрагента.ДополнительныеСведения.Добавить();
        Строка.ВидСведения = Вид; Строка.Значение = Описание.Значение;
    КонецЦикла;
    ОбъектМенеджера.Записать();
    ОбъектКонтрагента.Менеджер = Менеджер;
    ОбъектКонтрагента.Записать();
КонецПроцедуры
