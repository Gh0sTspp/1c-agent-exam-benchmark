Функция ЗапросТаблица(ТекстЗапроса, Параметры) Экспорт
    Запрос = Новый Запрос(ТекстЗапроса);
    Для Каждого Параметр Из Параметры Цикл
        Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
    КонецЦикла;
    Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

Процедура ОшибкаЗаполнения(ТекстОшибки) Экспорт
    ВызватьИсключение ТекстОшибки;
КонецПроцедуры

Функция СтрокиНакладной(ДокументОбъект) Экспорт
    Таблица = ДокументОбъект.СписокНоменклатуры.Выгрузить();
    Для Каждого Строка Из Таблица Цикл
        Если Не ЗначениеЗаполнено(Строка.Номенклатура) Или Строка.Количество <= 0 Тогда
            ОшибкаЗаполнения("В строке " + Строка.НомерСтроки + " укажите товар и положительное количество.");
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Строка.Подразделение) Тогда
            Строка.Подразделение = ДокументОбъект.Подразделение;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(Строка.Подразделение) И Не ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
            ОшибкаЗаполнения("В каждой строке укажите подразделение либо заполните склад документа.");
        КонецЕсли;
        Если Строка.Сумма = 0 Тогда
            Строка.Сумма = Окр(Строка.Количество * Строка.Цена, 2);
        КонецЕсли;
        Если Строка.Сумма < 0 Тогда
            ОшибкаЗаполнения("Сумма строки не может быть отрицательной.");
        КонецЕсли;
    КонецЦикла;
    Возврат Таблица;
КонецФункции

Процедура БлокировкаОстатков(Таблица, Бухгалтерский = Ложь) Экспорт
    Если Таблица.Количество() = 0 Тогда Возврат; КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Если Бухгалтерский Тогда
        Элемент = Блокировка.Добавить("РегистрБухгалтерии.Хозрасчетный");
        Элемент.УстановитьЗначение("Счет", ПланыСчетов.Управленческий.Товары);
        Элемент.ИсточникДанных = Таблица;
        Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
    Иначе
        Элемент = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
        Элемент.ИсточникДанных = Таблица;
        Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    КонецЕсли;
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Если Не Бухгалтерский Тогда
        Элемент = Блокировка.Добавить("РегистрНакопления.ПартииНоменклатуры");
        Элемент.ИсточникДанных = Таблица;
        Элемент.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    КонецЕсли;
    Блокировка.Заблокировать();
КонецПроцедуры

Функция ГраницаДокумента(ДокументОбъект) Экспорт
    Возврат Новый Граница(ДокументОбъект.МоментВремени(), ВидГраницы.Исключая);
КонецФункции

Функция КлючиОстатков(ДокументОбъект, НовыеДанные, Бухгалтерский = Ложь)
    Поля = ?(Бухгалтерский, "Номенклатура", "Подразделение,Номенклатура");
    Ключи = НовыеДанные.Скопировать(, Поля);
    Ключи.Колонки.Добавить("Было", Новый ОписаниеТипов("Булево"));
    Параметры = Новый Структура("Регистратор,Счет", ДокументОбъект.Ссылка, ПланыСчетов.Управленческий.Товары);
    Если Бухгалтерский Тогда
        Старые = ЗапросТаблица(
        "ВЫБРАТЬ НоменклатураДт КАК Номенклатура ИЗ РегистрБухгалтерии.Хозрасчетный
        |ГДЕ Регистратор = &Регистратор И СчетДт = &Счет
        |ОБЪЕДИНИТЬ
        |ВЫБРАТЬ НоменклатураКт ИЗ РегистрБухгалтерии.Хозрасчетный
        |ГДЕ Регистратор = &Регистратор И СчетКт = &Счет", Параметры);
    Иначе
        Старые = ЗапросТаблица("ВЫБРАТЬ РАЗЛИЧНЫЕ Подразделение, Номенклатура ИЗ РегистрНакопления.ОстаткиНоменклатуры ГДЕ Регистратор = &Регистратор", Параметры);
    КонецЕсли;
    Для Каждого Старая Из Старые Цикл
        Строка = Ключи.Добавить(); ЗаполнитьЗначенияСвойств(Строка, Старая); Строка.Было = Истина;
    КонецЦикла;
    Ключи.Свернуть(Поля + ",Было");
    Возврат Ключи;
КонецФункции

Процедура Приход(ДокументОбъект) Экспорт
    Строки = СтрокиНакладной(ДокументОбъект);
    Если Строки.Количество() = 0 Тогда ОшибкаЗаполнения("Укажите товары."); КонецЕсли;
    КлючиБУ = КлючиОстатков(ДокументОбъект, Строки, Истина);
    КлючиОУ = КлючиОстатков(ДокументОбъект, Строки);
    ЕстьБУ = ЗначениеЗаполнено(ДокументОбъект.Склад) Или КлючиБУ.Найти(Истина, "Было") <> Неопределено;
    ЕстьОУ = Строки.НайтиСтроки(Новый Структура("Подразделение", Справочники.Подразделения.ПустаяСсылка())).Количество() <> Строки.Количество() Или КлючиОУ.Найти(Истина, "Было") <> Неопределено;
    Если ЕстьБУ Тогда БлокировкаОстатков(КлючиБУ, Истина); КонецЕсли;
    Если ЕстьОУ Тогда БлокировкаОстатков(КлючиОУ); КонецЕсли;
    ДокументОбъект.Движения.Хозрасчетный.Очистить(); ДокументОбъект.Движения.Хозрасчетный.Записывать = Истина;
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Очистить(); ДокументОбъект.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    ДокументОбъект.Движения.ПартииНоменклатуры.Очистить(); ДокументОбъект.Движения.ПартииНоменклатуры.Записывать = Истина;
    Для Каждого Строка Из Строки Цикл
        Если ЗначениеЗаполнено(Строка.Подразделение) Тогда
            ДобавитьПриходОУ(ДокументОбъект, Строка.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Строка.Сумма);
        КонецЕсли;
        Если ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
            Движение = ДокументОбъект.Движения.Хозрасчетный.Добавить();
            Движение.Период = ДокументОбъект.Дата;
            Движение.СчетДт = ПланыСчетов.Управленческий.Товары;
            Движение.СчетКт = ПланыСчетов.Управленческий.Поставщики;
            Движение.НоменклатураДт = Строка.Номенклатура; Движение.СкладДт = ДокументОбъект.Склад;
            Движение.КоличествоДт = Строка.Количество; Движение.Сумма = Строка.Сумма;
        КонецЕсли;
    КонецЦикла;
    Если ЕстьБУ Тогда ПроверитьОстаткиБУ(ДокументОбъект, КлючиБУ); КонецЕсли;
    Если ЕстьОУ Тогда ПроверитьОстаткиОУ(ДокументОбъект, КлючиОУ); КонецЕсли;
КонецПроцедуры



Функция ОстаткиОУ(ДокументОбъект, Потребность) Экспорт
    Параметры = Новый Структура("Момент,Товары,Подразделения", ГраницаДокумента(ДокументОбъект), Потребность.ВыгрузитьКолонку("Номенклатура"), Потребность.ВыгрузитьКолонку("Подразделение"));
    Возврат ЗапросТаблица(
    "ВЫБРАТЬ Подразделение, Номенклатура, Свойство, Партия,
    | Партия.Дата КАК ДатаПартии, КоличествоОстаток КАК Количество, СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(&Момент,
    | Номенклатура В (&Товары) И Подразделение В (&Подразделения))
    |УПОРЯДОЧИТЬ ПО ДатаПартии, Партия", Параметры);
КонецФункции

Функция СписатьОУ(ДокументОбъект, Остатки, Подразделение, Товар, Свойство, Количество, Метод, ТочноеСвойство = Истина) Экспорт
    Отбор = Новый Структура("Подразделение,Номенклатура", Подразделение, Товар);
    Если ТочноеСвойство Тогда Отбор.Вставить("Свойство", Свойство); КонецЕсли;
    Остатки.Сортировать(?(Метод = Перечисления.УчетнаяПолитика.ЛИФО, "ДатаПартии Убыв, Партия Убыв", "ДатаПартии, Партия"));
    Партии = Остатки.НайтиСтроки(Отбор);
    ВсегоКоличество = 0; ВсегоСтоимость = 0;
    Изменения = Новый ТаблицаЗначений;
    Для Каждого Имя Из СтрРазделить("Строка,КоличествоДо,СтоимостьДо,КоличествоПосле,СтоимостьПосле", ",") Цикл Изменения.Колонки.Добавить(Имя); КонецЦикла;
    Для Каждого Партия Из Партии Цикл
        Изменение = Изменения.Добавить(); Изменение.Строка = Партия;
        Изменение.КоличествоДо = Партия.Количество; Изменение.СтоимостьДо = Партия.Стоимость;
        Изменение.КоличествоПосле = Партия.Количество; Изменение.СтоимостьПосле = Партия.Стоимость;
        ВсегоКоличество = ВсегоКоличество + Партия.Количество;
        ВсегоСтоимость = ВсегоСтоимость + Партия.Стоимость;
    КонецЦикла;
    Если ВсегоКоличество < Количество Тогда
        ОшибкаЗаполнения("Недостаточно товара " + Товар + " в подразделении " + Подразделение + ". Требуется " + Количество + ", доступно " + ВсегоКоличество + ".");
    КонецЕсли;
    Осталось = Количество;
    Для Каждого Изменение Из Изменения Цикл
        Если Осталось <= 0 Тогда Прервать; КонецЕсли;
        Если Изменение.КоличествоДо <= 0 Тогда Продолжить; КонецЕсли;
        Списано = Мин(Осталось, Изменение.КоличествоДо);
        Изменение.КоличествоПосле = Изменение.КоличествоДо - Списано;
        Если Списано = Изменение.КоличествоДо Тогда
            Изменение.СтоимостьПосле = 0;
        Иначе
            Изменение.СтоимостьПосле = Изменение.СтоимостьДо - Окр(Изменение.СтоимостьДо * Списано / Изменение.КоличествоДо, 2);
        КонецЕсли;
        Осталось = Осталось - Списано;
    КонецЦикла;
    Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
        // Сумма списания определяется до распределения по партиям. Количество
        // не округляется пропорционально: это изменило бы среднюю стоимость.
        СписатьСтоимость = ?(Количество = ВсегоКоличество, ВсегоСтоимость, Окр(ВсегоСтоимость * Количество / ВсегоКоличество, 2));
        ОсталосьКоличество = ВсегоКоличество - Количество;
        ОсталосьСтоимость = ВсегоСтоимость - СписатьСтоимость;
        Для Каждого Изменение Из Изменения Цикл
            Если Изменение.КоличествоПосле = 0 Тогда
                Изменение.СтоимостьПосле = 0;
            Иначе
                Изменение.СтоимостьПосле = ?(Изменение.КоличествоПосле = ОсталосьКоличество, ОсталосьСтоимость, Окр(ОсталосьСтоимость * Изменение.КоличествоПосле / ОсталосьКоличество, 2));
                ОсталосьКоличество = ОсталосьКоличество - Изменение.КоличествоПосле;
                ОсталосьСтоимость = ОсталосьСтоимость - Изменение.СтоимостьПосле;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    ПоСвойствам = Остатки.Скопировать(, "Свойство,Количество,Стоимость"); ПоСвойствам.Очистить();
    СуммаСписания = 0;
    Для Каждого Изменение Из Изменения Цикл
        Партия = Изменение.Строка;
        Списано = Изменение.КоличествоДо - Изменение.КоличествоПосле;
        Стоимость = Изменение.СтоимостьДо - Изменение.СтоимостьПосле;
        Если Списано > 0 Или Стоимость > 0 Тогда
            Движение = ДокументОбъект.Движения.ПартииНоменклатуры.ДобавитьРасход();
            ЗаполнитьЗначенияСвойств(Движение, Партия, "Подразделение,Номенклатура,Свойство,Партия");
            Движение.Период = ДокументОбъект.Дата; Движение.Количество = Списано; Движение.Стоимость = Макс(0, Стоимость);
        КонецЕсли;
        Если Стоимость < 0 Тогда
            Движение = ДокументОбъект.Движения.ПартииНоменклатуры.ДобавитьПриход();
            ЗаполнитьЗначенияСвойств(Движение, Партия, "Подразделение,Номенклатура,Свойство,Партия");
            Движение.Период = ДокументОбъект.Дата; Движение.Стоимость = -Стоимость;
        КонецЕсли;
        СтрокаСвойства = ПоСвойствам.Добавить(); СтрокаСвойства.Свойство = Партия.Свойство;
        СтрокаСвойства.Количество = Списано; СтрокаСвойства.Стоимость = Стоимость;
        Партия.Количество = Изменение.КоличествоПосле; Партия.Стоимость = Изменение.СтоимостьПосле;
        СуммаСписания = СуммаСписания + Стоимость;
    КонецЦикла;
    ПоСвойствам.Свернуть("Свойство", "Количество,Стоимость");
    Для Каждого СтрокаСвойства Из ПоСвойствам Цикл
        Если СтрокаСвойства.Количество > 0 Или СтрокаСвойства.Стоимость > 0 Тогда
            Движение = ДокументОбъект.Движения.ОстаткиНоменклатуры.ДобавитьРасход();
            Движение.Период = ДокументОбъект.Дата; Движение.Подразделение = Подразделение; Движение.Номенклатура = Товар;
            Движение.Свойство = СтрокаСвойства.Свойство; Движение.Количество = СтрокаСвойства.Количество; Движение.Стоимость = Макс(0, СтрокаСвойства.Стоимость);
        КонецЕсли;
        Если СтрокаСвойства.Стоимость < 0 Тогда
            Движение = ДокументОбъект.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
            Движение.Период = ДокументОбъект.Дата; Движение.Подразделение = Подразделение; Движение.Номенклатура = Товар;
            Движение.Свойство = СтрокаСвойства.Свойство; Движение.Стоимость = -СтрокаСвойства.Стоимость;
        КонецЕсли;
    КонецЦикла;
    Возврат СуммаСписания;
КонецФункции

Процедура ДобавитьПриходОУ(ДокументОбъект, Подразделение, Товар, Свойство, Количество, Стоимость)
    Движение = ДокументОбъект.Движения.ОстаткиНоменклатуры.ДобавитьПриход();
    Движение.Период = ДокументОбъект.Дата; Движение.Подразделение = Подразделение; Движение.Номенклатура = Товар;
    Если Свойство <> Неопределено Тогда Движение.Свойство = Свойство; КонецЕсли;
    Движение.Количество = Количество; Движение.Стоимость = Стоимость;
    Партия = ДокументОбъект.Движения.ПартииНоменклатуры.ДобавитьПриход();
    ЗаполнитьЗначенияСвойств(Партия, Движение);
    Партия.Партия = ДокументОбъект.Ссылка;
КонецПроцедуры



Функция Политики(ДокументОбъект, Строки)
    Возврат ЗапросТаблица("ВЫБРАТЬ Подразделение, Метод ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата, Подразделение В (&Подразделения))",
        Новый Структура("Дата,Подразделения", ДокументОбъект.Дата, Строки.ВыгрузитьКолонку("Подразделение")));
КонецФункции

Процедура ПродажаОУ(ДокументОбъект, Строки)
    Ключи = КлючиОстатков(ДокументОбъект, Строки);
    БлокировкаОстатков(Ключи);
    // Старые движения удаляются до чтения себестоимости при перепроведении.
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Записать();
    ДокументОбъект.Движения.ПартииНоменклатуры.Записать();
    Остатки = ОстаткиОУ(ДокументОбъект, Ключи);
    ПолитикиПодразделений = Политики(ДокументОбъект, Строки);
    Для Каждого Строка Из Строки Цикл
        Если Не ЗначениеЗаполнено(Строка.Подразделение) Тогда Продолжить; КонецЕсли;
        Политика = ПолитикиПодразделений.Найти(Строка.Подразделение, "Подразделение");
        Если Политика = Неопределено Тогда
            ОшибкаЗаполнения("Не задана учетная политика подразделения " + Строка.Подразделение + " на дату документа.");
        КонецЕсли;
        Стоимость = СписатьОУ(ДокументОбъект, Остатки, Строка.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Политика.Метод, ЗначениеЗаполнено(Строка.Свойство));
        Движение = ДокументОбъект.Движения.Продажи.Добавить();
        Движение.Период = ДокументОбъект.Дата;
        Движение.Номенклатура = Строка.Номенклатура;
        Движение.Количество = Строка.Количество;
        Движение.Себестоимость = Стоимость;
        Движение.Выручка = Строка.Сумма;
    КонецЦикла;
    ДокументОбъект.Движения.Продажи.Записать();
    ПроверитьОстаткиОУ(ДокументОбъект, Ключи);
КонецПроцедуры

Функция КандидатыАналогов(Строки, Связи)
    Результат = Новый Соответствие;
    Для Каждого Строка Из Строки Цикл
        Если Результат.Получить(Строка.Номенклатура) <> Неопределено Тогда Продолжить; КонецЕсли;
        Множество = Новый Соответствие;
        Множество.Вставить(Строка.Номенклатура, Истина);
        Изменено = Истина;
        Пока Изменено Цикл
            Изменено = Ложь;
            Для Каждого Связь Из Связи Цикл
                Если Множество.Получить(Связь.Товар) <> Неопределено И Множество.Получить(Связь.Аналог) = Неопределено Тогда
                    Множество.Вставить(Связь.Аналог, Истина); Изменено = Истина;
                КонецЕсли;
                Если Множество.Получить(Связь.Аналог) <> Неопределено И Множество.Получить(Связь.Товар) = Неопределено Тогда
                    Множество.Вставить(Связь.Товар, Истина); Изменено = Истина;
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        Список = Новый Массив;
        Список.Добавить(Строка.Номенклатура);
        Для Каждого Узел Из Множество Цикл
            Если Узел.Ключ <> Строка.Номенклатура Тогда Список.Добавить(Узел.Ключ); КонецЕсли;
        КонецЦикла;
        Результат.Вставить(Строка.Номенклатура, Список);
    КонецЦикла;
    Возврат Результат;
КонецФункции

Процедура ПродажаБУ(ДокументОбъект, Строки)
    Связи = ЗапросТаблица("ВЫБРАТЬ Товар, Аналог ИЗ РегистрСведений.Аналоги", Новый Структура);
    Кандидаты = КандидатыАналогов(Строки, Связи);
    НужныеТовары = Новый Массив;
    Для Каждого Группа Из Кандидаты Цикл
        Для Каждого Товар Из Группа.Значение Цикл
            Если НужныеТовары.Найти(Товар) = Неопределено Тогда НужныеТовары.Добавить(Товар); КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Товары = ЗапросТаблица("ВЫБРАТЬ Ссылка КАК Номенклатура, Артикул ИЗ Справочник.Номенклатура ГДЕ Ссылка В (&Товары) УПОРЯДОЧИТЬ ПО Артикул, Номенклатура", Новый Структура("Товары", НужныеТовары));
    УпорядоченныеКандидаты = Новый Соответствие;
    Для Каждого Группа Из Кандидаты Цикл
        Список = Новый Массив; Список.Добавить(Группа.Ключ);
        Для Каждого Товар Из Товары Цикл
            Если Товар.Номенклатура <> Группа.Ключ И Группа.Значение.Найти(Товар.Номенклатура) <> Неопределено Тогда Список.Добавить(Товар.Номенклатура); КонецЕсли;
        КонецЦикла;
        УпорядоченныеКандидаты.Вставить(Группа.Ключ, Список);
    КонецЦикла;
    Кандидаты = УпорядоченныеКандидаты;
    Товары = КлючиОстатков(ДокументОбъект, Товары, Истина);
    БлокировкаОстатков(Товары, Истина);
    ДокументОбъект.Движения.Хозрасчетный.Записать();
    Параметры = Новый Структура("Момент,Товары,Счет", ГраницаДокумента(ДокументОбъект), Товары.ВыгрузитьКолонку("Номенклатура"), ПланыСчетов.Управленческий.Товары);
    Остатки = ЗапросТаблица(
    "ВЫБРАТЬ Номенклатура, Склад, КоличествоОстаток КАК Количество, СуммаОстаток КАК Стоимость
    |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(&Момент, Счет = &Счет, Номенклатура В (&Товары))", Параметры);
    Средние = Остатки.Скопировать();
    Средние.Свернуть("Номенклатура", "Количество,Стоимость");
    Выровнены = Новый Соответствие;
    Для Каждого Строка Из Строки Цикл
        Осталось = Строка.Количество;
        ВыручкаОсталась = Строка.Сумма;
        Для Каждого Товар Из Кандидаты.Получить(Строка.Номенклатура) Цикл
            Если Осталось <= 0 Тогда Прервать; КонецЕсли;
            ПартииСклада = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Товар, ДокументОбъект.Склад));
            Если ПартииСклада.Количество() = 0 Тогда Продолжить; КонецЕсли;
            Остаток = ПартииСклада[0];
            Если Остаток.Количество <= 0 Тогда Продолжить; КонецЕсли;
            Списано = Мин(Осталось, Остаток.Количество);
            Средняя = Средние.Найти(Товар, "Номенклатура");
            Если Средняя = Неопределено Или Средняя.Количество <= 0 Тогда
                ОшибкаЗаполнения("Некорректные количественные остатки товара " + Товар);
            КонецЕсли;
            Если Выровнены.Получить(Товар) = Неопределено Тогда
                ВыровнятьСтоимостьСкладов(ДокументОбъект, Остатки, Средняя, Товар);
                Выровнены.Вставить(Товар, Истина);
            КонецЕсли;
            Стоимость = ?(Списано = Остаток.Количество, Остаток.Стоимость, Окр(Средняя.Стоимость * Списано / Средняя.Количество, 2));
            Выручка = ?(Списано = Осталось, ВыручкаОсталась, Окр(Строка.Сумма * Списано / Строка.Количество, 2));
            Движение = ДокументОбъект.Движения.Хозрасчетный.Добавить();
            Движение.Период = ДокументОбъект.Дата;
            Движение.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
            Движение.СчетКт = ПланыСчетов.Управленческий.Товары;
            Движение.НоменклатураКт = Товар;
            Движение.СкладКт = ДокументОбъект.Склад;
            Движение.КоличествоКт = Списано;
            Движение.Сумма = Стоимость;
            Продажа = ДокументОбъект.Движения.ПродажиАналогов.Добавить();
            Продажа.Период = ДокументОбъект.Дата;
            Продажа.Номенклатура = Строка.Номенклатура;
            Продажа.Продано = Товар;
            Продажа.Количество = Списано;
            Продажа.Себестоимость = Стоимость;
            Продажа.Выручка = Выручка;
            Остаток.Количество = Остаток.Количество - Списано;
            Остаток.Стоимость = Остаток.Стоимость - Стоимость;
            Средняя.Количество = Средняя.Количество - Списано;
            Средняя.Стоимость = Средняя.Стоимость - Стоимость;
            Осталось = Осталось - Списано;
            ВыручкаОсталась = ВыручкаОсталась - Выручка;
        КонецЦикла;
        Если Осталось > 0 Тогда
            ОшибкаЗаполнения("Недостаточно товара " + Строка.Номенклатура + " и его аналогов на складе " + ДокументОбъект.Склад + ". Нехватка: " + Осталось);
        КонецЕсли;
        Движение = ДокументОбъект.Движения.Хозрасчетный.Добавить();
        Движение.Период = ДокументОбъект.Дата;
        Движение.СчетДт = ПланыСчетов.Управленческий.Покупатели;
        Движение.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
        Движение.Сумма = Строка.Сумма;
    КонецЦикла;
    ДокументОбъект.Движения.ПродажиАналогов.Записать();
    ПроверитьОстаткиБУ(ДокументОбъект, Товары);
КонецПроцедуры

Процедура Продажа(ДокументОбъект) Экспорт
    Строки = СтрокиНакладной(ДокументОбъект);
    Если Строки.Количество() = 0 Тогда ОшибкаЗаполнения("Укажите товары."); КонецЕсли;
    ДокументОбъект.Движения.Хозрасчетный.Очистить();
    ДокументОбъект.Движения.Хозрасчетный.Записывать = Истина;
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Очистить();
    ДокументОбъект.Движения.ПартииНоменклатуры.Очистить();
    ДокументОбъект.Движения.ПартииНоменклатуры.Записывать = Истина;
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    ДокументОбъект.Движения.Продажи.Очистить();
    ДокументОбъект.Движения.Продажи.Записывать = Истина;
    ДокументОбъект.Движения.ПродажиАналогов.Очистить();
    ДокументОбъект.Движения.ПродажиАналогов.Записывать = Истина;
    Если ЗначениеЗаполнено(ДокументОбъект.Склад) Тогда
        ПродажаБУ(ДокументОбъект, Строки);
    Иначе
        КлючиСтарогоБУ = КлючиОстатков(ДокументОбъект, Строки, Истина);
        Если КлючиСтарогоБУ.Найти(Истина, "Было") <> Неопределено Тогда
            БлокировкаОстатков(КлючиСтарогоБУ, Истина);
            ПроверитьОстаткиБУ(ДокументОбъект, КлючиСтарогоБУ);
        КонецЕсли;
    КонецЕсли;
    Если Строки.НайтиСтроки(Новый Структура("Подразделение", Справочники.Подразделения.ПустаяСсылка())).Количество() <> Строки.Количество() Тогда
        ПродажаОУ(ДокументОбъект, Строки);
    Иначе
        КлючиСтарогоОУ = КлючиОстатков(ДокументОбъект, Строки);
        Если КлючиСтарогоОУ.Найти(Истина, "Было") <> Неопределено Тогда
            БлокировкаОстатков(КлючиСтарогоОУ);
            ПроверитьОстаткиОУ(ДокументОбъект, КлючиСтарогоОУ);
        КонецЕсли;
    КонецЕсли;
КонецПроцедуры

Процедура Сборка(ДокументОбъект) Экспорт
    Если Не ЗначениеЗаполнено(ДокументОбъект.ПодразделениеИсточник) Или Не ЗначениеЗаполнено(ДокументОбъект.ПодразделениеПолучатель) Тогда
        ОшибкаЗаполнения("Укажите подразделения списания деталей и поступления блоков.");
    КонецЕсли;
    Блоки = ДокументОбъект.СистемныеБлоки.Выгрузить();
    Блоки.Свернуть("Номенклатура", "Количество");
    Если Блоки.Количество() = 0 Тогда ОшибкаЗаполнения("Укажите системные блоки."); КонецЕсли;
    Спецификации = ЗапросТаблица(
        "ВЫБРАТЬ СистемныйБлок, Деталь, Свойство, Количество
        |ИЗ РегистрСведений.Спецификации.СрезПоследних(&Дата, СистемныйБлок В (&Блоки))",
        Новый Структура("Дата,Блоки", ДокументОбъект.Дата, Блоки.ВыгрузитьКолонку("Номенклатура")));
    Потребность = Новый ТаблицаЗначений;
    Потребность.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Потребность.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    Потребность.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
    Потребность.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
    Потребность.Колонки.Добавить("Блок", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Блоки.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
    Для Каждого Блок Из Блоки Цикл
        Если Блок.Количество <= 0 Тогда ОшибкаЗаполнения("Количество блоков должно быть положительным."); КонецЕсли;
        Состав = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Блок.Номенклатура));
        Если Состав.Количество() = 0 Тогда ОшибкаЗаполнения("Нет спецификации для " + Блок.Номенклатура); КонецЕсли;
        Для Каждого Деталь Из Состав Цикл
            Если Деталь.Количество = 0 Тогда Продолжить; КонецЕсли;
            Строка = Потребность.Добавить();
            Строка.Номенклатура = Деталь.Деталь;
            Строка.Свойство = Деталь.Свойство;
            Строка.Количество = Деталь.Количество * Блок.Количество;
            Строка.Подразделение = ДокументОбъект.ПодразделениеИсточник;
            Строка.Блок = Блок.Номенклатура;
        КонецЦикла;
    КонецЦикла;
    Для Каждого Деталь Из ДокументОбъект.ДополнительныеДетали Цикл
        Если Деталь.Количество <= 0 Тогда ОшибкаЗаполнения("Количество дополнительных деталей должно быть положительным."); КонецЕсли;
        Строка = Потребность.Добавить();
        ЗаполнитьЗначенияСвойств(Строка, Деталь);
        Строка.Подразделение = ДокументОбъект.ПодразделениеИсточник;
    КонецЦикла;
    Ключи = КлючиОстатков(ДокументОбъект, Потребность);
    Для Каждого Блок Из Блоки Цикл
        Ключ = Ключи.Добавить(); Ключ.Номенклатура = Блок.Номенклатура; Ключ.Подразделение = ДокументОбъект.ПодразделениеПолучатель;
    КонецЦикла;
    БлокировкаОстатков(Ключи);
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Очистить();
    ДокументОбъект.Движения.ПартииНоменклатуры.Очистить();
    ДокументОбъект.Движения.ПартииНоменклатуры.Записывать = Истина;
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Записывать = Истина;
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Записать();
    ДокументОбъект.Движения.ПартииНоменклатуры.Записать();
    Остатки = ОстаткиОУ(ДокументОбъект, Ключи);
    ДополнительнаяСтоимость = 0;
    Для Каждого Строка Из Потребность Цикл
        Стоимость = СписатьОУ(ДокументОбъект, Остатки, Строка.Подразделение, Строка.Номенклатура, Строка.Свойство, Строка.Количество, Перечисления.УчетнаяПолитика.ПоСредней);
        Если ЗначениеЗаполнено(Строка.Блок) Тогда
            Блок = Блоки.Найти(Строка.Блок, "Номенклатура");
            Блок.Стоимость = Блок.Стоимость + Стоимость;
        Иначе
            ДополнительнаяСтоимость = ДополнительнаяСтоимость + Стоимость;
        КонецЕсли;
    КонецЦикла;
    ВсегоБлоков = Блоки.Итог("Количество");
    ОсталосьБлоков = ВсегоБлоков;
    Для Каждого Блок Из Блоки Цикл
        Добавка = ?(Блок.Количество = ОсталосьБлоков, ДополнительнаяСтоимость, Окр(ДополнительнаяСтоимость * Блок.Количество / ОсталосьБлоков, 2));
        ДобавитьПриходОУ(ДокументОбъект, ДокументОбъект.ПодразделениеПолучатель, Блок.Номенклатура, Неопределено, Блок.Количество, Блок.Стоимость + Добавка);
        ДополнительнаяСтоимость = ДополнительнаяСтоимость - Добавка;
        ОсталосьБлоков = ОсталосьБлоков - Блок.Количество;
    КонецЦикла;
    ПроверитьОстаткиОУ(ДокументОбъект, Ключи);
КонецПроцедуры

Процедура Операция(ДокументОбъект) Экспорт
    НовыеКлючи = Новый ТаблицаЗначений;
    НовыеКлючи.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    Для Каждого Строка Из ДокументОбъект.Проводки Цикл
        Если Строка.СчетДт = ПланыСчетов.Управленческий.Товары Тогда НовыеКлючи.Добавить().Номенклатура = Строка.НоменклатураДт; КонецЕсли;
        Если Строка.СчетКт = ПланыСчетов.Управленческий.Товары Тогда НовыеКлючи.Добавить().Номенклатура = Строка.НоменклатураКт; КонецЕсли;
    КонецЦикла;
    Ключи = КлючиОстатков(ДокументОбъект, НовыеКлючи, Истина);
    Если Ключи.Количество() > 0 Тогда БлокировкаОстатков(Ключи, Истина); КонецЕсли;
    ДокументОбъект.Движения.Хозрасчетный.Очистить();
    ДокументОбъект.Движения.Хозрасчетный.Записывать = Истина;
    Для Каждого Строка Из ДокументОбъект.Проводки Цикл
        Если Не ЗначениеЗаполнено(Строка.СчетДт) Или Не ЗначениеЗаполнено(Строка.СчетКт) Тогда
            ОшибкаЗаполнения("Укажите оба счета проводки.");
        КонецЕсли;
        Движение = ДокументОбъект.Движения.Хозрасчетный.Добавить();
        ЗаполнитьЗначенияСвойств(Движение, Строка);
        Движение.Период = ДокументОбъект.Дата;
    КонецЦикла;
    Если Ключи.Количество() > 0 Тогда ПроверитьОстаткиБУ(ДокументОбъект, Ключи); КонецЕсли;
КонецПроцедуры

Функция ПечатныйОтчет(Данные, ВидОтчета, Заголовок) Экспорт
    ТабДок = Новый ТабличныйДокумент;
    ТабДок.АвтоМасштаб = Истина;
    ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
    ТабДок.Область(1,1).Текст = Заголовок;
    ТабДок.Область(1,1).Шрифт = Новый Шрифт(, 12, Истина);
    НомерСтроки = 3;
    Если ВидОтчета = "ВедомостьПоПодразделению" Тогда
        Заголовки = СтрРазделить("Производитель,Товар,Нач. ост.,Приход,Расход,Кон. ост.", ",");
    ИначеЕсли ВидОтчета = "Премии" Тогда
        Заголовки = СтрРазделить("Сотрудник,Трудовой стаж,% премии,Сумма премии", ",");
    ИначеЕсли ВидОтчета = "ПродажиТоваров" Тогда
        Заголовки = СтрРазделить("Номенклатура,Продано,Кол-во,Себест-сть,Продажа,Прибыль", ",");
    Иначе
        Заголовки = СтрРазделить("Номенклатура,Кол-во,Себест-сть,Продажа,Прибыль", ",");
    КонецЕсли;
    НомерКолонки = 1;
    Для Каждого ЗаголовокКолонки Из Заголовки Цикл
        ТабДок.Область(НомерСтроки, НомерКолонки).Текст = ЗаголовокКолонки;
        ТабДок.Область(НомерСтроки, НомерКолонки).Шрифт = Новый Шрифт(, , Истина);
        ТабДок.Область(, НомерКолонки, , НомерКолонки).ШиринаКолонки = ?(НомерКолонки <= 2, 26, 17);
        НомерКолонки = НомерКолонки + 1;
    КонецЦикла;
    НомерСтроки = НомерСтроки + 1;
    ПредыдущаяГруппа = Неопределено;
    Если ВидОтчета = "ПродажиТоваров" Тогда
        Группы = Данные.Скопировать(); Группы.Свернуть("Номенклатура", "Количество,Себестоимость,Продажа,Прибыль");
    КонецЕсли;
    Для Каждого Строка Из Данные Цикл
        Если ВидОтчета = "ВедомостьПоПодразделению" Тогда
            Если ПредыдущаяГруппа <> Строка.Характеристика Тогда
                ТабДок.Область(НомерСтроки,1).Текст = Строка(Строка.Характеристика);
                ТабДок.Область(НомерСтроки,1).Шрифт = Новый Шрифт(, , Истина);
                ПредыдущаяГруппа = Строка.Характеристика; НомерСтроки = НомерСтроки + 1;
            КонецЕсли;
            ТабДок.Область(НомерСтроки,2).Текст = Строка(Строка.Номенклатура);
            ИменаКоличеств = СтрРазделить("НачальноеКоличество,КоличествоПриход,КоличествоРасход,КонечноеКоличество", ",");
            ИменаСумм = СтрРазделить("НачальныйОстаток,Приход,Расход,КонечныйОстаток", ",");
            Для Индекс = 0 По 3 Цикл
                Область = ТабДок.Область(НомерСтроки, Индекс+3);
                Область.Текст = Формат(Строка[ИменаКоличеств[Индекс]], "ЧГ=0") + Символы.ПС + Формат(Строка[ИменаСумм[Индекс]], "ЧДЦ=2");
                Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
            КонецЦикла;
        ИначеЕсли ВидОтчета = "Премии" Тогда
            ТабДок.Область(НомерСтроки,1).Текст = Строка(Строка.Сотрудник);
            ТабДок.Область(НомерСтроки,2).Текст = Формат(Строка.Стаж, "ЧГ=0") + " лет";
            ЗаполнитьЯчейку(ТабДок, НомерСтроки, 3, Строка.Процент);
            ЗаполнитьЯчейку(ТабДок, НомерСтроки, 4, Строка.СуммаПремии);
        Иначе
            Смещение = ?(ВидОтчета = "ПродажиТоваров", 1, 0);
            Если Смещение = 1 Тогда
                Если ПредыдущаяГруппа <> Строка.Номенклатура Тогда
                    Группа = Группы.Найти(Строка.Номенклатура, "Номенклатура");
                    ТабДок.Область(НомерСтроки,1).Текст = Строка(Строка.Номенклатура);
                    ЗаполнитьЯчейку(ТабДок, НомерСтроки, 3, Группа.Количество);
                    ЗаполнитьЯчейку(ТабДок, НомерСтроки, 4, Группа.Себестоимость);
                    ЗаполнитьЯчейку(ТабДок, НомерСтроки, 5, Группа.Продажа);
                    ЗаполнитьЯчейку(ТабДок, НомерСтроки, 6, Группа.Прибыль);
                    ТабДок.Область(НомерСтроки,1,НомерСтроки,6).Шрифт = Новый Шрифт(, , Истина);
                    НомерСтроки = НомерСтроки + 1; ПредыдущаяГруппа = Строка.Номенклатура;
                КонецЕсли;
                ТабДок.Область(НомерСтроки,2).Текст = Строка(Строка.Продано);
            Иначе
                ТабДок.Область(НомерСтроки,1).Текст = Строка(Строка.Номенклатура);
            КонецЕсли;
            ЗаполнитьЯчейку(ТабДок, НомерСтроки, 2+Смещение, Строка.Количество);
            ЗаполнитьЯчейку(ТабДок, НомерСтроки, 3+Смещение, Строка.Себестоимость);
            ЗаполнитьЯчейку(ТабДок, НомерСтроки, 4+Смещение, Строка.Продажа);
            ЗаполнитьЯчейку(ТабДок, НомерСтроки, 5+Смещение, Строка.Прибыль);
        КонецЕсли;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    Если ВидОтчета = "Премии" Тогда
        ТабДок.Область(НомерСтроки,1).Текст = "ИТОГО:";
        ЗаполнитьЯчейку(ТабДок, НомерСтроки, 4, Данные.Итог("СуммаПремии"));
    КонецЕсли;
    ТабДок.Область(3,1,НомерСтроки,Заголовки.Количество()).Обвести(Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1));
    Возврат ТабДок;
КонецФункции



Процедура ЗаполнитьЯчейку(ТабДок, НомерСтроки, НомерКолонки, ЗначениеЯчейки)
    Область = ТабДок.Область(НомерСтроки, НомерКолонки);
    Область.СодержитЗначение = Истина;
    Область.Значение = ЗначениеЯчейки;
КонецПроцедуры



Процедура ВыровнятьСтоимостьСкладов(ДокументОбъект, Остатки, Средняя, Товар)
    Если Средняя.Количество <= 0 Тогда Возврат; КонецЕсли;
    Склады = Остатки.НайтиСтроки(Новый Структура("Номенклатура", Товар));
    Получатели = Новый Массив; Источники = Новый Массив;
    ОсталосьКоличество = Средняя.Количество; ОсталосьСтоимость = Средняя.Стоимость;
    Для Каждого Склад Из Склады Цикл
        Если Склад.Количество < 0 Тогда ВызватьИсключение "Отрицательный остаток товара на складе."; КонецЕсли;
        Если ОсталосьКоличество = 0 Тогда
            ЦелеваяСтоимость = 0;
        Иначе
            ЦелеваяСтоимость = ?(Склад.Количество = ОсталосьКоличество, ОсталосьСтоимость, Окр(ОсталосьСтоимость * Склад.Количество / ОсталосьКоличество, 2));
        КонецЕсли;
        Разница = ЦелеваяСтоимость - Склад.Стоимость;
        Если Разница > 0 Тогда Получатели.Добавить(Новый Структура("Склад,Сумма", Склад.Склад, Разница)); КонецЕсли;
        Если Разница < 0 Тогда Источники.Добавить(Новый Структура("Склад,Сумма", Склад.Склад, -Разница)); КонецЕсли;
        Склад.Стоимость = ЦелеваяСтоимость;
        ОсталосьКоличество = ОсталосьКоличество - Склад.Количество;
        ОсталосьСтоимость = ОсталосьСтоимость - ЦелеваяСтоимость;
    КонецЦикла;
    // Суммовая оценка едина по товару. Внутренние проводки распределяют ее
    // по складам и не изменяют общую стоимость и количество товара.
    ИндексИсточника = 0;
    Для Каждого Получатель Из Получатели Цикл
        Пока Получатель.Сумма > 0 Цикл
            Источник = Источники[ИндексИсточника];
            Сумма = Мин(Получатель.Сумма, Источник.Сумма);
            Движение = ДокументОбъект.Движения.Хозрасчетный.Добавить();
            Движение.Период = ДокументОбъект.Дата;
            Движение.СчетДт = ПланыСчетов.Управленческий.Товары;
            Движение.СчетКт = ПланыСчетов.Управленческий.Товары;
            Движение.НоменклатураДт = Товар; Движение.НоменклатураКт = Товар;
            Движение.СкладДт = Получатель.Склад; Движение.СкладКт = Источник.Склад;
            Движение.Сумма = Сумма;
            Получатель.Сумма = Получатель.Сумма - Сумма; Источник.Сумма = Источник.Сумма - Сумма;
            Если Источник.Сумма = 0 Тогда ИндексИсточника = ИндексИсточника + 1; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Процедура ПроверитьОстаткиОУ(ДокументОбъект, Строки)
    ДокументОбъект.Движения.ОстаткиНоменклатуры.БлокироватьДляИзменения = Истина;
    ДокументОбъект.Движения.ПартииНоменклатуры.БлокироватьДляИзменения = Истина;
    ДокументОбъект.Движения.ОстаткиНоменклатуры.Записать();
    ДокументОбъект.Движения.ПартииНоменклатуры.Записать();
    Параметры = Новый Структура("Подразделения,Товары", Строки.ВыгрузитьКолонку("Подразделение"), Строки.ВыгрузитьКолонку("Номенклатура"));
    Отрицательные = ЗапросТаблица(
    "ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура, Подразделение
    |ИЗ РегистрНакопления.ОстаткиНоменклатуры.Остатки(, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |ГДЕ КоличествоОстаток < 0 ИЛИ СтоимостьОстаток < 0", Параметры);
    ОтрицательныеПартии = ЗапросТаблица(
    "ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура
    |ИЗ РегистрНакопления.ПартииНоменклатуры.Остатки(, Подразделение В (&Подразделения) И Номенклатура В (&Товары))
    |ГДЕ КоличествоОстаток < 0 ИЛИ СтоимостьОстаток < 0", Параметры);
    Если ОтрицательныеПартии.Количество() > 0 Тогда
        ВызватьИсключение "Изменение документа приводит к отрицательному остатку партии: " + ОтрицательныеПартии[0].Номенклатура + ". Перепроведите последующие документы по хронологии.";
    КонецЕсли;
    Если Отрицательные.Количество() > 0 Тогда
        ВызватьИсключение "Изменение документа приводит к отрицательному остатку: " + Отрицательные[0].Номенклатура + ". Восстановите хронологию проведения последующих документов.";
    КонецЕсли;
КонецПроцедуры

Процедура ПроверитьОстаткиБУ(ДокументОбъект, Товары)
    ДокументОбъект.Движения.Хозрасчетный.БлокироватьДляИзменения = Истина;
    ДокументОбъект.Движения.Хозрасчетный.Записать();
    Параметры = Новый Структура("Счет,Товары", ПланыСчетов.Управленческий.Товары, Товары.ВыгрузитьКолонку("Номенклатура"));
    Отрицательные = ЗапросТаблица(
    "ВЫБРАТЬ ПЕРВЫЕ 1 Номенклатура, Склад
    |ИЗ РегистрБухгалтерии.Хозрасчетный.Остатки(, Счет = &Счет, Номенклатура В (&Товары))
    |ГДЕ КоличествоОстаток < 0 ИЛИ СуммаОстаток < 0", Параметры);
    Если Отрицательные.Количество() > 0 Тогда
        ВызватьИсключение "Изменение документа приводит к отрицательному остатку на складе: " + Отрицательные[0].Номенклатура;
    КонецЕсли;
КонецПроцедуры





Процедура ОтменитьУчет(ДокументОбъект) Экспорт
    ПустыеДанные = Новый ТаблицаЗначений;
    ПустыеДанные.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
    ПустыеДанные.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
    КлючиБУ = КлючиОстатков(ДокументОбъект, ПустыеДанные, Истина);
    КлючиОУ = КлючиОстатков(ДокументОбъект, ПустыеДанные);
    Если КлючиБУ.Количество() > 0 Тогда БлокировкаОстатков(КлючиБУ, Истина); КонецЕсли;
    Если КлючиОУ.Количество() > 0 Тогда БлокировкаОстатков(КлючиОУ); КонецЕсли;
    Если КлючиБУ.Количество() > 0 Тогда
        ДокументОбъект.Движения.Хозрасчетный.Очистить(); ДокументОбъект.Движения.Хозрасчетный.Записывать = Истина;
        ПроверитьОстаткиБУ(ДокументОбъект, КлючиБУ);
    КонецЕсли;
    Если КлючиОУ.Количество() > 0 Тогда
        ДокументОбъект.Движения.ОстаткиНоменклатуры.Очистить(); ДокументОбъект.Движения.ОстаткиНоменклатуры.Записывать = Истина;
        ДокументОбъект.Движения.ПартииНоменклатуры.Очистить(); ДокументОбъект.Движения.ПартииНоменклатуры.Записывать = Истина;
        ПроверитьОстаткиОУ(ДокументОбъект, КлючиОУ);
    КонецЕсли;
КонецПроцедуры


