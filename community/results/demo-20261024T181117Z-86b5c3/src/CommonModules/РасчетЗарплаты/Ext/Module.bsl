Процедура ОтменитьПроведение(ДокументОбъект) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = ДокументОбъект.ОсновныеНачисления;
    Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    Блокировка.Заблокировать();
    Набор = ДокументОбъект.Движения.Начисления;
    Набор.Очистить();
    Набор.Записывать = Истина;
    Набор.Записать();
    Пересчитать(ДокументОбъект.ОсновныеНачисления.ВыгрузитьКолонку("Подразделение"));
КонецПроцедуры
