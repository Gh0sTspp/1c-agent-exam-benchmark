Процедура НастроитьВидыРасчета() Экспорт
    // Пользовательские изменения шкалы и тарифов не затрагиваются.
    Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
    Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
    Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
    ОбъектТарифа = Тариф.ПолучитьОбъект();
    Если ОбъектТарифа.ВытесняющиеВидыРасчета.Найти(Командировка, "ВидРасчета") = Неопределено Тогда
        ОбъектТарифа.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка;
        ОбъектТарифа.Записать();
    КонецЕсли;
    ОбъектПремии = Премия.ПолучитьОбъект();
    Изменен = Ложь;
    Если ОбъектПремии.ВытесняющиеВидыРасчета.Найти(Командировка, "ВидРасчета") = Неопределено Тогда
        ОбъектПремии.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка; Изменен = Истина;
    КонецЕсли;
    Если ОбъектПремии.БазовыеВидыРасчета.Найти(Тариф, "ВидРасчета") = Неопределено Тогда
        ОбъектПремии.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф; Изменен = Истина;
    КонецЕсли;
    Если Изменен Тогда ОбъектПремии.Записать(); КонецЕсли;
    ОбъектКомандировки = Командировка.ПолучитьОбъект();
    Если ОбъектКомандировки.БазовыеВидыРасчета.Количество() = 0 Тогда
        ОбъектКомандировки.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф;
        ОбъектКомандировки.БазовыеВидыРасчета.Добавить().ВидРасчета = Премия;
        ОбъектКомандировки.БазовыеВидыРасчета.Добавить().ВидРасчета = Командировка;
        ОбъектКомандировки.Записать();
    КонецЕсли;
КонецПроцедуры

Функция ПолныхЛет(НачалоСтажа, ДатаСтажа) Экспорт
    Если Не ЗначениеЗаполнено(НачалоСтажа) Тогда Возврат 0; КонецЕсли;
    Стаж = Год(ДатаСтажа) - Год(НачалоСтажа);
    Если ДобавитьМесяц(НачалоСтажа, Стаж * 12) > ДатаСтажа Тогда Стаж = Стаж - 1; КонецЕсли;
    Возврат Макс(0, Стаж);
КонецФункции

Процедура Провести(ДокументОбъект) Экспорт
    НастроитьВидыРасчета();
    Набор = ДокументОбъект.Движения.Начисления;
    Набор.Очистить();
    Набор.Записывать = Истина;
    // Блокируем связанные записи до получения дополнения и расчетной базы.
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Элемент.ИсточникДанных = ДокументОбъект.ОсновныеНачисления;
    Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    Блокировка.Заблокировать();
    Набор.Записать();
    ДанныеНачислений = ДокументОбъект.ОсновныеНачисления.Выгрузить();
    ДанныеНачислений.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания,ПериодРегистрации");
    Для Каждого Строка Из ДанныеНачислений Цикл
        Если Не ЗначениеЗаполнено(Строка.Сотрудник) Или Не ЗначениеЗаполнено(Строка.Подразделение)
            Или Не ЗначениеЗаполнено(Строка.ВидРасчета) Или Не ЗначениеЗаполнено(Строка.ДатаНачала)
            Или Строка.ДатаОкончания < Строка.ДатаНачала Тогда
            ВызватьИсключение "Заполните сотрудника, подразделение, вид расчета и корректный период в строке " + Строка.Сотрудник;
        КонецЕсли;
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Тариф И Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия И Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
            ВызватьИсключение "Используйте виды расчета Тариф, Премия или Командировка.";
        КонецЕсли;
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка
            И НачалоМесяца(Строка.ДатаНачала) <> НачалоМесяца(Строка.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия вводятся только в пределах одного календарного месяца.";
        КонецЕсли;
        Регистрация = ?(ЗначениеЗаполнено(Строка.ПериодРегистрации), НачалоМесяца(Строка.ПериодРегистрации), НачалоМесяца(ДокументОбъект.Дата));
        Начало = НачалоДня(Строка.ДатаНачала);
        Пока Начало <= Строка.ДатаОкончания Цикл
            Конец = Мин(КонецМесяца(Начало), КонецДня(Строка.ДатаОкончания));
            Запись = Набор.Добавить();
            Запись.ПериодРегистрации = Регистрация;
            Запись.ПериодДействияНачало = Начало;
            Запись.ПериодДействияКонец = Конец;
            Запись.Сотрудник = Строка.Сотрудник;
            Запись.Подразделение = Строка.Подразделение;
            Запись.ГрафикПодразделения = Строка.Подразделение;
            Запись.ВидРасчета = Строка.ВидРасчета;
            Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда
                Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Строка.ДатаНачала), -3);
                Запись.БазовыйПериодКонец = НачалоМесяца(Строка.ДатаНачала) - 1;
            Иначе
                Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(Начало), -1);
                Запись.БазовыйПериодКонец = НачалоМесяца(Начало) - 1;
            КонецЕсли;
            Начало = НачалоМесяца(ДобавитьМесяц(Начало, 1));
        КонецЦикла;
    КонецЦикла;
    Если Набор.Количество() = 0 Тогда ВызватьИсключение "Укажите начисления."; КонецЕсли;
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого Строка Из Дополнение Цикл
        Сторно = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Сторно, Строка);
        Сторно.Сторно = Истина;
        Сторно.ПериодРегистрации = Строка.ПериодРегистрацииСторно;
        Сторно.ПериодДействияНачало = Строка.ПериодДействияНачалоСторно;
        Сторно.ПериодДействияКонец = Строка.ПериодДействияКонецСторно;
    КонецЦикла;
    // Результат и фактический период становятся источником следующего этапа.
    Набор.Записать();
    Пересчитать(ДокументОбъект.ОсновныеНачисления.ВыгрузитьКолонку("Подразделение"));
    Набор.Прочитать();
КонецПроцедуры

Функция База(Подразделения, Измерения, ВидРасчета)
    Параметры = Новый Структура("Подразделения,Измерения,ВидРасчета", Подразделения, Измерения, ВидРасчета);
    Возврат УчетСервер.ЗапросТаблица(
    "ВЫБРАТЬ Регистратор, НомерСтроки, РезультатБаза, ОтработаноДнейБаза
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, ,
    | Подразделение В (&Подразделения) И ВидРасчета = &ВидРасчета)", Параметры);
КонецФункции

Процедура СохранитьНаборы(Записи)
    // Чтения БД в цикле нет: все данные уже получены одним пакетным запросом.
    Наборы = Новый Соответствие;
    Для Каждого Строка Из Записи Цикл
        Набор = Наборы.Получить(Строка.Регистратор);
        Если Набор = Неопределено Тогда
            Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
            Набор.Отбор.Регистратор.Установить(Строка.Регистратор);
            Наборы.Вставить(Строка.Регистратор, Набор);
        КонецЕсли;
        Запись = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Запись, Строка);
    КонецЦикла;
    Для Каждого Элемент Из Наборы Цикл
        Элемент.Значение.Записать(, Ложь, Ложь, Ложь);
    КонецЦикла;
КонецПроцедуры

Процедура Пересчитать(Подразделения) Экспорт
    Параметры = Новый Структура("Подразделения", Подразделения);
    // Сохраняем целые наборы регистраторов, включая строки других подразделений.
    Записи = УчетСервер.ЗапросТаблица(
    "ВЫБРАТЬ * ИЗ РегистрРасчета.Начисления
    |ГДЕ Регистратор В (ВЫБРАТЬ РАЗЛИЧНЫЕ Регистратор ИЗ РегистрРасчета.Начисления ГДЕ Подразделение В (&Подразделения))
    |УПОРЯДОЧИТЬ ПО Регистратор, НомерСтроки", Параметры);
    Если Записи.Количество() = 0 Тогда Возврат; КонецЕсли;
    Параметры.Вставить("Регистраторы", Записи.ВыгрузитьКолонку("Регистратор"));
    Графики = УчетСервер.ЗапросТаблица(
    "ВЫБРАТЬ Регистратор, НомерСтроки, ЗначениеФактическийПериодДействия КАК Часы,
    | ЗначениеПериодДействия КАК Норма, ДниФактическийПериодДействия КАК Дни
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы))", Параметры);
    Ставки = УчетСервер.ЗапросТаблица(
    "ВЫБРАТЬ Н.Регистратор, Н.НомерСтроки, МАКСИМУМ(Т.Период) КАК ДатаСтавки
    |ПОМЕСТИТЬ ДатыСтавок
    |ИЗ РегистрРасчета.Начисления КАК Н
    | ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Т
    | ПО Н.Сотрудник = Т.Сотрудник И Т.Период <= НАЧАЛОПЕРИОДА(Н.ПериодДействияНачало, МЕСЯЦ)
    |ГДЕ Н.Регистратор В (&Регистраторы)
    |СГРУППИРОВАТЬ ПО Н.Регистратор, Н.НомерСтроки;
    |ВЫБРАТЬ Н.Регистратор, Н.НомерСтроки, ЕСТЬNULL(Т.Ставка, 0) КАК Ставка,
    | Н.Сотрудник.НачалоСтажа КАК НачалоСтажа
    |ИЗ РегистрРасчета.Начисления КАК Н
    | ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДатыСтавок КАК Д ПО Н.Регистратор = Д.Регистратор И Н.НомерСтроки = Д.НомерСтроки
    | ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ТарифныеСтавки КАК Т ПО Н.Сотрудник = Т.Сотрудник И Т.Период = Д.ДатаСтавки", Параметры);
    Шкала = УчетСервер.ЗапросТаблица("ВЫБРАТЬ Стаж, Процент ИЗ РегистрСведений.ШкалаПремий УПОРЯДОЧИТЬ ПО Стаж", Новый Структура);
    Для Каждого Строка Из Записи Цикл
        Ключ = Новый Структура("Регистратор,НомерСтроки", Строка.Регистратор, Строка.НомерСтроки);
        ДанныеГрафика = Графики.НайтиСтроки(Ключ);
        ДанныеСтавки = Ставки.НайтиСтроки(Ключ);
        Если ДанныеГрафика.Количество() = 0 Тогда Продолжить; КонецЕсли;
        График = ДанныеГрафика[0];
        Строка.Результат = 0;
        Строка.ОтработаноДней = 0;
        Строка.ОтработаноЧасов = 0;
        Если Строка.ВидРасчета = ПланыВидовРасчета.ОсновныеНачисления.Тариф Тогда
            Если ДанныеСтавки.Количество() = 0 Или ДанныеСтавки[0].Ставка = 0 Тогда
                ВызватьИсключение "Не задана тарифная ставка сотрудника " + Строка.Сотрудник + " на начало месяца.";
            КонецЕсли;
            Знак = ?(Строка.Сторно, -1, 1);
            Строка.ОтработаноЧасов = График.Часы * Знак;
            Строка.ОтработаноДней = График.Дни * Знак;
            Строка.Результат = Окр(ДанныеСтавки[0].Ставка * Строка.ОтработаноЧасов, 2);
        КонецЕсли;
        Если ДанныеСтавки.Количество() > 0 Тогда
            Строка.Стаж = ПолныхЛет(ДанныеСтавки[0].НачалоСтажа, НачалоМесяца(Строка.ПериодДействияНачало));
        КонецЕсли;
        Строка.Процент = 0;
        Для Каждого Ступень Из Шкала Цикл
            Если Ступень.Стаж <= Строка.Стаж Тогда Строка.Процент = Ступень.Процент; КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    СохранитьНаборы(Записи);
    // База премии: начисления подразделения минус начисления самого руководителя.
    ИзмеренияПодразделения = Новый Массив; ИзмеренияПодразделения.Добавить("Подразделение");
    ИзмеренияСотрудника = Новый Массив; ИзмеренияСотрудника.Добавить("Сотрудник");
    ИзмеренияСовместные = Новый Массив; ИзмеренияСовместные.Добавить("Сотрудник"); ИзмеренияСовместные.Добавить("Подразделение");
    БазаПодразделения = База(Подразделения, ИзмеренияПодразделения, ПланыВидовРасчета.ОсновныеНачисления.Премия);
    БазаРуководителя = База(Подразделения, ИзмеренияСовместные, ПланыВидовРасчета.ОсновныеНачисления.Премия);
    Для Каждого Строка Из Записи Цикл
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Премия Тогда Продолжить; КонецЕсли;
        Ключ = Новый Структура("Регистратор,НомерСтроки", Строка.Регистратор, Строка.НомерСтроки);
        СуммаПодразделения = СуммаБазы(БазаПодразделения, Ключ);
        СуммаРуководителя = СуммаБазы(БазаРуководителя, Ключ);
        ДанныеГрафика = Графики.НайтиСтроки(Ключ);
        Доля = 0;
        Если ДанныеГрафика.Количество() > 0 И ДанныеГрафика[0].Норма <> 0 Тогда
            Доля = ДанныеГрафика[0].Часы / ДанныеГрафика[0].Норма;
        КонецЕсли;
        Строка.Результат = Окр((СуммаПодразделения - СуммаРуководителя) * Строка.Процент / 100 * Доля * ?(Строка.Сторно, -1, 1), 2);
    КонецЦикла;
    СохранитьНаборы(Записи);
    // Детализация платформенной базы связывает результат с каждой исходной записью.
    // Благодаря этому несколько последовательных командировок рассчитываются
    // хронологически в памяти, без запросов в цикле.
    Разрезы = Новый Массив; Разрезы.Добавить("Регистратор"); Разрезы.Добавить("НомерСтроки");
    Параметры.Вставить("Измерения", ИзмеренияСотрудника);
    Параметры.Вставить("Разрезы", Разрезы);
    Параметры.Вставить("ВидРасчета", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
    БазаКомандировок = УчетСервер.ЗапросТаблица(
    "ВЫБРАТЬ Регистратор, НомерСтроки, РегистраторРазрез, НомерСтрокиРазрез, РезультатБаза, ОтработаноДнейБаза
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы,
    | Регистратор В (&Регистраторы) И ВидРасчета = &ВидРасчета)", Параметры);
    Порядок = Записи.Скопировать(, "Регистратор,НомерСтроки,ПериодДействияНачало");
    Порядок.Сортировать("ПериодДействияНачало, Регистратор, НомерСтроки");
    Для Каждого Позиция Из Порядок Цикл
        Ключ = Новый Структура("Регистратор,НомерСтроки", Позиция.Регистратор, Позиция.НомерСтроки);
        Строка = Записи.НайтиСтроки(Ключ)[0];
        Если Строка.ВидРасчета <> ПланыВидовРасчета.ОсновныеНачисления.Командировка Тогда Продолжить; КонецЕсли;
        СуммаНачислений = 0; ДнейБазы = 0;
        Для Каждого ДанныеБазы Из БазаКомандировок.НайтиСтроки(Ключ) Цикл
            Источники = Записи.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", ДанныеБазы.РегистраторРазрез, ДанныеБазы.НомерСтрокиРазрез));
            Если Источники.Количество() > 0 Тогда
                СуммаНачислений = СуммаНачислений + Источники[0].Результат;
                ДнейБазы = ДнейБазы + Источники[0].ОтработаноДней;
            Иначе
                СуммаНачислений = СуммаНачислений + ДанныеБазы.РезультатБаза;
                ДнейБазы = ДнейБазы + ДанныеБазы.ОтработаноДнейБаза;
            КонецЕсли;
        КонецЦикла;
        ДанныеГрафика = Графики.НайтиСтроки(Ключ);
        Если ДнейБазы = 0 Тогда
            ВызватьИсключение "Для командировки сотрудника " + Строка.Сотрудник + " нет отработанных дней за три предыдущих месяца.";
        КонецЕсли;
        Если ДанныеГрафика.Количество() > 0 Тогда
            Строка.Результат = Окр(СуммаНачислений / ДнейБазы * ДанныеГрафика[0].Дни * ?(Строка.Сторно, -1, 1), 2);
        КонецЕсли;
    КонецЦикла;
    СохранитьНаборы(Записи);
КонецПроцедуры

Функция СуммаБазы(Таблица, Ключ)
    Сумма = 0;
    Для Каждого Строка Из Таблица.НайтиСтроки(Ключ) Цикл
        Сумма = Сумма + Строка.РезультатБаза;
    КонецЦикла;
    Возврат Сумма;
