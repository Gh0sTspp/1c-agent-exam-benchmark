#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет графики работы всех подразделений: 8 часов в рабочий день, 0 - в выходной.
//
// Параметры:
//  ДатаНачала, ДатаОкончания - Дата - период заполнения.
//  ВыходныеДни - Строка - номера дней недели выходных дней, например "67".
//  Подразделение - СправочникСсылка.Подразделения - если не указано, заполняются все подразделения.
//
Процедура ЗаполнитьГрафик(ДатаНачала, ДатаОкончания, ВыходныеДни, Подразделение = Неопределено) Экспорт

	Подразделения = Новый Массив;
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Подразделения.Добавить(Подразделение);
	Иначе
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Подразделения.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Подразделения КАК Подразделения
		|ГДЕ
		|	НЕ Подразделения.ЭтоГруппа";
		Подразделения = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	КонецЕсли;

	Для Каждого ТекущееПодразделение Из Подразделения Цикл
		Набор = РегистрыСведений.ГрафикиРаботы.СоздатьНаборЗаписей();
		Набор.Отбор.Подразделение.Установить(ТекущееПодразделение);
		Набор.Прочитать();
		Индекс = Набор.Количество() - 1;
		Пока Индекс >= 0 Цикл
			Если Набор[Индекс].Дата >= НачалоДня(ДатаНачала) И Набор[Индекс].Дата <= КонецДня(ДатаОкончания) Тогда
				Набор.Удалить(Индекс);
			КонецЕсли;
			Индекс = Индекс - 1;
		КонецЦикла;
		Дата = НачалоДня(ДатаНачала);
		Пока Дата <= ДатаОкончания Цикл
			Запись = Набор.Добавить();
			Запись.Подразделение = ТекущееПодразделение;
			Запись.Дата = Дата;
			Запись.Значение = ?(СтрНайти(ВыходныеДни, Строка(ДеньНедели(Дата))) > 0, 0, 8);
			Запись.РабочийДень = ?(Запись.Значение > 0, 1, 0);
			Дата = Дата + 86400;
		КонецЦикла;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
