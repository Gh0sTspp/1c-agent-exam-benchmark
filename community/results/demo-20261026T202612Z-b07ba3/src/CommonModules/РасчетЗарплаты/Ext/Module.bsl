#Область ПрограммныйИнтерфейс

// Рассчитывает записанные движения регистратора: тариф, затем премию, затем командировку.
// После расчета командировок пересчитывает тариф и премию других документов, в которых
// фактический период действия изменился из-за командировки, введенной задним числом.
//
// Параметры:
//  Регистратор - ДокументСсылка.НачислениеЗарплаты.
//  Набор - РегистрРасчетаНаборЗаписей.ОсновныеНачисления - записанный набор регистратора.
//
Процедура РассчитатьНачисления(Регистратор, Набор) Экспорт

	РассчитатьТариф(Регистратор, Набор);
	Набор.Записать();
	РассчитатьПремию(Регистратор, Набор);
	Набор.Записать();
	РассчитатьКомандировки(Регистратор, Набор);
	Набор.Записать();

	ПересчитатьВытесненныеНачисления(Регистратор);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тариф: ставка на начало расчетного периода * фактически отработанные часы (данные графика с учетом вытеснения).
Процедура РассчитатьТариф(Регистратор, Набор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.НомерСтроки КАК НомерСтроки,
	|	Начисления.Сотрудник КАК Сотрудник,
	|	Начисления.Подразделение КАК Подразделение,
	|	Начисления.ПериодРегистрации КАК ПериодРегистрации
	|ПОМЕСТИТЬ ВТЗаписи
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления КАК Начисления
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|	И Начисления.ВидРасчета = &Тариф
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Записи.НомерСтроки КАК НомерСтроки,
	|	МАКСИМУМ(Ставки.Период) КАК Период
	|ПОМЕСТИТЬ ВТПериодыСтавок
	|ИЗ
	|	ВТЗаписи КАК Записи
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСотрудниках КАК Ставки
	|		ПО Записи.Сотрудник = Ставки.Сотрудник
	|			И Записи.Подразделение = Ставки.Подразделение
	|			И (Ставки.Период <= Записи.ПериодРегистрации)
	|
	|СГРУППИРОВАТЬ ПО
	|	Записи.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Записи.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(Ставки.Оклад, 0) КАК Ставка,
	|	ЕСТЬNULL(ДанныеГрафика.ЗначениеФактическийПериодДействия, 0) КАК Часов,
	|	ЕСТЬNULL(ДанныеГрафика.ЗначениеПериодДействия, 0) КАК НормаЧасов,
	|	ЕСТЬNULL(ДанныеГрафика.РабочийДеньФактическийПериодДействия, 0) КАК Дней
	|ИЗ
	|	ВТЗаписи КАК Записи
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТПериодыСтавок КАК ПериодыСтавок
	|		ПО Записи.НомерСтроки = ПериодыСтавок.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСотрудниках КАК Ставки
	|		ПО Записи.Сотрудник = Ставки.Сотрудник
	|			И Записи.Подразделение = Ставки.Подразделение
	|			И (ПериодыСтавок.Период = Ставки.Период)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Тариф) КАК ДанныеГрафика
	|		ПО Записи.НомерСтроки = ДанныеГрафика.НомерСтроки";
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Тариф", ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = Набор[Выборка.НомерСтроки - 1];
		Запись.Ставка = Выборка.Ставка;
		Запись.ОтработаноЧасов = Выборка.Часов;
		Запись.НормаЧасов = Выборка.НормаЧасов;
		Запись.ОтработаноДней = Выборка.Дней;
		Запись.Результат = Окр(Выборка.Ставка * Выборка.Часов, 2);
	КонецЦикла;

КонецПроцедуры

// Премия руководителя: процент по шкале стажа от тарифа сотрудников подразделения за предыдущий месяц
// (базовый период записи) без тарифа самого руководителя.
Процедура РассчитатьПремию(Регистратор, Набор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.НомерСтроки КАК НомерСтроки,
	|	Начисления.ПериодРегистрации КАК ПериодРегистрации,
	|	Начисления.Сотрудник.ДатаНачалаСтажа КАК ДатаНачалаСтажа
	|ПОМЕСТИТЬ ВТЗаписи
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления КАК Начисления
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|	И Начисления.ВидРасчета = &Премия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Записи.НомерСтроки КАК НомерСтроки,
	|	Записи.ПериодРегистрации КАК ПериодРегистрации,
	|	Записи.ДатаНачалаСтажа КАК ДатаНачалаСтажа,
	|	ЕСТЬNULL(БазаПодразделения.РезультатБаза, 0) - ЕСТЬNULL(БазаРуководителя.РезультатБаза, 0) КАК База,
	|	ЕСТЬNULL(ДанныеГрафика.ЗначениеФактическийПериодДействия, 0) КАК Часов,
	|	ЕСТЬNULL(ДанныеГрафика.ЗначениеПериодДействия, 0) КАК НормаЧасов
	|ИЗ
	|	ВТЗаписи КАК Записи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(
	|				&ИзмеренияПодразделения,
	|				&ИзмеренияПодразделения,
	|				,
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Премия) КАК БазаПодразделения
	|		ПО Записи.НомерСтроки = БазаПодразделения.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(
	|				&ИзмеренияСотрудника,
	|				&ИзмеренияСотрудника,
	|				,
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Премия) КАК БазаРуководителя
	|		ПО Записи.НомерСтроки = БазаРуководителя.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Премия) КАК ДанныеГрафика
	|		ПО Записи.НомерСтроки = ДанныеГрафика.НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Шкала.СтажОт КАК СтажОт,
	|	Шкала.Процент КАК Процент
	|ИЗ
	|	РегистрСведений.ШкалаПремий КАК Шкала
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтажОт УБЫВ";
	ИзмеренияПодразделения = Новый Массив;
	ИзмеренияПодразделения.Добавить("Подразделение");
	ИзмеренияСотрудника = Новый Массив;
	ИзмеренияСотрудника.Добавить("Сотрудник");
	ИзмеренияСотрудника.Добавить("Подразделение");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Премия", ПланыВидовРасчета.ОсновныеНачисления.Премия);
	Запрос.УстановитьПараметр("ИзмеренияПодразделения", ИзмеренияПодразделения);
	Запрос.УстановитьПараметр("ИзмеренияСотрудника", ИзмеренияСотрудника);
	Результаты = Запрос.ВыполнитьПакет();
	Шкала = Результаты[2].Выгрузить();

	Выборка = Результаты[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Стаж = СтажЛет(Выборка.ДатаНачалаСтажа, Выборка.ПериодРегистрации);
		Процент = 0;
		Для Каждого СтрокаШкалы Из Шкала Цикл
			Если Стаж >= СтрокаШкалы.СтажОт Тогда
				Процент = СтрокаШкалы.Процент;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		// Во время командировки премия не начисляется: результат пропорционален фактически отработанному времени.
		Доля = ?(Выборка.НормаЧасов = 0, 1, Выборка.Часов / Выборка.НормаЧасов);

		Запись = Набор[Выборка.НомерСтроки - 1];
		Запись.Ставка = Выборка.База;
		Запись.Стаж = Стаж;
		Запись.ПроцентПремии = Процент;
		Запись.ОтработаноЧасов = Выборка.Часов;
		Запись.НормаЧасов = Выборка.НормаЧасов;
		Запись.Результат = Окр(Выборка.База * Процент / 100 * Доля, 2);
	КонецЦикла;

КонецПроцедуры

// Командировка: дневная ставка (все начисления за три месяца до начала командировки - базовый период записи,
// деленные на дни, отработанные по тарифу) * рабочие дни командировки по графику подразделения.
Процедура РассчитатьКомандировки(Регистратор, Набор)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Начисления.НомерСтроки КАК НомерСтроки,
	|	ЕСТЬNULL(База.РезультатБаза, 0) КАК База,
	|	ЕСТЬNULL(База.ОтработаноДнейБаза, 0) КАК ДнейБазы,
	|	ЕСТЬNULL(ДанныеГрафика.РабочийДеньФактическийПериодДействия, 0) КАК Дней
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления КАК Начисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.БазаОсновныеНачисления(
	|				&Измерения,
	|				&Измерения,
	|				,
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Командировка) КАК База
	|		ПО Начисления.НомерСтроки = База.НомерСтроки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления.ДанныеГрафика(
	|				Регистратор = &Регистратор
	|					И ВидРасчета = &Командировка) КАК ДанныеГрафика
	|		ПО Начисления.НомерСтроки = ДанныеГрафика.НомерСтроки
	|ГДЕ
	|	Начисления.Регистратор = &Регистратор
	|	И Начисления.ВидРасчета = &Командировка";
	Измерения = Новый Массив;
	Измерения.Добавить("Сотрудник");
	Измерения.Добавить("Подразделение");
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Запрос.УстановитьПараметр("Измерения", Измерения);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДневнаяСтавка = ?(Выборка.ДнейБазы = 0, 0, Выборка.База / Выборка.ДнейБазы);
		Запись = Набор[Выборка.НомерСтроки - 1];
		Запись.Ставка = Окр(ДневнаяСтавка, 2);
		Запись.ДнейКомандировки = Выборка.Дней;
		Запись.Результат = Окр(ДневнаяСтавка * Выборка.Дней, 2);
	КонецЦикла;

КонецПроцедуры

// Возвращает документы, тариф и премия которых пересекаются с командировками регистратора.
Функция ДокументыСВытесненнымиНачислениями(Регистратор) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Начисления.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрРасчета.ОсновныеНачисления КАК Командировки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрРасчета.ОсновныеНачисления КАК Начисления
	|		ПО Командировки.Сотрудник = Начисления.Сотрудник
	|			И Командировки.Подразделение = Начисления.Подразделение
	|			И Командировки.ПериодДействияНачало <= Начисления.ПериодДействияКонец
	|			И Командировки.ПериодДействияКонец >= Начисления.ПериодДействияНачало
	|			И (Начисления.ВидРасчета В (&Вытесняемые))
	|			И Командировки.Регистратор <> Начисления.Регистратор
	|ГДЕ
	|	Командировки.Регистратор = &Регистратор
	|	И Командировки.ВидРасчета = &Командировка";
	Вытесняемые = Новый Массив;
	Вытесняемые.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Тариф);
	Вытесняемые.Добавить(ПланыВидовРасчета.ОсновныеНачисления.Премия);
	Запрос.УстановитьПараметр("Регистратор", Регистратор);
	Запрос.УстановитьПараметр("Командировка", ПланыВидовРасчета.ОсновныеНачисления.Командировка);
	Запрос.УстановитьПараметр("Вытесняемые", Вытесняемые);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");

КонецФункции

// Пересчитывает тариф и премию указанных документов по текущим данным регистра.
Процедура ПересчитатьДокументы(СписокДокументов) Экспорт

	Для Каждого Документ Из СписокДокументов Цикл
		Набор = РегистрыРасчета.ОсновныеНачисления.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Установить(Документ);
		Набор.Прочитать();
		РассчитатьТариф(Документ, Набор);
		Набор.Записать();
		РассчитатьПремию(Документ, Набор);
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

// Пересчитывает тариф и премию других документов, вытесненные командировками этого документа.
Процедура ПересчитатьВытесненныеНачисления(Регистратор)

	ПересчитатьДокументы(ДокументыСВытесненнымиНачислениями(Регистратор));

КонецПроцедуры

// Полных лет стажа на дату.
Функция СтажЛет(ДатаНачалаСтажа, НаДату)

	Если Не ЗначениеЗаполнено(ДатаНачалаСтажа) Или ДатаНачалаСтажа > НаДату Тогда
		Возврат 0;
	КонецЕсли;
	Лет = Год(НаДату) - Год(ДатаНачалаСтажа);
	Если ДобавитьМесяц(НачалоДня(ДатаНачалаСтажа), Лет * 12) > НаДату Тогда
		Лет = Лет - 1;
	КонецЕсли;
	Возврат Лет;

КонецФункции

#КонецОбласти
