#Область ПрограммныйИнтерфейс

// Заполняет информационную базу примером данных по всем разделам задачи и проводит документы.
//
Процедура ЗаполнитьДемоДанные() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	ЗаполнитьОперативныйУчет();
	ЗаполнитьБухгалтерскийУчет();
	ЗаполнитьПериодическиеРасчеты();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьОперативныйУчет()

	ОсновнойЦех = Элемент("Подразделения", "Основной цех");
	Магазин = Элемент("Подразделения", "Магазин");
	УстановитьПолитику(ОсновнойЦех, Перечисления.УчетнаяПолитика.ФИФО);
	УстановитьПолитику(Магазин, Перечисления.УчетнаяПолитика.ПоСредней);

	Видеокарта = Элемент("Номенклатура", "Видеокарта");
	Материнская = Элемент("Номенклатура", "Материнская плата");
	Процессор = Элемент("Номенклатура", "Процессор");
	Блок = Элемент("Номенклатура", "Системный блок");
	Принтер = Элемент("Номенклатура", "Принтер");

	Производитель = ВидХарактеристики("Производитель");
	ВидеокартаASUS = Свойство(Видеокарта, "ASUS", Производитель, ЗначениеХарактеристики(Производитель, "ASUS"));
	ВидеокартаPALIT = Свойство(Видеокарта, "PALIT", Производитель, ЗначениеХарактеристики(Производитель, "PALIT"));
	ПлатаASUS = Свойство(Материнская, "ASUS", Производитель, ЗначениеХарактеристики(Производитель, "ASUS"));
	ПроцессорIntel = Свойство(Процессор, "Intel", Производитель, ЗначениеХарактеристики(Производитель, "Intel"));

	Для Каждого Деталь Из ОбщийМассив(ВидеокартаASUS, ПлатаASUS, ПроцессорIntel) Цикл
		Запись = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
		Запись.Период = Дата(2014, 1, 1);
		Запись.СистемныйБлок = Блок;
		Запись.Деталь = Деталь.Владелец;
		Запись.Свойство = Деталь;
		Запись.Количество = 1;
		Запись.Записать();
	КонецЦикла;

	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2014, 1, 10, 10, 0, 0);
	Приход.Подразделение = ОсновнойЦех;
	ДобавитьСтроку(Приход.СписокНоменклатуры, Видеокарта, 2, 16000, ВидеокартаASUS);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Материнская, 1, 5000, ПлатаASUS);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Видеокарта, 1, 10000, ВидеокартаPALIT);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Процессор, 2, 8000, ПроцессорIntel);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Принтер, 3, 10000);
	Провести(Приход);

	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2014, 2, 5, 10, 0, 0);
	Приход.Подразделение = ОсновнойЦех;
	ДобавитьСтроку(Приход.СписокНоменклатуры, Видеокарта, 4, 15000, ВидеокартаASUS);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Материнская, 2, 5500, ПлатаASUS);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Видеокарта, 2, 11500, ВидеокартаPALIT);
	Провести(Приход);

	Сборка = Документы.Сборка.СоздатьДокумент();
	Сборка.Дата = Дата(2014, 2, 10, 10, 0, 0);
	Сборка.ПодразделениеОтправитель = ОсновнойЦех;
	Сборка.ПодразделениеПолучатель = Магазин;
	СтрокаБлока = Сборка.СистемныеБлоки.Добавить();
	СтрокаБлока.Номенклатура = Блок;
	СтрокаБлока.Количество = 1;
	СтрокаДетали = Сборка.ДополнительныеДетали.Добавить();
	СтрокаДетали.Номенклатура = Видеокарта;
	СтрокаДетали.Свойство = ВидеокартаASUS;
	СтрокаДетали.Количество = 1;
	Провести(Сборка);

	Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
	Продажа.Дата = Дата(2014, 3, 1, 10, 0, 0);
	ДобавитьСтроку(Продажа.СписокНоменклатуры, Принтер, 3, 14000, , ОсновнойЦех);
	ДобавитьСтроку(Продажа.СписокНоменклатуры, Блок, 1, 75000, , Магазин);
	ДобавитьСтроку(Продажа.СписокНоменклатуры, Видеокарта, 3, 19000, , ОсновнойЦех);
	Провести(Продажа);

КонецПроцедуры

Процедура ЗаполнитьБухгалтерскийУчет()

	Склад = Элемент("Склады", "Основной склад");
	Поставщик = Элемент("Контрагенты", "Поставщик (демо)");
	Покупатель = Элемент("Контрагенты", "Покупатель (демо)");

	Куртка = Элемент("Номенклатура", "Куртка замшевая", Новый Структура("Артикул", "A-001"));
	Портсигар = Элемент("Номенклатура", "Портсигар", Новый Структура("Артикул", "A-002"));
	ПортсигарИмп = Элемент("Номенклатура", "Портсигар (имп.)", Новый Структура("Артикул", "A-003"));
	ПортсигарОтеч = Элемент("Номенклатура", "Портсигар (отеч.)", Новый Структура("Артикул", "A-004"));

	Аналог = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
	Аналог.Номенклатура = Портсигар;
	Аналог.Аналог = ПортсигарИмп;
	Аналог.Записать();
	Аналог = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
	Аналог.Номенклатура = ПортсигарИмп;
	Аналог.Аналог = ПортсигарОтеч;
	Аналог.Записать();

	Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
	Приход.Дата = Дата(2014, 1, 15, 10, 0, 0);
	Приход.Склад = Склад;
	Приход.Контрагент = Поставщик;
	ДобавитьСтроку(Приход.СписокНоменклатуры, Куртка, 3, 100);
	ДобавитьСтроку(Приход.СписокНоменклатуры, Портсигар, 1, 5);
	ДобавитьСтроку(Приход.СписокНоменклатуры, ПортсигарИмп, 3, 10);
	ДобавитьСтроку(Приход.СписокНоменклатуры, ПортсигарОтеч, 1, 7);
	Провести(Приход);

	Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
	Продажа.Дата = Дата(2014, 2, 10, 10, 0, 0);
	Продажа.Склад = Склад;
	Продажа.Контрагент = Покупатель;
	ДобавитьСтроку(Продажа.СписокНоменклатуры, Куртка, 3, 620 / 3);
	Продажа.СписокНоменклатуры[0].Сумма = 620;
	ДобавитьСтроку(Продажа.СписокНоменклатуры, Портсигар, 5, 92);
	Провести(Продажа);

	Операция = Документы.Операция.СоздатьДокумент();
	Операция.Дата = Дата(2014, 1, 20, 10, 0, 0);
	Операция.Содержание = "Внесение наличных (демо)";
	Проводка = Операция.Проводки.Добавить();
	Проводка.СчетДт = ПланыСчетов.Управленческий.Касса;
	Проводка.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
	Проводка.Сумма = 1000;
	Провести(Операция);

КонецПроцедуры

Процедура ЗаполнитьПериодическиеРасчеты()

	Цех = Элемент("Подразделения", "Цех сборки");
	Иванов = Элемент("ФизическиеЛица", "Иванов И.И.", Новый Структура("ДатаНачалаСтажа", Дата(2010, 5, 1)));
	Петров = Элемент("ФизическиеЛица", "Петров П.П.", Новый Структура("ДатаНачалаСтажа", Дата(2013, 1, 1)));
	Сидоров = Элемент("ФизическиеЛица", "Сидоров С.С.", Новый Структура("ДатаНачалаСтажа", Дата(2012, 6, 1)));
	ЦехОбъект = Цех.ПолучитьОбъект();
	ЦехОбъект.Руководитель = Иванов;
	ЦехОбъект.Записать();

	Обработки.ЗаполнениеГрафика.Создать().ЗаполнитьГрафик(Дата(2014, 1, 1), Дата(2014, 6, 30), "67", Цех);

	Для Каждого Данные Из ОбщийМассив(
			Новый Структура("Сотрудник, Ставка", Иванов, 300),
			Новый Структура("Сотрудник, Ставка", Петров, 200),
			Новый Структура("Сотрудник, Ставка", Сидоров, 250)) Цикл
		Ставка = РегистрыСведений.СведенияОСотрудниках.СоздатьМенеджерЗаписи();
		Ставка.Период = Дата(2014, 1, 1);
		Ставка.Сотрудник = Данные.Сотрудник;
		Ставка.Подразделение = Цех;
		Ставка.Оклад = Данные.Ставка;
		Ставка.Записать();
	КонецЦикла;

	Для Каждого Данные Из ОбщийМассив(Новый Структура("От, Процент", 0, 5), Новый Структура("От, Процент", 1, 10), Новый Структура("От, Процент", 3, 15)) Цикл
		Шкала = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
		Шкала.СтажОт = Данные.От;
		Шкала.Процент = Данные.Процент;
		Шкала.Записать();
	КонецЦикла;

	Тариф = ПланыВидовРасчета.ОсновныеНачисления.Тариф;
	Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;
	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
	Сотрудники = ОбщийМассив(Иванов, Петров, Сидоров);

	Для Месяц = 1 По 4 Цикл
		Документ = Документы.НачислениеЗарплаты.СоздатьДокумент();
		Документ.Дата = Дата(2014, Месяц, 28, 10, 0, 0);
		Для Каждого Сотрудник Из Сотрудники Цикл
			ДобавитьНачисление(Документ, Сотрудник, Цех, Тариф, Дата(2014, Месяц, 1), КонецМесяца(Дата(2014, Месяц, 1)));
		КонецЦикла;
		Если Месяц > 1 Тогда
			ДобавитьНачисление(Документ, Иванов, Цех, Премия, Дата(2014, Месяц, 1), КонецМесяца(Дата(2014, Месяц, 1)));
		КонецЕсли;
		Провести(Документ);
	КонецЦикла;

	// Командировка за несколько расчетных периодов, введенная после начисления тарифа (задним числом).
	Документ = Документы.НачислениеЗарплаты.СоздатьДокумент();
	Документ.Дата = Дата(2014, 4, 30, 10, 0, 0);
	ДобавитьНачисление(Документ, Петров, Цех, Командировка, Дата(2014, 4, 21), Дата(2014, 5, 9));
	Провести(Документ);

	// Дополнительные сведения контрагентов (управляемые формы).
	ВалютаКредита = ВидСведений("Валюта кредита", Новый ОписаниеТипов("СправочникСсылка.Валюты"));
	СрокКредита = ВидСведений("Срок кредита, дни", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10, 0)));
	Регион = ВидСведений("Регион", Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов"));
	Москва = Справочники.ЗначенияСвойствОбъектов.НайтиПоНаименованию("Москва", , , Регион);
	Если Москва.Пустая() Тогда
		МоскваОбъект = Справочники.ЗначенияСвойствОбъектов.СоздатьЭлемент();
		МоскваОбъект.Владелец = Регион;
		МоскваОбъект.Наименование = "Москва";
		МоскваОбъект.Записать();
		Москва = МоскваОбъект.Ссылка;
	КонецЕсли;

	ИвановОбъект = Иванов.ПолучитьОбъект();
	ИвановОбъект.ДополнительныеСведения.Очистить();
	Для Каждого Вид Из ОбщийМассив(ВалютаКредита, СрокКредита, Регион) Цикл
		ИвановОбъект.ДополнительныеСведения.Добавить().Свойство = Вид;
	КонецЦикла;
	ИвановОбъект.Записать();

	Сатурн = Элемент("Контрагенты", "Завод ""Сатурн""").ПолучитьОбъект();
	Сатурн.Менеджер = Иванов;
	Сатурн.ДополнительныеСведения.Очистить();
	Строка = Сатурн.ДополнительныеСведения.Добавить();
	Строка.Свойство = СрокКредита;
	Строка.Значение = 10;
	Строка = Сатурн.ДополнительныеСведения.Добавить();
	Строка.Свойство = Регион;
	Строка.Значение = Москва;
	Валюта = Справочники.Валюты.Выбрать();
	Если Валюта.Следующий() Тогда
		Строка = Сатурн.ДополнительныеСведения.Добавить();
		Строка.Свойство = ВалютаКредита;
		Строка.Значение = Валюта.Ссылка;
	КонецЕсли;
	Сатурн.Записать();

КонецПроцедуры

Процедура Провести(ДокументОбъект)

	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Тексты = Новый Массив;
		Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
			Тексты.Добавить(Сообщение.Текст);
		КонецЦикла;
		ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()) + Символы.ПС + СтрСоединить(Тексты, Символы.ПС);
	КонецПопытки;

КонецПроцедуры

Функция Элемент(ИмяСправочника, Наименование, Реквизиты = Неопределено)

	Менеджер = Справочники[ИмяСправочника];
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если Ссылка.Пустая() Тогда
		Объект = Менеджер.СоздатьЭлемент();
		Объект.Наименование = Наименование;
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Если Реквизиты <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Объект, Реквизиты);
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура УстановитьПолитику(Подразделение, Политика)

	Запись = РегистрыСведений.УчетныеПолитики.СоздатьМенеджерЗаписи();
	Запись.Период = Дата(2014, 1, 1);
	Запись.Подразделение = Подразделение;
	Запись.УчетнаяПолитика = Политика;
	Запись.Записать();

КонецПроцедуры

Функция ВидХарактеристики(Наименование)

	Ссылка = ПланыВидовХарактеристик.ХарактеристикиНоменклатуры.НайтиПоНаименованию(Наименование, Истина);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = ПланыВидовХарактеристик.ХарактеристикиНоменклатуры.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияХарактеристик");
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ВидСведений(Наименование, ТипЗначения)

	Ссылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоНаименованию(Наименование, Истина);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ТипЗначения = ТипЗначения;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ЗначениеХарактеристики(ВидХарактеристики, Наименование)

	Ссылка = Справочники.ЗначенияХарактеристик.НайтиПоНаименованию(Наименование, Истина, , ВидХарактеристики);
	Если Не Ссылка.Пустая() Тогда
		Возврат Ссылка;
	КонецЕсли;
	Объект = Справочники.ЗначенияХарактеристик.СоздатьЭлемент();
	Объект.Владелец = ВидХарактеристики;
	Объект.Наименование = Наименование;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция Свойство(Номенклатура, Наименование, ВидХарактеристики, Значение)

	Ссылка = Справочники.СвойстваНоменклатуры.НайтиПоНаименованию(Наименование, Истина, , Номенклатура);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.СвойстваНоменклатуры.СоздатьЭлемент();
		Объект.Владелец = Номенклатура;
		Объект.Наименование = Наименование;
		Объект.Записать();
		Ссылка = Объект.Ссылка;
	КонецЕсли;
	Запись = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
	Запись.Свойство = Ссылка;
	Запись.Характеристика = ВидХарактеристики;
	Запись.Значение = Значение;
	Запись.Записать();
	Возврат Ссылка;

КонецФункции

Процедура ДобавитьСтроку(Таблица, Номенклатура, Количество, Цена, Свойство = Неопределено, Подразделение = Неопределено)

	Строка = Таблица.Добавить();
	Строка.Номенклатура = Номенклатура;
	Строка.Количество = Количество;
	Строка.Цена = Цена;
	Строка.Сумма = Количество * Цена;
	Если Свойство <> Неопределено Тогда
		Строка.Свойство = Свойство;
	КонецЕсли;
	Если Подразделение <> Неопределено Тогда
		Строка.Подразделение = Подразделение;
	КонецЕсли;

КонецПроцедуры

Процедура ДобавитьНачисление(Документ, Сотрудник, Подразделение, ВидРасчета, ДатаНачала, ДатаОкончания)

	Строка = Документ.ОсновныеНачисления.Добавить();
	Строка.Сотрудник = Сотрудник;
	Строка.Подразделение = Подразделение;
	Строка.ВидРасчета = ВидРасчета;
	Строка.ДатаНачала = ДатаНачала;
	Строка.ДатаОкончания = ДатаОкончания;

КонецПроцедуры

Функция ОбщийМассив(Знач П1 = Неопределено, Знач П2 = Неопределено, Знач П3 = Неопределено)

	Результат = Новый Массив;
	Для Каждого Значение Из ПараметрыВМассив(П1, П2, П3) Цикл
		Если Значение <> Неопределено Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ПараметрыВМассив(П1, П2, П3)

	Результат = Новый Массив;
	Результат.Добавить(П1);
	Результат.Добавить(П2);
	Результат.Добавить(П3);
	Возврат Результат;

КонецФункции

#КонецОбласти
