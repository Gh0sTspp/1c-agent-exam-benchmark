#Область ПрограммныйИнтерфейс

// Списывает партии номенклатуры подразделений согласно учетной политике каждого подразделения.
//
// Параметры:
//  Движения    - КоллекцияДвижений - движения документа.
//  Период      - Дата - дата документа.
//  Граница     - Граница - момент получения остатков.
//  Потребность - ТаблицаЗначений - см. НоваяТаблицаПотребности(); в колонку Стоимость
//                помещается себестоимость списания.
//  Отказ       - Булево.
//
Процедура СписатьПартии(Движения, Период, Граница, Потребность, Отказ) Экспорт

	Если Потребность.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиНоменклатуры");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Потребность;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Номенклатура", "Номенклатура");
	Блокировка.Заблокировать();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Потребность.Подразделение КАК Подразделение,
	|	Потребность.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ ВТПотребность
	|ИЗ
	|	&Потребность КАК Потребность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.Свойство КАК Свойство,
	|	Остатки.Партия КАК Партия,
	|	Остатки.Партия.МоментВремени КАК МоментПартии,
	|	Остатки.КоличествоОстаток КАК Количество,
	|	Остатки.СтоимостьОстаток КАК Стоимость
	|ИЗ
	|	РегистрНакопления.ОстаткиНоменклатуры.Остатки(
	|			&Граница,
	|			(Подразделение, Номенклатура) В
	|				(ВЫБРАТЬ
	|					ВТПотребность.Подразделение,
	|					ВТПотребность.Номенклатура
	|				ИЗ
	|					ВТПотребность)) КАК Остатки
	|ГДЕ
	|	Остатки.КоличествоОстаток > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	МоментПартии
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Политики.Подразделение КАК Подразделение,
	|	Политики.УчетнаяПолитика КАК УчетнаяПолитика
	|ИЗ
	|	РегистрСведений.УчетныеПолитики.СрезПоследних(
	|			&Период,
	|			Подразделение В
	|				(ВЫБРАТЬ
	|					ВТПотребность.Подразделение
	|				ИЗ
	|					ВТПотребность)) КАК Политики";
	Запрос.УстановитьПараметр("Граница", Граница);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Потребность", Потребность);
	Результаты = Запрос.ВыполнитьПакет();
	Партии = Результаты[1].Выгрузить();
	Политики = Результаты[2].Выгрузить();

	Для Каждого СтрокаПотребности Из Потребность Цикл

		СтрокаПолитики = Политики.Найти(СтрокаПотребности.Подразделение, "Подразделение");
		Политика = ?(СтрокаПолитики = Неопределено, Перечисления.УчетнаяПолитика.ФИФО, СтрокаПолитики.УчетнаяПолитика);

		Отбор = Новый Структура("Подразделение, Номенклатура", СтрокаПотребности.Подразделение, СтрокаПотребности.Номенклатура);
		Если СтрокаПотребности.УчитыватьСвойство Тогда
			Отбор.Вставить("Свойство", СтрокаПотребности.Свойство);
		КонецЕсли;
		СтрокиПартий = Партии.НайтиСтроки(Отбор);

		ВсегоКоличество = 0;
		ВсегоСтоимость = 0;
		Для Каждого СтрокаПартии Из СтрокиПартий Цикл
			ВсегоКоличество = ВсегоКоличество + СтрокаПартии.Количество;
			ВсегоСтоимость = ВсегоСтоимость + СтрокаПартии.Стоимость;
		КонецЦикла;

		Если ВсегоКоличество < СтрокаПотребности.Количество Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru = 'В подразделении ""%1"" не хватает ""%2""%3: требуется %4, в наличии %5'"),
				СтрокаПотребности.Подразделение, СтрокаПотребности.Номенклатура,
				?(СтрокаПотребности.УчитыватьСвойство И ЗначениеЗаполнено(СтрокаПотребности.Свойство), " (" + СтрокаПотребности.Свойство + ")", ""),
				СтрокаПотребности.Количество, ВсегоКоличество);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Отказ);
			Продолжить;
		КонецЕсли;

		Если Отказ Тогда
			Продолжить;
		КонецЕсли;

		// По средней себестоимость определяется по всем партиям подразделения, номенклатуры (и свойства).
		СтоимостьПоСредней = 0;
		Если Политика = Перечисления.УчетнаяПолитика.ПоСредней Тогда
			Если ВсегоКоличество = СтрокаПотребности.Количество Тогда
				СтоимостьПоСредней = ВсегоСтоимость;
			Иначе
				СтоимостьПоСредней = Окр(ВсегоСтоимость * СтрокаПотребности.Количество / ВсегоКоличество, 2);
			КонецЕсли;
		КонецЕсли;

		// ЛИФО - партии в обратном порядке поступления.
		Если Политика = Перечисления.УчетнаяПолитика.ЛИФО Тогда
			Порядок = Новый Массив;
			Для Индекс = 1 По СтрокиПартий.Количество() Цикл
				Порядок.Добавить(СтрокиПартий[СтрокиПартий.Количество() - Индекс]);
			КонецЦикла;
			СтрокиПартий = Порядок;
		КонецЕсли;

		ОсталосьСписать = СтрокаПотребности.Количество;
		ОсталосьСтоимостиПоСредней = СтоимостьПоСредней;
		СтоимостьСписания = 0;

		Для Каждого СтрокаПартии Из СтрокиПартий Цикл

			Если ОсталосьСписать = 0 Тогда
				Прервать;
			КонецЕсли;
			Если СтрокаПартии.Количество = 0 Тогда
				Продолжить;
			КонецЕсли;

			Списать = Мин(ОсталосьСписать, СтрокаПартии.Количество);
			Если Политика = Перечисления.УчетнаяПолитика.ПоСредней Тогда
				Если Списать = ОсталосьСписать Тогда
					Стоимость = ОсталосьСтоимостиПоСредней;
				Иначе
					Стоимость = Окр(СтоимостьПоСредней * Списать / СтрокаПотребности.Количество, 2);
				КонецЕсли;
				ОсталосьСтоимостиПоСредней = ОсталосьСтоимостиПоСредней - Стоимость;
			ИначеЕсли Списать = СтрокаПартии.Количество Тогда
				Стоимость = СтрокаПартии.Стоимость;
			Иначе
				Стоимость = Окр(СтрокаПартии.Стоимость * Списать / СтрокаПартии.Количество, 2);
			КонецЕсли;

			Движение = Движения.ОстаткиНоменклатуры.ДобавитьРасход();
			Движение.Период = Период;
			Движение.Подразделение = СтрокаПартии.Подразделение;
			Движение.Номенклатура = СтрокаПартии.Номенклатура;
			Движение.Свойство = СтрокаПартии.Свойство;
			Движение.Партия = СтрокаПартии.Партия;
			Движение.Количество = Списать;
			Движение.Стоимость = Стоимость;

			СтрокаПартии.Количество = СтрокаПартии.Количество - Списать;
			СтрокаПартии.Стоимость = СтрокаПартии.Стоимость - Стоимость;
			ОсталосьСписать = ОсталосьСписать - Списать;
			СтоимостьСписания = СтоимостьСписания + Стоимость;

		КонецЦикла;

		СтрокаПотребности.Стоимость = СтоимостьСписания;

	КонецЦикла;

КонецПроцедуры

// Возвращает новую таблицу потребности для процедуры СписатьПартии.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Подразделение, Номенклатура, Свойство, УчитыватьСвойство, Количество, Стоимость.
//
Функция НоваяТаблицаПотребности() Экспорт

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Таблица.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Таблица.Колонки.Добавить("Свойство", Новый ОписаниеТипов("СправочникСсылка.СвойстваНоменклатуры"));
	Таблица.Колонки.Добавить("УчитыватьСвойство", Новый ОписаниеТипов("Булево"));
	Таблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	Таблица.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	Возврат Таблица;

КонецФункции

#КонецОбласти
