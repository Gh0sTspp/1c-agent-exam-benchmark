#Область ПрограммныйИнтерфейс

// Возвращает для каждого товара порядок списания: сам товар, затем его аналоги по возрастанию артикула.
// Аналоги определяются с учетом транзитивности: если Товар1 имеет аналог Товар2, а Товар2 имеет
// аналог Товар3, то Товар3 - аналог Товар1. Связь аналогов считается взаимной.
//
// Параметры:
//  Товары - Массив - номенклатура документа.
//
// Возвращаемое значение:
//  Соответствие - ключ: номенклатура, значение: Массив номенклатуры в порядке списания.
//
Функция ПорядокСписанияСАналогами(Товары) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Аналоги.Номенклатура КАК Номенклатура,
	|	Аналоги.Аналог КАК Аналог,
	|	Аналоги.Номенклатура.Артикул КАК АртикулНоменклатуры,
	|	Аналоги.Аналог.Артикул КАК АртикулАналога
	|ИЗ
	|	РегистрСведений.Аналоги КАК Аналоги";
	Пары = Запрос.Выполнить().Выгрузить();

	// Граф связей и артикулы.
	Связи = Новый Соответствие;
	Артикулы = Новый Соответствие;
	Для Каждого Пара Из Пары Цикл
		ДобавитьСвязь(Связи, Пара.Номенклатура, Пара.Аналог);
		ДобавитьСвязь(Связи, Пара.Аналог, Пара.Номенклатура);
		Артикулы.Вставить(Пара.Номенклатура, Пара.АртикулНоменклатуры);
		Артикулы.Вставить(Пара.Аналог, Пара.АртикулАналога);
	КонецЦикла;

	Результат = Новый Соответствие;
	Для Каждого Товар Из Товары Цикл
		Если Результат[Товар] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		// Обход в ширину - все транзитивные аналоги.
		Найденные = Новый Соответствие;
		Найденные.Вставить(Товар, Истина);
		Очередь = Новый Массив;
		Очередь.Добавить(Товар);
		Аналоги = Новый СписокЗначений;
		Индекс = 0;
		Пока Индекс < Очередь.Количество() Цикл
			Соседи = Связи[Очередь[Индекс]];
			Индекс = Индекс + 1;
			Если Соседи = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого Сосед Из Соседи Цикл
				Если Найденные[Сосед] = Неопределено Тогда
					Найденные.Вставить(Сосед, Истина);
					Очередь.Добавить(Сосед);
					Аналоги.Добавить(Сосед, Артикулы[Сосед]);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		Аналоги.СортироватьПоПредставлению();

		Порядок = Новый Массив;
		Порядок.Добавить(Товар);
		Для Каждого ЭлементСписка Из Аналоги Цикл
			Порядок.Добавить(ЭлементСписка.Значение);
		КонецЦикла;
		Результат.Вставить(Товар, Порядок);
	КонецЦикла;

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСвязь(Связи, Откуда, Куда)

	Соседи = Связи[Откуда];
	Если Соседи = Неопределено Тогда
		Соседи = Новый Массив;
		Связи.Вставить(Откуда, Соседи);
	КонецЕсли;
	Соседи.Добавить(Куда);

КонецПроцедуры

#КонецОбласти
