#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Ключ.Пустая() Тогда
		ПостроитьДополнительныеПоля();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ПостроитьДополнительныеПоля();

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Для Каждого ЭлементСписка Из ДополнительныеПоля Цикл
		Свойство = ЭлементСписка.Значение;
		СтрокиСведений = ТекущийОбъект.ДополнительныеСведения.НайтиСтроки(Новый Структура("Свойство", Свойство));
		Если СтрокиСведений.Количество() = 0 Тогда
			СтрокаСведений = ТекущийОбъект.ДополнительныеСведения.Добавить();
			СтрокаСведений.Свойство = Свойство;
		Иначе
			СтрокаСведений = СтрокиСведений[0];
		КонецЕсли;
		СтрокаСведений.Значение = ЭтотОбъект[ЭлементСписка.Представление];
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура МенеджерПриИзменении(Элемент)

	МенеджерПриИзмененииНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура МенеджерПриИзмененииНаСервере()

	ПостроитьДополнительныеПоля();

КонецПроцедуры

// Создает поля ввода дополнительных сведений по списку, заданному у менеджера контрагента.
&НаСервере
Процедура ПостроитьДополнительныеПоля()

	// Значения уже введенных полей сохраняются при смене менеджера.
	ТекущиеЗначения = Новый Соответствие;
	УдаляемыеРеквизиты = Новый Массив;
	Для Каждого ЭлементСписка Из ДополнительныеПоля Цикл
		ТекущиеЗначения.Вставить(ЭлементСписка.Значение, ЭтотОбъект[ЭлементСписка.Представление]);
		УдаляемыеРеквизиты.Добавить(ЭлементСписка.Представление);
		Элементы.Удалить(Элементы[ЭлементСписка.Представление]);
	КонецЦикла;
	ДополнительныеПоля.Очистить();

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сведения.Свойство КАК Свойство,
	|	Сведения.Свойство.Наименование КАК Наименование,
	|	Сведения.Свойство.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.ФизическиеЛица.ДополнительныеСведения КАК Сведения
	|ГДЕ
	|	Сведения.Ссылка = &Менеджер
	|	И Сведения.Свойство <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сведения.НомерСтроки";
	Запрос.УстановитьПараметр("Менеджер", Объект.Менеджер);
	Свойства = Запрос.Выполнить().Выгрузить();

	ДобавляемыеРеквизиты = Новый Массив;
	ИменаПолей = Новый Соответствие;
	Для Каждого СтрокаСвойства Из Свойства Цикл
		Если ИменаПолей[СтрокаСвойства.Свойство] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяПоля = "ДополнительноеСведение" + Формат(ИменаПолей.Количество() + 1, "ЧГ=0");
		ИменаПолей.Вставить(СтрокаСвойства.Свойство, ИмяПоля);
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяПоля, СтрокаСвойства.ТипЗначения, , СтрокаСвойства.Наименование));
		ДополнительныеПоля.Добавить(СтрокаСвойства.Свойство, ИмяПоля);
	КонецЦикла;

	ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);

	Для Каждого СтрокаСвойства Из Свойства Цикл
		ИмяПоля = ИменаПолей[СтрокаСвойства.Свойство];
		Если Элементы.Найти(ИмяПоля) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Поле = Элементы.Добавить(ИмяПоля, Тип("ПолеФормы"), Элементы.ГруппаДополнительныеСведения);
		Поле.Вид = ВидПоляФормы.ПолеВвода;
		Поле.ПутьКДанным = ИмяПоля;
		Поле.Заголовок = СтрокаСвойства.Наименование;
		Если СтрокаСвойства.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЗначенияСвойствОбъектов")) Тогда
			МассивПараметров = Новый Массив;
			МассивПараметров.Добавить(Новый ПараметрВыбора("Отбор.Владелец", СтрокаСвойства.Свойство));
			Поле.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
		КонецЕсли;

		Значение = ТекущиеЗначения[СтрокаСвойства.Свойство];
		Если Значение = Неопределено Тогда
			СтрокиСведений = Объект.ДополнительныеСведения.НайтиСтроки(Новый Структура("Свойство", СтрокаСвойства.Свойство));
			Если СтрокиСведений.Количество() > 0 Тогда
				Значение = СтрокиСведений[0].Значение;
			КонецЕсли;
		КонецЕсли;
		ЭтотОбъект[ИмяПоля] = СтрокаСвойства.ТипЗначения.ПривестиЗначение(Значение);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
