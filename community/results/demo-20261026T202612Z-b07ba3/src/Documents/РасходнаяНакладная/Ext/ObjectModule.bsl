#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Если Не ЗначениеЗаполнено(Склад) Тогда
		Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
			Если Не ЗначениеЗаполнено(СтрокаТовара.Подразделение) Тогда
				ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'В строке %1 укажите подразделение (оперативный учет) или склад документа (бухгалтерский учет)'"),
					СтрокаТовара.НомерСтроки), Отказ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СуммаПоДокументу = СписокНоменклатуры.Итог("Сумма");

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Движения.Продажи.Записывать = Истина;
	ПровестиПоОперативномуУчету(Отказ);
	Если ЗначениеЗаполнено(Склад) Тогда
		ПровестиПоБухгалтерскомуУчету(Отказ);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПровестиПоОперативномуУчету(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Товары.Подразделение КАК Подразделение,
	|	Товары.Номенклатура КАК Номенклатура,
	|	СУММА(Товары.Количество) КАК Количество,
	|	СУММА(Товары.Сумма) КАК Сумма
	|ИЗ
	|	Документ.РасходнаяНакладная.СписокНоменклатуры КАК Товары
	|ГДЕ
	|	Товары.Ссылка = &Ссылка
	|	И Товары.Подразделение <> ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	Товары.Подразделение,
	|	Товары.Номенклатура";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;

	Потребность = ОперативныйУчетСервер.НоваяТаблицаПотребности();
	Потребность.Колонки.Добавить("Выручка", Новый ОписаниеТипов("Число"));
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПотребности = Потребность.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПотребности, Выборка);
		СтрокаПотребности.Выручка = Выборка.Сумма;
	КонецЦикла;

	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	ОперативныйУчетСервер.СписатьПартии(Движения, Дата, Новый Граница(МоментВремени(), ВидГраницы.Исключая), Потребность, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаПотребности Из Потребность Цикл
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Подразделение = СтрокаПотребности.Подразделение;
		Движение.Номенклатура = СтрокаПотребности.Номенклатура;
		Движение.ПроданнаяНоменклатура = СтрокаПотребности.Номенклатура;
		Движение.Количество = СтрокаПотребности.Количество;
		Движение.Себестоимость = СтрокаПотребности.Стоимость;
		Движение.Выручка = СтрокаПотребности.Выручка;
	КонецЦикла;

КонецПроцедуры

Процедура ПровестиПоБухгалтерскомуУчету(Отказ)

	Движения.Управленческий.Записывать = Истина;

	СчетТоваров = ПланыСчетов.Управленческий.Товары;
	ВидНоменклатура = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
	ВидСклады = ПланыВидовХарактеристик.ВидыСубконто.Склады;

	// Кандидаты на списание: сам товар, затем его аналоги в порядке артикулов.
	Кандидаты = БухгалтерскийУчетСервер.ПорядокСписанияСАналогами(СписокНоменклатуры.ВыгрузитьКолонку("Номенклатура"));
	ВсяНоменклатура = Новый Массив;
	Для Каждого КлючИЗначение Из Кандидаты Цикл
		Для Каждого Элемент Из КлючИЗначение.Значение Цикл
			ВсяНоменклатура.Добавить(Элемент);
		КонецЦикла;
	КонецЦикла;

	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрБухгалтерии.Управленческий");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Счет", СчетТоваров);
	Блокировка.Заблокировать();

	// Количество - на складе документа; сумма и количество по номенклатуре в целом - для средней себестоимости.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Остатки.Субконто1 КАК Номенклатура,
	|	Остатки.Субконто2 КАК Склад,
	|	Остатки.КоличествоОстатокДт КАК Количество,
	|	Остатки.СуммаОстатокДт КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.Управленческий.Остатки(
	|			&Граница,
	|			Счет = &Счет,
	|			&ВидыСубконто,
	|			Субконто1 В (&ВсяНоменклатура)) КАК Остатки";
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ВидНоменклатура);
	ВидыСубконто.Добавить(ВидСклады);
	Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Счет", СчетТоваров);
	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	Запрос.УстановитьПараметр("ВсяНоменклатура", ВсяНоменклатура);
	Остатки = Запрос.Выполнить().Выгрузить();

	НаСкладе = Новый Соответствие;
	ВсегоКоличество = Новый Соответствие;
	ВсегоСумма = Новый Соответствие;
	Для Каждого СтрокаОстатка Из Остатки Цикл
		Если СтрокаОстатка.Склад = Склад Тогда
			НаСкладе.Вставить(СтрокаОстатка.Номенклатура, ЧислоИлиНоль(НаСкладе[СтрокаОстатка.Номенклатура]) + СтрокаОстатка.Количество);
		КонецЕсли;
		ВсегоКоличество.Вставить(СтрокаОстатка.Номенклатура, ЧислоИлиНоль(ВсегоКоличество[СтрокаОстатка.Номенклатура]) + СтрокаОстатка.Количество);
		ВсегоСумма.Вставить(СтрокаОстатка.Номенклатура, ЧислоИлиНоль(ВсегоСумма[СтрокаОстатка.Номенклатура]) + СтрокаОстатка.Сумма);
	КонецЦикла;

	Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл

		ОсталосьСписать = СтрокаТовара.Количество;
		ОсталосьВыручки = СтрокаТовара.Сумма;
		Списания = Новый Массив;
		Для Каждого Кандидат Из Кандидаты[СтрокаТовара.Номенклатура] Цикл
			Если ОсталосьСписать <= 0 Тогда
				Прервать;
			КонецЕсли;
			Доступно = ЧислоИлиНоль(НаСкладе[Кандидат]);
			Если Доступно <= 0 Тогда
				Продолжить;
			КонецЕсли;
			Списать = Мин(Доступно, ОсталосьСписать);
			Количество = ЧислоИлиНоль(ВсегоКоличество[Кандидат]);
			Сумма = ЧислоИлиНоль(ВсегоСумма[Кандидат]);
			Если Списать >= Количество Тогда
				Себестоимость = Сумма;
			Иначе
				Себестоимость = Окр(Сумма * Списать / Количество, 2);
			КонецЕсли;
			НаСкладе.Вставить(Кандидат, Доступно - Списать);
			ВсегоКоличество.Вставить(Кандидат, Количество - Списать);
			ВсегоСумма.Вставить(Кандидат, Сумма - Себестоимость);
			ОсталосьСписать = ОсталосьСписать - Списать;
			Списания.Добавить(Новый Структура("Номенклатура, Количество, Себестоимость", Кандидат, Списать, Себестоимость));
		КонецЦикла;

		Если ОсталосьСписать > 0 Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Строка %1: на складе ""%2"" не хватает товара ""%3"" и всех его аналогов (не хватает %4)'"),
				СтрокаТовара.НомерСтроки, Склад, СтрокаТовара.Номенклатура, ОсталосьСписать), Отказ);
			Продолжить;
		КонецЕсли;
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;

		Для Индекс = 0 По Списания.ВГраница() Цикл
			Списание = Списания[Индекс];
			Проводка = Движения.Управленческий.Добавить();
			Проводка.Период = Дата;
			Проводка.СчетДт = ПланыСчетов.Управленческий.ПрибылиУбытки;
			Проводка.СчетКт = СчетТоваров;
			Проводка.СубконтоКт[ВидНоменклатура] = Списание.Номенклатура;
			Проводка.СубконтоКт[ВидСклады] = Склад;
			Проводка.КоличествоКт = Списание.Количество;
			Проводка.Сумма = Списание.Себестоимость;

			Если Индекс = Списания.ВГраница() Тогда
				Выручка = ОсталосьВыручки;
			Иначе
				Выручка = Окр(СтрокаТовара.Сумма * Списание.Количество / СтрокаТовара.Количество, 2);
			КонецЕсли;
			ОсталосьВыручки = ОсталосьВыручки - Выручка;

			Движение = Движения.Продажи.Добавить();
			Движение.Период = Дата;
			Движение.Склад = Склад;
			Движение.Номенклатура = СтрокаТовара.Номенклатура;
			Движение.ПроданнаяНоменклатура = Списание.Номенклатура;
			Движение.Количество = Списание.Количество;
			Движение.Себестоимость = Списание.Себестоимость;
			Движение.Выручка = Выручка;
		КонецЦикла;

		Проводка = Движения.Управленческий.Добавить();
		Проводка.Период = Дата;
		Проводка.СчетДт = ПланыСчетов.Управленческий.Покупатели;
		Если ЗначениеЗаполнено(Контрагент) Тогда
			Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Контрагенты] = Контрагент;
		КонецЕсли;
		Проводка.СчетКт = ПланыСчетов.Управленческий.ПрибылиУбытки;
		Проводка.Сумма = СтрокаТовара.Сумма;

	КонецЦикла;

КонецПроцедуры

Функция ЧислоИлиНоль(Значение)

	Возврат ?(Значение = Неопределено, 0, Значение);

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
