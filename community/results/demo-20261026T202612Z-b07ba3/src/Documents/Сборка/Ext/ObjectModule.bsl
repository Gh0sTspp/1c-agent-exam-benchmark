#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОстаткиНоменклатуры.Записывать = Истина;
	
	// Детали по актуальной на момент проведения спецификации и дополнительные детали.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Блоки.НомерСтроки КАК НомерСтроки,
	|	Блоки.Номенклатура КАК Номенклатура,
	|	Блоки.Количество КАК Количество
	|ПОМЕСТИТЬ ВТБлоки
	|ИЗ
	|	Документ.Сборка.СистемныеБлоки КАК Блоки
	|ГДЕ
	|	Блоки.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБлоки.НомерСтроки КАК НомерСтроки,
	|	Спецификации.Деталь КАК Номенклатура,
	|	Спецификации.Свойство КАК Свойство,
	|	Спецификации.Количество * ВТБлоки.Количество КАК Количество
	|ПОМЕСТИТЬ ВТДетали
	|ИЗ
	|	ВТБлоки КАК ВТБлоки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Спецификации.СрезПоследних(
	|				&Период,
	|				СистемныйБлок В
	|					(ВЫБРАТЬ
	|						ВТБлоки.Номенклатура
	|					ИЗ
	|						ВТБлоки)) КАК Спецификации
	|		ПО ВТБлоки.Номенклатура = Спецификации.СистемныйБлок
	|ГДЕ
	|	Спецификации.Количество > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	0,
	|	Доп.Номенклатура,
	|	Доп.Свойство,
	|	Доп.Количество
	|ИЗ
	|	Документ.Сборка.ДополнительныеДетали КАК Доп
	|ГДЕ
	|	Доп.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДетали.Номенклатура КАК Номенклатура,
	|	ВТДетали.Свойство КАК Свойство,
	|	ИСТИНА КАК УчитыватьСвойство,
	|	СУММА(ВТДетали.Количество) КАК Количество
	|ИЗ
	|	ВТДетали КАК ВТДетали
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТДетали.Номенклатура,
	|	ВТДетали.Свойство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТДетали.НомерСтроки КАК НомерСтроки,
	|	ВТДетали.Номенклатура КАК Номенклатура,
	|	ВТДетали.Свойство КАК Свойство,
	|	ВТДетали.Количество КАК Количество
	|ИЗ
	|	ВТДетали КАК ВТДетали
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТБлоки.НомерСтроки КАК НомерСтроки,
	|	ВТБлоки.Номенклатура КАК Номенклатура,
	|	ВТБлоки.Количество КАК Количество
	|ИЗ
	|	ВТБлоки КАК ВТБлоки
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Период", Дата);
	Результаты = Запрос.ВыполнитьПакет();
	
	Потребность = ОперативныйУчетСервер.НоваяТаблицаПотребности();
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтрокаПотребности = Потребность.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПотребности, Выборка);
		СтрокаПотребности.Подразделение = ПодразделениеОтправитель;
	КонецЦикла;
	ДеталиПоСтрокам = Результаты[3].Выгрузить();
	Блоки = Результаты[4].Выгрузить();
	
	Если Потребность.Количество() = 0 Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не найдены спецификации собираемых блоков и не указаны дополнительные детали'"), Отказ);
		Возврат;
	КонецЕсли;
	
	ОперативныйУчетСервер.СписатьПартии(Движения, Дата, Новый Граница(МоментВремени(), ВидГраницы.Исключая), Потребность, Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Распределение себестоимости деталей по собранным блокам:
	// детали спецификации - на свой блок, дополнительные детали - пропорционально количеству блоков.
	ВсегоСтоимость = Потребность.Итог("Стоимость");
	ЦеныДеталей = Новый Соответствие;
	Для Каждого СтрокаПотребности Из Потребность Цикл
		Ключ = Строка(СтрокаПотребности.Номенклатура.УникальныйИдентификатор()) + Строка(СтрокаПотребности.Свойство.УникальныйИдентификатор());
		ЦеныДеталей.Вставить(Ключ, ?(СтрокаПотребности.Количество = 0, 0, СтрокаПотребности.Стоимость / СтрокаПотребности.Количество));
	КонецЦикла;
	
	Блоки.Колонки.Добавить("Стоимость", Новый ОписаниеТипов("Число"));
	СтоимостьПоСпецификациям = 0;
	Для Каждого СтрокаДетали Из ДеталиПоСтрокам Цикл
		Если СтрокаДетали.НомерСтроки = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаБлока = Блоки.Найти(СтрокаДетали.НомерСтроки, "НомерСтроки");
		Ключ = Строка(СтрокаДетали.Номенклатура.УникальныйИдентификатор()) + Строка(СтрокаДетали.Свойство.УникальныйИдентификатор());
		Стоимость = Окр(СтрокаДетали.Количество * ЦеныДеталей[Ключ], 2);
		СтрокаБлока.Стоимость = СтрокаБлока.Стоимость + Стоимость;
		СтоимостьПоСпецификациям = СтоимостьПоСпецификациям + Стоимость;
	КонецЦикла;
	
	СтоимостьДополнительных = ВсегоСтоимость - СтоимостьПоСпецификациям;
	ВсегоБлоков = Блоки.Итог("Количество");
	Распределено = 0;
	Для Индекс = 0 По Блоки.Количество() - 1 Цикл
		СтрокаБлока = Блоки[Индекс];
		Если Индекс = Блоки.Количество() - 1 Тогда
			СтрокаБлока.Стоимость = ВсегоСтоимость - Распределено;
		ИначеЕсли ВсегоБлоков <> 0 Тогда
			СтрокаБлока.Стоимость = СтрокаБлока.Стоимость + Окр(СтоимостьДополнительных * СтрокаБлока.Количество / ВсегоБлоков, 2);
		КонецЕсли;
		Распределено = Распределено + СтрокаБлока.Стоимость;
		
		Движение = Движения.ОстаткиНоменклатуры.ДобавитьПриход();
		Движение.Период = Дата;
		Движение.Подразделение = ПодразделениеПолучатель;
		Движение.Номенклатура = СтрокаБлока.Номенклатура;
		Движение.Партия = Ссылка;
		Движение.Количество = СтрокаБлока.Количество;
		Движение.Стоимость = СтрокаБлока.Стоимость;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
