#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЗначениеЗаполнено(Подразделение) И Не ЗначениеЗаполнено(Склад) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Укажите подразделение (оперативный учет) или склад (бухгалтерский учет)'"), Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	СуммаПоДокументу = СписокНоменклатуры.Итог("Сумма");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Оперативный учет: партии деталей и товаров подразделения.
	Если ЗначениеЗаполнено(Подразделение) Тогда
		Движения.ОстаткиНоменклатуры.Записывать = Истина;
		Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
			Движение = Движения.ОстаткиНоменклатуры.ДобавитьПриход();
			Движение.Период = Дата;
			Движение.Подразделение = Подразделение;
			Движение.Номенклатура = СтрокаТовара.Номенклатура;
			Движение.Свойство = СтрокаТовара.Свойство;
			Движение.Партия = Ссылка;
			Движение.Количество = СтрокаТовара.Количество;
			Движение.Стоимость = СтрокаТовара.Сумма;
		КонецЦикла;
	КонецЕсли;
	
	// Бухгалтерский учет: Дт Товары - Кт Поставщики.
	Если ЗначениеЗаполнено(Склад) Тогда
		Движения.Управленческий.Записывать = Истина;
		Для Каждого СтрокаТовара Из СписокНоменклатуры Цикл
			Проводка = Движения.Управленческий.Добавить();
			Проводка.Период = Дата;
			Проводка.СчетДт = ПланыСчетов.Управленческий.Товары;
			Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Номенклатура] = СтрокаТовара.Номенклатура;
			Проводка.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Склады] = Склад;
			Проводка.СчетКт = ПланыСчетов.Управленческий.Поставщики;
			Если ЗначениеЗаполнено(Контрагент) Тогда
				Проводка.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Контрагенты] = Контрагент;
			КонецЕсли;
			Проводка.КоличествоДт = СтрокаТовара.Количество;
			Проводка.Сумма = СтрокаТовара.Сумма;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
