#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
	Для Каждого СтрокаНачисления Из ОсновныеНачисления Цикл
		Если Не ЗначениеЗаполнено(СтрокаНачисления.ДатаНачала) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'В строке %1 не указана дата начала'"), СтрокаНачисления.НомерСтроки), Отказ);
			Продолжить;
		КонецЕсли;
		ДатаОкончания = ДатаОкончанияСтроки(СтрокаНачисления);
		Если ДатаОкончания < СтрокаНачисления.ДатаНачала Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'В строке %1 дата окончания меньше даты начала'"), СтрокаНачисления.НомерСтроки), Отказ);
		ИначеЕсли СтрокаНачисления.ВидРасчета <> Командировка
			И НачалоМесяца(ДатаОкончания) <> НачалоМесяца(СтрокаНачисления.ДатаНачала) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(НСтр("ru = 'В строке %1 период начисления по тарифу и премии должен быть в пределах одного месяца'"),
				СтрокаНачисления.НомерСтроки), Отказ);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	Командировка = ПланыВидовРасчета.ОсновныеНачисления.Командировка;
	Премия = ПланыВидовРасчета.ОсновныеНачисления.Премия;

	Движения.ОсновныеНачисления.Записывать = Истина;
	Для Каждого СтрокаНачисления Из ОсновныеНачисления Цикл

		ДатаОкончания = ДатаОкончанияСтроки(СтрокаНачисления);
		НачалоЧасти = НачалоДня(СтрокаНачисления.ДатаНачала);

		// Командировка разбивается по расчетным периодам; база - три месяца, предшествующие началу командировки.
		Пока НачалоЧасти <= ДатаОкончания Цикл
			КонецЧасти = Мин(КонецМесяца(НачалоЧасти), ДатаОкончания);

			Движение = Движения.ОсновныеНачисления.Добавить();
			Движение.ПериодРегистрации = НачалоМесяца(НачалоЧасти);
			Движение.ВидРасчета = СтрокаНачисления.ВидРасчета;
			Движение.ПериодДействияНачало = НачалоЧасти;
			Движение.ПериодДействияКонец = КонецЧасти;
			Движение.Сотрудник = СтрокаНачисления.Сотрудник;
			Движение.Подразделение = СтрокаНачисления.Подразделение;
			Если СтрокаНачисления.ВидРасчета = Командировка Тогда
				Движение.БазовыйПериодНачало = НачалоМесяца(ДобавитьМесяц(СтрокаНачисления.ДатаНачала, -3));
				Движение.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(СтрокаНачисления.ДатаНачала, -1));
			ИначеЕсли СтрокаНачисления.ВидРасчета = Премия Тогда
				Движение.БазовыйПериодНачало = НачалоМесяца(ДобавитьМесяц(НачалоЧасти, -1));
				Движение.БазовыйПериодКонец = КонецМесяца(ДобавитьМесяц(НачалоЧасти, -1));
			КонецЕсли;

			НачалоЧасти = НачалоДня(КонецЧасти) + 86400;
		КонецЦикла;

	КонецЦикла;

	// Расчет выполняется по записанным движениям (данные графика и вытеснение берутся из регистра расчета).
	Движения.ОсновныеНачисления.Записать();
	РасчетЗарплаты.РассчитатьНачисления(Ссылка, Движения.ОсновныеНачисления);

КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)

	// Начисления других документов, вытесненные командировками этого документа, пересчитываются
	// после удаления его движений.
	СписокДокументов = РасчетЗарплаты.ДокументыСВытесненнымиНачислениями(Ссылка);
	Движения.ОсновныеНачисления.Записать();
	РасчетЗарплаты.ПересчитатьДокументы(СписокДокументов);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДатаОкончанияСтроки(СтрокаНачисления)

	Если ЗначениеЗаполнено(СтрокаНачисления.ДатаОкончания) Тогда
		Возврат КонецДня(СтрокаНачисления.ДатаОкончания);
	КонецЕсли;
	Возврат КонецМесяца(СтрокаНачисления.ДатаНачала);

КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
