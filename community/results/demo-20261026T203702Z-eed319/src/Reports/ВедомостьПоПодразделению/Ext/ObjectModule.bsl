#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ОбработчикиСобытий
Процедура ПриКомпоновкеРезультата(ДокументРезультат, ДанныеРасшифровки, СтандартнаяОбработка)
    СтандартнаяОбработка = Ложь;
    Настройки = КомпоновщикНастроек.ПолучитьНастройки();
    НачалоПериода = Дата(2024,1,1);
    КонецПериода = Дата(2024,12,31);
    Подразделение = Справочники.Подразделения.ПустаяСсылка();
    Для Каждого ЗначениеПараметра Из Настройки.ПараметрыДанных.Элементы Цикл
        Если ЗначениеПараметра.Параметр = Новый ПараметрКомпоновкиДанных("НачалоПериода") Тогда
            НачалоПериода = ЗначениеПараметра.Значение;
        ИначеЕсли ЗначениеПараметра.Параметр = Новый ПараметрКомпоновкиДанных("КонецПериода") Тогда
            КонецПериода = ЗначениеПараметра.Значение;
        ИначеЕсли ЗначениеПараметра.Параметр = Новый ПараметрКомпоновкиДанных("Подразделение") Тогда
            Подразделение = ЗначениеПараметра.Значение;
        КонецЕсли;
    КонецЦикла;
    Если Не ЗначениеЗаполнено(Подразделение) Тогда
        ВызватьИсключение "Укажите подразделение для ведомости";
    КонецЕсли;
    Данные = Отчеты.ВедомостьПоПодразделению.СформироватьДанные(НачалоПериода, КонецПериода, Подразделение);
    Данные.Сортировать("Характеристика,Номенклатура");
    ДокументРезультат.Очистить();
    ДокументРезультат.Область(1,1,1,6).Объединить();
    ДокументРезультат.Область(1,1).Текст = "Ведомость по подразделению «" + Строка(Подразделение)
        + "» за период с " + Формат(НачалоПериода,"ДФ=dd.MM.yyyy") + " по " + Формат(КонецПериода,"ДФ=dd.MM.yyyy");
    ДокументРезультат.Область(1,1).Шрифт = ШрифтыСтиля.КрупныйШрифтТекста;
    Заголовки = СтрРазделить("Производитель;Товар;Нач. ост.;Приход;Расход;Кон. ост.",";");
    Для Индекс = 0 По Заголовки.Количество()-1 Цикл
        Ячейка = ДокументРезультат.Область(3,Индекс+1);
        Ячейка.Текст = Заголовки[Индекс];
        Ячейка.Шрифт = ШрифтыСтиля.ОбычныйШрифтТекста;
        Ячейка.ШиринаКолонки = 18;
    КонецЦикла;
    ДокументРезультат.Область(3,2).ШиринаКолонки = 30;
    НомерСтроки = 4;
    ПредыдущаяХарактеристика = Неопределено;
    Для Каждого СтрокаДанных Из Данные Цикл
        Если ПредыдущаяХарактеристика <> СтрокаДанных.Характеристика Тогда
            ДокументРезультат.Область(НомерСтроки,1,НомерСтроки,6).Объединить();
            ДокументРезультат.Область(НомерСтроки,1).Текст = Строка(СтрокаДанных.Характеристика);
            ДокументРезультат.Область(НомерСтроки,1).Шрифт = ШрифтыСтиля.КрупныйШрифтТекста;
            ПредыдущаяХарактеристика = СтрокаДанных.Характеристика;
            НомерСтроки = НомерСтроки + 1;
        КонецЕсли;
        ДокументРезультат.Область(НомерСтроки,2).Текст = Строка(СтрокаДанных.Номенклатура);
        Показатель(ДокументРезультат,НомерСтроки,3,СтрокаДанных.НачальноеКоличество,СтрокаДанных.НачальнаяСтоимость);
        Показатель(ДокументРезультат,НомерСтроки,4,СтрокаДанных.ПриходКоличество,СтрокаДанных.ПриходСтоимость);
        Показатель(ДокументРезультат,НомерСтроки,5,СтрокаДанных.РасходКоличество,СтрокаДанных.РасходСтоимость);
        Показатель(ДокументРезультат,НомерСтроки,6,СтрокаДанных.КонечноеКоличество,СтрокаДанных.КонечнаяСтоимость);
        ДокументРезультат.Область(НомерСтроки,1,НомерСтроки,6).ВысотаСтроки = 30;
        НомерСтроки = НомерСтроки + 1;
    КонецЦикла;
    ДокументРезультат.АвтоМасштаб = Истина;
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура Показатель(ДокументРезультат, НомерСтроки, НомерКолонки, Количество, Стоимость)
    Ячейка = ДокументРезультат.Область(НомерСтроки,НомерКолонки);
    Ячейка.Текст = Формат(Количество,"ЧДЦ=3;ЧН=;ЧГ=0") + Символы.ПС + Формат(Стоимость,"ЧДЦ=2;ЧН=;ЧГ=0");
    Ячейка.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
КонецПроцедуры
#КонецОбласти
#КонецЕсли
