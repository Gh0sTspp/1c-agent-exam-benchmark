		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ З.Номенклатура КАК Номенклатура, З.Свойство КАК Свойство,
 ЕСТЬNULL(Х.Значение, З.Свойство.Наименование) КАК Характеристика,
 СУММА(З.КоличествоНачальныйОстаток) КАК НачальноеКоличество,
 СУММА(З.КоличествоПриход) КАК ПриходКоличество,
 СУММА(З.КоличествоРасход) КАК РасходКоличество,
 СУММА(З.КоличествоКонечныйОстаток) КАК КонечноеКоличество,
 СУММА(З.СтоимостьНачальныйОстаток) КАК НачальнаяСтоимость,
 СУММА(З.СтоимостьПриход) КАК ПриходСтоимость,
 СУММА(З.СтоимостьРасход) КАК РасходСтоимость,
 СУММА(З.СтоимостьКонечныйОстаток) КАК КонечнаяСтоимость
 ИЗ РегистрНакопления.Запасы.ОстаткиИОбороты(&amp;НачалоПериода, &amp;КонецПериода, , , Подразделение = &amp;Подразделение) КАК З
 ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойств КАК Х
 ПО З.Свойство = Х.Свойство И Х.Характеристика.Наименование = "Производитель"
 СГРУППИРОВАТЬ ПО З.Номенклатура, З.Свойство, ЕСТЬNULL(Х.Значение, З.Свойство.Наименование)</query>
