#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ПрограммныйИнтерфейс
// Продажи по бухгалтерским проводкам, включая документ ручной операции.
// Период включительный; корреспонденция отделяет продажи от прочих оборотов.
Функция СформироватьДанные(НачалоПериода, КонецПериода) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ П.Номенклатура КАК Номенклатура, П.Продано КАК Продано,
    | СУММА(П.Количество) КАК Количество, СУММА(П.Себестоимость) КАК Себестоимость,
    | СУММА(П.Выручка) КАК Выручка, СУММА(П.Выручка - П.Себестоимость) КАК Прибыль
    |ИЗ (
    | ВЫБРАТЬ У.Заказано КАК Номенклатура, У.Продано КАК Продано,
    | У.КоличествоКт КАК Количество, У.Сумма КАК Себестоимость, 0 КАК Выручка
    | ИЗ РегистрБухгалтерии.Учет КАК У
    | ГДЕ У.Период МЕЖДУ &НачалоПериода И &КонецПериода И У.Активность
    | И У.СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Торговый.ПрибылиУбытки)
    | И У.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Торговый.Товары)
    | ОБЪЕДИНИТЬ ВСЕ
    | ВЫБРАТЬ У.Заказано, У.Продано, 0, 0, У.Сумма
    | ИЗ РегистрБухгалтерии.Учет КАК У
    | ГДЕ У.Период МЕЖДУ &НачалоПериода И &КонецПериода И У.Активность
    | И У.СчетДт = ЗНАЧЕНИЕ(ПланСчетов.Торговый.Покупатели)
    | И У.СчетКт = ЗНАЧЕНИЕ(ПланСчетов.Торговый.ПрибылиУбытки)
    |) КАК П
    |СГРУППИРОВАТЬ ПО П.Номенклатура, П.Продано";
    Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(НачалоПериода));
    Запрос.УстановитьПараметр("КонецПериода", КонецДня(КонецПериода));
    РезультатЗапроса = Запрос.Выполнить();
    Возврат РезультатЗапроса.Выгрузить();
КонецФункции
#КонецОбласти
#КонецЕсли
