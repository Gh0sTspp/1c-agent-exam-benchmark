    ВидХарактеристики.ТипЗначения = Новый ОписаниеТипов("Строка");
    ВидХарактеристики.Записать();
    Свойство = Справочники.СвойстваНоменклатуры.СоздатьЭлемент();
    Свойство.Наименование = "Пример: ASUS";
    Свойство.Номенклатура = Деталь;
    Свойство.Записать();
    ЗначениеСвойства = РегистрыСведений.ЗначенияСвойств.СоздатьМенеджерЗаписи();
