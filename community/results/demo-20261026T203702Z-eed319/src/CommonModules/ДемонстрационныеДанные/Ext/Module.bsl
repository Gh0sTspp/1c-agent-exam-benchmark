    ЗначениеСвойства.Записать();
    Спецификация = РегистрыСведений.Спецификации.СоздатьМенеджерЗаписи();
    Спецификация.Период = Дата(2024, 1, 1);
    Спецификация.СистемныйБлок = Блок;
    Спецификация.Деталь = Деталь;
    Спецификация.Свойство = Свойство.Ссылка;
    Спецификация.Количество = 2;
    Спецификация.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
    Приход.Дата = Дата(2024, 1, 2, 10, 0, 0);
    Приход.Подразделение = Цех.Ссылка;
    СтрокаТоваров = Приход.СписокНоменклатуры.Добавить();
    СтрокаТоваров.Номенклатура = Деталь;
    СтрокаТоваров.Свойство = Свойство.Ссылка;
    СтрокаТоваров.Количество = 10;
    СтрокаТоваров.Цена = 100;
    СтрокаТоваров.Сумма = 1000;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Сборка = Документы.Сборка.СоздатьДокумент();
    Сборка.Дата = Дата(2024, 1, 3, 10, 0, 0);
    Сборка.ПодразделениеИсточник = Цех.Ссылка;
    Сборка.ПодразделениеПолучатель = Магазин.Ссылка;
    СтрокаБлоков = Сборка.СистемныеБлоки.Добавить();
    СтрокаБлоков.Номенклатура = Блок;
    СтрокаБлоков.Количество = 2;
    Сборка.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
    Продажа.Дата = Дата(2024, 1, 4, 10, 0, 0);
    СтрокаТоваров = Продажа.СписокНоменклатуры.Добавить();
    СтрокаТоваров.Подразделение = Магазин.Ссылка;
    СтрокаТоваров.Номенклатура = Блок;
    СтрокаТоваров.Количество = 1;
    СтрокаТоваров.Сумма = 350;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Связь = РегистрыСведений.Аналоги.СоздатьМенеджерЗаписи();
    Связь.Товар = Принтер;
    Связь.Аналог = Аналог;
    Связь.Записать();
    Приход = Документы.ПриходнаяНакладная.СоздатьДокумент();
    Приход.Дата = Дата(2024, 1, 2, 11, 0, 0);
    Приход.Склад = Склад.Ссылка;
    СтрокаТоваров = Приход.СписокНоменклатуры.Добавить();
    СтрокаТоваров.Номенклатура = Аналог;
    СтрокаТоваров.Количество = 10;
    СтрокаТоваров.Сумма = 2000;
    Приход.Записать(РежимЗаписиДокумента.Проведение);
    Продажа = Документы.РасходнаяНакладная.СоздатьДокумент();
    Продажа.Дата = Дата(2024, 1, 4, 11, 0, 0);
    Продажа.Склад = Склад.Ссылка;
    СтрокаТоваров = Продажа.СписокНоменклатуры.Добавить();
    СтрокаТоваров.Номенклатура = Принтер;
    СтрокаТоваров.Количество = 3;
    СтрокаТоваров.Сумма = 900;
    Продажа.Записать(РежимЗаписиДокумента.Проведение);
    Операция = Документы.Операция.СоздатьДокумент();
    Операция.Дата = Дата(2024, 1, 5);
    Проводка = Операция.Проводки.Добавить();
    Проводка.СчетДт = ПланыСчетов.Торговый.Покупатели;
    Проводка.СчетКт = ПланыСчетов.Торговый.Поставщики;
    Проводка.Сумма = 100;
    Операция.Записать(РежимЗаписиДокумента.Проведение);
    Работник = Справочники.ФизическиеЛица.СоздатьЭлемент();
    Работник.Наименование = "Пример: работник";
    Работник.НачалоСтажа = Дата(2020, 1, 1);
    Работник.Записать();
    Руководитель = Справочники.ФизическиеЛица.СоздатьЭлемент();
    Руководитель.Наименование = "Пример: руководитель";
    Руководитель.НачалоСтажа = Дата(2019, 1, 1);
    ВидСведений = ПланыВидовХарактеристик.СведенияКонтрагентов.СоздатьЭлемент();
    ВидСведений.Наименование = "Срок кредита, дни";
    ВидСведений.ТипЗначения = Новый ОписаниеТипов("Число");
    ВидСведений.Записать();
    ВидВалюта = ПланыВидовХарактеристик.СведенияКонтрагентов.СоздатьЭлемент();
    ВидВалюта.Наименование = "Валюта кредита";
    ВидВалюта.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.Валюты");
    ВидВалюта.Записать();
    ВидРегион = ПланыВидовХарактеристик.СведенияКонтрагентов.СоздатьЭлемент();
    ВидРегион.Наименование = "Регион";
    ВидРегион.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ЗначенияСведений");
    ВидРегион.Записать();
    Регион = Справочники.ЗначенияСведений.СоздатьЭлемент();
    Регион.Владелец = ВидРегион.Ссылка;
    Регион.Наименование = "Москва";
    Регион.Записать();
    Руководитель.ДополнительныеСведения.Добавить().ВидСведений = ВидСведений.Ссылка;
    Руководитель.ДополнительныеСведения.Добавить().ВидСведений = ВидВалюта.Ссылка;
    Руководитель.ДополнительныеСведения.Добавить().ВидСведений = ВидРегион.Ссылка;
    Руководитель.Записать();
    Контрагент = Справочники.Контрагенты.СоздатьЭлемент();
    Контрагент.Наименование = "Пример: завод Сатурн";
    Контрагент.Менеджер = Руководитель.Ссылка;
    Сведения = Контрагент.ДополнительныеСведения.Добавить();
    Сведения.ВидСведений = ВидСведений.Ссылка;
    Сведения.Значение = 10;
    Сведения = Контрагент.ДополнительныеСведения.Добавить();
    Сведения.ВидСведений = ВидРегион.Ссылка;
    Сведения.Значение = Регион.Ссылка;
    Контрагент.Записать();
    Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи();
    Ставка.Период = Дата(2024, 1, 1);
    Ставка.Сотрудник = Работник.Ссылка;
    Ставка.Ставка = 100;
    Ставка.Записать();
    Ставка = РегистрыСведений.ТарифныеСтавки.СоздатьМенеджерЗаписи();
    Ставка.Период = Дата(2024, 1, 1);
    Ставка.Сотрудник = Руководитель.Ссылка;
    Ставка.Ставка = 150;
    Ставка.Записать();
    Ступень = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
    Ступень.Стаж = 0;
    Ступень.Процент = 5;
    Ступень.Записать();
    Ступень = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
    Ступень.Стаж = 1;
    Ступень.Процент = 10;
    Ступень.Записать();
    Ступень = РегистрыСведений.ШкалаПремий.СоздатьМенеджерЗаписи();
    Ступень.Стаж = 3;
    Ступень.Процент = 15;
    Ступень.Записать();
    График = РегистрыСведений.ЧасыПодразделений.СоздатьНаборЗаписей();
    График.Отбор.Подразделение.Установить(Цех.Ссылка);
    День = Дата(2024, 1, 1);
    Пока День <= Дата(2024, 6, 30) Цикл
        ЗаписьГрафика = График.Добавить();
        ЗаписьГрафика.Подразделение = Цех.Ссылка;
        ЗаписьГрафика.Дата = День;
        Если ДеньНедели(День) <= 5 Тогда
            ЗаписьГрафика.Часы = 8;
            ЗаписьГрафика.Дни = 1;
        КонецЕсли;
        День = День + 86400;
    КонецЦикла;
    График.Записать();
    Для Месяц = 1 По 4 Цикл
        Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент();
        Начисление.Дата = Дата(2024, Месяц, 28, 12, 0, 0);
        СтрокаНачисления = Начисление.ОсновныеНачисления.Добавить();
        СтрокаНачисления.Сотрудник = Работник.Ссылка;
        СтрокаНачисления.Подразделение = Цех.Ссылка;
        СтрокаНачисления.ВидРасчета = ПланыВидовРасчета.Начисления.Тариф;
        СтрокаНачисления.ДатаНачала = НачалоМесяца(Начисление.Дата);
        СтрокаНачисления.ДатаОкончания = КонецМесяца(Начисление.Дата);
        СтрокаРуководителя = Начисление.ОсновныеНачисления.Добавить();
        ЗаполнитьЗначенияСвойств(СтрокаРуководителя, СтрокаНачисления);
        СтрокаРуководителя.Сотрудник = Руководитель.Ссылка;
        Если Месяц > 1 Тогда
            СтрокаПремии = Начисление.ОсновныеНачисления.Добавить();
            ЗаполнитьЗначенияСвойств(СтрокаПремии, СтрокаРуководителя);
            СтрокаПремии.ВидРасчета = ПланыВидовРасчета.Начисления.Премия;
        КонецЕсли;
        Начисление.Записать(РежимЗаписиДокумента.Проведение);
    КонецЦикла;
    Начисление = Документы.НачислениеЗарплаты.СоздатьДокумент();
    Начисление.Дата = Дата(2024, 4, 30, 15, 0, 0);
    СтрокаНачисления = Начисление.ОсновныеНачисления.Добавить();
    СтрокаНачисления.Сотрудник = Работник.Ссылка;
    СтрокаНачисления.Подразделение = Цех.Ссылка;
    СтрокаНачисления.ВидРасчета = ПланыВидовРасчета.Начисления.Командировка;
    СтрокаНачисления.ДатаНачала = Дата(2024, 4, 15);
    СтрокаНачисления.ДатаОкончания = Дата(2024, 4, 19);
    Начисление.Записать(РежимЗаписиДокумента.Проведение);
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция НовыйТовар(Наименование, Артикул)
    Товар = Справочники.Номенклатура.СоздатьЭлемент();
    Товар.Наименование = Наименование;
    Товар.Артикул = Артикул;
    Товар.Записать();
    Возврат Товар.Ссылка;
КонецФункции
#КонецОбласти
