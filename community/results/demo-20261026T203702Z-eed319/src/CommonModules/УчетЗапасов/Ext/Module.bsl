#Область ПрограммныйИнтерфейс
// Блокировка до чтения остатков. Порядок един для накладных и сборки.
Процедура Заблокировать(Документ) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Подразделения = Новый ТаблицаЗначений;
    Подразделения.Колонки.Добавить("Подразделение");
    ВестиБухгалтерскийУчет = Ложь;
    ИмяДокумента = Документ.Метаданные().Имя;
    Если ИмяДокумента = "Сборка" Тогда
        Подразделения.Добавить().Подразделение = Документ.ПодразделениеИсточник;
        Подразделения.Добавить().Подразделение = Документ.ПодразделениеПолучатель;
    ИначеЕсли ИмяДокумента = "Операция" Тогда
        ВестиБухгалтерскийУчет = Истина;
    Иначе
        ВестиБухгалтерскийУчет = ЗначениеЗаполнено(Документ.Склад);
        Если ЗначениеЗаполнено(Документ.Подразделение) Тогда
            Подразделения.Добавить().Подразделение = Документ.Подразделение;
        КонецЕсли;
        Для Каждого СтрокаТоваров Из Документ.СписокНоменклатуры Цикл
            Если ЗначениеЗаполнено(СтрокаТоваров.Подразделение) Тогда
                Подразделения.Добавить().Подразделение = СтрокаТоваров.Подразделение;
            КонецЕсли;
        КонецЦикла;
    КонецЕсли;
    Если Подразделения.Количество() > 0 Тогда
        Подразделения.Свернуть("Подразделение");
        Элемент = Блокировка.Добавить("РегистрНакопления.Запасы");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        Элемент.ИсточникДанных = Подразделения;
        Элемент.ИспользоватьИзИсточникаДанных("Подразделение", "Подразделение");
    КонецЕсли;
    Если ВестиБухгалтерскийУчет Тогда
        Элемент = Блокировка.Добавить("РегистрБухгалтерии.Учет");
        Элемент.Режим = РежимБлокировкиДанных.Исключительный;
        // Средняя общая для всех складов, а аналоги могут пересекаться между строками.
        Элемент.УстановитьЗначение("Счет", ПланыСчетов.Торговый.Товары);
    КонецЕсли;
    Блокировка.Заблокировать();
КонецПроцедуры

// Возвращает остатки партий на исключающей границе документа.
Функция Остатки(Документ) Экспорт
    Подразделения = Новый Массив;
    Если Документ.Метаданные().Имя = "Сборка" Тогда
        Подразделения.Добавить(Документ.ПодразделениеИсточник);
    Иначе
        Подразделения = Документ.СписокНоменклатуры.ВыгрузитьКолонку("Подразделение");
        Подразделения.Добавить(Документ.Подразделение);
    КонецЕсли;
    Запрос = Новый Запрос;
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Запрос.Текст =
    "ВЫБРАТЬ З.Подразделение КАК Подразделение, З.Номенклатура КАК Номенклатура,
    | З.Свойство КАК Свойство, З.Партия КАК Партия, З.ДатаПартии КАК ДатаПартии,
    | З.КоличествоОстаток КАК Количество, З.СтоимостьОстаток КАК Стоимость
    |ИЗ РегистрНакопления.Запасы.Остатки(&Момент, Подразделение В (&Подразделения)) КАК З
    |ГДЕ З.КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО ДатаПартии, Партия";
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    РезультатЗапроса = Запрос.Выполнить();
    Таблица = РезультатЗапроса.Выгрузить();
    Таблица.Индексы.Добавить("Подразделение,Номенклатура,Свойство");
    Возврат Таблица;
КонецФункции

Функция Политики(ДатаДокумента) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ П.Подразделение КАК Подразделение, П.Метод КАК Метод
    |ИЗ РегистрСведений.УчетныеПолитики.СрезПоследних(&Дата) КАК П";
    Запрос.УстановитьПараметр("Дата", ДатаДокумента);
    РезультатЗапроса = Запрос.Выполнить();
    Результат = Новый Соответствие;
    Выборка = РезультатЗапроса.Выбрать();
    Пока Выборка.Следующий() Цикл
        Результат.Вставить(Выборка.Подразделение, Выборка.Метод);
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Списание меняет рабочие остатки, поэтому повторные строки используют остаток после предыдущих.
Функция Списать(Документ, Остатки, Подразделение, Товар, Свойство, Количество, Метод) Экспорт
    Если Количество <= 0 Тогда
        ВызватьИсключение "Количество должно быть больше нуля";
    КонецЕсли;
    Отбор = Новый Структура("Подразделение,Номенклатура,Свойство", Подразделение, Товар, Свойство);
    Партии = Остатки.НайтиСтроки(Отбор);
    Доступно = 0;
    Стоимость = 0;
    Для Каждого Партия Из Партии Цикл
        Доступно = Доступно + Партия.Количество;
        Стоимость = Стоимость + Партия.Стоимость;
    КонецЦикла;
    Если Доступно < Количество Тогда
        ВызватьИсключение "Недостаточно запасов: " + Строка(Товар) + ", " + Строка(Подразделение) + ", " + Строка(Свойство);
    КонецЕсли;
    Если Метод = Неопределено Или Не ЗначениеЗаполнено(Метод) Тогда
        ВызватьИсключение "Не установлена учетная политика подразделения";
    КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.ПоСредней Тогда
        Возврат СписатьПоСредней(Документ, Партии, Количество, Доступно, Стоимость);
    КонецЕсли;
    Если Метод = Перечисления.УчетнаяПолитика.ЛИФО Тогда
        Обратные = Новый Массив;
        Индекс = Партии.Количество() - 1;
        Пока Индекс >= 0 Цикл
            Обратные.Добавить(Партии[Индекс]);
            Индекс = Индекс - 1;
        КонецЦикла;
        Партии = Обратные;
    КонецЕсли;
    Осталось = Количество;
    СписаннаяСтоимость = 0;
    Для Каждого Партия Из Партии Цикл
        Если Осталось <= 0 Тогда
            Прервать;
        КонецЕсли;
        Если Партия.Количество <= 0 Тогда
            Продолжить;
        КонецЕсли;
        СписатьКоличество = Мин(Осталось, Партия.Количество);
        СписатьСтоимость = Окр(Партия.Стоимость * СписатьКоличество / Партия.Количество, 2);
        Движение = Документ.Движения.Запасы.ДобавитьРасход();
        Движение.Период = Документ.Дата;
        ЗаполнитьЗначенияСвойств(Движение, Партия, "Подразделение,Номенклатура,Свойство,Партия,ДатаПартии");
        Движение.Количество = СписатьКоличество;
        Движение.Стоимость = СписатьСтоимость;
        Партия.Количество = Партия.Количество - СписатьКоличество;
        Партия.Стоимость = Партия.Стоимость - СписатьСтоимость;
        Осталось = Осталось - СписатьКоличество;
        СписаннаяСтоимость = СписаннаяСтоимость + СписатьСтоимость;
    КонецЦикла;
    Если Осталось <> 0 Тогда
        ВызватьИсключение "Не удалось полностью распределить списание по партиям";
    КонецЕсли;
    Возврат СписаннаяСтоимость;
КонецФункции

Процедура Приход(Документ, Подразделение, Товар, Свойство, Количество, Стоимость) Экспорт
    Если Количество <= 0 Или Стоимость < 0 Тогда
        ВызватьИсключение "Некорректное количество или сумма прихода";
    КонецЕсли;
    Движение = Документ.Движения.Запасы.ДобавитьПриход();
    Движение.Период = Документ.Дата;
    Движение.Подразделение = Подразделение;
    Движение.Номенклатура = Товар;
    Движение.Свойство = Свойство;
    Движение.Партия = Документ.Ссылка;
    Движение.ДатаПартии = Документ.Дата;
    Движение.Количество = Количество;
    Движение.Стоимость = Стоимость;
КонецПроцедуры

Процедура Продажа(Документ, Товар, Продано, Количество, Себестоимость, Выручка, Раздел) Экспорт
    Движение = Документ.Движения.Продажи.Добавить();
    Движение.Период = Документ.Дата;
    Движение.Номенклатура = Товар;
    Движение.Продано = Продано;
    Движение.Раздел = Раздел;
    Движение.Количество = Количество;
    Движение.Себестоимость = Себестоимость;
    Движение.Выручка = Выручка;
КонецПроцедуры

Функция СуммаСтроки(СтрокаТоваров) Экспорт
    Если СтрокаТоваров.Сумма <> 0 Тогда
        Возврат СтрокаТоваров.Сумма;
    КонецЕсли;
    Возврат Окр(СтрокаТоваров.Количество * СтрокаТоваров.Цена, 2);
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция СписатьПоСредней(Документ, Партии, Количество, Доступно, Стоимость)
    Себестоимость = Окр(Стоимость * Количество / Доступно, 2);
    ОстатокКоличества = Доступно - Количество;
    ОстатокСтоимости = Стоимость - Себестоимость;
    ОсталосьСписать = Количество;
    ОсталосьРаспределить = ОстатокСтоимости;
    ОсталосьОценить = ОстатокКоличества;
    Для Каждого Партия Из Партии Цикл
        СписатьКоличество = Мин(ОсталосьСписать, Партия.Количество);
        НовоеКоличество = Партия.Количество - СписатьКоличество;
        НоваяСтоимость = 0;
        Если НовоеКоличество > 0 Тогда
            Если НовоеКоличество = ОсталосьОценить Тогда
                НоваяСтоимость = ОсталосьРаспределить;
            Иначе
                НоваяСтоимость = Мин(ОсталосьРаспределить,
                    Окр(ОстатокСтоимости * НовоеКоличество / ОстатокКоличества, 2));
            КонецЕсли;
        КонецЕсли;
        // Оставшиеся партии оцениваются по средней. Перенос стоимости между партиями
        // допускает отрицательную сумму отдельного расходного движения, но все остатки
        // неотрицательны; суммарный расход равен себестоимости, приход не завышается.
        СписатьСтоимость = Партия.Стоимость - НоваяСтоимость;
        Если СписатьКоличество <> 0 Или СписатьСтоимость <> 0 Тогда
            Движение = Документ.Движения.Запасы.ДобавитьРасход();
            Движение.Период = Документ.Дата;
            ЗаполнитьЗначенияСвойств(Движение, Партия, "Подразделение,Номенклатура,Свойство,Партия,ДатаПартии");
            Движение.Количество = СписатьКоличество;
            Движение.Стоимость = СписатьСтоимость;
        КонецЕсли;
        Партия.Количество = НовоеКоличество;
        Партия.Стоимость = НоваяСтоимость;
        ОсталосьСписать = ОсталосьСписать - СписатьКоличество;
        ОсталосьОценить = ОсталосьОценить - НовоеКоличество;
        ОсталосьРаспределить = ОсталосьРаспределить - НоваяСтоимость;
    КонецЦикла;
    Если ОсталосьСписать <> 0 Или ОсталосьРаспределить <> 0 Тогда
        ВызватьИсключение "Не удалось распределить среднюю стоимость запасов";
    КонецЕсли;
    Возврат Себестоимость;
КонецФункции
#КонецОбласти
