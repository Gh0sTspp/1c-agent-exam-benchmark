#Область ПрограммныйИнтерфейс
// Граф аналогов симметричен; обход в памяти обеспечивает транзитивность без запросов в цикле.
Процедура Продать(Документ) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ А.Товар КАК Товар, А.Аналог КАК Аналог ИЗ РегистрСведений.Аналоги КАК А";
    РезультатЗапроса = Запрос.Выполнить();
    Связи = РезультатЗапроса.Выгрузить();
    Связи.Индексы.Добавить("Товар");
    Связи.Индексы.Добавить("Аналог");
    ПодборАналогов = Новый Соответствие;
    ВключенныеТовары = Новый Соответствие;
    ВсеТовары = Новый Массив;
    Для Каждого СтрокаТоваров Из Документ.СписокНоменклатуры Цикл
        Если ПодборАналогов.Получить(СтрокаТоваров.Номенклатура) <> Неопределено Тогда
            Продолжить;
        КонецЕсли;
        Кандидаты = АналогиТовара(СтрокаТоваров.Номенклатура, Связи);
        ПодборАналогов.Вставить(СтрокаТоваров.Номенклатура, Кандидаты);
        Для Каждого Кандидат Из Кандидаты Цикл
            Если ВключенныеТовары.Получить(Кандидат.Ключ) = Неопределено Тогда
                ВключенныеТовары.Вставить(Кандидат.Ключ, Истина);
                ВсеТовары.Добавить(Кандидат.Ключ);
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    Запрос.УстановитьПараметр("Товары", ВсеТовары);
    Запрос.УстановитьПараметр("Склад", Документ.Склад);
    Запрос.УстановитьПараметр("Момент", Новый Граница(Документ.МоментВремени(), ВидГраницы.Исключая));
    Запрос.УстановитьПараметр("СчетТоваров", ПланыСчетов.Торговый.Товары);
    Запрос.Текст =
    "ВЫБРАТЬ О.Субконто1 КАК Номенклатура, О.Субконто2 КАК Склад,
    |О.КоличествоОстаток КАК Количество
    |ИЗ РегистрБухгалтерии.Учет.Остатки(&Момент, Счет = &СчетТоваров, ,
    |Субконто1 В (&Товары) И Субконто2 = &Склад) КАК О";
    РезультатЗапроса = Запрос.Выполнить();
    Остатки = РезультатЗапроса.Выгрузить();
    Остатки.Индексы.Добавить("Номенклатура,Склад");
    // Стоимость и количество для средней получаем по всем складам товара.
    Запрос.Текст = "ВЫБРАТЬ О.Субконто1 КАК Номенклатура,
    |О.КоличествоОстаток КАК Количество, О.СуммаОстаток КАК Сумма
    |ИЗ РегистрБухгалтерии.Учет.Остатки(&Момент, Счет = &СчетТоваров, , Субконто1 В (&Товары)) КАК О";
    РезультатЗапроса = Запрос.Выполнить();
    Средние = РезультатЗапроса.Выгрузить();
    Средние.Индексы.Добавить("Номенклатура");
    Запрос.Текст = "ВЫБРАТЬ Н.Ссылка КАК Номенклатура, Н.Артикул КАК Артикул
    |ИЗ Справочник.Номенклатура КАК Н ГДЕ Н.Ссылка В (&Товары)
    |УПОРЯДОЧИТЬ ПО Артикул, Номенклатура";
    РезультатЗапроса = Запрос.Выполнить();
    Номенклатура = РезультатЗапроса.Выгрузить();
    Для Каждого СтрокаТоваров Из Документ.СписокНоменклатуры Цикл
        Кандидаты = ПодборАналогов.Получить(СтрокаТоваров.Номенклатура);
        Порядок = Новый Массив;
        Порядок.Добавить(СтрокаТоваров.Номенклатура);
        Для Каждого Товар Из Номенклатура Цикл
            Если Товар.Номенклатура <> СтрокаТоваров.Номенклатура И Кандидаты.Получить(Товар.Номенклатура) <> Неопределено Тогда
                Порядок.Добавить(Товар.Номенклатура);
            КонецЕсли;
        КонецЦикла;
        Осталось = СтрокаТоваров.Количество;
        ВыручкаСтроки = УчетЗапасов.СуммаСтроки(СтрокаТоваров);
        ОстатокВыручки = ВыручкаСтроки;
        Для Каждого Товар Из Порядок Цикл
            Если Осталось <= 0 Тогда
                Прервать;
            КонецЕсли;
            СтрокиОстатков = Остатки.НайтиСтроки(Новый Структура("Номенклатура,Склад", Товар, Документ.Склад));
            Если СтрокиОстатков.Количество() = 0 Тогда
                Продолжить;
            КонецЕсли;
            Остаток = СтрокиОстатков[0];
            Если Остаток.Количество <= 0 Тогда
                Продолжить;
            КонецЕсли;
            Количество = Мин(Осталось, Остаток.Количество);
            Средняя = Средние.Найти(Товар, "Номенклатура");
            Если Средняя = Неопределено Или Средняя.Количество <= 0 Тогда
                ВызватьИсключение "Не определена средняя себестоимость товара";
            КонецЕсли;
            Себестоимость = Окр(Средняя.Сумма * Количество / Средняя.Количество, 2);
            Выручка = Окр(ВыручкаСтроки * Количество / СтрокаТоваров.Количество, 2);
            Если Количество = Осталось Тогда
                Выручка = ОстатокВыручки;
            КонецЕсли;
            Движение = Документ.Движения.Учет.Добавить();
            Движение.Период = Документ.Дата;
            Движение.СчетДт = ПланыСчетов.Торговый.ПрибылиУбытки;
            Движение.СчетКт = ПланыСчетов.Торговый.Товары;
            Движение.СубконтоКт[ПланыВидовХарактеристик.АналитикаТорговли.Номенклатура] = Товар;
            Движение.СубконтоКт[ПланыВидовХарактеристик.АналитикаТорговли.Склады] = Документ.Склад;
            Движение.КоличествоКт = Количество;
            Движение.Заказано = СтрокаТоваров.Номенклатура;
            Движение.Продано = Товар;
            Движение.Сумма = Себестоимость;
            Движение = Документ.Движения.Учет.Добавить();
            Движение.Период = Документ.Дата;
            Движение.СчетДт = ПланыСчетов.Торговый.Покупатели;
            Движение.СчетКт = ПланыСчетов.Торговый.ПрибылиУбытки;
            Движение.Заказано = СтрокаТоваров.Номенклатура;
            Движение.Продано = Товар;
            Движение.Сумма = Выручка;
            Остаток.Количество = Остаток.Количество - Количество;
            Средняя.Количество = Средняя.Количество - Количество;
            Средняя.Сумма = Средняя.Сумма - Себестоимость;
            Осталось = Осталось - Количество;
            ОстатокВыручки = ОстатокВыручки - Выручка;
        КонецЦикла;
        Если Осталось > 0 Тогда
            ВызватьИсключение "Недостаточно товара и его аналогов: " + Строка(СтрокаТоваров.Номенклатура);
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Функция АналогиТовара(Товар, Связи)
    Результат = Новый Соответствие;
    Очередь = Новый Массив;
    Очередь.Добавить(Товар);
    Результат.Вставить(Товар, Истина);
    Позиция = 0;
    Пока Позиция < Очередь.Количество() Цикл
        Текущий = Очередь[Позиция];
        Для Каждого Связь Из Связи.НайтиСтроки(Новый Структура("Товар", Текущий)) Цикл
            Если Результат.Получить(Связь.Аналог) = Неопределено Тогда
                Результат.Вставить(Связь.Аналог, Истина);
                Очередь.Добавить(Связь.Аналог);
            КонецЕсли;
        КонецЦикла;
        Для Каждого Связь Из Связи.НайтиСтроки(Новый Структура("Аналог", Текущий)) Цикл
            Если Результат.Получить(Связь.Товар) = Неопределено Тогда
                Результат.Вставить(Связь.Товар, Истина);
                Очередь.Добавить(Связь.Товар);
            КонецЕсли;
        КонецЦикла;
        Позиция = Позиция + 1;
    КонецЦикла;
    Возврат Результат;
КонецФункции
#КонецОбласти
