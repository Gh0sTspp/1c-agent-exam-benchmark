#Область ПрограммныйИнтерфейс
// Зависимости хранятся в видах расчета и используются платформой для графика и базы.
Процедура НастроитьВидыРасчета() Экспорт
    Тариф = ПланыВидовРасчета.Начисления.Тариф;
    Премия = ПланыВидовРасчета.Начисления.Премия;
    Командировка = ПланыВидовРасчета.Начисления.Командировка;
    ОбъектТариф = Тариф.ПолучитьОбъект();
    Если ОбъектТариф.ВытесняющиеВидыРасчета.Количество() = 0 Тогда
        ОбъектТариф.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка;
        ОбъектТариф.Записать();
    КонецЕсли;
    ОбъектПремия = Премия.ПолучитьОбъект();
    Если ОбъектПремия.БазовыеВидыРасчета.Количество() = 0 Тогда
        ОбъектПремия.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф;
        ОбъектПремия.ВытесняющиеВидыРасчета.Добавить().ВидРасчета = Командировка;
        ОбъектПремия.Записать();
    КонецЕсли;
    ОбъектКомандировка = Командировка.ПолучитьОбъект();
    Если ОбъектКомандировка.БазовыеВидыРасчета.Количество() = 0 Тогда
        ОбъектКомандировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Тариф;
        ОбъектКомандировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Премия;
        ОбъектКомандировка.БазовыеВидыРасчета.Добавить().ВидРасчета = Командировка;
        ОбъектКомандировка.Записать();
    КонецЕсли;
КонецПроцедуры

Процедура Провести(Документ) Экспорт
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрРасчета.Начисления");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    НастроитьВидыРасчета();
    Набор = Документ.Движения.Начисления;
    // При замене сотрудника или подразделения пересчитывается и прежняя база.
    Набор.Прочитать();
    ПрежниеНачисления = Набор.Выгрузить();
    ПодразделенияПересчета = Документ.ОсновныеНачисления.ВыгрузитьКолонку("Подразделение");
    СотрудникиПересчета = Документ.ОсновныеНачисления.ВыгрузитьКолонку("Сотрудник");
    Для Каждого ПрежнееНачисление Из ПрежниеНачисления Цикл
        ПодразделенияПересчета.Добавить(ПрежнееНачисление.Подразделение);
        СотрудникиПересчета.Добавить(ПрежнееНачисление.Сотрудник);
    КонецЦикла;
    Набор.Записывать = Истина;
    Набор.Очистить();
    СтрокиНачислений = Документ.ОсновныеНачисления.Выгрузить();
    СтрокиНачислений.Свернуть("Сотрудник,Подразделение,ВидРасчета,ДатаНачала,ДатаОкончания");
    Для Каждого СтрокаНачисления Из СтрокиНачислений Цикл
        Если Не ЗначениеЗаполнено(СтрокаНачисления.Сотрудник)
            Или Не ЗначениеЗаполнено(СтрокаНачисления.Подразделение)
            Или Не ЗначениеЗаполнено(СтрокаНачисления.ВидРасчета)
            Или Не ЗначениеЗаполнено(СтрокаНачисления.ДатаНачала)
            Или Не ЗначениеЗаполнено(СтрокаНачисления.ДатаОкончания)
            Или СтрокаНачисления.ДатаНачала > СтрокаНачисления.ДатаОкончания Тогда
            ВызватьИсключение "Некорректная строка начисления";
        КонецЕсли;
        Командировка = СтрокаНачисления.ВидРасчета = ПланыВидовРасчета.Начисления.Командировка;
        Если Не Командировка И НачалоМесяца(СтрокаНачисления.ДатаНачала) <> НачалоМесяца(СтрокаНачисления.ДатаОкончания) Тогда
            ВызватьИсключение "Тариф и премия должны находиться в пределах одного месяца";
        КонецЕсли;
        ДатаНачала = НачалоДня(СтрокаНачисления.ДатаНачала);
        Пока ДатаНачала <= СтрокаНачисления.ДатаОкончания Цикл
            Запись = Набор.Добавить();
            Запись.Активность = Истина;
            Запись.ВидРасчета = СтрокаНачисления.ВидРасчета;
            Запись.Сотрудник = СтрокаНачисления.Сотрудник;
            Запись.Подразделение = СтрокаНачисления.Подразделение;
            Запись.ПериодДействияНачало = ДатаНачала;
            Запись.ПериодДействияКонец = Мин(КонецМесяца(ДатаНачала), КонецДня(СтрокаНачисления.ДатаОкончания));
            Запись.ПериодРегистрации = НачалоМесяца(ДатаНачала);
            Если Командировка Тогда
                Запись.ПериодРегистрации = Макс(Запись.ПериодРегистрации, НачалоМесяца(Документ.Дата));
                // Средний заработок фиксируется на начало поездки для всех ее месячных фрагментов.
                Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(СтрокаНачисления.ДатаНачала), -3);
                Запись.БазовыйПериодКонец = НачалоМесяца(СтрокаНачисления.ДатаНачала) - 1;
            Иначе
                Запись.БазовыйПериодНачало = ДобавитьМесяц(НачалоМесяца(ДатаНачала), -1);
                Запись.БазовыйПериодКонец = НачалоМесяца(ДатаНачала) - 1;
            КонецЕсли;
            ДатаНачала = КонецМесяца(ДатаНачала) + 1;
        КонецЦикла;
    КонецЦикла;
    // Платформа предлагает сторно прошлых периодов. Суммы затем рассчитываются по фактическому графику.
    Дополнение = Набор.ПолучитьДополнение();
    Для Каждого СтрокаСторно Из Дополнение Цикл
        Запись = Набор.Добавить();
        ЗаполнитьЗначенияСвойств(Запись, СтрокаСторно);
        Запись.Сторно = Истина;
        Запись.ПериодРегистрации = СтрокаСторно.ПериодРегистрацииСторно;
        Запись.ПериодДействияНачало = СтрокаСторно.ПериодДействияНачалоСторно;
        Запись.ПериодДействияКонец = СтрокаСторно.ПериодДействияКонецСторно;
    КонецЦикла;
    Набор.Записать();
    РассчитатьВсе(ПодразделенияПересчета, СотрудникиПересчета);
    // Обновленные результаты уже записаны. Не даем механизму проведения затереть их исходным набором.
    Набор.Прочитать();
    Набор.Записывать = Ложь;
КонецПроцедуры

// Пересчитывает результаты при изменении отклонений без объектов перерасчета.
Процедура РассчитатьВсе(Подразделения, СотрудникиРасчета) Экспорт
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ Р.Регистратор КАК Регистратор
    |ИЗ РегистрРасчета.Начисления КАК Р
    |ГДЕ Р.Подразделение В (&Подразделения) ИЛИ Р.Сотрудник В (&Сотрудники)";
    Запрос.УстановитьПараметр("Подразделения", Подразделения);
    Запрос.УстановитьПараметр("Сотрудники", СотрудникиРасчета);
    РезультатЗапроса = Запрос.Выполнить();
    ТаблицаРегистраторов = РезультатЗапроса.Выгрузить();
    СсылкиРегистраторов = ТаблицаРегистраторов.ВыгрузитьКолонку("Регистратор");
    Запрос.УстановитьПараметр("Регистраторы", СсылкиРегистраторов);
    Запрос.Текст = "ВЫБРАТЬ Р.* ИЗ РегистрРасчета.Начисления КАК Р
    |ГДЕ Р.Регистратор В (&Регистраторы)";
    РезультатЗапроса = Запрос.Выполнить();
    ВсеЗаписи = РезультатЗапроса.Выгрузить();
    ВсеЗаписи.Индексы.Добавить("Регистратор");
    Запрос.УстановитьПараметр("СотрудникиНаборов", ВсеЗаписи.ВыгрузитьКолонку("Сотрудник"));
    Наборы = Новый Массив;
    Для Каждого СтрокаРегистратора Из ТаблицаРегистраторов Цикл
        Набор = РегистрыРасчета.Начисления.СоздатьНаборЗаписей();
        Набор.Отбор.Регистратор.Установить(СтрокаРегистратора.Регистратор);
        СтрокиНабора = ВсеЗаписи.НайтиСтроки(Новый Структура("Регистратор", СтрокаРегистратора.Регистратор));
        Набор.Загрузить(ВсеЗаписи.Скопировать(СтрокиНабора));
        Набор.Записать(Истина, Ложь, Истина, Ложь);
        Наборы.Добавить(Набор);
    КонецЦикла;
    Запрос.Текст =
    "ВЫБРАТЬ Г.Регистратор КАК Регистратор, Г.НомерСтроки КАК НомерСтроки,
    |Г.Сотрудник КАК Сотрудник, Г.Подразделение КАК Подразделение,
    |Г.ВидРасчета КАК ВидРасчета, Г.ПериодДействияНачало КАК Начало,
    |Г.ПериодРегистрации КАК Регистрация, Г.Сторно КАК Сторно,
    |Г.ЧасыФактическийПериодДействия КАК Часы,
    |Г.ДниФактическийПериодДействия КАК Дни,
    |Г.ЧасыПериодДействия КАК Норма
    |ИЗ РегистрРасчета.Начисления.ДанныеГрафика(Регистратор В (&Регистраторы)) КАК Г";
    РезультатЗапроса = Запрос.Выполнить();
    График = РезультатЗапроса.Выгрузить();
    График.Индексы.Добавить("Регистратор,НомерСтроки");
    Запрос.Текст = "ВЫБРАТЬ С.Период КАК Период, С.Сотрудник КАК Сотрудник, С.Ставка КАК Ставка
    |ИЗ РегистрСведений.ТарифныеСтавки КАК С ГДЕ С.Сотрудник В (&СотрудникиНаборов) УПОРЯДОЧИТЬ ПО Период УБЫВ";
    РезультатЗапроса = Запрос.Выполнить();
    Ставки = РезультатЗапроса.Выгрузить();
    Ставки.Индексы.Добавить("Сотрудник");
    Запрос.Текст = "ВЫБРАТЬ С.Ссылка КАК Сотрудник, С.НачалоСтажа КАК НачалоСтажа ИЗ Справочник.ФизическиеЛица КАК С ГДЕ С.Ссылка В (&СотрудникиНаборов)";
    РезультатЗапроса = Запрос.Выполнить();
    Сотрудники = РезультатЗапроса.Выгрузить();
    Сотрудники.Индексы.Добавить("Сотрудник");
    Запрос.Текст = "ВЫБРАТЬ Ш.Стаж КАК Стаж, Ш.Процент КАК Процент ИЗ РегистрСведений.ШкалаПремий КАК Ш УПОРЯДОЧИТЬ ПО Стаж УБЫВ";
    РезультатЗапроса = Запрос.Выполнить();
    Шкала = РезультатЗапроса.Выгрузить();
    Для Каждого Набор Из Наборы Цикл
        Для Каждого Запись Из Набор Цикл
            СтрокиГрафика = График.НайтиСтроки(Новый Структура("Регистратор,НомерСтроки", Запись.Регистратор, Запись.НомерСтроки));
            Часы = 0;
            Дни = 0;
            Если СтрокиГрафика.Количество() > 0 Тогда
                Часы = СтрокиГрафика[0].Часы;
                Дни = СтрокиГрафика[0].Дни;
            КонецЕсли;
            Если Запись.Сторно Тогда
                Часы = -Часы;
                Дни = -Дни;
            КонецЕсли;
            Если Запись.ВидРасчета = ПланыВидовРасчета.Начисления.Тариф Тогда
                Запись.Ставка = 0;
                Для Каждого Ставка Из Ставки.НайтиСтроки(Новый Структура("Сотрудник", Запись.Сотрудник)) Цикл
                    Если Ставка.Период <= НачалоМесяца(Запись.ПериодДействияНачало) Тогда
                        Запись.Ставка = Ставка.Ставка;
                        Прервать;
                    КонецЕсли;
                КонецЦикла;
                Если Запись.Ставка = 0 И Часы <> 0 Тогда
                    ВызватьИсключение "Не установлена тарифная ставка на начало месяца";
                КонецЕсли;
                Запись.Результат = Окр(Запись.Ставка * Часы, 2);
                Запись.Дни = Дни;
            Иначе
                Запись.Дни = 0;
            КонецЕсли;
            Запись.Стаж = 0;
            ДанныеСотрудника = Сотрудники.Найти(Запись.Сотрудник, "Сотрудник");
            Если ДанныеСотрудника <> Неопределено И ЗначениеЗаполнено(ДанныеСотрудника.НачалоСтажа) Тогда
                ДатаОценки = НачалоМесяца(Запись.ПериодДействияНачало);
                Лет = Год(ДатаОценки) - Год(ДанныеСотрудника.НачалоСтажа);
                Если ДобавитьМесяц(ДанныеСотрудника.НачалоСтажа, Лет * 12) > ДатаОценки Тогда
                    Лет = Лет - 1;
                КонецЕсли;
                Запись.Стаж = Макс(0, Лет);
            КонецЕсли;
            Запись.Процент = 0;
            Для Каждого Ступень Из Шкала Цикл
                Если Запись.Стаж >= Ступень.Стаж Тогда
                    Запись.Процент = Ступень.Процент;
                    Прервать;
                КонецЕсли;
            КонецЦикла;
        КонецЦикла;
        Набор.Записать(Истина, Истина);
    КонецЦикла;
    РассчитатьПремии(Наборы, График, СсылкиРегистраторов);
    РассчитатьКомандировки(Наборы, График, СсылкиРегистраторов);
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
Процедура РассчитатьПремии(Наборы, График, Регистраторы)
    Измерения = Новый Массив;
    Измерения.Добавить("Подразделение");
    Разрезы = Новый Массив;
    Разрезы.Добавить("Сотрудник");
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ Б.Регистратор КАК Регистратор, Б.НомерСтроки КАК НомерСтроки,
    |СУММА(Б.РезультатБаза) КАК База
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, &Разрезы, ВидРасчета = &Вид И Регистратор В (&Регистраторы)) КАК Б
    |ГДЕ Б.Сотрудник <> Б.СотрудникРазрез
    |СГРУППИРОВАТЬ ПО Б.Регистратор, Б.НомерСтроки";
    Запрос.УстановитьПараметр("Измерения", Измерения);
    Запрос.УстановитьПараметр("Разрезы", Разрезы);
    Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.Начисления.Премия);
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
    РезультатЗапроса = Запрос.Выполнить();
    Базы = РезультатЗапроса.Выгрузить();
    Базы.Индексы.Добавить("Регистратор,НомерСтроки");
    Для Каждого Набор Из Наборы Цикл
        Для Каждого Запись Из Набор Цикл
            Если Запись.ВидРасчета <> ПланыВидовРасчета.Начисления.Премия Тогда
                Продолжить;
            КонецЕсли;
            Запись.Результат = 0;
            Ключ = Новый Структура("Регистратор,НомерСтроки", Запись.Регистратор, Запись.НомерСтроки);
            СтрокиБазы = Базы.НайтиСтроки(Ключ);
            СтрокиГрафика = График.НайтиСтроки(Ключ);
            Если СтрокиБазы.Количество() > 0 И СтрокиГрафика.Количество() > 0 И СтрокиГрафика[0].Норма <> 0 Тогда
                Запись.Результат = Окр(СтрокиБазы[0].База * Запись.Процент / 100
                    * СтрокиГрафика[0].Часы / СтрокиГрафика[0].Норма, 2);
                Если Запись.Сторно Тогда
                    Запись.Результат = -Запись.Результат;
                КонецЕсли;
            КонецЕсли;
        КонецЦикла;
        Набор.Записать(Истина, Истина);
    КонецЦикла;
КонецПроцедуры

Процедура РассчитатьКомандировки(Наборы, График, Регистраторы)
    Измерения = Новый Массив;
    Измерения.Добавить("Сотрудник");
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ Б.Регистратор КАК Регистратор, Б.НомерСтроки КАК НомерСтроки,
    |Б.РезультатБаза КАК База, Б.ДниБаза КАК ДниБазы
    |ИЗ РегистрРасчета.Начисления.БазаНачисления(&Измерения, &Измерения, , ВидРасчета = &Вид И Регистратор В (&Регистраторы)) КАК Б";
    Запрос.УстановитьПараметр("Измерения", Измерения);
    Запрос.УстановитьПараметр("Вид", ПланыВидовРасчета.Начисления.Командировка);
    Запрос.УстановитьПараметр("Регистраторы", Регистраторы);
    РезультатЗапроса = Запрос.Выполнить();
    Базы = РезультатЗапроса.Выгрузить();
    Базы.Индексы.Добавить("Регистратор,НомерСтроки");
    ПорядокПоездок = Новый ТаблицаЗначений;
    ПорядокПоездок.Колонки.Добавить("Дата");
    ПорядокПоездок.Колонки.Добавить("НомерНабора");
    ПорядокПоездок.Колонки.Добавить("НомерЗаписи");
    Для НомерНабора = 0 По Наборы.Количество() - 1 Цикл
        Набор = Наборы[НомерНабора];
        Для НомерЗаписи = 0 По Набор.Количество() - 1 Цикл
            Запись = Набор[НомерЗаписи];
            Если Запись.ВидРасчета = ПланыВидовРасчета.Начисления.Командировка Тогда
                СтрокаПорядка = ПорядокПоездок.Добавить();
                СтрокаПорядка.Дата = Запись.ПериодДействияНачало;
                СтрокаПорядка.НомерНабора = НомерНабора;
                СтрокаПорядка.НомерЗаписи = НомерЗаписи;
            КонецЕсли;
        КонецЦикла;
    КонецЦикла;
    ПорядокПоездок.Сортировать("Дата");
    Корректировки = Новый ТаблицаЗначений;
    Корректировки.Колонки.Добавить("Сотрудник");
    Корректировки.Колонки.Добавить("Месяц");
    Корректировки.Колонки.Добавить("Сумма");
    Корректировки.Индексы.Добавить("Сотрудник");
    // Виртуальная база получена одним запросом. Изменения более ранних поездок
    // добавляем к ней в памяти: последующие поездки получают уже исправленный доход.
    Для Каждого СтрокаПорядка Из ПорядокПоездок Цикл
        Набор = Наборы[СтрокаПорядка.НомерНабора];
        Запись = Набор[СтрокаПорядка.НомерЗаписи];
        ПрежнийРезультат = Запись.Результат;
        Запись.Результат = 0;
        Ключ = Новый Структура("Регистратор,НомерСтроки", Запись.Регистратор, Запись.НомерСтроки);
        СтрокиБазы = Базы.НайтиСтроки(Ключ);
        СтрокиГрафика = График.НайтиСтроки(Ключ);
        Если СтрокиБазы.Количество() > 0 И СтрокиБазы[0].ДниБазы > 0 И СтрокиГрафика.Количество() > 0 Тогда
            База = СтрокиБазы[0].База;
            Для Каждого Корректировка Из Корректировки.НайтиСтроки(Новый Структура("Сотрудник", Запись.Сотрудник)) Цикл
                Если Корректировка.Месяц >= Запись.БазовыйПериодНачало
                    И Корректировка.Месяц <= Запись.БазовыйПериодКонец Тогда
                    База = База + Корректировка.Сумма;
                КонецЕсли;
            КонецЦикла;
            Запись.Результат = Окр(База / СтрокиБазы[0].ДниБазы * СтрокиГрафика[0].Дни, 2);
        КонецЕсли;
        Корректировка = Корректировки.Добавить();
        Корректировка.Сотрудник = Запись.Сотрудник;
        Корректировка.Месяц = НачалоМесяца(Запись.ПериодДействияНачало);
        Корректировка.Сумма = Запись.Результат - ПрежнийРезультат;
    КонецЦикла;
    Для Каждого Набор Из Наборы Цикл
        Набор.Записать(Истина, Истина);
    КонецЦикла;
КонецПроцедуры
#КонецОбласти
