#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ОбработчикиСобытий
// Ограничение частоты изменения состава обязательно и при загрузке данных.
// BSLLS:DataExchangeLoading-off
Процедура ПередЗаписью(Отказ, Замещение)
    НовыеСтроки = Выгрузить();
    Если НовыеСтроки.Количество() = 0 Тогда
        Возврат;
    КонецЕсли;
    Блокировка = Новый БлокировкаДанных;
    Элемент = Блокировка.Добавить("РегистрСведений.Спецификации");
    Элемент.Режим = РежимБлокировкиДанных.Исключительный;
    Блокировка.Заблокировать();
    Запрос = Новый Запрос;
    Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ С.СистемныйБлок КАК СистемныйБлок, С.Период КАК Период
    |ИЗ РегистрСведений.Спецификации КАК С ГДЕ С.СистемныйБлок В (&Блоки)";
    Запрос.УстановитьПараметр("Блоки", НовыеСтроки.ВыгрузитьКолонку("СистемныйБлок"));
    РезультатЗапроса = Запрос.Выполнить();
    Версии = РезультатЗапроса.Выгрузить();
    Версии.Индексы.Добавить("СистемныйБлок");
    Для Каждого СтрокаСпецификации Из НовыеСтроки Цикл
        Если СтрокаСпецификации.Количество <= 0 Тогда
            ВызватьИсключение "Количество детали в спецификации должно быть больше нуля";
        КонецЕсли;
        СтруктураОтбора = Новый Структура("СистемныйБлок", СтрокаСпецификации.СистемныйБлок);
        Для Каждого Версия Из Версии.НайтиСтроки(СтруктураОтбора) Цикл
            Если НачалоНедели(Версия.Период) = НачалоНедели(СтрокаСпецификации.Период)
                И Версия.Период <> СтрокаСпецификации.Период Тогда
                ВызватьИсключение "Состав блока можно изменять не чаще одного раза в календарную неделю";
            КонецЕсли;
        КонецЦикла;
        Версия = Версии.Добавить();
        Версия.СистемныйБлок = СтрокаСпецификации.СистемныйБлок;
        Версия.Период = СтрокаСпецификации.Период;
    КонецЦикла;
КонецПроцедуры
// BSLLS:DataExchangeLoading-on
#КонецОбласти
#КонецЕсли
