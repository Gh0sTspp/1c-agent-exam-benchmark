#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если СписокНоменклатуры.Количество() = 0 Тогда
        ВызватьИсключение "Не заполнен список номенклатуры";
    КонецЕсли;
    УчетЗапасов.Заблокировать(ЭтотОбъект);
    Движения.Запасы.Записывать = Истина;
    Движения.Учет.Записывать = Истина;
    Движения.Запасы.Очистить();
    Движения.Учет.Очистить();
    Для Каждого СтрокаТоваров Из СписокНоменклатуры Цикл
        Если СтрокаТоваров.Количество <= 0 Тогда
            ВызватьИсключение "Количество должно быть больше нуля";
        КонецЕсли;
        Стоимость = УчетЗапасов.СуммаСтроки(СтрокаТоваров);
        Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура) Или Стоимость < 0 Тогда
            ВызватьИсключение "Не указан товар или задана отрицательная сумма поступления";
        КонецЕсли;
        ПодразделениеСтроки = СтрокаТоваров.Подразделение;
        Если Не ЗначениеЗаполнено(ПодразделениеСтроки) Тогда
            ПодразделениеСтроки = Подразделение;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ПодразделениеСтроки) И Не ЗначениеЗаполнено(Склад) Тогда
            ВызватьИсключение "Укажите подразделение или склад поступления";
        КонецЕсли;
        Если ЗначениеЗаполнено(ПодразделениеСтроки) Тогда
            УчетЗапасов.Приход(ЭтотОбъект, ПодразделениеСтроки, СтрокаТоваров.Номенклатура,
                СтрокаТоваров.Свойство, СтрокаТоваров.Количество, Стоимость);
        КонецЕсли;
        Если ЗначениеЗаполнено(Склад) Тогда
            Движение = Движения.Учет.Добавить();
            Движение.Период = Дата;
            Движение.СчетДт = ПланыСчетов.Торговый.Товары;
            Движение.СчетКт = ПланыСчетов.Торговый.Поставщики;
            Движение.СубконтоДт[ПланыВидовХарактеристик.АналитикаТорговли.Номенклатура] = СтрокаТоваров.Номенклатура;
            Движение.СубконтоДт[ПланыВидовХарактеристик.АналитикаТорговли.Склады] = Склад;
            Движение.КоличествоДт = СтрокаТоваров.Количество;
            Движение.Сумма = Стоимость;
        КонецЕсли;
    КонецЦикла;
КонецПроцедуры
#КонецОбласти

#КонецЕсли
