#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если Не ЗначениеЗаполнено(ПодразделениеИсточник) Или Не ЗначениеЗаполнено(ПодразделениеПолучатель) Тогда
        ВызватьИсключение "Укажите подразделения списания деталей и поступления блоков";
    КонецЕсли;
    УчетЗапасов.Заблокировать(ЭтотОбъект);
    Движения.Запасы.Записывать = Истина;
    Движения.Запасы.Очистить();
    Движения.Запасы.Записать();
    Остатки = УчетЗапасов.Остатки(ЭтотОбъект);
    Политики = УчетЗапасов.Политики(Дата);
    Метод = Политики.Получить(ПодразделениеИсточник);
    // Спецификация задается целиком на одну дату версии; исчезнувшие детали не переходят из старой версии.
    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ С.СистемныйБлок КАК СистемныйБлок, МАКСИМУМ(С.Период) КАК Период
    |ПОМЕСТИТЬ ВТ_Версии ИЗ РегистрСведений.Спецификации КАК С
    |ГДЕ С.Период <= &Дата И С.СистемныйБлок В (&Блоки)
    |СГРУППИРОВАТЬ ПО С.СистемныйБлок ИНДЕКСИРОВАТЬ ПО СистемныйБлок;
    |ВЫБРАТЬ С.СистемныйБлок КАК СистемныйБлок, С.Деталь КАК Деталь,
    |С.Свойство КАК Свойство, С.Количество КАК Количество
    |ИЗ РегистрСведений.Спецификации КАК С
    |ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Версии КАК Версии
    |ПО С.СистемныйБлок = Версии.СистемныйБлок И С.Период = Версии.Период";
    Запрос.УстановитьПараметр("Дата", Дата);
    Запрос.УстановитьПараметр("Блоки", СистемныеБлоки.ВыгрузитьКолонку("Номенклатура"));
    РезультатЗапроса = Запрос.Выполнить();
    Спецификации = РезультатЗапроса.Выгрузить();
    Спецификации.Индексы.Добавить("СистемныйБлок");
    ВсегоБлоков = СистемныеБлоки.Итог("Количество");
    Если ВсегоБлоков <= 0 Тогда
        ВызватьИсключение "Не указаны собираемые системные блоки";
    КонецЕсли;
    ДополнительнаяСтоимость = 0;
    Для Каждого Деталь Из ДополнительныеДетали Цикл
        ДополнительнаяСтоимость = ДополнительнаяСтоимость + УчетЗапасов.Списать(ЭтотОбъект, Остатки,
            ПодразделениеИсточник, Деталь.Номенклатура, Деталь.Свойство, Деталь.Количество, Метод);
    КонецЦикла;
    ОстатокДопСтоимость = ДополнительнаяСтоимость;
    НомерБлока = 0;
    Для Каждого Блок Из СистемныеБлоки Цикл
        НомерБлока = НомерБлока + 1;
        Если Блок.Количество <= 0 Тогда
            ВызватьИсключение "Количество системных блоков должно быть больше нуля";
        КонецЕсли;
        Состав = Спецификации.НайтиСтроки(Новый Структура("СистемныйБлок", Блок.Номенклатура));
        Если Состав.Количество() = 0 Тогда
            ВызватьИсключение "Не задана спецификация: " + Строка(Блок.Номенклатура);
        КонецЕсли;
        Стоимость = 0;
        Для Каждого Деталь Из Состав Цикл
            Стоимость = Стоимость + УчетЗапасов.Списать(ЭтотОбъект, Остатки, ПодразделениеИсточник,
                Деталь.Деталь, Деталь.Свойство, Деталь.Количество * Блок.Количество, Метод);
        КонецЦикла;
        Доля = Окр(ДополнительнаяСтоимость * Блок.Количество / ВсегоБлоков, 2);
        Если НомерБлока = СистемныеБлоки.Количество() Тогда
            Доля = ОстатокДопСтоимость;
        КонецЕсли;
        ОстатокДопСтоимость = ОстатокДопСтоимость - Доля;
        УчетЗапасов.Приход(ЭтотОбъект, ПодразделениеПолучатель, Блок.Номенклатура,
            Справочники.СвойстваНоменклатуры.ПустаяСсылка(), Блок.Количество, Стоимость + Доля);
    КонецЦикла;
КонецПроцедуры
#КонецОбласти

#КонецЕсли
