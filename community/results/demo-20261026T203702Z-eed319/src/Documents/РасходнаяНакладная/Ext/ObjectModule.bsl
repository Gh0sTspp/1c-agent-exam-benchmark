#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
    Если СписокНоменклатуры.Количество() = 0 Тогда
        ВызватьИсключение "Не заполнен список номенклатуры";
    КонецЕсли;
    УчетЗапасов.Заблокировать(ЭтотОбъект);
    Движения.Запасы.Записывать = Истина;
    Движения.Учет.Записывать = Истина;
    Движения.Продажи.Записывать = Истина;
    Движения.Запасы.Очистить();
    Движения.Учет.Очистить();
    Движения.Продажи.Очистить();
    // Исключаем старые движения при перепроведении.
    Движения.Запасы.Записать();
    Движения.Учет.Записать();
    Движения.Продажи.Записать();
    Остатки = УчетЗапасов.Остатки(ЭтотОбъект);
    Политики = УчетЗапасов.Политики(Дата);
    Для Каждого СтрокаТоваров Из СписокНоменклатуры Цикл
        Если СтрокаТоваров.Количество <= 0 Тогда
            ВызватьИсключение "Количество должно быть больше нуля";
        КонецЕсли;
        Если Не ЗначениеЗаполнено(СтрокаТоваров.Номенклатура)
            Или УчетЗапасов.СуммаСтроки(СтрокаТоваров) < 0 Тогда
            ВызватьИсключение "Не указан товар или задана отрицательная сумма продажи";
        КонецЕсли;
        ПодразделениеСтроки = СтрокаТоваров.Подразделение;
        Если Не ЗначениеЗаполнено(ПодразделениеСтроки) Тогда
            ПодразделениеСтроки = Подразделение;
        КонецЕсли;
        Если Не ЗначениеЗаполнено(ПодразделениеСтроки) И Не ЗначениеЗаполнено(Склад) Тогда
            ВызватьИсключение "Укажите подразделение или склад продажи";
        КонецЕсли;
        Если ЗначениеЗаполнено(ПодразделениеСтроки) Тогда
            Стоимость = УчетЗапасов.Списать(ЭтотОбъект, Остатки, ПодразделениеСтроки,
                СтрокаТоваров.Номенклатура, СтрокаТоваров.Свойство, СтрокаТоваров.Количество,
                Политики.Получить(ПодразделениеСтроки));
            УчетЗапасов.Продажа(ЭтотОбъект, СтрокаТоваров.Номенклатура, СтрокаТоваров.Номенклатура,
                СтрокаТоваров.Количество, Стоимость, УчетЗапасов.СуммаСтроки(СтрокаТоваров), "ОУ");
        КонецЕсли;
    КонецЦикла;
    Если ЗначениеЗаполнено(Склад) Тогда
        БухгалтерскийУчет.Продать(ЭтотОбъект);
    КонецЕсли;
КонецПроцедуры
#КонецОбласти

#КонецЕсли
